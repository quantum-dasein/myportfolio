# Paste the verification tokens shown by each webmaster platform, then rebuild.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=

# GA4 measurement ID ("G-XXXXXXXXXX"). Set it and src/utils/vitals.ts starts
# reporting real LCP / CLS / INP / FCP / TTFB from real visitors, tagged
# mobile vs desktop and by page path. Left blank the collector stays a silent
# no-op in production and only logs to the console in dev.
# Set the same value in the Vercel project's environment variables so it is
# present at build time — PUBLIC_ vars are inlined into the bundle.
PUBLIC_GA4_ID=

# Origin serving the portfolio films (Cloudflare R2, Vercel Blob, any CDN),
# e.g. "https://media.rodionbelousov.studio" — no trailing slash. Set it and
# the three .mp4 files are requested from there and dropped from the build
# output, cutting dist/ from ~43 MB to ~12 MB and with it the Vercel
# Deployment Storage every deploy consumes. The CDN must send
# Access-Control-Allow-Origin, because the WebGL gallery samples the film as a
# texture. Left blank the films are served from /public as before.
PUBLIC_MEDIA_BASE_URL=
