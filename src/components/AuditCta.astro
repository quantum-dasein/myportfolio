---
import type { Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
  compact?: boolean;
}
const { lang, compact = false } = Astro.props;
const de = lang === "de";
const href = `${de ? "/de/kontakt/" : "/contact/"}?project=audit`;
---

<aside class:list={["audit-cta", { compact }]} data-reveal>
  <div class="audit-mark" aria-hidden="true">
    <span>01</span><span>02</span><span>03</span>
  </div>
  <div class="audit-copy">
    <span class="audit-kicker"
      >{de ? "KOSTENLOSER 3-PUNKTE-CHECK" : "FREE THREE-POINT CHECK"}</span
    >
    <h2>{de ? "Schicken Sie mir Ihre Website." : "Send me your website."}</h2>
    <p>
      {
        de
          ? "Ich antworte mit drei konkreten Verbesserungen für Klarheit, mobile Nutzung und Anfragen — ohne Verkaufsgespräch und ohne PDF voller Allgemeinplätze."
          : "I will reply with three concrete improvements for clarity, mobile use and enquiries — no sales call and no PDF full of generalities."
      }
    </p>
  </div>
  <a
    href={href}
    data-track="audit_open"
    data-track-item="three-point-check"
    data-track-place={compact ? "service-page" : "services-hub"}
    data-cursor="OPEN"
    data-magnetic
  >
    <span>{de ? "Website prüfen lassen" : "Get the website checked"}</span>
    <i aria-hidden="true">→</i>
  </a>
</aside>

<style>
  .audit-cta {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: clamp(1.4rem, 3vw, 3rem);
    align-items: center;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 16px;
    background:
      radial-gradient(
        circle at 12% 50%,
        rgba(255, 255, 255, 0.09),
        transparent 24rem
      ),
      rgba(5, 7, 9, 0.94);
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.08),
      0 2rem 5rem rgba(0, 0, 0, 0.28);
  }
  .audit-mark {
    display: grid;
    gap: 0.28rem;
    width: 3.5rem;
  }
  .audit-mark span {
    display: block;
    padding: 0.28rem 0.4rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    font: 0.58rem var(--font-inter);
    letter-spacing: 0.18em;
    color: rgba(var(--rgb-text), 0.58);
  }
  .audit-mark span:nth-child(2) {
    transform: translateX(0.45rem);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.5);
  }
  .audit-kicker {
    font: 0.6rem var(--font-inter);
    letter-spacing: 0.2em;
    color: rgba(var(--rgb-text), 0.48);
  }
  .audit-copy h2 {
    margin: 0.65rem 0 0.5rem;
    font: 500 clamp(1.45rem, 2.5vw, 2.25rem)/1.05 var(--font-display);
  }
  .audit-copy p {
    max-width: 58ch;
    margin: 0;
    color: rgba(var(--rgb-text), 0.68);
    font-size: 0.94rem;
    line-height: 1.55;
  }
  .audit-cta > a {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem 1.35rem;
    border-radius: 999px;
    background: #f3f5f6;
    color: #090b0d;
    font: 600 0.66rem var(--font-inter);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      opacity 0.25s ease,
      gap 0.4s var(--ease-out-expo);
  }
  .audit-cta > a:hover {
    opacity: 0.86;
    gap: 1.15rem;
  }
  .audit-cta > a i {
    font-style: normal;
  }
  .audit-cta.compact {
    margin-block: clamp(3rem, 7vw, 6rem);
  }

  @media (max-width: 820px) {
    .audit-cta {
      grid-template-columns: auto 1fr;
    }
    .audit-cta > a {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }
  @media (max-width: 520px) {
    .audit-cta {
      grid-template-columns: 1fr;
    }
    .audit-mark {
      grid-auto-flow: column;
      grid-template-columns: repeat(3, 1fr);
      width: 100%;
    }
    .audit-mark span:nth-child(2) {
      transform: none;
    }
    .audit-cta > a {
      width: 100%;
      justify-content: space-between;
      white-space: normal;
    }
  }
</style>
