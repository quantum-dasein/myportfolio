---
// ─────────────────────────────────────────────────────────────────────────────
//  ContactForm — the thing that replaces `mailto:`.
//
//  A mailto link is a dead end on a phone: it hands the visitor off to a mail
//  app that half of them have never set up, and whatever they were going to
//  write is lost. Three answers — what, when, roughly how much — are enough to
//  quote from, which is the promise the process scene makes elsewhere on the
//  site, so the form asks for exactly those and nothing else.
//
//  Delivery: the site is a static build with no server of its own, so the POST
//  goes to Formspree, which forwards it to Rodion's inbox. The form id is public
//  by design — it is meant to sit in client HTML and only permits submissions to
//  one configured address — so it lives here rather than in an environment
//  variable that has to be set on every deploy target. PUBLIC_FORM_ENDPOINT can
//  still override it for a staging form.
//
//  Formspree's own AJAX SDK is not used. It exists to supply form state,
//  validation display and button handling, and this form already had all three
//  before Formspree did: a status line, `reportValidity`, a disabled button and
//  a honeypot. Adding the library would mean a script from a CDN and a second
//  source of truth for the same behaviour.
// ─────────────────────────────────────────────────────────────────────────────
import { useTranslations, type Lang } from "../i18n/utils";
import { scopes } from "../data/scopes";

interface Props { lang?: Lang }
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const ENDPOINT = import.meta.env.PUBLIC_FORM_ENDPOINT ?? "https://formspree.io/f/mjyvjpdk";
const MAIL = "rodionbelousov@protonmail.com";

const what = ["audit", "landing", "site", "film", "shop", "seo", "platform", "showreel", "other"] as const;
// The lattice behind the form is the same one the scope picker drives: every
// node is a unit of the job, so choosing "a landing page" contracts it to a
// handful and "a platform" fills it. The ratios live in scopes.ts; "other" is
// the one answer with no row there, so it sits in the middle rather than
// pretending to be a size.
const fieldOf = (id: string) => scopes.find((scope) => scope.id === id)?.field ?? 0.5;
const when = ["asap", "month", "quarter", "open"] as const;
const budget = ["small", "mid", "large", "xl", "unsure"] as const;
---

<form class="cf" data-contact-form data-endpoint={ENDPOINT} data-mail={MAIL} novalidate>
  <div class="cf-audit-intro" data-audit-intro hidden>
    <strong>{lang === "de" ? "Kostenloser 3-Punkte-Check" : "Free three-point check"}</strong>
    <p>{lang === "de"
      ? "Tragen Sie die Website ein. Sie erhalten drei konkrete Verbesserungen — ohne Verkaufsgespräch."
      : "Add the website below. You will get three concrete improvements — no sales call."}</p>
  </div>
  <div class="cf-field">
    <label for="cf-what"><i aria-hidden="true">01</i><span data-i18n="form.what.label">{t("form.what.label")}</span></label>
    <select id="cf-what" name="what" required>
      {what.map((id) => (
        <option value={id} data-field={fieldOf(id)} data-i18n={`form.what.${id}`}>{t(`form.what.${id}` as any)}</option>
      ))}
    </select>
  </div>

  <div class="cf-field">
    <label for="cf-url"><i aria-hidden="true">02</i><span data-i18n="form.url.label">{t("form.url.label")}</span></label>
    <input
      id="cf-url"
      name="url"
      type="url"
      autocomplete="url"
      inputmode="url"
      placeholder={t("form.url.placeholder")}
      data-i18n-attr="placeholder:form.url.placeholder"
      data-audit-url
    />
  </div>

  <div class="cf-row">
    <div class="cf-field">
      <label for="cf-when"><i aria-hidden="true">03</i><span data-i18n="form.when.label">{t("form.when.label")}</span></label>
      <select id="cf-when" name="when" required>
        {when.map((id) => (
          <option value={id} data-i18n={`form.when.${id}`}>{t(`form.when.${id}` as any)}</option>
        ))}
      </select>
    </div>
    <div class="cf-field">
      <label for="cf-budget"><i aria-hidden="true">04</i><span data-i18n="form.budget.label">{t("form.budget.label")}</span></label>
      <select id="cf-budget" name="budget" required>
        {budget.map((id) => (
          <option value={id} data-i18n={`form.budget.${id}`}>{t(`form.budget.${id}` as any)}</option>
        ))}
      </select>
    </div>
  </div>

  <div class="cf-field">
    <label for="cf-email"><i aria-hidden="true">05</i><span data-i18n="form.email.label">{t("form.email.label")}</span></label>
    <input
      id="cf-email"
      name="email"
      type="email"
      required
      autocomplete="email"
      inputmode="email"
      placeholder={t("form.email.placeholder")}
      data-i18n-attr="placeholder:form.email.placeholder"
    />
  </div>

  <div class="cf-field">
    <label for="cf-message"><i aria-hidden="true">06</i><span data-i18n="form.message.label">{t("form.message.label")}</span></label>
    <textarea
      id="cf-message"
      name="message"
      rows="3"
      placeholder={t("form.message.placeholder")}
      data-i18n-attr="placeholder:form.message.placeholder"
    ></textarea>
  </div>

  {/* Bots fill every field they can see. This one they can, and people cannot. */}
  <input class="cf-trap" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <button class="cf-send" type="submit">
    <span data-i18n="form.submit">{t("form.submit")}</span>
    <span class="cf-arrow" aria-hidden="true"></span>
  </button>

  <p class="cf-note" data-i18n="form.privacy">{t("form.privacy")}</p>
  <p class="cf-status" role="status" aria-live="polite"></p>
</form>

<style is:global>
  .cf { display: grid; gap: 1.35rem; max-width: 34rem; }
  .cf-audit-intro { padding: 1rem 1.1rem; border: 1px solid rgba(var(--rgb-text), .2); border-radius: 12px; background: rgba(var(--rgb-white), .045); }
  .cf-audit-intro[hidden] { display: none; }
  .cf-audit-intro strong { font: 500 1rem var(--font-display); }
  .cf-audit-intro p { margin: .4rem 0 0; color: var(--color-text-alt); font-size: .82rem; line-height: 1.5; }
  .cf-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.35rem; }
  .cf-field { position: relative; display: grid; gap: 0.55rem; min-width: 0; }

  .cf-field label {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-alt);
    transition: color 0.3s ease;
  }
  /* Step numbers make a six-question form feel finite rather than open-ended. */
  .cf-field label i {
    font-style: normal;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    color: rgba(var(--rgb-text), 0.3);
    transition: color 0.3s ease;
  }
  .cf-field:focus-within label { color: var(--color-text); }
  .cf-field:focus-within label i { color: var(--color-accent); }

  .cf select,
  .cf-select-trigger,
  .cf input,
  .cf textarea {
    width: 100%;
    font: inherit;
    font-size: 0.92rem;
    color: var(--color-text);
    /* A flat rgba fill read as a browser default. This is the same glass the
       cards elsewhere on the site are made of: a top-lit gradient, a hairline,
       and an inner highlight along the upper edge. */
    /* The lattice behind this form draws lines across the whole column, so the
       controls need a floor of their own or the placeholder competes with it. */
    background:
      linear-gradient(180deg, rgba(var(--rgb-white), 0.055), rgba(var(--rgb-white), 0.015)),
      rgba(7, 9, 11, 0.82);
    border: 1px solid rgba(var(--rgb-text), 0.16);
    border-radius: 12px;
    padding: 0.95rem 1.05rem;
    box-shadow: inset 0 1px 0 rgba(var(--rgb-white), 0.07);
    transition: border-color 0.3s ease, box-shadow 0.35s ease, background-color 0.3s ease;
    /* iOS zooms the page in on focus for anything under 16px, and never zooms
       back out. The visual size stays small; only the computed size is 16. */
    -webkit-text-size-adjust: 100%;
  }
  .cf textarea { resize: vertical; min-height: 6rem; line-height: 1.5; }

  /* Native selects inherit the OS palette on some platforms and come out white
     text on white. Naming both sides keeps the dropdown readable everywhere. */
  .cf select {
    appearance: none;
    color-scheme: dark;
    /* A select with the chevron removed and nothing put back looks exactly like
       a text input that will not accept typing. */
    padding-right: 2.9rem;
    /* Long German options must not run past the box on engines that do not
       ellipsise a select on their own. */
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .cf select option { background: #0d1013; color: #f4f6f9; }

  /* Drawn rather than typed: a glyph would inherit the OS emoji font on iOS. */
  .cf-field { --chev: 1.15rem; }
  .cf-field:not(.has-custom-select):has(select)::after {
    content: "";
    position: absolute;
    right: 1.15rem;
    bottom: 1.42rem;
    width: 0.44rem;
    height: 0.44rem;
    border-right: 1px solid rgba(var(--rgb-text), 0.55);
    border-bottom: 1px solid rgba(var(--rgb-text), 0.55);
    transform: rotate(45deg);
    pointer-events: none;
    transition: border-color 0.3s ease, transform 0.35s var(--ease-out-expo);
  }
  .cf-field:not(.has-custom-select):focus-within:has(select)::after {
    border-color: var(--color-text);
    transform: rotate(45deg) translate(1px, 1px);
  }

  .cf select:hover,
  .cf-select-trigger:hover,
  .cf input:hover,
  .cf textarea:hover { border-color: rgba(var(--rgb-text), 0.3); }

  .cf select:focus-visible,
  .cf-select-trigger:focus-visible,
  .cf input:focus-visible,
  .cf textarea:focus-visible {
    outline: none;
    border-color: rgba(var(--rgb-text), 0.62);
    background:
      linear-gradient(180deg, rgba(var(--rgb-white), 0.09), rgba(var(--rgb-white), 0.03)),
      rgba(9, 11, 14, 0.88);
    box-shadow:
      inset 0 1px 0 rgba(var(--rgb-white), 0.1),
      0 0 0 3px rgba(var(--rgb-text), 0.07),
      0 0 28px rgba(var(--rgb-white), 0.05);
  }

  /* The operating system owns a native <select> popup, including the white
     rectangle visible in Chromium on Windows. Keep the real select as the form
     value and progressive fallback, then place an accessible site-native
     listbox over it only after the enhancer has built successfully. */
  .cf-field.has-custom-select > select {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }
  .cf-select-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
    max-width: 100%;
    min-height: 3.45rem;
    text-align: left;
    cursor: pointer;
  }
  .cf-select-trigger > span {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .cf-select-trigger > i {
    flex: 0 0 auto;
    width: .5rem;
    height: .5rem;
    border-right: 1px solid rgba(var(--rgb-text), .6);
    border-bottom: 1px solid rgba(var(--rgb-text), .6);
    transform: rotate(45deg) translate(-1px, -1px);
    transition: transform .35s var(--ease-out-expo), border-color .25s ease;
  }
  .cf-field.is-select-open .cf-select-trigger {
    border-color: rgba(var(--rgb-text), .58);
    box-shadow: inset 0 1px rgba(var(--rgb-white), .1), 0 0 0 3px rgba(var(--rgb-text), .06);
  }
  .cf-field.is-select-open .cf-select-trigger > i {
    border-color: #fff;
    transform: rotate(225deg) translate(-1px, -1px);
  }
  .cf-select-menu {
    position: absolute;
    z-index: 30;
    left: 0;
    right: 0;
    top: calc(100% + .55rem);
    max-height: min(22rem, 52vh);
    overflow: auto;
    overscroll-behavior: contain;
    padding: .45rem;
    border: 1px solid rgba(var(--rgb-text), .24);
    border-radius: 13px;
    background:
      linear-gradient(180deg, rgba(var(--rgb-white), .055), transparent 35%),
      rgba(5, 7, 9, .985);
    box-shadow:
      inset 0 1px rgba(var(--rgb-white), .08),
      0 1.4rem 4rem rgba(0, 0, 0, .72);
    backdrop-filter: blur(18px);
  }
  .cf-select-menu[hidden] { display: none; }
  .cf-field.is-select-open.select-open-up .cf-select-menu {
    top: auto;
    bottom: calc(100% + .55rem);
  }
  .cf-select-option {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    gap: .7rem;
    align-items: center;
    width: 100%;
    min-height: 2.9rem;
    padding: .65rem .75rem;
    border: 1px solid transparent;
    border-radius: 9px;
    color: rgba(var(--rgb-text), .76);
    background: transparent;
    text-align: left;
    cursor: pointer;
    transition: color .2s ease, background-color .2s ease, border-color .2s ease;
  }
  .cf-select-option:hover,
  .cf-select-option:focus-visible {
    outline: none;
    color: #fff;
    background: rgba(var(--rgb-white), .07);
    border-color: rgba(var(--rgb-text), .12);
  }
  .cf-select-option[aria-selected="true"] {
    color: #fff;
    background: rgba(var(--rgb-white), .1);
    border-color: rgba(var(--rgb-text), .2);
  }
  .cf-select-option > small {
    font: .55rem var(--font-inter);
    letter-spacing: .14em;
    color: rgba(var(--rgb-text), .34);
  }
  .cf-select-option[aria-selected="true"] > small { color: rgba(var(--rgb-text), .72); }
  .cf-select-option > b {
    width: .42rem;
    height: .7rem;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg);
    opacity: 0;
  }
  .cf-select-option[aria-selected="true"] > b { opacity: 1; }
  .cf input:user-invalid {
    border-color: rgba(226, 128, 128, 0.6);
    box-shadow: inset 0 1px 0 rgba(var(--rgb-white), 0.05), 0 0 0 3px rgba(226, 128, 128, 0.09);
  }

  .cf-trap { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  .cf-send {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    justify-self: start;
    margin-top: 0.35rem;
    padding: 0.95rem 1.6rem;
    font: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #0b0e12;
    background: var(--color-text);
    border: 1px solid transparent;
    border-radius: 999px;
    cursor: pointer;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .cf-send:hover { opacity: 0.86; }
  .cf-send[disabled] { opacity: 0.5; cursor: progress; }
  .cf-arrow {
    width: 0.5rem;
    height: 0.5rem;
    border-top: 1px solid currentColor;
    border-right: 1px solid currentColor;
    transform: rotate(45deg);
  }

  .cf-note { margin: 0; font-size: 0.76rem; color: var(--color-text-alt); }
  .cf-status { margin: 0; font-size: 0.88rem; min-height: 1.2em; }
  .cf-status.is-ok { color: var(--color-text); }
  .cf-status.is-bad { color: rgb(226, 150, 150); }

  @media (max-width: 560px) {
    .cf-row { grid-template-columns: 1fr; }
    /* Anything under 16px makes iOS zoom in on focus and stay there. */
    .cf select, .cf-select-trigger, .cf input, .cf textarea { font-size: 16px; }
    .cf-select-menu { max-height: min(21rem, 48vh); }
  }
</style>

<script>
  import { t as translate } from "../utils/i18n";
  import { getAttribution } from "../utils/analytics";

  let selectSequence = 0;

  function enhanceSelect(select: HTMLSelectElement) {
    if (select.dataset.customSelect === "true") return;
    const field = select.closest<HTMLElement>(".cf-field");
    if (!field) return;

    const menuId = `${select.id || "cf-select"}-menu-${++selectSequence}`;
    const trigger = document.createElement("button");
    trigger.type = "button";
    trigger.className = "cf-select-trigger";
    trigger.setAttribute("role", "combobox");
    trigger.setAttribute("aria-haspopup", "listbox");
    trigger.setAttribute("aria-expanded", "false");
    trigger.setAttribute("aria-controls", menuId);
    trigger.id = `${select.id || "cf-select"}-trigger`;
    trigger.innerHTML = `<span></span><i aria-hidden="true"></i>`;

    const menu = document.createElement("div");
    menu.className = "cf-select-menu";
    menu.id = menuId;
    menu.setAttribute("role", "listbox");
    menu.hidden = true;

    const options = Array.from(select.options).map((option, index) => {
      const item = document.createElement("button");
      item.type = "button";
      item.className = "cf-select-option";
      item.setAttribute("role", "option");
      item.dataset.value = option.value;
      item.innerHTML = `<small>${String(index + 1).padStart(2, "0")}</small><span></span><b aria-hidden="true"></b>`;
      item.querySelector("span")!.textContent = option.textContent;
      menu.appendChild(item);
      return item;
    });

    field.append(trigger, menu);
    field.classList.add("has-custom-select");
    const label = field.querySelector<HTMLLabelElement>("label");
    if (label) label.htmlFor = trigger.id;
    select.dataset.customSelect = "true";
    select.tabIndex = -1;
    select.setAttribute("aria-hidden", "true");

    const sync = () => {
      const selected = select.selectedOptions[0] ?? select.options[0];
      trigger.querySelector("span")!.textContent = selected?.textContent || "";
      options.forEach((item) => item.setAttribute("aria-selected", String(item.dataset.value === select.value)));
    };
    const close = (restoreFocus = false) => {
      menu.hidden = true;
      field.classList.remove("is-select-open", "select-open-up");
      trigger.setAttribute("aria-expanded", "false");
      if (restoreFocus) trigger.focus();
    };
    const open = () => {
      document.querySelectorAll<HTMLElement>(".cf-field.is-select-open").forEach((other) => {
        if (other !== field) other.dispatchEvent(new CustomEvent("cf:select-close"));
      });
      menu.hidden = false;
      const rect = trigger.getBoundingClientRect();
      const roomBelow = innerHeight - rect.bottom - 12;
      const roomAbove = rect.top - 12;
      const wantedHeight = Math.min(menu.scrollHeight, innerHeight * .52);
      field.classList.toggle("select-open-up", roomBelow < wantedHeight && roomAbove > roomBelow);
      field.classList.add("is-select-open");
      trigger.setAttribute("aria-expanded", "true");
      (options.find((item) => item.getAttribute("aria-selected") === "true") ?? options[0])?.focus();
    };

    trigger.addEventListener("click", () => menu.hidden ? open() : close());
    trigger.addEventListener("keydown", (event) => {
      if (["ArrowDown", "ArrowUp", "Enter", " "].includes(event.key)) {
        event.preventDefault();
        menu.hidden ? open() : close();
      }
    });
    menu.addEventListener("keydown", (event) => {
      const current = Math.max(0, options.indexOf(document.activeElement as HTMLButtonElement));
      let next = current;
      if (event.key === "ArrowDown") next = (current + 1) % options.length;
      else if (event.key === "ArrowUp") next = (current - 1 + options.length) % options.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = options.length - 1;
      else if (event.key === "Escape") {
        event.preventDefault();
        close(true);
        return;
      } else if (event.key === "Tab") {
        close();
        return;
      } else return;
      event.preventDefault();
      options[next]?.focus();
    });
    options.forEach((item) => item.addEventListener("click", () => {
      select.value = item.dataset.value || "";
      select.dispatchEvent(new Event("change", { bubbles: true }));
      close(true);
    }));
    field.addEventListener("cf:select-close", () => close());
    document.addEventListener("pointerdown", (event) => {
      if (!field.contains(event.target as Node)) close();
    });
    select.addEventListener("change", sync);
    select.form?.addEventListener("reset", () => requestAnimationFrame(sync));
    sync();
  }

  function initContactForm() {
    document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
      if (form.dataset.wired) return;
      form.dataset.wired = "true";
      form.querySelectorAll<HTMLSelectElement>("select").forEach(enhanceSelect);

      // Arriving from the scope picker with `?project=<id>`: the ids in
      // src/data/scopes.ts and the ids of these options are deliberately the
      // same words, so a visitor who already said what they need on /services
      // is not asked again on the next page. An unknown value simply leaves
      // the select on its default.
      const project = new URLSearchParams(location.search).get("project");
      const what = form.elements.namedItem("what") as HTMLSelectElement | null;
      const url = form.elements.namedItem("url") as HTMLInputElement | null;
      if (project && what && Array.from(what.options).some((option) => option.value === project)) {
        what.value = project;
        what.dispatchEvent(new Event("change", { bubbles: true }));
      }

      const syncAudit = () => {
        if (!url) return;
        const audit = what?.value === "audit";
        url.required = audit;
        url.closest(".cf-field")?.classList.toggle("is-required", audit);
        const intro = form.querySelector<HTMLElement>("[data-audit-intro]");
        if (intro) intro.hidden = !audit;
      };
      what?.addEventListener("change", syncAudit);
      syncAudit();

      // Tell the lattice how big the job is. It is the same `rb:scope` event the
      // picker sends, so the field behind the form behaves exactly as it does
      // behind the price table — the picture answers the question being asked.
      const announce = () => {
        const option = what?.selectedOptions?.[0];
        const ratio = Number(option?.dataset.field);
        if (Number.isFinite(ratio)) dispatchEvent(new CustomEvent("rb:scope", { detail: { ratio } }));
      };
      what?.addEventListener("change", announce);
      // After the preselect above, and late enough that the canvas is listening.
      requestAnimationFrame(announce);

      const status = form.querySelector<HTMLParagraphElement>(".cf-status")!;
      const button = form.querySelector<HTMLButtonElement>(".cf-send")!;
      const label = button.querySelector("span")!;
      const endpoint = form.dataset.endpoint || "";
      const mail = form.dataset.mail || "";
      let started = false;

      form.addEventListener("focusin", () => {
        if (started) return;
        started = true;
        dispatchEvent(new CustomEvent("rb:track", { detail: {
          name: "form_start",
          data: { kind: what?.value || "unknown", placement: location.pathname },
        } }));
      });

      const say = (key: string, ok: boolean) => {
        status.textContent = translate(key);
        status.classList.toggle("is-ok", ok);
        status.classList.toggle("is-bad", !ok);
      };

      // What the visitor picked, in words rather than in slugs — this is the
      // body of the mail Rodion actually reads, so it has to stand on its own.
      const compose = () => {
        const value = (name: string) => (form.elements.namedItem(name) as HTMLSelectElement | HTMLInputElement)?.value || "";
        const spell = (group: string, id: string) => translate(`form.${group}.${id}`) || id;
        const extra = value("message").trim();
        const site = value("url").trim();
        return [
          `${translate("form.what.label")} ${spell("what", value("what"))}`,
          site ? `${translate("form.url.label")} ${site}` : "",
          `${translate("form.when.label")} ${spell("when", value("when"))}`,
          `${translate("form.budget.label")}: ${spell("budget", value("budget"))}`,
          "",
          extra,
        ].join("\n").trim();
      };

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        // The honeypot is invisible and unlabelled, so only a bot fills it.
        // Answer those exactly like a success: nothing sent, nothing learned.
        if ((form.elements.namedItem("company") as HTMLInputElement)?.value) {
          say("form.success", true);
          return;
        }

        const email = (form.elements.namedItem("email") as HTMLInputElement).value.trim();
        const body = compose();
        const attribution = getAttribution();
        const kind = what?.value || "other";

        // Only reachable if the endpoint is deliberately blanked. Kept because
        // losing a written enquiry is worse than one extra tap.
        if (!endpoint) {
          const subject = encodeURIComponent(`${kind === "audit" ? "Website audit" : "Website enquiry"} — ${email}`);
          const source = `\n\nSource\nLanding: ${attribution.landing}\nReferrer: ${attribution.referrer}\nCampaign: ${attribution.campaign}`;
          location.href = `mailto:${mail}?subject=${subject}&body=${encodeURIComponent(body + source)}`;
          say("form.success", true);
          dispatchEvent(new CustomEvent("rb:track", { detail: { name: "form_success", data: { kind, source: attribution.campaign } } }));
          return;
        }

        button.disabled = true;
        const idle = label.textContent;
        label.textContent = translate("form.sending");
        status.textContent = "";

        try {
          // `Accept: application/json` is what stops Formspree replying with its
          // own hosted thank-you page; `_replyto` and `_subject` are the two
          // fields it treats specially, so hitting reply in the inbox answers
          // the person who wrote rather than Formspree.
          const response = await fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify({
              email,
              _replyto: email,
              _subject: `${kind === "audit" ? "Website audit" : "Website enquiry"} — ${email}`,
              message: body,
              landing_page: attribution.landing,
              referrer: attribution.referrer,
              campaign: attribution.campaign,
            }),
          });
          if (!response.ok) {
            // Formspree answers a rejected submission with a JSON body naming
            // the reason. Worth reading: a form that is paused or over quota
            // fails exactly like a network error otherwise, and the visitor is
            // told to try again forever.
            const detail = await response.json().catch(() => null);
            throw new Error(detail?.errors?.[0]?.message || String(response.status));
          }
          form.reset();
          syncAudit();
          say("form.success", true);
          dispatchEvent(new CustomEvent("rb:track", { detail: { name: "form_success", data: { kind, source: attribution.campaign } } }));
        } catch {
          say("form.error", false);
          dispatchEvent(new CustomEvent("rb:track", { detail: { name: "form_error", data: { kind, placement: location.pathname } } }));
        } finally {
          button.disabled = false;
          label.textContent = idle;
        }
      });
    });
  }

  initContactForm();
  document.addEventListener("astro:page-load", initContactForm);
</script>
