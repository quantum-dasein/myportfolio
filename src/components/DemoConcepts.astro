---
import type { Lang } from "../i18n/utils";

interface Props { lang: Lang }
const { lang } = Astro.props;
const de = lang === "de";

const concepts = [
  {
    id: "restaurant",
    image: "/images/concepts/restaurant.webp",
    href: de ? "/de/website-restaurant-wien/" : "/en/website-for-restaurants-vienna/",
    sector: de ? "RESTAURANT · 1070 WIEN" : "RESTAURANT · VIENNA 1070",
    name: "RB / TABLE",
    headline: de ? "Heute Abend noch ein Tisch." : "A table for tonight.",
    detail: de ? "Karte · Öffnungszeiten · Reservieren" : "Menu · Hours · Reserve",
    action: de ? "Tisch reservieren" : "Reserve a table",
  },
  {
    id: "practice",
    image: "/images/concepts/practice.webp",
    href: de ? "/de/website-arztpraxis-wien/" : "/en/website-for-doctors-vienna/",
    sector: de ? "ARZTPRAXIS · 1180 WIEN" : "MEDICAL PRACTICE · VIENNA 1180",
    name: "RB / PRAXIS",
    headline: de ? "Der nächste Termin, klar erklärt." : "The next appointment, clearly explained.",
    detail: de ? "Wahlarzt · DE / EN · Barrierefrei" : "Private practice · DE / EN · Accessible",
    action: de ? "Termin anfragen" : "Request appointment",
  },
  {
    id: "trade",
    image: "/images/concepts/trade.webp",
    href: de ? "/de/website-handwerker-wien/" : "/en/website-for-tradespeople-vienna/",
    sector: de ? "HANDWERK · WIEN & UMGEBUNG" : "TRADES · VIENNA & SURROUNDINGS",
    name: "RB / WERK",
    headline: de ? "Repariert, bevor es größer wird." : "Fixed before it becomes a bigger job.",
    detail: de ? "Leistungen · Einsatzgebiet · Rückruf" : "Services · Coverage · Callback",
    action: de ? "Rückruf anfragen" : "Request a callback",
  },
];
---

<section class="demo-concepts" aria-labelledby="demo-concepts-title" data-demo-concepts>
  <div class="u-container">
    <div class="demo-head">
      <span>{de ? "03 — KONZEPTSTUDIEN" : "03 — CONCEPT STUDIES"}</span>
      <div>
        <h2 id="demo-concepts-title">
          {de ? "So kann der kleine Auftrag aussehen." : "What the small job can look like."}
        </h2>
        <p>
          {de
            ? "Keine erfundenen Kunden und keine erfundenen Ergebnisse: drei bewusst als Konzept markierte Einstiege für typische Wiener Betriebe."
            : "No invented clients and no invented results: three clearly labelled concepts for typical Vienna businesses."}
        </p>
      </div>
    </div>

    <div class="demo-mobile-guide" aria-hidden="true">
      <span>{de ? "WISCHEN" : "SWIPE"}</span>
      <b data-demo-count>01 / 03</b>
    </div>

    <div class="demo-grid" data-demo-grid>
      {concepts.map((concept, index) => (
        <div class="demo-card-wrap" data-reveal>
          <a
            class={`demo-card demo-card--${concept.id}`}
            href={concept.href}
            data-track="demo_open"
            data-track-item={concept.id}
            data-track-place="services-hub"
            data-cursor="VIEW"
          >
            <img class="demo-image" src={concept.image} alt="" width="960" height="1200" loading="lazy" decoding="async" draggable="false" />
            <span class="demo-shade" aria-hidden="true"></span>
            <span class="demo-grain" aria-hidden="true"></span>

            <span class="demo-topline">
              <span class="demo-honesty">
                {de ? "KONZEPT · KEIN KUNDENPROJEKT" : "CONCEPT · NOT A CLIENT PROJECT"}
              </span>
              <small>{String(index + 1).padStart(2, "0")} / 03</small>
            </span>

            <span class="demo-interface">
              <span class="demo-chrome">
                <span class="demo-mark">{concept.name}</span>
                <span class="demo-url">{concept.id}.wien</span>
              </span>
              <span class="demo-copy">
                <span class="demo-sector">{concept.sector}</span>
                <b>{concept.headline}</b>
                <span class="demo-detail">{concept.detail}</span>
                <span class="demo-action">{concept.action}<i>↗</i></span>
              </span>
            </span>

            <span class="demo-link">
              <span>{de ? "Angebot für diese Branche" : "Offer for this trade"}</span>
              <i aria-hidden="true">↗</i>
            </span>
          </a>
        </div>
      ))}
    </div>

    <div class="demo-dots" aria-hidden="true">
      {concepts.map((_, index) => <i class:list={{ "is-active": index === 0 }} />)}
    </div>
  </div>
</section>

<style>
  .demo-concepts {
    position: relative;
    overflow: clip;
    padding: clamp(5rem, 10vw, 9rem) 0 clamp(6rem, 11vw, 10rem);
    border-top: 1px solid var(--color-line);
    background:
      radial-gradient(circle at 18% 55%, rgba(155, 32, 24, 0.05), transparent 28rem),
      radial-gradient(circle at 82% 42%, rgba(82, 157, 171, 0.045), transparent 30rem);
  }
  .demo-head {
    display: grid;
    grid-template-columns: 18rem minmax(0, 1fr);
    gap: 3rem;
    margin-bottom: clamp(2.5rem, 5vw, 4.75rem);
  }
  .demo-head > span {
    padding-top: 0.45rem;
    font: 0.64rem var(--font-inter);
    letter-spacing: 0.22em;
    color: var(--color-text-alt);
  }
  .demo-head h2 {
    max-width: 13ch;
    margin: 0;
    font: 500 clamp(2.4rem, 4.8vw, 4.5rem)/0.96 var(--font-display);
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .demo-head p {
    max-width: 58ch;
    margin: 1.45rem 0 0;
    color: rgba(var(--rgb-text), 0.66);
    line-height: 1.65;
  }
  .demo-mobile-guide,
  .demo-dots { display: none; }

  .demo-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.8rem, 1.3vw, 1.25rem);
    align-items: start;
  }
  .demo-card-wrap { min-width: 0; }
  .demo-card-wrap:nth-child(2) { margin-top: 2.25rem; }
  .demo-card-wrap:nth-child(3) { margin-top: 0.75rem; }

  .demo-card {
    --accent: 203, 74, 45;
    --mx: 78%;
    --my: 22%;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    min-height: clamp(32rem, 48vw, 39rem);
    padding: 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 16px;
    background: #050607;
    color: var(--color-text);
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.3);
    transform: perspective(1100px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
    transition: transform 0.45s var(--ease-out-expo), border-color 0.45s ease, box-shadow 0.5s ease;
  }
  .demo-card::before {
    content: "";
    position: absolute;
    z-index: 3;
    inset: -1px;
    border-radius: inherit;
    background: radial-gradient(23rem circle at var(--mx) var(--my), rgba(var(--accent), 0.24), transparent 55%);
    opacity: 0.38;
    pointer-events: none;
    transition: opacity 0.45s ease;
  }
  .demo-card::after {
    content: "";
    position: absolute;
    z-index: 4;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.12);
    pointer-events: none;
  }
  .demo-card--practice { --accent: 82, 186, 205; }
  .demo-card--trade { --accent: 233, 181, 53; }

  .demo-image,
  .demo-shade,
  .demo-grain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    pointer-events: none;
  }
  .demo-image {
    z-index: -3;
    object-fit: cover;
    filter: saturate(0.72) brightness(0.72) contrast(1.08);
    transform: scale(1.035) translate3d(var(--ix, 0), var(--iy, 0), 0);
    transition: transform 1.1s var(--ease-out-expo), filter 0.7s ease;
  }
  .demo-shade {
    z-index: -2;
    background:
      linear-gradient(180deg, rgba(2, 3, 4, 0.16), transparent 30%, rgba(2, 3, 4, 0.18) 48%, rgba(2, 3, 4, 0.94) 88%),
      linear-gradient(90deg, rgba(2, 3, 4, 0.46), transparent 74%);
  }
  .demo-grain {
    z-index: -1;
    opacity: 0.12;
    background-image: repeating-radial-gradient(circle at 30% 20%, rgba(255,255,255,.32) 0 .45px, transparent .55px 3px);
    background-size: 5px 5px;
    mix-blend-mode: soft-light;
  }

  .demo-topline {
    position: absolute;
    z-index: 5;
    top: 1.1rem;
    left: 1.1rem;
    right: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .demo-honesty {
    padding: 0.45rem 0.62rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    background: rgba(3, 4, 5, 0.48);
    backdrop-filter: blur(12px);
    font: 0.75rem var(--font-inter);
    letter-spacing: 0.08em;
    color: rgba(var(--rgb-text), 0.7);
  }
  .demo-topline small {
    flex: 0 0 auto;
    font: 0.75rem var(--font-inter);
    letter-spacing: 0.12em;
    color: rgba(var(--rgb-text), 0.56);
  }

  .demo-interface {
    position: relative;
    z-index: 2;
    display: flex;
    flex: 1;
    flex-direction: column;
    margin: 3.1rem 0 3.7rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 11px;
    background: linear-gradient(180deg, rgba(5, 7, 9, 0.05), rgba(5, 7, 9, 0.5));
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.06);
  }
  .demo-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.7rem;
    padding: 0 0.95rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    font: 0.75rem var(--font-inter);
    letter-spacing: 0.08em;
  }
  .demo-mark { color: rgba(var(--rgb-text), 0.84); }
  .demo-url { color: rgba(var(--rgb-text), 0.42); }
  .demo-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding: clamp(1.15rem, 2vw, 1.65rem);
  }
  .demo-sector {
    font: 0.75rem var(--font-inter);
    letter-spacing: 0.12em;
    color: rgba(var(--rgb-text), 0.68);
  }
  .demo-copy b {
    display: block;
    max-width: 9.5ch;
    margin: 0.8rem 0 1rem;
    font: 500 clamp(1.8rem, 3vw, 2.75rem)/0.94 var(--font-display);
    letter-spacing: -0.05em;
    text-shadow: 0 0.2rem 1.3rem rgba(0, 0, 0, 0.65);
  }
  .demo-detail {
    font-size: 0.78rem;
    line-height: 1.45;
    color: rgba(var(--rgb-text), 0.65);
  }
  .demo-action {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 1.35rem;
    padding: 0.68rem 0.82rem;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    background: rgba(3, 4, 5, 0.38);
    font: 0.75rem var(--font-inter);
    letter-spacing: 0.08em;
    backdrop-filter: blur(10px);
  }
  .demo-action i { font-style: normal; color: rgb(var(--accent)); }

  .demo-link {
    position: absolute;
    z-index: 5;
    left: 1.1rem;
    right: 1.1rem;
    bottom: 1.15rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(255, 255, 255, 0.17);
    font: 0.75rem var(--font-inter);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(var(--rgb-text), 0.7);
  }
  .demo-link i {
    font-style: normal;
    font-size: 0.9rem;
    color: rgb(var(--accent));
    transition: transform 0.45s var(--ease-out-expo);
  }

  @media (hover: hover) and (pointer: fine) {
    .demo-card:hover,
    .demo-card:focus-visible {
      border-color: rgba(var(--accent), 0.62);
      box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.5), 0 0 2.6rem rgba(var(--accent), 0.12);
    }
    .demo-card:hover::before,
    .demo-card:focus-visible::before { opacity: 0.95; }
    .demo-card:hover .demo-image,
    .demo-card:focus-visible .demo-image {
      filter: saturate(0.94) brightness(0.79) contrast(1.04);
      transform: scale(1.075) translate3d(var(--ix, 0), var(--iy, 0), 0);
    }
    .demo-card:hover .demo-link i,
    .demo-card:focus-visible .demo-link i { transform: translate(0.18rem, -0.18rem); }
  }

  @media (max-width: 900px) {
    .demo-head { grid-template-columns: 1fr; gap: 1rem; }
    .demo-card-wrap:nth-child(2),
    .demo-card-wrap:nth-child(3) { margin-top: 0; }
    .demo-grid {
      display: flex;
      gap: 0.85rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--container-offset);
      margin-inline: calc(var(--container-offset) * -1);
      padding: 0.35rem var(--container-offset) 1.4rem;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .demo-grid::-webkit-scrollbar { display: none; }
    .demo-card-wrap {
      flex: 0 0 min(82vw, 22rem);
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }
    .demo-card { min-height: min(36rem, 71svh); }
    .demo-mobile-guide {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin: -0.6rem 0 1rem;
      font: 0.75rem var(--font-inter);
      letter-spacing: 0.16em;
      color: rgba(var(--rgb-text), 0.48);
    }
    .demo-mobile-guide > span::after { content: "  →"; color: rgba(var(--rgb-text), 0.82); }
    .demo-mobile-guide b { font-weight: 400; }
    .demo-dots { display: flex; gap: 0.35rem; width: 100%; margin-top: 0.2rem; }
    .demo-dots i {
      flex: 1;
      height: 1px;
      background: rgba(255, 255, 255, 0.14);
      transition: background-color 0.35s ease, box-shadow 0.35s ease;
    }
    .demo-dots i.is-active {
      background: rgba(255, 255, 255, 0.72);
      box-shadow: 0 0 0.75rem rgba(255, 255, 255, 0.25);
    }
    .demo-card.is-current {
      border-color: rgba(var(--accent), 0.5);
      box-shadow: 0 1.8rem 4rem rgba(0, 0, 0, 0.45), 0 0 2rem rgba(var(--accent), 0.1);
    }
    .demo-card.is-current::before { opacity: 0.8; }
    .demo-card.is-current .demo-image { filter: saturate(0.9) brightness(0.78) contrast(1.04); }
  }

  @media (max-width: 520px) {
    .demo-concepts { padding-top: 4.75rem; }
    .demo-head h2 { font-size: clamp(2.45rem, 12vw, 3.45rem); }
    .demo-head p { font-size: 1rem; }
    .demo-card-wrap { flex-basis: 84vw; }
    .demo-card { min-height: min(34rem, 69svh); }
    .demo-honesty { max-width: 73%; line-height: 1.35; }
    .demo-copy b { font-size: clamp(2rem, 9.8vw, 2.7rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-card,
    .demo-image,
    .demo-link i { transition: none; transform: none; }
    .demo-grid { scroll-behavior: auto; }
  }
</style>

<script>
  function initDemoConcepts() {
    document.querySelectorAll<HTMLElement>("[data-demo-concepts]").forEach((section) => {
      if (section.dataset.wired === "true") return;
      section.dataset.wired = "true";

      const cards = Array.from(section.querySelectorAll<HTMLElement>(".demo-card"));
      const grid = section.querySelector<HTMLElement>("[data-demo-grid]");
      const count = section.querySelector<HTMLElement>("[data-demo-count]");
      const dots = Array.from(section.querySelectorAll<HTMLElement>(".demo-dots i"));
      const finePointer = matchMedia("(hover: hover) and (pointer: fine)");
      const reduced = matchMedia("(prefers-reduced-motion: reduce)");

      cards.forEach((card) => {
        card.addEventListener("pointermove", (event) => {
          if (!finePointer.matches || reduced.matches) return;
          const rect = card.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width;
          const y = (event.clientY - rect.top) / rect.height;
          card.style.setProperty("--mx", `${x * 100}%`);
          card.style.setProperty("--my", `${y * 100}%`);
          card.style.setProperty("--rx", `${(0.5 - y) * 2.2}deg`);
          card.style.setProperty("--ry", `${(x - 0.5) * 2.4}deg`);
          card.style.setProperty("--ix", `${(0.5 - x) * 4}px`);
          card.style.setProperty("--iy", `${(0.5 - y) * 4}px`);
        });
        card.addEventListener("pointerleave", () => {
          card.style.removeProperty("--rx");
          card.style.removeProperty("--ry");
          card.style.removeProperty("--ix");
          card.style.removeProperty("--iy");
        });
      });

      if (!grid) return;
      const updateMobileState = () => {
        if (innerWidth > 900) return;
        const center = grid.getBoundingClientRect().left + grid.clientWidth / 2;
        let active = 0;
        let distance = Infinity;
        cards.forEach((card, index) => {
          const rect = card.getBoundingClientRect();
          const nextDistance = Math.abs(rect.left + rect.width / 2 - center);
          if (nextDistance < distance) { distance = nextDistance; active = index; }
        });
        cards.forEach((card, index) => card.classList.toggle("is-current", index === active));
        dots.forEach((dot, index) => dot.classList.toggle("is-active", index === active));
        if (count) count.textContent = `${String(active + 1).padStart(2, "0")} / ${String(cards.length).padStart(2, "0")}`;
      };
      let frame = 0;
      grid.addEventListener("scroll", () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(updateMobileState);
      }, { passive: true });
      addEventListener("resize", updateMobileState, { passive: true });
      updateMobileState();
    });
  }

  initDemoConcepts();
  document.addEventListener("astro:page-load", initDemoConcepts);
</script>
