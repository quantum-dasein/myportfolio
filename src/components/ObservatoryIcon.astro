---
interface Props { name: 'open' | 'close' | 'next' | 'previous' | 'grid'; }
const { name } = Astro.props;
const paths = { open: 'M6 18 18 6M6 6h12v12', close: 'm6 6 12 12M6 18 18 6', next: 'M4 12h16m-6-6 6 6-6 6', previous: 'M20 12H4m6-6-6 6 6 6', grid: 'M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z' };
---
<svg class="obs-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={paths[name]} /></svg>
