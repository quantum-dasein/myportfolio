---
// ─────────────────────────────────────────────────────────────────────────────
//  ProcessFlow — "what happens after you write", as one scene rather than three
//  cards.
//
//  The first attempt took the art direction literally and laid it out as three
//  equal columns with a paragraph under each. That read as a concept mockup:
//  symmetrical, static, and heaviest exactly where it should have been lightest.
//  This is a single horizontal journey instead.
//
//  Composition — a soft sine, not a row:
//    WRITE   left, low, smallest       the message goes out
//    SCOPE   centre, raised, LARGEST   the visual centre of the section
//    LAUNCH  right, low                the finished thing, and a node beyond it
//
//  One line runs through all three and is the section's main motif. It is a real
//  SVG path whose viewBox is rebuilt from the stage's pixel box, so it lands on
//  the objects exactly at any width, and the particle swarm samples that same
//  path with getPointAtLength — the stroke and the swarm cannot disagree.
//
//  The whole thing is one scrubbed ScrollTrigger timeline: the message types
//  itself, the send button acknowledges once, the line draws through, the sheet
//  assembles and confirms row by row, the window builds out of its own blocks,
//  the end node arrives. Scrolling back runs it backwards.
//
//  Deliberately NOT done: no pin (it would cost ~150vh of page for an animation
//  that reads fine as it passes), no Three.js (nothing here has depth that earns
//  a WebGL context), and no text hidden from view for search — the longer
//  explanation stays visible as one quiet line under the scene rather than three
//  heavy columns inside it.
// ─────────────────────────────────────────────────────────────────────────────
interface Step { n: string; label: string; line: string }
interface Props { steps: Step[]; typed: string; rows: string[]; note: string; live: string; liveTag: string }
const { steps, typed, rows, note, live, liveTag } = Astro.props;
---

<div class="pv" data-process-flow>
  <div class="pv-stage" data-pv-stage>
    <!-- Ripples sit behind everything and overlap between the stages, so the
         three objects read as points in one field, not three framed cards. -->
    <span class="pv-ripple pv-ripple--a" aria-hidden="true"></span>
    <span class="pv-ripple pv-ripple--b" aria-hidden="true"></span>
    <span class="pv-ripple pv-ripple--c" aria-hidden="true"></span>

    <svg class="pv-path" data-pv-svg aria-hidden="true" preserveAspectRatio="none">
      <path data-pv-line fill="none" />
    </svg>
    <canvas class="pv-dust" data-pv-dust aria-hidden="true"></canvas>

    <!-- 01 · WRITE -->
    <div class="pv-node pv-node--write">
      <span class="pv-n" aria-hidden="true">{steps[0].n}</span>
      <span class="pv-label">{steps[0].label}</span>
      <div class="pv-obj pv-pill" data-pv-tilt data-pv-write>
        <span class="pv-pill-text" data-pv-type data-text={typed}></span>
        <span class="pv-send" data-pv-send>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 2 11 13" /><path d="M22 2l-7 20-4-9-9-4 20-7z" />
          </svg>
        </span>
      </div>
      <p class="pv-line">{steps[0].line}</p>
    </div>

    <!-- 02 · SCOPE — the visual centre -->
    <div class="pv-node pv-node--scope">
      <span class="pv-n" aria-hidden="true">{steps[1].n}</span>
      <span class="pv-label">{steps[1].label}</span>
      <div class="pv-obj pv-sheet" data-pv-tilt data-pv-sheet>
        {rows.map((row, r) => (
          <div class="pv-row" data-pv-row={r}>
            <span class="pv-row-label">{row}</span>
            <span class="pv-row-rule"><i></i></span>
            <span class="pv-row-tick">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m5 12.5 4.5 4.5L19 7" />
              </svg>
            </span>
          </div>
        ))}
      </div>
      <p class="pv-line">{steps[1].line}</p>
    </div>

    <!-- 03 · LAUNCH -->
    <div class="pv-node pv-node--launch">
      <span class="pv-n" aria-hidden="true">{steps[2].n}</span>
      <span class="pv-label">{steps[2].label}</span>
      <div class="pv-obj pv-win" data-pv-tilt data-pv-win>
        <span class="pv-win-bar">
          <i></i><i></i><i></i>
          <b>{liveTag}</b>
        </span>
        <span class="pv-win-body">
          <span class="pv-block pv-block--head" data-pv-block></span>
          <span class="pv-block pv-block--sub" data-pv-block></span>
          <span class="pv-block pv-block--wide" data-pv-block></span>
          <span class="pv-tiles">
            <i data-pv-block></i><i data-pv-block></i><i data-pv-block></i>
          </span>
        </span>
      </div>
      <p class="pv-line">{steps[2].line}</p>
    </div>

    <span class="pv-terminus" data-pv-terminus aria-hidden="true"></span>
    <p class="pv-live" data-pv-live>{live}</p>
  </div>

  <p class="pv-note">{note}</p>
</div>

<style>
  .pv { margin-top: clamp(2.6rem, 5vw, 4rem); }

  /* One scene. The objects sit on a soft sine across it, not in a row. */
  .pv-stage {
    position: relative;
    height: clamp(23rem, 27vw, 28rem);
    isolation: isolate;
    /* The ripples are sized to bleed; clipping the horizontal axis only is what
       stops the rightmost one becoming the page's horizontal overflow, while
       leaving the numerals — which sit ABOVE their objects — visible. `clip`
       rather than `hidden` so no scroll container is created. */
    overflow-x: clip;
  }

  /* ── Atmosphere ──────────────────────────────────────────────────────────── */
  .pv-ripple {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(circle, transparent 0 30%, rgba(var(--rgb-text), 0.042) 30.3% 30.7%, transparent 31%),
      radial-gradient(circle, transparent 0 38%, rgba(var(--rgb-text), 0.032) 38.3% 38.7%, transparent 39%),
      radial-gradient(circle, transparent 0 45%, rgba(var(--rgb-text), 0.024) 45.3% 45.7%, transparent 46%),
      radial-gradient(circle, transparent 0 50%, rgba(var(--rgb-text), 0.016) 50.3% 50.7%, transparent 51%);
    will-change: transform;
  }
  .pv-ripple--a { left: -14%; top: 4%;   width: 52%; aspect-ratio: 1; }
  .pv-ripple--b { left: 26%;  top: -34%; width: 62%; aspect-ratio: 1; }
  .pv-ripple--c { left: 56%;  top: 6%;   width: 44%; aspect-ratio: 1; }

  .pv-path,
  .pv-dust {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .pv-path { z-index: 1; overflow: visible; }
  .pv-path path {
    stroke: rgba(var(--rgb-text), 0.32);
    stroke-width: 1;
    filter: drop-shadow(0 0 3px rgba(255, 255, 255, 0.25));
  }
  .pv-dust { z-index: 2; }

  /* ── Nodes ───────────────────────────────────────────────────────────────── */
  .pv-node { position: absolute; z-index: 3; }
  .pv-node--write  { left: 0;     top: 47%; width: 25%; }
  .pv-node--scope  { left: 32%;   top: 4%;  width: 33%; }
  .pv-node--launch { left: 68%;   top: 34%; width: 26%; }

  /* Atmospheric anchors — present, never competing with the section headline. */
  .pv-n {
    position: absolute;
    left: -0.06em;
    bottom: calc(100% + 0.55rem);
    font: 400 clamp(3rem, 6vw, 5.4rem)/0.8 var(--font-display);
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(var(--rgb-text), 0.1);
    font-variant-numeric: tabular-nums;
    pointer-events: none;
    z-index: -1;
  }
  .pv-label {
    display: block;
    margin-bottom: 0.8rem;
    font-family: var(--font-inter);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(var(--rgb-text), 0.42);
  }
  .pv-line {
    margin: 1rem 0 0 !important;
    max-width: 26ch;
    font-size: 0.82rem !important;
    line-height: 1.5;
    color: rgba(var(--rgb-text), 0.52) !important;
  }

  /* Smoked optical glass — dark and dense, not frosted white. */
  .pv-obj {
    position: relative;
    background:
      linear-gradient(158deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.012) 55%),
      linear-gradient(158deg, #0a0d11, #05070a);
    border: 1px solid rgba(255, 255, 255, 0.095);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 30px 70px -34px rgba(0, 0, 0, 0.95);
    will-change: transform;
  }

  /* 01 — the message */
  .pv-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.5rem 0.5rem 1rem;
    border-radius: 999px;
  }
  .pv-pill-text {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-inter);
    font-size: clamp(0.58rem, 0.8vw, 0.7rem);
    color: rgba(var(--rgb-text), 0.62);
    white-space: nowrap;
    overflow: hidden;
  }
  .pv-pill-text::after {
    content: "";
    display: inline-block;
    width: 1px;
    height: 1em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: rgba(var(--rgb-text), 0.75);
    animation: pv-caret 1.1s steps(1) infinite;
  }
  @keyframes pv-caret { 0%, 50% { opacity: 1 } 50.01%, 100% { opacity: 0 } }
  .pv-send {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 1.95rem;
    height: 1.95rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.05);
    color: rgba(var(--rgb-text), 0.9);
    will-change: transform;
  }
  .pv-send svg { width: 0.85rem; height: 0.85rem; }

  /* 02 — the sheet, the largest object in the scene */
  .pv-sheet { padding: 0.35rem 1.15rem; border-radius: 1.2rem; }
  .pv-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.95rem 0;
  }
  .pv-row + .pv-row { border-top: 1px solid rgba(255, 255, 255, 0.05); }
  .pv-row-label {
    font-family: var(--font-inter);
    font-size: clamp(0.66rem, 0.9vw, 0.78rem);
    letter-spacing: 0.02em;
    color: rgba(var(--rgb-text), 0.88);
    white-space: nowrap;
  }
  .pv-row-rule {
    display: block;
    height: 1px;
    background: rgba(var(--rgb-text), 0.075);
    overflow: hidden;
  }
  .pv-row-rule i {
    display: block;
    height: 100%;
    width: 100%;
    background: rgba(var(--rgb-text), 0.32);
    transform: scaleX(0);
    transform-origin: left center;
  }
  .pv-row-tick {
    display: grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(var(--rgb-text), 0.92);
  }
  .pv-row-tick svg { width: 0.72rem; height: 0.72rem; stroke-dasharray: 26; stroke-dashoffset: 26; }

  /* 03 — the finished thing */
  .pv-win { border-radius: 0.85rem; overflow: hidden; }
  .pv-win-bar {
    display: flex;
    align-items: center;
    gap: 0.26rem;
    padding: 0.48rem 0.65rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .pv-win-bar i {
    width: 0.3rem; height: 0.3rem; border-radius: 50%;
    background: rgba(var(--rgb-text), 0.28);
  }
  .pv-win-bar b {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    font-family: var(--font-inter);
    font-size: 0.48rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: rgba(var(--rgb-text), 0.55);
  }
  .pv-win-bar b::before {
    content: "";
    width: 0.28rem; height: 0.28rem; border-radius: 50%;
    background: rgba(255, 255, 255, 0.85);
    box-shadow: 0 0 6px rgba(255, 255, 255, 0.65);
  }
  .pv-win-body { display: block; padding: 0.85rem 0.8rem 0.9rem; }
  .pv-block {
    display: block;
    height: 4px;
    border-radius: 4px;
    background: rgba(var(--rgb-text), 0.19);
    transform-origin: left center;
  }
  .pv-block--head { width: 58%; height: 7px; }
  .pv-block--sub  { width: 38%; margin-top: 0.45rem; }
  .pv-block--wide { width: 72%; margin-top: 0.4rem; }
  .pv-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.3rem; margin-top: 0.9rem; }
  .pv-tiles i {
    display: block;
    height: 1.9rem;
    border-radius: 0.3rem;
    background: rgba(255, 255, 255, 0.032);
    border: 1px solid rgba(255, 255, 255, 0.045);
    transform-origin: left center;
  }

  /* Where the flow ends. */
  .pv-terminus {
    position: absolute;
    right: 1.5%;
    top: 52%;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 5px rgba(255, 255, 255, 0.06), 0 0 18px rgba(255, 255, 255, 0.5);
    z-index: 3;
    will-change: transform, opacity;
  }
  .pv-live {
    position: absolute;
    right: 0;
    bottom: 1%;
    max-width: 14rem;
    margin: 0 !important;
    font-family: var(--font-inter);
    font-size: 0.58rem !important;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-align: right;
    color: rgba(var(--rgb-text), 0.5) !important;
    z-index: 3;
  }

  /* One quiet line for the whole scene, instead of three heavy columns in it. */
  .pv-note {
    max-width: 62ch;
    margin: clamp(2.2rem, 4vw, 3.2rem) 0 0 !important;
    font-size: 0.9rem !important;
    line-height: 1.65;
    color: rgba(var(--rgb-text), 0.5) !important;
  }

  /* ── Narrow: the scene becomes a column, and stops being expensive ───────── */
  @media (max-width: 940px) {
    .pv-stage { height: auto; display: grid; gap: 3.6rem; }
    .pv-path, .pv-dust { display: none; }
    .pv-node { position: relative; left: auto; top: auto; width: 100%; max-width: 23rem; }
    .pv-n { font-size: clamp(2.6rem, 13vw, 4rem); }
    .pv-line { max-width: 34ch; }
    .pv-ripple--a { left: -34%; top: 1%;  width: 92%; }
    .pv-ripple--b { left: 20%;  top: 32%; width: 98%; }
    .pv-ripple--c { left: -12%; top: 66%; width: 94%; }
    .pv-terminus { position: relative; right: auto; top: auto; margin-left: 0.2rem; }
    .pv-live { position: relative; right: auto; top: auto; text-align: left; margin-top: 0.9rem !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pv-pill-text::after { animation: none; }
  }
</style>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";

  const root = document.querySelector<HTMLElement>("[data-process-flow]");

  if (root) {
    gsap.registerPlugin(ScrollTrigger);

    const stage = root.querySelector<HTMLElement>("[data-pv-stage]")!;
    const svg = root.querySelector<SVGSVGElement>("[data-pv-svg]")!;
    const line = root.querySelector<SVGPathElement>("[data-pv-line]")!;
    const dust = root.querySelector<HTMLCanvasElement>("[data-pv-dust]")!;
    const typeEl = root.querySelector<HTMLElement>("[data-pv-type]")!;
    const write = root.querySelector<HTMLElement>("[data-pv-write]")!;
    const send = root.querySelector<HTMLElement>("[data-pv-send]")!;
    const sheet = root.querySelector<HTMLElement>("[data-pv-sheet]")!;
    const win = root.querySelector<HTMLElement>("[data-pv-win]")!;
    const rows = Array.from(root.querySelectorAll<HTMLElement>("[data-pv-row]"));
    const blocks = Array.from(root.querySelectorAll<HTMLElement>("[data-pv-block]"));
    const terminus = root.querySelector<HTMLElement>("[data-pv-terminus]")!;
    const liveText = root.querySelector<HTMLElement>("[data-pv-live]")!;
    const ripples = Array.from(root.querySelectorAll<HTMLElement>(".pv-ripple"));
    const tilts = Array.from(root.querySelectorAll<HTMLElement>("[data-pv-tilt]"));
    const rules = rows.map((r) => r.querySelector<HTMLElement>(".pv-row-rule i")!);
    const ticks = rows.map((r) => r.querySelector<SVGElement>(".pv-row-tick svg")!);
    const rings = rows.map((r) => r.querySelector<HTMLElement>(".pv-row-tick")!);

    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const narrow = matchMedia("(max-width: 940px)").matches;
    const nav = navigator as Navigator & {
      connection?: { saveData?: boolean; effectiveType?: string };
      deviceMemory?: number;
    };
    const frugal =
      nav.connection?.saveData === true ||
      /(^|-)2g$/.test(nav.connection?.effectiveType || "") ||
      (nav.deviceMemory !== undefined && nav.deviceMemory <= 2);
    const still = reduced || frugal;

    const full = typeEl.dataset.text || "";
    let progress = 0;

    // ── The path ─────────────────────────────────────────────────────────────
    // Measured from the objects themselves rather than hardcoded fractions:
    // out of the send button, into the sheet's left edge, out of its right,
    // into the window, on to the end node. Fractions drifted the moment the
    // composition moved; this cannot.
    const buildPath = () => {
      const w = stage.clientWidth, h = stage.clientHeight;
      if (!w || !h) return 0;
      svg.setAttribute("viewBox", `0 0 ${w} ${h}`);
      const box = (el: Element) => {
        const s0 = stage.getBoundingClientRect(), b0 = el.getBoundingClientRect();
        return { l: b0.left - s0.left, r: b0.right - s0.left, t: b0.top - s0.top, b: b0.bottom - s0.top,
                 cx: b0.left - s0.left + b0.width / 2, cy: b0.top - s0.top + b0.height / 2 };
      };
      const S = box(send), H = box(sheet), W = box(win), T = box(terminus);
      const p: [number, number][] = [
        [S.r + 4, S.cy],
        [(S.r + H.l) / 2, (S.cy + H.cy) / 2 - h * 0.05],
        [H.l - 6, H.cy],
        [H.r + 6, H.cy + h * 0.04],
        [(H.r + W.l) / 2, (H.cy + W.cy) / 2 + h * 0.05],
        [W.l - 6, W.cy],
        [T.cx, T.cy],
      ];
      // Catmull-Rom expressed as cubics, so the line bends instead of kinking.
      let d = `M ${p[0][0]} ${p[0][1]}`;
      for (let i = 0; i < p.length - 1; i++) {
        const p0 = p[i - 1] || p[i], p1 = p[i], p2 = p[i + 1], p3 = p[i + 2] || p[i + 1];
        d += ` C ${p1[0] + (p2[0] - p0[0]) / 6} ${p1[1] + (p2[1] - p0[1]) / 6},` +
             ` ${p2[0] - (p3[0] - p1[0]) / 6} ${p2[1] - (p3[1] - p1[1]) / 6},` +
             ` ${p2[0]} ${p2[1]}`;
      }
      line.setAttribute("d", d);
      const len = line.getTotalLength();
      line.style.strokeDasharray = String(len);
      line.style.strokeDashoffset = String(len * (1 - Math.min(1, progress / 0.88)));
      return len;
    };

    // ── Dust and the swarm ───────────────────────────────────────────────────
    let dw = 0, dh = 0, raf = 0, onScreen = false;
    const SWARM = narrow || still ? 0 : 30;
    const MOTES = narrow || still ? 0 : 46;
    const swarm = Array.from({ length: SWARM }, (_, i) => ({
      t: i / Math.max(1, SWARM),
      speed: 0.0016 + Math.random() * 0.0026,
      off: (Math.random() - 0.5) * 20,
      size: 0.5 + Math.random() * 1.3,
      lead: Math.random() < 0.22,
    }));
    const motes = Array.from({ length: MOTES }, () => ({
      x: Math.random(), y: Math.random(),
      r: 0.4 + Math.random() * 1.1,
      a: 0.1 + Math.random() * 0.3,
      vx: (Math.random() - 0.5) * 0.00018,
      vy: (Math.random() - 0.5) * 0.00014,
    }));

    const dctx = dust.getContext("2d", { alpha: true });
    const sizeDust = () => {
      if (!dctx) return;
      const w = stage.clientWidth, h = stage.clientHeight;
      if (!w || !h) return;
      const dpr = Math.min(devicePixelRatio || 1, 2);
      dw = w; dh = h;
      dust.width = Math.round(w * dpr);
      dust.height = Math.round(h * dpr);
      dctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    let px = 0, py = 0, tx = 0, ty = 0;

    const paint = () => {
      if (!dctx || !dw) return;
      dctx.clearRect(0, 0, dw, dh);

      for (const m of motes) {
        m.x += m.vx; m.y += m.vy;
        if (m.x < 0) m.x = 1; if (m.x > 1) m.x = 0;
        if (m.y < 0) m.y = 1; if (m.y > 1) m.y = 0;
        dctx.beginPath();
        dctx.arc(m.x * dw + px * 10, m.y * dh + py * 6, m.r, 0, Math.PI * 2);
        dctx.fillStyle = `rgba(233, 240, 243, ${m.a})`;
        dctx.fill();
      }

      if (!swarm.length) return;
      const len = line.getTotalLength();
      if (!len) return;
      // The swarm only occupies the part of the line that has been drawn, so
      // the energy arrives WITH the stroke instead of running ahead of it.
      const reach = Math.max(0.02, Math.min(1, progress / 0.88));
      for (const p of swarm) {
        p.t += p.speed;
        if (p.t > 1) p.t -= 1;
        const t = p.t * reach;
        const a = line.getPointAtLength(t * len);
        const b = line.getPointAtLength(Math.max(0, t - 0.012) * len);
        const dx = a.x - b.x, dy = a.y - b.y;
        const l = Math.hypot(dx, dy) || 1;
        const spread = Math.sin(p.t * Math.PI) * p.off;
        const ox = (-dy / l) * spread + px * 12;
        const oy = (dx / l) * spread + py * 7;

        if (p.lead) {
          const c = line.getPointAtLength(Math.max(0, t - 0.045) * len);
          const g = dctx.createLinearGradient(c.x + ox, c.y + oy, a.x + ox, a.y + oy);
          g.addColorStop(0, "rgba(255,255,255,0)");
          g.addColorStop(1, "rgba(255,255,255,0.6)");
          dctx.beginPath();
          dctx.moveTo(c.x + ox, c.y + oy);
          dctx.lineTo(a.x + ox, a.y + oy);
          dctx.strokeStyle = g;
          dctx.lineWidth = 1.2;
          dctx.stroke();
        }
        dctx.beginPath();
        dctx.arc(a.x + ox, a.y + oy, p.size, 0, Math.PI * 2);
        dctx.fillStyle = `rgba(255,255,255,${p.lead ? 0.9 : 0.42})`;
        dctx.fill();
      }
    };

    const loop = () => {
      if (!onScreen) { raf = 0; return; }
      px += (tx - px) * 0.045;
      py += (ty - py) * 0.045;
      // ≤3° of tilt, and the ripples drift a little behind the pointer.
      const t = `perspective(1400px) rotateY(${(px * 2.6).toFixed(2)}deg) rotateX(${(-py * 1.8).toFixed(2)}deg)`;
      for (const el of tilts) el.style.transform = t;
      ripples.forEach((el, i) => {
        el.style.transform = `translate3d(${(px * (10 + i * 6)).toFixed(1)}px, ${(py * (6 + i * 4)).toFixed(1)}px, 0)`;
      });
      paint();
      raf = requestAnimationFrame(loop);
    };
    const play = () => { if (!raf && onScreen && !still && !narrow) raf = requestAnimationFrame(loop); };
    const halt = () => { cancelAnimationFrame(raf); raf = 0; };

    // ── Rest state, then the scrubbed sequence ───────────────────────────────
    const setFinal = () => {
      gsap.set([write, sheet, win], { opacity: 1, y: 0, scale: 1 });
      gsap.set(rules, { scaleX: 1 });
      gsap.set(ticks, { strokeDashoffset: 0 });
      gsap.set(rings, { borderColor: "rgba(255,255,255,0.45)" });
      gsap.set(blocks, { scaleX: 1, opacity: 1 });
      gsap.set(terminus, { opacity: 1, scale: 1 });
      gsap.set(liveText, { opacity: 1, y: 0 });
      typeEl.textContent = full;
      progress = 1;
      line.style.strokeDashoffset = "0";
    };

    buildPath();
    sizeDust();

    if (still) {
      setFinal();
      paint();
    } else {
      gsap.set([write, win], { opacity: 0, y: 20 });
      gsap.set(sheet, { opacity: 0, y: 26, scale: 0.965 });
      gsap.set(rules, { scaleX: 0 });
      gsap.set(ticks, { strokeDashoffset: 26 });
      gsap.set(blocks, { scaleX: 0, opacity: 0 });
      gsap.set(terminus, { opacity: 0, scale: 0.4 });
      gsap.set(liveText, { opacity: 0, y: 6 });
      typeEl.textContent = "";

      const typer = { v: 0 };
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: stage,
          start: "top 82%",
          end: "bottom 58%",
          scrub: 0.7,
          onUpdate: (self) => { progress = self.progress; },
        },
        defaults: { ease: "none" },
      });

      tl
        // 01 — the message writes itself
        .to(write, { opacity: 1, y: 0, duration: 0.08, ease: "power2.out" }, 0)
        .to(typer, {
          v: 1, duration: 0.16,
          onUpdate: () => { typeEl.textContent = full.slice(0, Math.round(typer.v * full.length)); },
        }, 0.06)
        // the send button acknowledges, once
        .to(send, { scale: 1.15, duration: 0.03, ease: "power2.out" }, 0.24)
        .to(send, { scale: 1, duration: 0.06, ease: "power2.inOut" }, 0.27)
        // the line carries it through the whole scene
        .to(line, { strokeDashoffset: 0, duration: 0.62 }, 0.26)
        // 02 — the sheet assembles
        .to(sheet, { opacity: 1, y: 0, scale: 1, duration: 0.1, ease: "power2.out" }, 0.4);

      // ...and confirms itself, one row at a time
      rows.forEach((_, i) => {
        const at = 0.5 + i * 0.075;
        tl.to(rules[i], { scaleX: 1, duration: 0.055, ease: "power2.inOut" }, at)
          .to(ticks[i], { strokeDashoffset: 0, duration: 0.04 }, at + 0.03)
          .to(rings[i], { borderColor: "rgba(255,255,255,0.45)", duration: 0.04 }, at + 0.03);
      });

      // 03 — the window builds out of its own blocks
      tl.to(win, { opacity: 1, y: 0, duration: 0.09, ease: "power2.out" }, 0.72);
      blocks.forEach((b, i) => {
        tl.to(b, { scaleX: 1, opacity: 1, duration: 0.05, ease: "power2.out" }, 0.78 + i * 0.022);
      });
      tl.to(terminus, { opacity: 1, scale: 1, duration: 0.05, ease: "back.out(2.4)" }, 0.93)
        .to(liveText, { opacity: 1, y: 0, duration: 0.05, ease: "power2.out" }, 0.955);
    }

    // ── Wiring ───────────────────────────────────────────────────────────────
    addEventListener("resize", () => { buildPath(); sizeDust(); paint(); ScrollTrigger.refresh(); }, { passive: true });
    document.fonts?.ready.then(() => { buildPath(); sizeDust(); ScrollTrigger.refresh(); });

    if (!narrow && !still) {
      addEventListener("pointermove", (e) => {
        const r = stage.getBoundingClientRect();
        tx = ((e.clientX - r.left) / r.width - 0.5) * 2;
        ty = ((e.clientY - r.top) / r.height - 0.5) * 2;
      }, { passive: true });
    }

    const io = new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      if (onScreen) play(); else halt();
    }, { rootMargin: "140px" });
    io.observe(stage);

    document.addEventListener("visibilitychange", () => { if (document.hidden) halt(); else play(); });
    paint();
  }
</script>
