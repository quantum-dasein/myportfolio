---
// ─────────────────────────────────────────────────────────────────────────────
//  ProcessFlow — "what happens after you write", as three stages you can see.
//
//  The section used to be three paragraphs with a numeral beside each. The
//  sequence it describes — a message, a fixed scope, a live site — is the most
//  concrete thing on the page, and it was the least visual. So it is drawn now:
//  a typed message, a scope sheet that ticks itself off, and a browser window
//  with the finished thing in it, joined by a stream that runs through all three.
//
//  Built as CSS and inline SVG with ONE small canvas for the stream. No 3D
//  library, no images: the objects are real boxes with real text in them, which
//  keeps the whole thing a few kB, crisp at any density, and legible to a
//  screen reader when it is not hidden from one. On a page whose argument is
//  that it loads fast, a heavyweight illustration of that argument would be
//  self-defeating.
//
//  The stream, the typing and the ticks all wait until the section is actually
//  on screen, and none of them run under reduced motion, Calm mode, Save-Data
//  or on a low-memory device.
// ─────────────────────────────────────────────────────────────────────────────
interface Step { n: string; title: string; text: string }
interface Props { steps: Step[]; typed: string; rows: string[]; lang: string }
const { steps, typed, rows } = Astro.props;
---

<div class="fx" data-process-flow>
  <canvas class="fx-stream" data-flow-stream aria-hidden="true"></canvas>

  <ol class="fx-stages">
    {steps.map((step, i) => (
      <li class="fx-stage" data-reveal>
        <span class="fx-n" aria-hidden="true">{step.n}</span>
        <h3 class="fx-title">{step.title}</h3>

        <div class="fx-art" aria-hidden="true">
          <span class="fx-rings"></span>

          {i === 0 && (
            <div class="fx-pill">
              <span class="fx-pill-text" data-flow-type data-text={typed}></span>
              <span class="fx-send">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 2 11 13" /><path d="M22 2l-7 20-4-9-9-4 20-7z" />
                </svg>
              </span>
            </div>
          )}

          {i === 1 && (
            <div class="fx-card">
              {rows.map((row, r) => (
                <div class="fx-row" style={`--d:${r * 0.18}s`}>
                  <span class="fx-ico">
                    {r === 0 && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /><path d="M8 13h8M8 17h5" />
                      </svg>
                    )}
                    {r === 1 && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                        <ellipse cx="12" cy="6" rx="8" ry="3" /><path d="M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6" /><path d="M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6" />
                      </svg>
                    )}
                    {r === 2 && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /><circle cx="8" cy="15" r=".8" fill="currentColor" /><circle cx="12" cy="15" r=".8" fill="currentColor" /><circle cx="16" cy="15" r=".8" fill="currentColor" />
                      </svg>
                    )}
                  </span>
                  <span class="fx-row-body">
                    <span class="fx-row-label">{row}</span>
                    <span class="fx-bar"><i></i></span>
                  </span>
                  <span class="fx-check">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m5 12 5 5L20 7" />
                    </svg>
                  </span>
                </div>
              ))}
            </div>
          )}

          {i === 2 && (
            <div class="fx-win">
              <span class="fx-win-bar">
                <i></i><i></i><i></i>
                <b></b>
              </span>
              <span class="fx-win-body">
                <span class="fx-copy"><i></i><i></i><i></i></span>
                <span class="fx-orb"></span>
                <span class="fx-tiles"><i></i><i></i><i></i></span>
              </span>
            </div>
          )}
        </div>

        <p class="fx-text">{step.text}</p>
      </li>
    ))}
  </ol>
</div>

<style>
  .fx {
    position: relative;
    margin-top: clamp(2.4rem, 5vw, 3.6rem);
    /* The orbits are wider than a column on purpose; clipping here is what
       stops them becoming the page's only horizontal overflow. */
    overflow: clip;
  }
  .fx-stream {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
  .fx-stages {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.2rem, 3vw, 2.4rem);
  }
  .fx-stage { display: flex; flex-direction: column; }

  .fx-n {
    font: 500 clamp(2.2rem, 4.4vw, 3.4rem)/0.85 var(--font-display);
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(var(--rgb-text), 0.3);
    font-variant-numeric: tabular-nums;
  }
  .fx-title {
    margin: 0.7rem 0 0;
    font: 500 clamp(1.05rem, 1.9vw, 1.3rem)/1.2 var(--font-display);
    letter-spacing: -0.01em;
  }
  .fx-text {
    margin: 1.2rem 0 0;
    color: rgba(var(--rgb-text), 0.66) !important;
    font-size: 0.92rem;
    line-height: 1.6;
  }

  /* ── The stage art ───────────────────────────────────────────────────────── */
  .fx-art {
    position: relative;
    margin-top: 1.6rem;
    min-height: clamp(9rem, 17vw, 13rem);
    display: flex;
    align-items: center;
    perspective: 1400px;
  }
  /* Faint concentric orbits, the way the reference frames each object in space. */
  .fx-rings {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 21rem;
    height: 21rem;
    margin: -10.5rem 0 0 -10.5rem;
    border-radius: 50%;
    background:
      radial-gradient(circle, transparent 0 27%, rgba(var(--rgb-text), 0.05) 27.5% 27.9%, transparent 28.4%),
      radial-gradient(circle, transparent 0 36%, rgba(var(--rgb-text), 0.04) 36.5% 36.9%, transparent 37.4%),
      radial-gradient(circle, transparent 0 45%, rgba(var(--rgb-text), 0.03) 45.5% 45.9%, transparent 46.4%);
    pointer-events: none;
  }

  /* Shared glass treatment: a translucent pane with a lit top edge. */
  .fx-pill,
  .fx-card,
  .fx-win {
    position: relative;
    /* An opaque base under the glass. Without it the stream showed straight
       THROUGH each object instead of passing behind it, which read as a wire
       drawn over the top rather than a flow the objects sit in. */
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.022)),
      linear-gradient(160deg, #0b0e12, #06080b);
    border: 1px solid rgba(255, 255, 255, 0.13);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      0 24px 60px -30px rgba(0, 0, 0, 0.9);
  }

  /* 01 — the message */
  .fx-pill {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.55rem 0.55rem 0.55rem 1.1rem;
    border-radius: 999px;
  }
  .fx-pill-text {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-inter);
    font-size: clamp(0.62rem, 0.95vw, 0.74rem);
    color: rgba(var(--rgb-text), 0.66);
    white-space: nowrap;
    overflow: hidden;
  }
  .fx-pill-text::after {
    content: "";
    display: inline-block;
    width: 1px;
    height: 1em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: rgba(var(--rgb-text), 0.8);
    animation: fx-caret 1.1s steps(1) infinite;
  }
  @keyframes fx-caret { 0%, 50% { opacity: 1 } 50.01%, 100% { opacity: 0 } }
  .fx-send {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.07);
    color: rgba(var(--rgb-text), 0.92);
  }
  .fx-send svg { width: 0.95rem; height: 0.95rem; }

  /* 02 — the scope sheet */
  .fx-card {
    width: 100%;
    padding: 0.65rem;
    border-radius: 1.15rem;
    display: grid;
    gap: 0.5rem;
    transform: rotateY(-7deg) rotateX(2deg);
  }
  .fx-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.7rem;
    border-radius: 0.8rem;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .fx-ico { color: rgba(var(--rgb-text), 0.72); display: grid; place-items: center; }
  .fx-ico svg { width: 1.05rem; height: 1.05rem; }
  .fx-row-label {
    display: block;
    font-family: var(--font-inter);
    font-size: clamp(0.66rem, 1vw, 0.76rem);
    color: rgba(var(--rgb-text), 0.86);
  }
  .fx-bar {
    display: block;
    margin-top: 0.4rem;
    height: 2px;
    border-radius: 2px;
    background: rgba(var(--rgb-text), 0.1);
    overflow: hidden;
  }
  .fx-bar i {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 2px;
    background: rgba(var(--rgb-text), 0.42);
  }
  .fx-check {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: rgba(var(--rgb-text), 0.9);
  }
  .fx-check svg { width: 0.8rem; height: 0.8rem; stroke-dasharray: 24; stroke-dashoffset: 24; }

  /* The sheet fills itself in once, when the section is reached. */
  .fx.is-live .fx-bar i { animation: fx-fill 0.9s var(--ease-out-expo) var(--d) both; }
  .fx.is-live .fx-check svg { animation: fx-tick 0.5s var(--ease-out-cubic) calc(var(--d) + 0.5s) both; }
  .fx.is-live .fx-check { animation: fx-ring 0.5s var(--ease-out-cubic) calc(var(--d) + 0.5s) both; }
  @keyframes fx-fill { from { width: 0 } to { width: 72% } }
  @keyframes fx-tick { to { stroke-dashoffset: 0 } }
  @keyframes fx-ring {
    from { border-color: rgba(255, 255, 255, 0.2) }
    to { border-color: rgba(255, 255, 255, 0.55) }
  }

  /* 03 — the finished thing */
  .fx-win {
    width: 100%;
    border-radius: 0.9rem;
    overflow: hidden;
    transform: rotateY(-9deg) rotateX(2deg);
  }
  .fx-win-bar {
    display: flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0.5rem 0.7rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
  }
  .fx-win-bar i {
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 50%;
    background: rgba(var(--rgb-text), 0.35);
  }
  .fx-win-bar b {
    margin-left: auto;
    width: 0.85rem;
    height: 1px;
    background: rgba(var(--rgb-text), 0.3);
    box-shadow: 0 3px 0 rgba(var(--rgb-text), 0.3);
  }
  .fx-win-body {
    position: relative;
    display: block;
    padding: 0.85rem 0.75rem 0.7rem;
    min-height: 6.4rem;
  }
  .fx-copy { display: grid; gap: 0.32rem; width: 48%; }
  .fx-copy i {
    height: 3px;
    border-radius: 3px;
    background: rgba(var(--rgb-text), 0.24);
  }
  .fx-copy i:nth-child(2) { width: 78% }
  .fx-copy i:nth-child(3) { width: 55% }
  /* The sphere, so the window is unmistakably one of these builds. */
  .fx-orb {
    position: absolute;
    right: -1.2rem;
    top: 0.4rem;
    width: 5.4rem;
    height: 5.4rem;
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 28%, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.08) 38%, rgba(0, 0, 0, 0.9) 70%),
      #05070a;
    box-shadow: inset -6px -8px 18px rgba(0, 0, 0, 0.9), 0 0 26px rgba(255, 255, 255, 0.08);
  }
  .fx-tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.35rem;
    margin-top: 1.5rem;
  }
  .fx-tiles i {
    height: 1.5rem;
    border-radius: 0.32rem;
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  /* ── Narrow ──────────────────────────────────────────────────────────────── */
  @media (max-width: 860px) {
    /* Stacked, the stream would run straight down through the body copy, and
       motion crossing text someone is reading is worse than no motion. The
       vertical order already says these follow one another, so the stream is a
       wide-screen device only — which also spares phones an rAF loop. */
    .fx-stream { display: none; }
    .fx-stages { grid-template-columns: 1fr; gap: 2.6rem; }
    .fx-art { min-height: 0; margin-top: 1.2rem; max-width: 22rem; }
    .fx-rings { width: 20rem; height: 20rem; margin: -10rem 0 0 -10rem; }
    .fx-card, .fx-win { transform: none; }
    .fx-text { margin-top: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fx-pill-text::after { animation: none; }
    .fx.is-live .fx-bar i,
    .fx.is-live .fx-check svg,
    .fx.is-live .fx-check { animation-duration: 0.01s; animation-delay: 0s; }
  }
  :global(html.rb-calm) .fx-stream { opacity: 0.35; }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-process-flow]");

  if (root) {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const narrow = matchMedia("(max-width: 860px)").matches;
    const nav = navigator as Navigator & {
      connection?: { saveData?: boolean; effectiveType?: string };
      deviceMemory?: number;
    };
    const frugal =
      nav.connection?.saveData === true ||
      /(^|-)2g$/.test(nav.connection?.effectiveType || "") ||
      (nav.deviceMemory !== undefined && nav.deviceMemory <= 2);

    // ── The typed message ────────────────────────────────────────────────────
    const typeEl = root.querySelector<HTMLElement>("[data-flow-type]");
    const full = typeEl?.dataset.text || "";
    const type = () => {
      if (!typeEl) return;
      if (reduced || frugal) { typeEl.textContent = full; return; }
      let i = 0;
      const step = () => {
        typeEl.textContent = full.slice(0, ++i);
        if (i < full.length) setTimeout(step, 42 + Math.random() * 45);
      };
      step();
    };

    // ── The stream ───────────────────────────────────────────────────────────
    // The stream is a wide-screen device (see the stylesheet); on a phone it
    // is never drawn, so it is never set up either.
    const canvas = narrow ? null : root.querySelector<HTMLCanvasElement>("[data-flow-stream]");
    const ctx = canvas?.getContext("2d", { alpha: true });
    let width = 0, height = 0, frame = 0, live = false;

    // Three anchors, one per stage, with the curve bowing between them. Laid out
    // in normalised space so it never needs to measure the DOM.
    const anchors = () => ([[0.17, 0.52], [0.5, 0.46], [0.84, 0.52]]) as [number, number][];

    // Catmull-Rom through the anchors, sampled once per resize.
    const path: [number, number][] = [];
    const buildPath = () => {
      path.length = 0;
      if (!canvas) return;
      const a = anchors().map(([x, y]) => [x * width, y * height] as [number, number]);
      const pts = [a[0], ...a, a[a.length - 1]];
      for (let s = 0; s < pts.length - 3; s++) {
        const [p0, p1, p2, p3] = [pts[s], pts[s + 1], pts[s + 2], pts[s + 3]];
        for (let t = 0; t < 1; t += 0.02) {
          const t2 = t * t, t3 = t2 * t;
          path.push([
            0.5 * ((2 * p1[0]) + (-p0[0] + p2[0]) * t + (2 * p0[0] - 5 * p1[0] + 4 * p2[0] - p3[0]) * t2 + (-p0[0] + 3 * p1[0] - 3 * p2[0] + p3[0]) * t3),
            0.5 * ((2 * p1[1]) + (-p0[1] + p2[1]) * t + (2 * p0[1] - 5 * p1[1] + 4 * p2[1] - p3[1]) * t2 + (-p0[1] + 3 * p1[1] - 3 * p2[1] + p3[1]) * t3),
          ]);
        }
      }
    };

    const COUNT = 84;
    const parts = Array.from({ length: COUNT }, (_, i) => ({
      t: i / COUNT,
      speed: 0.0013 + Math.random() * 0.0022,
      off: (Math.random() - 0.5) * 26,
      size: 0.7 + Math.random() * 1.7,
      lead: Math.random() < 0.24,
    }));

    const resize = () => {
      if (!canvas || !ctx) return;
      const rect = root.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      const dpr = Math.min(devicePixelRatio || 1, 2);
      width = rect.width; height = rect.height;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      buildPath();
    };

    const at = (t: number): [number, number] => {
      const i = Math.min(path.length - 1, Math.max(0, Math.floor(t * (path.length - 1))));
      return path[i] || [0, 0];
    };

    const draw = () => {
      if (!ctx || !path.length) return;
      ctx.clearRect(0, 0, width, height);

      // the channel itself, barely there
      ctx.beginPath();
      ctx.moveTo(path[0][0], path[0][1]);
      for (const [x, y] of path) ctx.lineTo(x, y);
      ctx.strokeStyle = "rgba(233, 240, 243, 0.1)";
      ctx.lineWidth = 1;
      ctx.stroke();

      for (const p of parts) {
        const [x, y] = at(p.t);
        const [px, py] = at(Math.max(0, p.t - 0.02));
        // spread the swarm off the centre line so it reads as a flow, not a wire
        const dx = x - px, dy = y - py;
        const len = Math.hypot(dx, dy) || 1;
        const nx = -dy / len, ny = dx / len;
        const ease = Math.sin(p.t * Math.PI); // tight at the objects, wide between
        const ox = nx * p.off * ease, oy = ny * p.off * ease;

        if (p.lead) {
          // a short comet tail, sampled further back so it actually reads
          const [tx, ty] = at(Math.max(0, p.t - 0.05));
          const grad = ctx.createLinearGradient(tx + ox, ty + oy, x + ox, y + oy);
          grad.addColorStop(0, "rgba(255, 255, 255, 0)");
          grad.addColorStop(1, "rgba(255, 255, 255, 0.7)");
          ctx.beginPath();
          ctx.moveTo(tx + ox, ty + oy);
          ctx.lineTo(x + ox, y + oy);
          ctx.strokeStyle = grad;
          ctx.lineWidth = 1.3;
          ctx.stroke();
        }
        ctx.beginPath();
        ctx.arc(x + ox, y + oy, p.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255, 255, 255, ${p.lead ? 0.95 : 0.5})`;
        if (p.lead) { ctx.shadowColor = "rgba(255,255,255,0.85)"; ctx.shadowBlur = 8; }
        ctx.fill();
        ctx.shadowBlur = 0;
      }
    };

    const tick = () => {
      if (!live) { frame = 0; return; }
      for (const p of parts) { p.t += p.speed; if (p.t > 1) p.t -= 1; }
      draw();
      frame = requestAnimationFrame(tick);
    };
    const start = () => { if (!frame && live && canvas && !reduced && !frugal) frame = requestAnimationFrame(tick); };
    const stop = () => { cancelAnimationFrame(frame); frame = 0; };

    resize();
    addEventListener("resize", () => { resize(); draw(); }, { passive: true });
    document.addEventListener("visibilitychange", () => { if (document.hidden) stop(); else start(); });

    // Nothing runs until the section is actually reached — the ticks and the
    // typing are a one-off performance, and they should happen while someone
    // is looking at them.
    let played = false;
    const io = new IntersectionObserver(([entry]) => {
      live = entry.isIntersecting;
      if (live) {
        if (!played) { played = true; root.classList.add("is-live"); type(); }
        start();
      } else stop();
    }, { threshold: 0.15 });
    io.observe(root);

    draw();
  }
</script>
