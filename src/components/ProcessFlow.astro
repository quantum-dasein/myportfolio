---
// ─────────────────────────────────────────────────────────────────────────────
//  ProcessFlow — "what happens after you write", as one cinematic scene.
//
//  Two rebuilds got here. The first was three equal columns — a concept mockup.
//  The second had the right composition but the wrong material: everything was
//  made of borders, so it read as a wireframe diagram, one thin SVG line between
//  three flat boxes. The difference that matters is
//      object → light → object → light → object
//  rather than
//      box → line → box → line → box.
//  This pass is about mass, depth, light and flow. The structure and the
//  ScrollTrigger sequence from the previous pass are unchanged.
//
//  What carries it now:
//   · Objects roughly 40% larger and close enough to OVERLAP in depth. SCOPE
//     overhangs both neighbours and sits highest in the stack — it is the hero
//     of the section, not one of three.
//   · Real optical surfaces: a lit top edge, an internal vertical gradient, a
//     specular sheen across the corner, inner glow, and ambient occlusion under
//     each object. Dark acrylic photographed in a black studio, not frosted white.
//   · The flow is four strands of differing weight and opacity plus a pulse that
//     travels the filament, not a single stroke.
//   · Four depth layers moving at different rates under the pointer: the
//     generative contour field, distant dust, the flow, then the objects.
//   · A light zone behind each object — SCOPE brightest, LAUNCH second, WRITE
//     faintest — so the eye is told where to look without a single colour.
//   · LAUNCH is an actual site preview (nav, hero, sphere, cards) instead of the
//     grey skeleton bars, which were the single cheapest thing in the scene.
//
//  Still no Three.js and no pin: nothing here has depth a WebGL context would
//  earn, and pinning would cost ~150vh of page for an animation that reads fine
//  as it passes.
// ─────────────────────────────────────────────────────────────────────────────
interface Step { n: string; label: string; line: string }
interface Props { steps: Step[]; typed: string; rows: string[]; note: string; live: string; liveTag: string }
const { steps, typed, rows, note, live, liveTag } = Astro.props;
---

<div class="pv" data-process-flow>
  <div class="pv-stage" data-pv-stage>
    <!-- Layer 1 — the generative contour field, drawn on canvas so it is one
         continuous system of overlapping arcs rather than three identical
         targets parked behind three cards. -->
    <canvas class="pv-field" data-pv-field aria-hidden="true"></canvas>

    <!-- Light zones. The only hierarchy tool available in a monochrome palette. -->
    <span class="pv-glow pv-glow--write" aria-hidden="true"></span>
    <span class="pv-glow pv-glow--scope" aria-hidden="true"></span>
    <span class="pv-glow pv-glow--launch" aria-hidden="true"></span>

    <!-- Layer 3 — the flow -->
    <svg class="pv-path" data-pv-svg aria-hidden="true" preserveAspectRatio="none">
      <path class="pv-strand pv-strand--1" data-pv-strand fill="none" />
      <path class="pv-strand pv-strand--2" data-pv-strand fill="none" />
      <path class="pv-strand pv-strand--3" data-pv-strand fill="none" />
      <path class="pv-filament" data-pv-line data-pv-strand fill="none" />
      <path class="pv-pulse" data-pv-pulse fill="none" />
    </svg>
    <canvas class="pv-dust" data-pv-dust aria-hidden="true"></canvas>

    <!-- 01 · WRITE -->
    <div class="pv-node pv-node--write" data-pv-layer="3">
      <span class="pv-n" aria-hidden="true">{steps[0].n}</span>
      <span class="pv-label">{steps[0].label}</span>
      <div class="pv-obj pv-pill" data-pv-tilt data-pv-write>
        <span class="pv-pill-text" data-pv-type data-text={typed}></span>
        <span class="pv-send" data-pv-send>
          <span class="pv-shock" data-pv-shock></span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 2 11 13" /><path d="M22 2l-7 20-4-9-9-4 20-7z" />
          </svg>
        </span>
      </div>
      <p class="pv-line">{steps[0].line}</p>
    </div>

    <!-- 02 · SCOPE — the hero of the scene -->
    <div class="pv-node pv-node--scope" data-pv-layer="4">
      <span class="pv-n" aria-hidden="true">{steps[1].n}</span>
      <span class="pv-label">{steps[1].label}</span>
      <div class="pv-obj pv-sheet" data-pv-tilt data-pv-sheet>
        {rows.map((row, r) => (
          <div class="pv-row" data-pv-row={r}>
            <span class="pv-row-label">{row}</span>
            <span class="pv-row-rule"><i></i></span>
            <span class="pv-row-tick">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m5 12.5 4.5 4.5L19 7" />
              </svg>
            </span>
          </div>
        ))}
      </div>
      <p class="pv-line">{steps[1].line}</p>
    </div>

    <!-- 03 · LAUNCH — a finished site, not a loading skeleton -->
    <div class="pv-node pv-node--launch" data-pv-layer="3">
      <span class="pv-n" aria-hidden="true">{steps[2].n}</span>
      <span class="pv-label">{steps[2].label}</span>
      <div class="pv-obj pv-win" data-pv-tilt data-pv-win>
        <span class="pv-win-bar">
          <i></i><i></i><i></i>
          <b>{liveTag}</b>
        </span>
        <span class="pv-win-body">
          <span class="pv-nav" data-pv-block><i></i><i></i><i></i></span>
          <span class="pv-hero">
            <span class="pv-hero-copy">
              <span class="pv-h1" data-pv-block></span>
              <span class="pv-h2" data-pv-block></span>
              <span class="pv-cta" data-pv-block></span>
            </span>
            <span class="pv-sphere" data-pv-block></span>
          </span>
          <span class="pv-cards">
            <i data-pv-block></i><i data-pv-block></i><i data-pv-block></i>
          </span>
        </span>
      </div>
      <p class="pv-line">{steps[2].line}</p>
    </div>

    <span class="pv-terminus" data-pv-terminus aria-hidden="true"></span>
    <p class="pv-live" data-pv-live>{live}</p>
  </div>

  <p class="pv-note">{note}</p>
</div>

<style>
  .pv { margin-top: clamp(2.6rem, 5vw, 4rem); }

  .pv-stage {
    position: relative;
    height: clamp(28rem, 33vw, 35rem);
    isolation: isolate;
    /* Everything here is sized to bleed. Clipping the horizontal axis only stops
       that becoming the page's overflow while leaving the numerals, which sit
       above their objects, visible. `clip` so no scroll container is created. */
    overflow-x: clip;
  }

  /* ── Layer 1 · contour field, and the light zones ────────────────────────── */
  .pv-field,
  .pv-dust {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .pv-field { z-index: 0; }
  .pv-dust { z-index: 2; }

  .pv-glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
    will-change: transform;
  }
  .pv-glow--write {
    left: -6%; top: 26%; width: 46%; aspect-ratio: 1;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.035), transparent 62%);
  }
  .pv-glow--scope {
    left: 20%; top: -20%; width: 62%; aspect-ratio: 1;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.02) 38%, transparent 65%);
  }
  .pv-glow--launch {
    left: 50%; top: 6%; width: 56%; aspect-ratio: 1;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.05), transparent 62%);
  }

  /* ── Layer 3 · the flow ──────────────────────────────────────────────────── */
  .pv-path { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; overflow: visible; pointer-events: none; }
  .pv-strand { stroke: rgba(var(--rgb-text), 0.1); stroke-width: 0.75; }
  .pv-strand--1 { stroke: rgba(var(--rgb-text), 0.075); stroke-width: 0.6; }
  .pv-strand--2 { stroke: rgba(var(--rgb-text), 0.13); stroke-width: 0.9; }
  .pv-strand--3 { stroke: rgba(var(--rgb-text), 0.06); stroke-width: 0.5; }
  .pv-filament {
    stroke: rgba(255, 255, 255, 0.42);
    stroke-width: 1.15;
    filter: drop-shadow(0 0 4px rgba(255, 255, 255, 0.4)) drop-shadow(0 0 12px rgba(255, 255, 255, 0.16));
  }
  .pv-pulse {
    stroke: rgba(255, 255, 255, 0.95);
    stroke-width: 1.7;
    stroke-linecap: round;
    filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.9)) drop-shadow(0 0 16px rgba(255, 255, 255, 0.4));
  }

  /* ── Layer 4 · the objects ───────────────────────────────────────────────── */
  .pv-node { position: absolute; }
  /* Close enough to overlap, so the scene has depth instead of three islands.
     SCOPE overhangs both neighbours and stacks above them. */
  .pv-node--write  { left: 0;   top: 43%; width: 30%; z-index: 3; }
  .pv-node--scope  { left: 40%; top: 2%;  width: 38%; z-index: 5; }
  .pv-node--launch { left: 68%; top: 28%; width: 29%; z-index: 4; }

  /* Atmospheric typography: large, very faint, and partly behind its object. */
  .pv-n {
    position: absolute;
    left: -0.05em;
    top: -0.34em;
    font: 400 clamp(4.5rem, 9vw, 9rem)/0.78 var(--font-display);
    letter-spacing: -0.055em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(var(--rgb-text), 0.075);
    font-variant-numeric: tabular-nums;
    pointer-events: none;
    z-index: -1;
  }
  .pv-label {
    position: relative;
    display: block;
    margin-bottom: 0.9rem;
    font-family: var(--font-inter);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(var(--rgb-text), 0.45);
  }
  .pv-line {
    position: relative;
    margin: 1.1rem 0 0 !important;
    max-width: 26ch;
    font-size: 0.84rem !important;
    line-height: 1.5;
    color: rgba(var(--rgb-text), 0.5) !important;
  }

  /* Optical glass: a lit top edge, an internal gradient, a specular corner,
     inner glow, and occlusion beneath. Dark acrylic in a black studio. */
  .pv-obj {
    position: relative;
    background:
      linear-gradient(142deg, rgba(255, 255, 255, 0.085) 0%, rgba(255, 255, 255, 0.018) 20%, transparent 44%),
      radial-gradient(130% 80% at 50% -12%, rgba(255, 255, 255, 0.055), transparent 62%),
      linear-gradient(168deg, #0d1117 0%, #080b10 52%, #04060a 100%);
    border: 1px solid rgba(255, 255, 255, 0.085);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.19),
      inset 0 -1px 0 rgba(255, 255, 255, 0.035),
      inset 0 0 44px rgba(255, 255, 255, 0.022),
      0 44px 90px -46px rgba(0, 0, 0, 1),
      0 8px 26px -14px rgba(0, 0, 0, 0.9);
    will-change: transform;
  }
  /* A slow specular streak across the surface — the give-away that it is glass
     and not a rectangle with a border. */
  .pv-obj::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(114deg, transparent 34%, rgba(255, 255, 255, 0.035) 48%, transparent 60%);
    pointer-events: none;
  }

  /* 01 — the message */
  .pv-pill {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.62rem 0.62rem 0.62rem 1.2rem;
    border-radius: 999px;
  }
  .pv-pill-text {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-inter);
    font-size: clamp(0.66rem, 0.86vw, 0.82rem);
    color: rgba(var(--rgb-text), 0.66);
    white-space: nowrap;
    overflow: hidden;
  }
  .pv-pill-text::after {
    content: "";
    display: inline-block;
    width: 1px; height: 1em;
    margin-left: 2px; vertical-align: -0.15em;
    background: rgba(var(--rgb-text), 0.78);
    animation: pv-caret 1.1s steps(1) infinite;
  }
  @keyframes pv-caret { 0%, 50% { opacity: 1 } 50.01%, 100% { opacity: 0 } }
  /* The send button reads as a small lens, not a bordered circle. */
  .pv-send {
    position: relative;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.4rem; height: 2.4rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background:
      radial-gradient(110% 110% at 34% 26%, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.04) 46%, transparent 70%),
      rgba(255, 255, 255, 0.045);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 0 16px rgba(255, 255, 255, 0.07);
    color: rgba(var(--rgb-text), 0.95);
    will-change: transform;
  }
  .pv-send svg { width: 0.95rem; height: 0.95rem; }
  .pv-shock {
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.55);
    opacity: 0;
    pointer-events: none;
  }

  /* 02 — the sheet */
  .pv-sheet {
    padding: 0.5rem 1.35rem;
    border-radius: 1.35rem;
    transform: perspective(1600px) rotateX(1.2deg) rotateY(-2.2deg);
  }
  /* Rows are inset glass, not text on a rule. */
  .pv-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    margin: 0.5rem 0;
    padding: 0.95rem 1rem;
    border-radius: 0.75rem;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.028), rgba(255, 255, 255, 0.008));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.055), inset 0 0 0 1px rgba(255, 255, 255, 0.028);
  }
  .pv-row-label {
    font-family: var(--font-inter);
    font-size: clamp(0.7rem, 0.92vw, 0.83rem);
    letter-spacing: 0.01em;
    color: rgba(var(--rgb-text), 0.9);
    white-space: nowrap;
  }
  .pv-row-rule { display: block; height: 1px; background: rgba(var(--rgb-text), 0.07); overflow: hidden; }
  .pv-row-rule i {
    display: block; height: 100%; width: 100%;
    background: linear-gradient(90deg, rgba(var(--rgb-text), 0.15), rgba(255, 255, 255, 0.6));
    transform: scaleX(0);
    transform-origin: left center;
  }
  .pv-row-tick {
    display: grid;
    place-items: center;
    width: 1.5rem; height: 1.5rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: radial-gradient(110% 110% at 34% 26%, rgba(255, 255, 255, 0.14), transparent 68%);
    color: rgba(var(--rgb-text), 0.95);
  }
  .pv-row-tick svg { width: 0.8rem; height: 0.8rem; stroke-dasharray: 26; stroke-dashoffset: 26; }

  /* 03 — a finished site */
  .pv-win {
    border-radius: 1rem;
    overflow: hidden;
    transform: perspective(1600px) rotateX(1deg) rotateY(-2.6deg);
  }
  .pv-win-bar {
    display: flex; align-items: center; gap: 0.3rem;
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.035), transparent);
  }
  .pv-win-bar i { width: 0.34rem; height: 0.34rem; border-radius: 50%; background: rgba(var(--rgb-text), 0.3); }
  .pv-win-bar b {
    margin-left: auto;
    display: inline-flex; align-items: center; gap: 0.34rem;
    font-family: var(--font-inter);
    font-size: 0.5rem; font-weight: 600; letter-spacing: 0.22em;
    color: rgba(var(--rgb-text), 0.6);
  }
  .pv-win-bar b::before {
    content: "";
    width: 0.3rem; height: 0.3rem; border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 7px rgba(255, 255, 255, 0.85);
  }
  .pv-win-body { display: block; padding: 0.9rem 1rem 1.05rem; }

  .pv-nav { display: flex; gap: 0.65rem; margin-bottom: 1.1rem; transform-origin: left center; }
  .pv-nav i { width: 1.5rem; height: 3px; border-radius: 3px; background: rgba(var(--rgb-text), 0.22); }
  .pv-nav i:first-child { width: 2.4rem; background: rgba(var(--rgb-text), 0.5); }

  .pv-hero { display: flex; align-items: center; gap: 0.9rem; }
  .pv-hero-copy { flex: 1 1 auto; display: block; }
  .pv-h1 { display: block; height: 9px; width: 88%; border-radius: 5px; background: rgba(var(--rgb-text), 0.42); transform-origin: left center; }
  .pv-h2 { display: block; height: 5px; width: 62%; margin-top: 0.42rem; border-radius: 4px; background: rgba(var(--rgb-text), 0.2); transform-origin: left center; }
  .pv-cta {
    display: block; height: 1.15rem; width: 3.6rem; margin-top: 0.7rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.82);
    transform-origin: left center;
  }
  /* The dark sphere — the one moment of real form inside the preview. */
  .pv-sphere {
    flex: 0 0 auto;
    display: block;
    width: 4.6rem; height: 4.6rem;
    border-radius: 50%;
    background:
      radial-gradient(circle at 33% 27%, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.1) 30%, rgba(4, 6, 10, 0.98) 66%),
      #04060a;
    box-shadow: inset -7px -9px 20px rgba(0, 0, 0, 0.95), 0 0 30px rgba(255, 255, 255, 0.1);
  }

  .pv-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.4rem; margin-top: 1rem; }
  .pv-cards i {
    display: block; height: 2.5rem;
    border-radius: 0.4rem;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.012));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07), inset 0 0 0 1px rgba(255, 255, 255, 0.03);
    transform-origin: center bottom;
  }

  /* Where the flow ends. */
  .pv-terminus {
    position: absolute;
    right: 0.5%;
    top: 62%;
    width: 0.6rem; height: 0.6rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 6px rgba(255, 255, 255, 0.06), 0 0 24px rgba(255, 255, 255, 0.65);
    z-index: 6;
    will-change: transform, opacity;
  }
  .pv-live {
    position: absolute;
    right: 0; bottom: 0;
    margin: 0 !important;
    max-width: 14rem;
    font-family: var(--font-inter);
    font-size: 0.58rem !important;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-align: right;
    color: rgba(var(--rgb-text), 0.5) !important;
    z-index: 6;
  }

  /* Out of the scene entirely — inside it, it turned the composition back into
     an ordinary website section. */
  .pv-note {
    max-width: 60ch;
    margin: clamp(2.4rem, 4vw, 3.4rem) 0 0 !important;
    font-size: 0.86rem !important;
    line-height: 1.65;
    color: rgba(var(--rgb-text), 0.4) !important;
  }

  /* ── Narrow ──────────────────────────────────────────────────────────────── */
  @media (max-width: 1040px) {
    .pv-stage { height: auto; display: grid; gap: 3.8rem; }
    .pv-path, .pv-dust, .pv-field { display: none; }
    .pv-node { position: relative; left: auto; top: auto; width: 100%; max-width: 25rem; }
    .pv-n { font-size: clamp(3.4rem, 16vw, 5.5rem); top: -0.3em; }
    .pv-line { max-width: 34ch; }
    .pv-sheet, .pv-win { transform: none; }
    .pv-glow--write  { left: -30%; top: 2%;  width: 90%; }
    .pv-glow--scope  { left: 6%;   top: 30%; width: 100%; }
    .pv-glow--launch { left: -6%;  top: 64%; width: 92%; }
    .pv-terminus { position: relative; right: auto; top: auto; margin-left: 0.2rem; }
    .pv-live { position: relative; right: auto; bottom: auto; text-align: left; margin-top: 0.9rem !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pv-pill-text::after { animation: none; }
  }
</style>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";

  const root = document.querySelector<HTMLElement>("[data-process-flow]");

  if (root) {
    gsap.registerPlugin(ScrollTrigger);

    const stage = root.querySelector<HTMLElement>("[data-pv-stage]")!;
    const svg = root.querySelector<SVGSVGElement>("[data-pv-svg]")!;
    const strands = Array.from(root.querySelectorAll<SVGPathElement>("[data-pv-strand]"));
    const line = root.querySelector<SVGPathElement>("[data-pv-line]")!;
    const pulse = root.querySelector<SVGPathElement>("[data-pv-pulse]")!;
    const field = root.querySelector<HTMLCanvasElement>("[data-pv-field]")!;
    const dust = root.querySelector<HTMLCanvasElement>("[data-pv-dust]")!;
    const typeEl = root.querySelector<HTMLElement>("[data-pv-type]")!;
    const write = root.querySelector<HTMLElement>("[data-pv-write]")!;
    const send = root.querySelector<HTMLElement>("[data-pv-send]")!;
    const shock = root.querySelector<HTMLElement>("[data-pv-shock]")!;
    const sheet = root.querySelector<HTMLElement>("[data-pv-sheet]")!;
    const win = root.querySelector<HTMLElement>("[data-pv-win]")!;
    const rows = Array.from(root.querySelectorAll<HTMLElement>("[data-pv-row]"));
    const blocks = Array.from(root.querySelectorAll<HTMLElement>("[data-pv-block]"));
    const terminus = root.querySelector<HTMLElement>("[data-pv-terminus]")!;
    const liveText = root.querySelector<HTMLElement>("[data-pv-live]")!;
    const glows = Array.from(root.querySelectorAll<HTMLElement>(".pv-glow"));
    const tilts = Array.from(root.querySelectorAll<HTMLElement>("[data-pv-tilt]"));
    const rules = rows.map((r) => r.querySelector<HTMLElement>(".pv-row-rule i")!);
    const ticks = rows.map((r) => r.querySelector<SVGElement>(".pv-row-tick svg")!);
    const rings = rows.map((r) => r.querySelector<HTMLElement>(".pv-row-tick")!);

    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const narrow = matchMedia("(max-width: 1040px)").matches;
    const nav = navigator as Navigator & {
      connection?: { saveData?: boolean; effectiveType?: string };
      deviceMemory?: number;
    };
    const frugal =
      nav.connection?.saveData === true ||
      /(^|-)2g$/.test(nav.connection?.effectiveType || "") ||
      (nav.deviceMemory !== undefined && nav.deviceMemory <= 2);
    const still = reduced || frugal;

    const full = typeEl.dataset.text || "";
    let progress = 0;

    // ── The flow ─────────────────────────────────────────────────────────────
    // Anchors are measured from the objects themselves, so the strands meet each
    // one at its own edge however the composition is sized.
    const anchors = (): [number, number][] => {
      const h = stage.clientHeight;
      const s0 = stage.getBoundingClientRect();
      const box = (el: Element) => {
        const b = el.getBoundingClientRect();
        return { l: b.left - s0.left, r: b.right - s0.left, b: b.bottom - s0.top,
                 cy: b.top - s0.top + b.height / 2 };
      };
      const S = box(send), H = box(sheet), W = box(win), T = box(terminus);
      return [
        [S.r + 6, S.cy],
        [S.r + (H.l - S.r) * 0.34, S.cy - h * 0.03],
        [S.r + (H.l - S.r) * 0.72, H.cy + h * 0.09],
        [H.l - 8, H.cy],
        [H.r + 8, H.cy + h * 0.06],
        [W.l + (W.r - W.l) * 0.45, W.b + h * 0.1],
        [W.r + (T.l - W.r) * 0.5, W.b + h * 0.04],
        [T.l + 3, T.cy],
      ];
    };

    const toPath = (p: [number, number][]) => {
      let d = `M ${p[0][0]} ${p[0][1]}`;
      for (let i = 0; i < p.length - 1; i++) {
        const p0 = p[i - 1] || p[i], p1 = p[i], p2 = p[i + 1], p3 = p[i + 2] || p[i + 1];
        d += ` C ${p1[0] + (p2[0] - p0[0]) / 6} ${p1[1] + (p2[1] - p0[1]) / 6},` +
             ` ${p2[0] - (p3[0] - p1[0]) / 6} ${p2[1] - (p3[1] - p1[1]) / 6},` +
             ` ${p2[0]} ${p2[1]}`;
      }
      return d;
    };

    // Each strand is the same journey at a slightly different altitude, which is
    // what makes it read as a current rather than a wire.
    const OFFSETS = [-9, 5, 13, 0];

    const buildPath = () => {
      const w = stage.clientWidth, h = stage.clientHeight;
      if (!w || !h) return;
      svg.setAttribute("viewBox", `0 0 ${w} ${h}`);
      const base = anchors();
      strands.forEach((el, i) => {
        const off = OFFSETS[i] ?? 0;
        const wob = (n: number) => Math.sin(n * 1.7 + i) * off * 0.5;
        el.setAttribute("d", toPath(base.map(([x, y], n) => [x, y + off * (n === 0 || n === base.length - 1 ? 0.15 : 1) + wob(n)])));
      });
      const len = line.getTotalLength();
      line.style.strokeDasharray = String(len);
      line.style.strokeDashoffset = String(len * (1 - Math.min(1, progress / 0.88)));
      strands.forEach((el) => {
        if (el === line) return;
        const l = el.getTotalLength();
        el.style.strokeDasharray = String(l);
        el.style.strokeDashoffset = String(l * (1 - Math.min(1, progress / 0.88)));
      });
      // The pulse is a short lit dash riding the filament.
      pulse.setAttribute("d", line.getAttribute("d") || "");
      pulse.style.strokeDasharray = `${Math.max(30, len * 0.05)} ${len}`;
    };

    // ── Layers 1 and 2 · contour field and dust ──────────────────────────────
    let dw = 0, dh = 0, raf = 0, onScreen = false, t0 = 0;
    const SWARM = narrow || still ? 0 : 34;
    const MOTES = narrow || still ? 0 : 54;
    const swarm = Array.from({ length: SWARM }, (_, i) => ({
      t: i / Math.max(1, SWARM),
      speed: 0.0018 + Math.random() * 0.0028,
      off: (Math.random() - 0.5) * 22,
      size: 0.5 + Math.random() * 1.4,
      lead: Math.random() < 0.24,
    }));
    const motes = Array.from({ length: MOTES }, () => ({
      x: Math.random(), y: Math.random(),
      r: 0.4 + Math.random() * 1.2,
      a: 0.1 + Math.random() * 0.3,
      vx: (Math.random() - 0.5) * 0.0002,
      vy: (Math.random() - 0.5) * 0.00015,
    }));
    // One field of overlapping ellipses at three loose centres, rotated apart,
    // so it reads as terrain rather than three targets behind three cards.
    const ARCS = Array.from({ length: 22 }, (_, i) => ({
      cx: [0.16, 0.5, 0.82][i % 3] + (Math.random() - 0.5) * 0.14,
      cy: [0.62, 0.3, 0.5][i % 3] + (Math.random() - 0.5) * 0.16,
      r: 0.08 + (i % 7) * 0.055 + Math.random() * 0.03,
      squash: 0.5 + Math.random() * 0.4,
      rot: Math.random() * Math.PI,
      a: 0.012 + Math.random() * 0.03,
      from: Math.random() * Math.PI * 2,
      span: Math.PI * (0.7 + Math.random() * 1.1),
    }));

    const fctx = field.getContext("2d", { alpha: true });
    const dctx = dust.getContext("2d", { alpha: true });

    const sizeCanvases = () => {
      const w = stage.clientWidth, h = stage.clientHeight;
      if (!w || !h) return;
      const dpr = Math.min(devicePixelRatio || 1, 2);
      dw = w; dh = h;
      for (const [c, cx] of [[field, fctx], [dust, dctx]] as const) {
        if (!cx) continue;
        c.width = Math.round(w * dpr);
        c.height = Math.round(h * dpr);
        cx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      drawField();
    };

    let px = 0, py = 0, tx = 0, ty = 0;

    // The contour field is static geometry, so it is drawn once per resize and
    // only translated by the pointer — no per-frame cost at all.
    const drawField = () => {
      if (!fctx || !dw) return;
      fctx.clearRect(0, 0, dw, dh);
      const R = Math.max(dw, dh);
      for (const a of ARCS) {
        fctx.save();
        fctx.translate(a.cx * dw, a.cy * dh);
        fctx.rotate(a.rot);
        fctx.beginPath();
        fctx.ellipse(0, 0, a.r * R, a.r * R * a.squash, 0, a.from, a.from + a.span);
        fctx.strokeStyle = `rgba(233, 240, 243, ${a.a})`;
        fctx.lineWidth = 1;
        fctx.stroke();
        fctx.restore();
      }
    };

    const paint = () => {
      if (!dctx || !dw) return;
      dctx.clearRect(0, 0, dw, dh);

      for (const m of motes) {
        m.x += m.vx; m.y += m.vy;
        if (m.x < 0) m.x = 1; if (m.x > 1) m.x = 0;
        if (m.y < 0) m.y = 1; if (m.y > 1) m.y = 0;
        dctx.beginPath();
        dctx.arc(m.x * dw + px * 8, m.y * dh + py * 5, m.r, 0, Math.PI * 2);
        dctx.fillStyle = `rgba(233, 240, 243, ${m.a})`;
        dctx.fill();
      }

      if (!swarm.length) return;
      const len = line.getTotalLength();
      if (!len) return;
      const reach = Math.max(0.02, Math.min(1, progress / 0.88));
      for (const p of swarm) {
        p.t += p.speed;
        if (p.t > 1) p.t -= 1;
        const t = p.t * reach;
        const a = line.getPointAtLength(t * len);
        const b = line.getPointAtLength(Math.max(0, t - 0.012) * len);
        const dx = a.x - b.x, dy = a.y - b.y;
        const l = Math.hypot(dx, dy) || 1;
        const spread = Math.sin(p.t * Math.PI) * p.off;
        const ox = (-dy / l) * spread + px * 14;
        const oy = (dx / l) * spread + py * 9;

        if (p.lead) {
          const c = line.getPointAtLength(Math.max(0, t - 0.05) * len);
          const g = dctx.createLinearGradient(c.x + ox, c.y + oy, a.x + ox, a.y + oy);
          g.addColorStop(0, "rgba(255,255,255,0)");
          g.addColorStop(1, "rgba(255,255,255,0.65)");
          dctx.beginPath();
          dctx.moveTo(c.x + ox, c.y + oy);
          dctx.lineTo(a.x + ox, a.y + oy);
          dctx.strokeStyle = g;
          dctx.lineWidth = 1.25;
          dctx.stroke();
        }
        dctx.beginPath();
        dctx.arc(a.x + ox, a.y + oy, p.size, 0, Math.PI * 2);
        dctx.fillStyle = `rgba(255,255,255,${p.lead ? 0.92 : 0.44})`;
        dctx.fill();
      }
    };

    const loop = (now: number) => {
      if (!onScreen) { raf = 0; return; }
      if (!t0) t0 = now;
      px += (tx - px) * 0.045;
      py += (ty - py) * 0.045;
      // Four layers, four rates. Small numbers on purpose — 4px to 18px.
      const t = `perspective(1600px) rotateY(${(px * 2.4).toFixed(2)}deg) rotateX(${(-py * 1.6).toFixed(2)}deg)`;
      for (const el of tilts) el.style.transform = `${t} ${el === sheet ? "rotateX(1.2deg) rotateY(-2.2deg)" : el === win ? "rotateX(1deg) rotateY(-2.6deg)" : ""}`;
      field.style.transform = `translate3d(${(px * 4).toFixed(1)}px, ${(py * 3).toFixed(1)}px, 0)`;
      glows.forEach((el, i) => { el.style.transform = `translate3d(${(px * (7 + i * 4)).toFixed(1)}px, ${(py * (4 + i * 3)).toFixed(1)}px, 0)`; });
      // the pulse rides the filament once the line exists
      const len = line.getTotalLength();
      if (len) pulse.style.strokeDashoffset = String(-(((now - t0) * 0.09) % (len * 1.05)));
      paint();
      raf = requestAnimationFrame(loop);
    };
    const play = () => { if (!raf && onScreen && !still && !narrow) raf = requestAnimationFrame(loop); };
    const halt = () => { cancelAnimationFrame(raf); raf = 0; };

    // ── Rest, then the scrubbed sequence ─────────────────────────────────────
    const setFinal = () => {
      gsap.set([write, sheet, win], { opacity: 1, y: 0, scale: 1 });
      gsap.set(rules, { scaleX: 1 });
      gsap.set(ticks, { strokeDashoffset: 0 });
      gsap.set(rings, { borderColor: "rgba(255,255,255,0.45)" });
      gsap.set(rows, { backgroundColor: "rgba(255,255,255,0.05)" });
      gsap.set(blocks, { scaleX: 1, scaleY: 1, opacity: 1 });
      gsap.set(terminus, { opacity: 1, scale: 1 });
      gsap.set(liveText, { opacity: 1, y: 0 });
      typeEl.textContent = full;
      progress = 1;
      strands.forEach((el) => { el.style.strokeDashoffset = "0"; });
    };

    buildPath();
    sizeCanvases();

    if (still) {
      setFinal();
      paint();
      gsap.set(pulse, { opacity: 0 });
    } else {
      gsap.set([write, win], { opacity: 0, y: 22 });
      gsap.set(sheet, { opacity: 0, y: 30, scale: 0.96 });
      gsap.set(rules, { scaleX: 0 });
      gsap.set(ticks, { strokeDashoffset: 26 });
      gsap.set(blocks, { scaleX: 0, opacity: 0 });
      gsap.set(terminus, { opacity: 0, scale: 0.4 });
      gsap.set(liveText, { opacity: 0, y: 6 });
      gsap.set(pulse, { opacity: 0 });
      typeEl.textContent = "";

      const typer = { v: 0 };
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: stage,
          start: "top 84%",
          end: "bottom 56%",
          scrub: 0.7,
          onUpdate: (self) => { progress = self.progress; },
        },
        defaults: { ease: "none" },
      });

      tl
        .to(write, { opacity: 1, y: 0, duration: 0.08, ease: "power2.out" }, 0)
        .to(typer, {
          v: 1, duration: 0.16,
          onUpdate: () => { typeEl.textContent = full.slice(0, Math.round(typer.v * full.length)); },
        }, 0.06)
        // the message leaves: the button flares, a shockwave rings off it
        .to(send, { scale: 1.16, duration: 0.03, ease: "power2.out" }, 0.24)
        .fromTo(shock, { opacity: 0.75, scale: 1 }, { opacity: 0, scale: 2.6, duration: 0.07, ease: "power2.out" }, 0.245)
        .to(send, { scale: 1, duration: 0.06, ease: "power2.inOut" }, 0.27)
        .to(pulse, { opacity: 1, duration: 0.02 }, 0.26);

      // every strand carries it, the heaviest slightly ahead
      strands.forEach((el, i) => {
        tl.to(el, { strokeDashoffset: 0, duration: 0.6 + i * 0.03 }, 0.26 + i * 0.012);
      });

      tl.to(sheet, { opacity: 1, y: 0, scale: 1, duration: 0.1, ease: "power2.out" }, 0.4);

      rows.forEach((row, i) => {
        const at = 0.5 + i * 0.075;
        tl.to(rules[i], { scaleX: 1, duration: 0.055, ease: "power2.inOut" }, at)
          .to(row, { backgroundColor: "rgba(255,255,255,0.05)", duration: 0.05 }, at + 0.02)
          .to(ticks[i], { strokeDashoffset: 0, duration: 0.04 }, at + 0.03)
          .to(rings[i], { borderColor: "rgba(255,255,255,0.45)", duration: 0.04 }, at + 0.03);
      });

      // the site assembles, chrome first
      tl.to(win, { opacity: 1, y: 0, duration: 0.09, ease: "power2.out" }, 0.72);
      blocks.forEach((b, i) => {
        const card = b.parentElement?.classList.contains("pv-cards");
        tl.to(b, card ? { scaleY: 1, opacity: 1, duration: 0.05, ease: "power2.out" }
                      : { scaleX: 1, opacity: 1, duration: 0.05, ease: "power2.out" }, 0.77 + i * 0.019);
      });
      tl.to(terminus, { opacity: 1, scale: 1, duration: 0.05, ease: "back.out(2.4)" }, 0.94)
        .to(liveText, { opacity: 1, y: 0, duration: 0.05, ease: "power2.out" }, 0.96);
    }

    // ── Wiring ───────────────────────────────────────────────────────────────
    addEventListener("resize", () => { buildPath(); sizeCanvases(); paint(); ScrollTrigger.refresh(); }, { passive: true });
    document.fonts?.ready.then(() => { buildPath(); sizeCanvases(); ScrollTrigger.refresh(); });

    if (!narrow && !still) {
      addEventListener("pointermove", (e) => {
        const r = stage.getBoundingClientRect();
        tx = ((e.clientX - r.left) / r.width - 0.5) * 2;
        ty = ((e.clientY - r.top) / r.height - 0.5) * 2;
      }, { passive: true });
    }

    const io = new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      if (onScreen) play(); else halt();
    }, { rootMargin: "160px" });
    io.observe(stage);

    document.addEventListener("visibilitychange", () => { if (document.hidden) halt(); else play(); });
    paint();
  }
</script>
