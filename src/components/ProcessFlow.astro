---
interface Step { n: string; label: string; line: string }
interface Props { steps: Step[]; typed: string; rows: string[]; lang: "en" | "de" }
const { steps, typed, rows, lang } = Astro.props;
const c = (en: string, de: string) => lang === "de" ? de : en;
const previews = [
  { label: "BRIDGE", src: "/cases/rodion-belousov-bridge-consult-ai-assisted-web-development-case-study.webp" },
  { label: "FIDIC", src: "/cases/rodion-belousov-fidic-uz-contract-knowledge-platform-design.webp" },
  { label: "SPATIAL", src: "/portfolio/rodion-belousov-luxury-interior-lighting-3d-visualization.webp" },
];
---

<div class="pv" data-process-flow>
  <div class="pv-stage" data-pv-stage>
    <svg class="pv-field" viewBox="0 0 1600 660" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs><radialGradient id="process-fade"><stop stop-color="white"/><stop offset="1" stop-color="black"/></radialGradient><mask id="process-mask"><rect width="1600" height="660" fill="url(#process-fade)"/></mask></defs>
      <g mask="url(#process-mask)" fill="none" stroke="currentColor" stroke-width=".65">
        {Array.from({ length: 34 }, (_, i) => <ellipse cx={250 + i * 14} cy={410 - i * 3} rx={80 + i * 20} ry={48 + i * 15} transform={`rotate(-24 ${250 + i * 14} ${410 - i * 3})`}/>)}
        {Array.from({ length: 30 }, (_, i) => <ellipse cx={1290 - i * 8} cy={320 + i * 3} rx={64 + i * 17} ry={48 + i * 16} transform={`rotate(30 ${1290 - i * 8} ${320 + i * 3})`}/>)}
      </g>
    </svg>
    <span class="pv-halo pv-halo--write" aria-hidden="true"></span>
    <span class="pv-halo pv-halo--scope" aria-hidden="true"></span>
    <span class="pv-halo pv-halo--launch" aria-hidden="true"></span>
    <svg class="pv-current" data-pv-svg aria-hidden="true" preserveAspectRatio="none">
      {Array.from({ length: 9 }, (_, i) => <path class:list={["pv-strand", { "pv-filament": i === 4 }]} data-flow-strand={i} pathLength="1000" fill="none"/>)}
      <circle class="pv-traveller" r="3" cx="0" cy="0"/>
      <path class="pv-pulse" data-flow-pulse pathLength="1000" fill="none"/>
      <path class="pv-pulse pv-pulse--second" data-flow-pulse pathLength="1000" fill="none"/>
    </svg>
    <svg class="pv-current pv-current--front" data-pv-front aria-hidden="true" preserveAspectRatio="none">
      <path class="pv-front-strand" data-flow-front pathLength="1000" fill="none"/>
      <path class="pv-pulse" data-flow-front pathLength="1000" fill="none"/>
    </svg>
    <div class="pv-dust" aria-hidden="true">{Array.from({ length: 18 }, (_, i) => <i style={`left:${(i * 37 + 11) % 100}%;top:${(i * 23 + 9) % 100}%;animation-delay:-${i * .7}s`}/>)}</div>

    <div class="pv-node pv-write">
      <div class="pv-step"><span aria-hidden="true">{steps[0].n}</span><h3>{steps[0].label.toLowerCase()}</h3></div>
      <div class="pv-message pv-glass" data-flow-object="write">
        <span class="pv-typed" aria-label={typed}><span class="pv-type-ink" aria-hidden="true">{typed}</span></span>
        <span class="pv-send" aria-hidden="true"><span class="pv-shockwave"></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="m4 11 16-7-6 17-3-7-7-3Z"/><path d="m11 14 9-10"/></svg></span>
      </div>
      <p class="pv-caption">{steps[0].line}</p>
    </div>

    <div class="pv-node pv-scope">
      <div class="pv-step"><span aria-hidden="true">{steps[1].n}</span><h3>{steps[1].label.toLowerCase()}</h3></div>
      <div class="pv-sheet pv-glass" data-flow-object="scope">
        <div class="pv-sheet-heading"><span>RB / {c("PROJECT BRIEF", "PROJEKTBRIEFING")}</span><span>02</span></div>
        {rows.map((row, i) => <div class="pv-row">
          <svg class="pv-row-icon" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            {i === 0 ? <><path d="M6 3h11l5 5v17H6Z M17 3v6h5 M10 13h8 M10 17h8 M10 21h5"/></> : i === 1 ? <><ellipse cx="14" cy="6" rx="9" ry="4"/><path d="M5 6v15c0 5 18 5 18 0V6 M5 11c0 5 18 5 18 0 M5 16c0 5 18 5 18 0"/></> : <><rect x="4" y="6" width="20" height="18" rx="2"/><path d="M4 12h20 M9 3v6 M19 3v6 M9 17h3 M16 17h3 M9 21h3"/></>}
          </svg>
          <div class="pv-row-copy"><span>{row}</span><i></i><i></i></div>
          <span class="pv-check" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width=".85"><circle class="pv-check-ring" cx="10" cy="10" r="9" pathLength="1"/><path class="pv-check-mark" d="m5 10 3 3 7-8" pathLength="1"/></svg></span>
        </div>)}
      </div>
      <p class="pv-caption">{steps[1].line}</p>
    </div>

    <div class="pv-node pv-launch">
      <div class="pv-step"><span aria-hidden="true">{steps[2].n}</span><h3>{steps[2].label.toLowerCase()}</h3></div>
      <div class="pv-browser pv-glass" data-flow-object="launch" role="img" aria-label={c("A finished website: clear typography, a sculpted sphere and three selected projects.", "Eine fertige Website: klare Typografie, eine skulpturale Kugel und drei ausgewählte Projekte.")}>
        <svg class="pv-frame" aria-hidden="true"><rect x="1" y="1" width="100%" height="100%" rx="16" pathLength="1"/></svg>
        <div class="pv-chrome" aria-hidden="true"><span><i></i><i></i><i></i></span><span class="pv-live"><i></i>LIVE</span></div>
        <div class="pv-site" aria-hidden="true">
          <div class="pv-nav"><span>RB® STUDIO</span><span>— &nbsp; 2026</span></div>
          <div class="pv-site-hero">
            <div class="pv-sphere"><span class="pv-sphere-light"></span></div>
            <span class="pv-site-kicker">{c("IDEAS INTO EXPERIENCES", "IDEEN WERDEN ERLEBNISSE")}</span>
            <p>{c("Clear thinking.", "Klar gedacht.")}<br/><span>{c("Made tangible.", "Stark gemacht.")}</span></p>
            <span class="pv-site-link">{c("Explore the work", "Projekte entdecken")} <svg class="pv-arrow" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 8.5 8.5 3.5M4.6 3.5h3.9v3.9"/></svg></span>
          </div>
          <div class="pv-projects">{previews.map(({ label, src }) => <div><img src={src} alt="" width="150" height="90" loading="lazy" decoding="async"/><span>{label}<svg class="pv-arrow" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 8.5 8.5 3.5M4.6 3.5h3.9v3.9"/></svg></span></div>)}</div>
        </div>
      </div>
      <p class="pv-caption">{steps[2].line}</p>
    </div>
    <span class="pv-terminus" data-flow-end aria-hidden="true"></span>
  </div>
</div>

<style>
  .pv { width: min(1600px, calc(100vw - 4rem)); margin: 2rem 0 0; margin-left: calc((100% - min(1600px, calc(100vw - 4rem))) / 2); color: #eef1f5; }
  .pv-stage { position: relative; height: clamp(650px, 45vw, 720px); isolation: isolate; }
  .pv-field, .pv-current, .pv-dust { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .pv-field { color: #9eacbb; opacity: .24; z-index: -2; }
  .pv-halo { position: absolute; width: 42%; aspect-ratio: 1; pointer-events: none; background: radial-gradient(ellipse, rgba(190,205,225,.12), transparent 66%); z-index: -1; }
  .pv-halo--write { left: 0; top: 15%; opacity: .55; }
  .pv-halo--scope { left: 29%; top: 0; }
  .pv-halo--launch { right: 0; top: 9%; opacity: .75; }
  .pv-current { z-index: 1; overflow: visible; }
  .pv-current--front { z-index: 5; opacity: .45; }
  .pv-front-strand { stroke: #d5e2f3; stroke-width: .65; filter: drop-shadow(0 0 4px #a6bad7); }
  .pv-current--front .pv-pulse { animation-delay: -5s; stroke-width: 1.2; }
  .pv-traveller { fill: #fff; opacity: 0; filter: drop-shadow(0 0 6px #eff5ff) drop-shadow(0 0 12px #a9bad1); }
  .pv-typed { flex: 1; min-width: 0; display: block; }
  .pv-type-ink { display: block; }
  .pv-type-ink :global(.pv-word) { display: inline-block; white-space: nowrap; }
  .pv-type-ink :global(.pv-letter) { position: relative; }
  .pv-type-ink :global(.pv-letter.is-caret)::after { content: ""; position: absolute; left: 100%; top: .05em; height: .9em; border-left: 1px solid #e8eff9; pointer-events: none; opacity: var(--caret, 0); }
  .pv-send { position: relative; }
  .pv-shockwave { position: absolute; inset: -1px; border-radius: 50%; border: 1px solid #d5e5fa; opacity: 0; pointer-events: none; }
  .pv-glass::after { content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; background: radial-gradient(ellipse at calc(var(--light-x, 35%) + var(--pointer-x, 0%)) calc(var(--light-y, 15%) + var(--pointer-y, 0%)), #e2edff18, transparent 58%); opacity: calc(var(--reflection, .12) + var(--pointer-reflection, 0)); }
  .pv-sheet::before { content: ""; position: absolute; inset: 5px; border: 1px solid #d2e2f70c; border-radius: 15px; pointer-events: none; box-shadow: inset 0 1px 0 #edf4ff16; }
  .pv-row { position: relative; overflow: hidden; }
  .pv-row::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(110deg, transparent 15%, #e8f1ff12 47%, transparent 75%); transform: translateX(var(--row-sheen, -110%)); }
  .pv-row-copy i { transform-origin: left; }
  .pv-check-ring, .pv-check-mark { stroke-dasharray: 1; stroke-dashoffset: 0; }
  .pv-frame { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 5; }
  .pv-frame rect { width: calc(100% - 2px); height: calc(100% - 2px); fill: none; stroke: #e1edff; stroke-width: 1; stroke-dasharray: 1; stroke-dashoffset: 0; opacity: .38; }
  .pv-sphere-light { position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(ellipse at 35% 22%,#ebf3ff21,transparent 38%); }
  .pv-strand { stroke: #c1d0e3; stroke-width: .6; opacity: .22; }
  .pv-filament { stroke: #e9f1ff; stroke-width: 1; opacity: .75; filter: drop-shadow(0 0 5px #a6bad7); }
  .pv-pulse { stroke: #fff; stroke-width: 2.2; stroke-linecap: round; stroke-dasharray: 2 998; filter: drop-shadow(0 0 6px #d3e0f3); animation: pv-travel 8s linear infinite; animation-play-state: paused; }
  .pv-pulse--second { stroke-width: 1.4; animation-delay: -3.4s; }
  .pv.is-visible:not(.is-sequenced) .pv-pulse, .pv.is-visible.is-complete .pv-pulse, .pv.is-visible .pv-dust i { animation-play-state: running; }
  .pv.is-sequenced:not(.is-complete) .pv-pulse { opacity: 0; }
  .pv-dust { z-index: 2; }
  .pv-dust i { position: absolute; width: 2px; height: 2px; border-radius: 50%; background: #d7e2ef; opacity: .35; box-shadow: 0 0 5px #aabbd2; animation: pv-drift 9s ease-in-out infinite alternate paused; }
  .pv-node { position: absolute; z-index: 3; }
  .pv-write { left: 1%; top: 45%; width: 28%; }
  .pv-scope { left: 32%; top: 22%; width: 34%; z-index: 4; }
  .pv-launch { left: 70%; top: 34%; width: 28%; }
  .pv-step { position: absolute; bottom: calc(100% + 24px); left: 5%; }
  .pv-step > span { position: absolute; bottom: -34px; left: -5px; font: 500 clamp(90px, 9.5vw, 150px)/1 var(--font-inter, sans-serif); letter-spacing: -.07em; color: rgba(225,235,250,.025); -webkit-text-stroke: 1px rgba(218,229,242,.58); text-shadow: 0 0 24px rgba(208,225,249,.08); z-index: -1; }
  .pv-step h3 { margin: 0; font-size: clamp(18px, 1.6vw, 25px); font-weight: 400; letter-spacing: -.02em; transform: translateY(17px); text-shadow: 0 2px 15px #000; }
  .pv-glass { position: relative; border: 1px solid rgba(206,222,242,.58); background: linear-gradient(145deg, rgba(231,239,253,.15), transparent 30%), linear-gradient(165deg,#20252c 0%,#0b0e12 48%,#14191f 100%); box-shadow: inset 0 1px 1px rgba(255,255,255,.4), inset 0 -1px 2px rgba(196,216,242,.16), 0 25px 45px -18px #000, 0 0 28px -12px rgba(191,212,242,.32); }
  .pv-message { display: flex; align-items: center; gap: 16px; min-height: 82px; padding: 14px 16px 14px 28px; border-radius: 999px; box-shadow: inset -3px 0 13px rgba(211,229,255,.3), inset 0 1px 1px rgba(255,255,255,.35), 0 18px 28px -12px #000, 5px 0 20px -8px #b5c9e9; }
  .pv-message > span:first-child { font-size: clamp(12px, 1vw, 16px); line-height: 1.5; color: #d2d5db; }
  .pv-send { flex: 0 0 44px; height: 44px; display: grid; place-items: center; margin-left: auto; border-radius: 50%; border: 1px solid #bbc9da; background: linear-gradient(135deg,#0e131a,#303b49); box-shadow: 0 0 13px #b0c6e333; }
  .pv-send svg { width: 22px; height: 22px; display: block; overflow: visible; }
  .pv-sheet { padding: 22px; border-radius: 20px; transform: perspective(1400px) rotateY(-7deg) rotateZ(-3deg); }
  .pv-sheet-heading { display: flex; justify-content: space-between; margin: 0 3px 15px; font: 9px/1.5 var(--font-mono,monospace); letter-spacing: .14em; color: #a7b3c2; }
  .pv-row { display: grid; grid-template-columns: 32px 1fr 34px; gap: 18px; align-items: center; padding: 20px 17px; border: 1px solid rgba(196,212,235,.1); border-radius: 13px; background: linear-gradient(115deg,rgba(208,221,241,.085),rgba(80,97,121,.04)); box-shadow: inset 0 1px 0 #ffffff05,0 8px 14px -10px #000; }
  .pv-row + .pv-row { margin-top: 12px; }
  .pv-row-icon { width: 28px; }
  .pv-row-copy > span { display: block; margin-bottom: 10px; font-size: clamp(13px,1.1vw,17px); }
  .pv-row-copy i { display: block; width: 65%; height: 3px; margin-top: 6px; background: #929dac30; }
  .pv-row-copy i:last-child { width: 39%; opacity: .6; }
  .pv-check { width: 32px; height: 32px; border-radius: 50%; border: 1px solid #a8b8cd; display: grid; place-items: center; box-shadow: inset 0 0 10px #a0b9db16; }
  .pv-check { position: relative; border: 0; color: #eff6ff; }
  .pv-check::after { content: ""; position: absolute; inset: -3px; border-radius: 50%; box-shadow: 0 0 13px #c5ddff66, inset 0 0 9px #dfedff20; opacity: var(--check-glow, 1); pointer-events: none; }
  .pv-check svg { width: 100%; height: 100%; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 0 3px rgba(206,229,255,calc(var(--check-glow, 1) * .75))); }
  .pv-browser { border-radius: 17px; overflow: hidden; transform: perspective(1400px) rotateY(-8deg) rotateZ(2deg); }
  .pv-chrome { height: 32px; padding: 0 14px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #bdcee51a; background: linear-gradient(110deg,#30394570,#10151c); }
  .pv-chrome > span:first-child { display: flex; gap: 5px; }
  .pv-chrome i { display: block; width: 4px; height: 4px; background: #a7b5c5; border-radius: 50%; }
  .pv-live { display: flex; gap: 5px; align-items: center; font: 7px/1 var(--font-mono,monospace); letter-spacing: .13em; }
  .pv-live i { background: white; box-shadow: 0 0 5px #dfeafa; }
  .pv-site { padding: 17px; background: radial-gradient(ellipse at 85% 40%,#202a3759,transparent 55%),#06090d; }
  .pv-nav { display: flex; justify-content: space-between; position: relative; z-index: 2; color: #c8ced8; font: 7px/1.3 var(--font-mono,monospace); letter-spacing: .12em; }
  .pv-site-hero { position: relative; padding: 29px 0 25px; isolation: isolate; }
  .pv-site-kicker { font: 6px/1.4 var(--font-mono,monospace); letter-spacing: .12em; color: #a5b1c2; }
  .pv-site-hero > p { position: relative; z-index: 1; font-size: clamp(18px,1.8vw,29px); line-height: 1.14; letter-spacing: -.045em; margin: 12px 0 17px; font-weight: 500; }
  .pv-site-hero > p > span { color: #a3acb9; }
  .pv-site-link { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 10px; font-size: 8px; border-bottom: 1px solid #b7c5d780; padding-bottom: 5px; white-space: nowrap; }
  .pv-arrow { width: 1.05em; height: 1.05em; flex: none; }
  .pv-sphere { position: absolute; width: 54%; aspect-ratio: 1; right: -7%; top: 14%; border-radius: 50%; background: radial-gradient(ellipse at 31% 24%,#d2dbe6 0%,#647181 4%,#202a37 14%,#080c13 39%,#010207 65%); box-shadow: inset -1px 1px 1px #e9f2ff, inset -7px 5px 12px #829bc160, 6px -4px 20px #b1c8ea16; transform: rotate(-22deg); }
  .pv-sphere::after { content: ""; position: absolute; inset: 20% -25%; border: 1px solid #b6c7df40; border-radius: 50%; transform: rotate(-18deg); }
  .pv-projects { position: relative; display: grid; grid-template-columns: repeat(3,1fr); gap: 7px; z-index: 1; }
  .pv-projects > div { min-width: 0; border-radius: 5px; overflow: hidden; border: 1px solid #a4b7d021; background: #10151c; }
  .pv-projects img { width: 100%; height: 47px; object-fit: cover; filter: grayscale(1); opacity: .8; }
  .pv-projects span { display: flex; align-items: center; justify-content: space-between; padding: 7px 6px; font: 6px/1 var(--font-mono,monospace); letter-spacing: .06em; }
  .pv-projects i { font-style: normal; }
  .pv-caption { max-width: 32ch; margin: 26px 5% 0; color: #aeb6c2; font-size: clamp(12px,1vw,15px); line-height: 1.6; text-wrap: pretty; }
  .pv-scope .pv-caption { margin-top: 32px; }
  .pv-terminus { position: absolute; right: -.25%; top: 59%; width: 8px; height: 8px; border-radius: 50%; background: #f5f8ff; box-shadow: 0 0 10px #eef5ff,0 0 24px #a6bad7,0 0 45px #a6bad775; z-index: 4; }
  .pv-terminus::before, .pv-terminus::after { content: ""; position: absolute; inset: -13px; border: 1px solid #b6c8e23d; border-radius: 50%; }
  .pv-terminus::after { inset: -27px; border-color: #b6c8e21c; }
  @keyframes pv-travel { to { stroke-dashoffset: -1000; } }
  @keyframes pv-drift { to { transform: translate(5px,-12px); opacity: .8; } }
  @keyframes pv-orbit { to { transform: rotate(360deg); } }
  @keyframes pv-breathe { to { opacity: .65; } }
  @keyframes pv-field-drift { to { transform: translate(3px,-3px) rotate(.25deg); } }
  @media (min-width: 1041px) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .pv.is-visible.is-complete .pv-sphere-light { animation: pv-orbit 55s linear infinite; }
    .pv.is-visible.is-complete .pv-sphere::after { animation: pv-orbit 85s linear infinite; }
    .pv.is-visible.is-complete .pv-terminus { animation: pv-breathe 4.5s ease-in-out infinite alternate; }
    .pv.is-visible.is-complete .pv-field g { transform-origin: center; animation: pv-field-drift 28s ease-in-out infinite alternate; }
  }
  @media (max-width: 1040px) {
    .pv { width: 100%; margin: 4rem 0 0; }
    .pv-stage { height: auto; display: grid; gap: 100px; padding: 40px 0 50px; }
    .pv-node { position: relative; left: auto; top: auto; width: 87%; max-width: 470px; }
    .pv-scope { width: 91%; justify-self: center; }
    .pv-launch { justify-self: end; }
    .pv-step { bottom: calc(100% + 13px); }
    .pv-step > span { font-size: 95px; }
    .pv-step h3 { font-size: 21px; transform: translateY(10px); }
    .pv-message { min-height: 78px; padding-left: 22px; }
    .pv-message > span:first-child { font-size: 14px; }
    .pv-row-copy > span { font-size: 16px; }
    .pv-caption { font-size: 14px; margin-top: 21px; }
    .pv-site-hero > p { font-size: 29px; }
    .pv-site { padding: 19px; }
    .pv-site-hero { padding: 29px 0; }
    .pv-projects img { height: 60px; }
    /* These two were never scaled with the rest of the preview: 8px and 6px on
       a phone, next to a 29px headline. */
    .pv-site-link { font-size: 12px; gap: 9px; padding-bottom: 6px; }
    .pv-projects span { font-size: 9px; padding: 9px 8px; }
    .pv-field { opacity: .19; }
    .pv-halo { width: 100%; left: 0; }
    .pv-halo--write { top: -4%; }
    .pv-halo--scope { top: 30%; }
    .pv-halo--launch { top: 64%; }
    .pv-terminus { right: 9%; top: auto; bottom: 0; }
  }
  @media (max-width: 480px) {
    .pv-stage { gap: 90px; }
    .pv-message { min-height: 78px; padding: 12px 12px 12px 18px; gap: 10px; }
    .pv-message > span:first-child { font-size: 12px; }
    .pv-send { flex-basis: 35px; height: 35px; }
    .pv-sheet { padding: 15px; border-radius: 17px; }
    .pv-sheet-heading { font-size: 7px; }
    .pv-row { grid-template-columns: 25px 1fr 27px; gap: 12px; padding: 16px 12px; }
    .pv-row-icon { width: 24px; }
    .pv-row-copy > span { font-size: 14px; }
    .pv-check { width: 26px; height: 26px; }
    .pv-caption { font-size: 13px; }
    .pv-site { padding: 14px; }
    .pv-site-hero > p { font-size: 25px; }
    .pv-site-hero { padding: 24px 0; }
    .pv-projects img { height: 42px; }
    .pv-site-link { font-size: 11px; }
    .pv-projects span { font-size: 8px; padding: 8px 7px; }
  }
  /* ── Touch: keep the picture, drop what a phone GPU pays for ─────────────── */
  @media (max-width: 1040px), (pointer: coarse) {
    /* Flat, not perspective-projected — the single biggest cost in the scene. */
    .pv-sheet, .pv-browser { transform: none; }
    /* Plain strokes instead of filtered ones; the glow is compensated in the
       stroke itself, and nothing has to repaint a filter region per frame. */
    .pv-front-strand, .pv-traveller, .pv-filament, .pv-pulse, .pv-check svg { filter: none; }
    .pv-filament { opacity: .9; }
    .pv-front-strand { stroke-width: .8; }
    /* Continuous animation on a scene that is already scrubbing is where the
       frames actually go. The dust stays as atmosphere; it just holds still. */
    .pv-pulse { animation: none; }
    .pv-dust i { animation: none; box-shadow: none; }
    /* A 45px shadow blur across three large panels, rasterized on every step. */
    .pv-glass { box-shadow: inset 0 1px 1px rgba(255,255,255,.4), 0 14px 24px -14px #000; }
  }

  @media (prefers-reduced-motion: reduce) { .pv-pulse, .pv-dust i { animation: none; } }
  :global(html.rb-calm) .pv-pulse, :global(html.rb-calm) .pv-dust i,
  :global(html.rb-calm) .pv-sphere-light, :global(html.rb-calm) .pv-sphere::after,
  :global(html.rb-calm) .pv-terminus, :global(html.rb-calm) .pv-field g { animation: none !important; }
</style>

<script>
  import { setupProcessMotion } from "../utils/processMotion";
  function initProcessFlow() {
    document.querySelectorAll<HTMLElement>("[data-process-flow]").forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = "true";
      const stage = root.querySelector<HTMLElement>("[data-pv-stage]")!;
      const svg = root.querySelector<SVGSVGElement>("[data-pv-svg]")!;
      const foreground = root.querySelector<SVGSVGElement>("[data-pv-front]")!;
      const objects = ["write", "scope", "launch"].map((name) => root.querySelector<HTMLElement>(`[data-flow-object="${name}"]`)!);
      const end = root.querySelector<HTMLElement>("[data-flow-end]")!;
      let frame = 0;
      const draw = () => {
        frame = 0;
        const bounds = stage.getBoundingClientRect();
        const box = (el: HTMLElement) => {
          // Layout coordinates stay stable while the glass tilts or scales.
          const node = el.closest<HTMLElement>(".pv-node");
          return { x: el.offsetLeft + (node?.offsetLeft || 0), y: el.offsetTop + (node?.offsetTop || 0), w: el.offsetWidth, h: el.offsetHeight };
        };
        const [a, b, c] = objects.map(box);
        const e = box(end);
        svg.setAttribute("viewBox", `0 0 ${bounds.width} ${bounds.height}`);
        foreground.setAttribute("viewBox", `0 0 ${bounds.width} ${bounds.height}`);
        const path = (offset: number) => {
          if (matchMedia("(max-width: 1040px)").matches) {
            const right = Math.min(bounds.width - 4, a.x + a.w + 20 + offset);
            return `M ${a.x+a.w*.8} ${a.y+a.h*.5} C ${right} ${a.y+a.h+65}, ${b.x+20+offset} ${b.y-55}, ${b.x+b.w*.5} ${b.y+b.h*.5} S ${c.x+c.w-15+offset} ${c.y-45}, ${c.x+c.w*.8} ${c.y+c.h*.5} S ${e.x+offset} ${e.y-35}, ${e.x+4} ${e.y+4}`;
          }
          return `M ${a.x+a.w-15} ${a.y+a.h*.5} C ${a.x+a.w+70} ${a.y+a.h*.5+offset}, ${b.x-65} ${b.y+b.h*.6+offset}, ${b.x+b.w*.5} ${b.y+b.h*.55} S ${c.x-85} ${c.y+c.h*.65+offset}, ${c.x+c.w*.48} ${c.y+c.h*.57} S ${e.x-35} ${e.y+offset}, ${e.x+4} ${e.y+4}`;
        };
        root.querySelectorAll<SVGPathElement>("[data-flow-strand]").forEach((strand, i) => strand.setAttribute("d", path((i - 4) * 9)));
        root.querySelectorAll<SVGPathElement>("[data-flow-pulse]").forEach((pulse) => pulse.setAttribute("d", path(0)));
        // A fine reflection crosses the lower rim; the main current stays behind
        // the glass. Keep the reflection clear of the text inside both objects.
        const front = matchMedia("(max-width: 1040px)").matches
          ? `M ${b.x+b.w*.84} ${b.y+b.h*.98} C ${b.x+b.w*.96} ${b.y+b.h+28}, ${c.x+c.w*.96} ${c.y-25}, ${c.x+c.w*.99} ${c.y+20}`
          : `M ${b.x+b.w*.86} ${b.y+b.h*.97} C ${b.x+b.w+30} ${b.y+b.h+12}, ${c.x-25} ${c.y+c.h*.85}, ${c.x+3} ${c.y+c.h*.74}`;
        root.querySelectorAll<SVGPathElement>("[data-flow-front]").forEach((strand) => strand.setAttribute("d", front));
        root.dispatchEvent(new Event("pv:geometry"));
      };
      const schedule = () => { if (!frame) frame = requestAnimationFrame(draw); };
      const resize = new ResizeObserver(schedule);
      resize.observe(stage);
      objects.forEach((el) => resize.observe(el));
      const visibility = new IntersectionObserver(([entry]) => root.classList.toggle("is-visible", entry.isIntersecting), { rootMargin: "80px" });
      visibility.observe(stage);
      draw();
      const disposeMotion = setupProcessMotion(root);
      document.fonts.ready.then(schedule);
      document.addEventListener("astro:before-swap", () => { disposeMotion(); resize.disconnect(); visibility.disconnect(); cancelAnimationFrame(frame); }, { once: true });
    });
  }
  initProcessFlow();
  document.addEventListener("astro:page-load", initProcessFlow);
</script>
