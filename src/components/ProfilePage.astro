---
// ─────────────────────────────────────────────────────────────────────────────
//  ProfilePage.astro — /en/rodion-belousov-vienna/ and /de/rodion-belousov-wien/
//
//  This used to be the home page again: the same career rows, the same work
//  cards, the same service list, restated with nothing added. A visitor who had
//  already scrolled the home page learned nothing by opening it, and it made
//  the site look like it was padding for search.
//
//  It has one job now that no other page does — answering the question someone
//  actually arrives with. Not "is he good", which the rest of the site argues
//  at length, but "would he take MY job, and how long would it take". So the
//  page leads with a scope picker: pick the size of the thing you need, from a
//  single landing page upward, and get the timeline, what is included, what I
//  need from you, and the closest real piece of work. The lattice behind it
//  lights up in proportion, so the picture states the same thing as the copy.
//
//  That ordering is deliberate. The smallest, fastest, cheapest job is the
//  first thing on the page, because the site's whole risk is reading as a
//  studio that only takes elaborate WebGL commissions. It takes ordinary work,
//  and this is where it says so.
//
//  The professional record stays — it is why the page ranks for the name and
//  what a hiring reader came for — but the duplicated work and service blocks
//  are gone, replaced by one line pointing at the pages that own them.
//
//  Both languages live in this one component; the route decides which. It is
//  lockLang, which means it states its own language and must never write that
//  into the visitor's stored preference.
// ─────────────────────────────────────────────────────────────────────────────
import Layout from "../layouts/Layout.astro";
import ScopeField from "./ScopeField.astro";
import ScopePicker from "./ScopePicker.astro";
import ProcessFlow from "./ProcessFlow.astro";
import { useTranslations, type Lang, type UIKey } from "../i18n/utils";
import { formatPrice } from "../data/pricing";

interface Props { lang: Lang }
const { lang } = Astro.props;
const de = lang === "de";
const t = useTranslations(lang);
const tk = (key: string) => t(key as UIKey);
const c = (en: string, deText: string) => (de ? deText : en);

const paths = { en: "/en/rodion-belousov-vienna/", de: "/de/rodion-belousov-wien/" };
const title = c(
  "Rodion Belousov — Websites & Video in Vienna | SEO, Reels, 3D",
  "Rodion Belousov — Websites & Video in Wien | SEO, Reels, 3D",
);
const description = c(
  "Rodion Belousov in Vienna: landing pages, business websites, shorts, reels, video editing, technical SEO, 3D and web platforms — with timelines and starting prices.",
  "Rodion Belousov in Wien: Landingpages, Unternehmens-Websites, Shorts, Reels, Videoschnitt, Technical SEO, 3D und Web-Plattformen — mit Zeitrahmen und Startpreisen.",
);

// ── The scope picker ─────────────────────────────────────────────────────────
// Ordered smallest first, on purpose. `field` is the share of the lattice that
// scope lights, so the picture scales with the job.
// NOTE (Rodion): these are starting prices, not quotes — the promise the
// process scene makes two sections below is that the real number is fixed
// within a day, once the scope is known. They sit deliberately under a Vienna
// agency (which asks 3–8k for a small business site) and under a mid-level
// local freelancer, because the job right now is to get the enquiry, not to
// win the margin. Change any of them here and the panel re-renders itself.

// Four numbers the rest of the site evidences. They are here because the hero
// is where someone decides whether to keep reading, and a claim with a figure
// on it survives that decision better than a paragraph.
const facts = [
  { v: "+780", suffix: "%", k: c("organic search after launch", "organische Suche nach Launch") },
  { v: "429", suffix: "", k: c("pages, FIDIC platform", "Seiten, FIDIC-Plattform") },
  { v: "2 900", suffix: "+", k: c("tenders, refreshed daily", "Ausschreibungen, täglich aktualisiert") },
  { v: "03", suffix: "", k: c("languages in one content system", "Sprachen in einem Content-System") },
];

const experience = [1, 2, 3];
const education = [1, 2, 3];

// Proof under each role, because a CV row is a claim and these three are the
// only ones on the page that can be checked in a click: the two case studies
// written about the Bridge Consult work, the Siemens video series, and the
// Awaken Trees film. They used to sit on the home page's career list; that
// list is gone and the links went with it, which left the record here as
// three paragraphs asking to be taken at their word.
const jobLinks: Record<number, Array<{ href: string; key: string; external?: boolean }>> = {
  1: [
    { href: "/work/bridge-consult/", key: "exp.1.link" },
    { href: "/work/fidic/", key: "exp.1.link2" },
  ],
  2: [{ href: "https://www.youtube.com/@WinCCOA/playlists", key: "exp.2.link", external: true }],
  3: [{ href: "https://www.youtube.com/watch?v=cC-eCQHxzyA", key: "exp.3.link", external: true }],
};

const steps = [
  { n: "01", label: c("WRITE", "SCHREIBEN"), line: c("Tell me what you need and when.", "Sagen Sie mir, was Sie brauchen — und bis wann.") },
  { n: "02", label: c("SCOPE", "UMFANG"), line: c("Scope, price and launch date — fixed within a day.", "Umfang, Preis und Launch-Termin — innerhalb eines Tages vereinbart.") },
  { n: "03", label: c("LAUNCH", "LAUNCH"), line: c("Review it live while it is built.", "Die Website live mitverfolgen, während sie entsteht.") },
];

const breadcrumbs = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Rodion Belousov Studio", item: "https://rodionbelousov.studio/" },
    { "@type": "ListItem", position: 2, name: c("Profile & experience", "Profil & Berufserfahrung"), item: `https://rodionbelousov.studio${paths[lang]}` },
  ],
};
---

<Layout
  lang={lang}
  lockLang
  alternateUrls={{ ...paths, "x-default": paths.en }}
  title={title}
  description={description}
  pageType="profile"
  structuredData={breadcrumbs}
  {/* Separate DE and EN URLs, so the poster a crawler sees can be in the
      language of the link that was pasted. Built by `npm run og`. */}
  image={`/og/profile-vienna-${lang}.jpg`}
  imageAlt={lang === "de"
    ? "Rodion Belousov — Websites, Reels, Video und SEO in Wien"
    : "Rodion Belousov — websites, reels, video and SEO in Vienna"}
  noWebgl
>
  <div class="pf">
    <div class="pf-stage">
      <ScopeField />
      <article class="u-container pf-inner">
        <header class="pf-hero">
          <span class="pf-kicker">{c("VIENNA, AUSTRIA · INTERNATIONAL / REMOTE", "WIEN, ÖSTERREICH · INTERNATIONAL / REMOTE")}</span>
          <h1 class="pf-title" data-sy-reveal="words">Rodion Belousov <span>{c("in Vienna.", "in Wien.")}</span></h1>
          <p class="pf-lead" data-sy-reveal="lines">{c(
            "I build websites and make video in Vienna — from one short, reel or landing page in a few days to a 429-page platform or a full 3D production. Small jobs are explicitly welcome: one clean edit, one page or one search fix is a complete project here, not a sales step toward a larger one.",
            "Ich baue Websites und produziere Video in Wien — vom einzelnen Short, Reel oder einer Landingpage in wenigen Tagen bis zur Plattform mit 429 Seiten oder einer kompletten 3D-Produktion. Kleine Aufträge sind ausdrücklich willkommen: Ein sauberer Schnitt, eine Seite oder ein Search-Fix ist hier ein vollständiges Projekt — kein Verkaufsschritt zu einem größeren.",
          )}</p>

          <div class="pf-actions" data-reveal>
            <a class="pf-btn primary" href={de ? "/de/kontakt/" : "/contact/"} data-magnetic>
              <span>{c("Get a fixed quote", "Festes Angebot anfragen")}</span><i class="ui-arrow" aria-hidden="true"></i>
            </a>
            <a class="pf-btn ghost" href="#scope" data-magnetic>
              <span>{c("What do you need?", "Was brauchen Sie?")}</span><i class="ui-arrow ui-arrow-down" aria-hidden="true"></i>
            </a>
          </div>

          <dl class="pf-facts" data-reveal>
            {facts.map((f) => (
              <div>
                <dt><span>{f.v}</span>{f.suffix && <em>{f.suffix}</em>}</dt>
                <dd>{f.k}</dd>
              </div>
            ))}
          </dl>
        </header>

      <!-- ── 01 · Scope picker ──────────────────────────────────────────── -->
      <section class="pf-section" id="scope" aria-labelledby="scope-title">
        <span class="pf-idx">01 — {c("SCOPE", "UMFANG")}</span>
        <div class="pf-body">
          <h2 id="scope-title" data-sy-reveal="words">{c("What do you actually need?", "Was brauchen Sie wirklich?")}</h2>
          <p class="pf-sub" data-reveal>{c(
            "Pick the size of the job and see the shape of it — how long, from how much, what you end up with. The full breakdown of any one of them is a click away.",
            "Wählen Sie die Größe des Projekts und sehen Sie, worauf es hinausläuft — wie lange, ab wie viel, was am Ende steht. Die vollen Leistungen sind einen Klick entfernt.",
          )}</p>

          <ScopePicker lang={lang} variant="compact" />

        </div>
      </section>
      </article>
    </div>

    <article class="u-container pf-inner">
      <!-- ── 02 · How it works ─────────────────────────────────────────── -->
      <section class="pf-section pf-process" aria-labelledby="process-title">
        <span class="pf-idx">02 — {c("PROCESS", "ABLAUF")}</span>
        <div class="pf-body">
          <h2 id="process-title" data-sy-reveal="words">{c("What happens after you write.", "Was passiert, nachdem Sie schreiben.")}</h2>
          <ProcessFlow
            lang={lang}
            steps={steps}
            typed={c("I need a website for my project…", "Ich brauche eine Website für mein Projekt…")}
            rows={[c("Scope", "Umfang"), c("Price", "Preis"), c("Launch date", "Launch-Termin")]}
          />
        </div>
      </section>

      <!-- ── 03 · The record ───────────────────────────────────────────── -->
      <section class="pf-section" id="experience" aria-labelledby="experience-title">
        <span class="pf-idx">03 — {c("EXPERIENCE", "BERUFSERFAHRUNG")}</span>
        <div class="pf-body">
          <h2 id="experience-title" data-sy-reveal="words">{c("Professional experience", "Berufserfahrung")}</h2>
          <ol class="pf-rows" data-career-timeline>
            {experience.map((n) => (
              <li>
                <span class="pf-track" aria-hidden="true"><span></span></span>
                <span class="pf-dot" aria-hidden="true"></span>
                <span class="pf-period">{tk(`exp.${n}.period`)}</span>
                <div>
                  <h3>{tk(`exp.${n}.company`)}</h3>
                  <p class="pf-role">{tk(`exp.${n}.role`)}</p>
                  <p>{tk(`exp.${n}.text`)}</p>
                  {jobLinks[n] && (
                    <p class="pf-proof">
                      {jobLinks[n].map((link) => (
                        <a
                          href={link.href}
                          target={link.external ? "_blank" : undefined}
                          rel={link.external ? "noopener" : undefined}
                          data-case-exit={link.external ? undefined : true}
                          data-cursor={link.external ? "WATCH" : "READ"}
                        >
                          {tk(link.key)}
                          <span class="css-arrow css-arrow-up" aria-hidden="true"></span>
                        </a>
                      ))}
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ol>
          <p class="pf-langs" data-reveal><span>{t("edu.langs.label")}</span>{t("edu.langs.value")}</p>
        </div>
      </section>

      <!-- ── 04 · Education ────────────────────────────────────────────── -->
      <section class="pf-section" aria-labelledby="education-title">
        <span class="pf-idx">04 — {c("EDUCATION", "AUSBILDUNG")}</span>
        <div class="pf-body">
          <h2 id="education-title" data-sy-reveal="words">{c("Education & tools", "Ausbildung & Werkzeuge")}</h2>
          <div class="pf-cards three">
            {education.map((n) => (
              <article data-reveal>
                <span class="pf-meta">{tk(`edu.${n}.period`)}</span>
                <h3>{tk(`edu.${n}.degree`)}</h3>
                <p>{tk(`edu.${n}.school`)}</p>
              </article>
            ))}
          </div>
          <p class="pf-langs" data-reveal><span>{t("edu.stack.label")}</span>{t("edu.stack.value")}</p>
        </div>
      </section>

      <!-- The work and the services have their own pages. Repeating them here
           is what made this page a duplicate of the home page in the first
           place, so it points at them instead of restating them. -->
      <nav class="pf-elsewhere" data-reveal aria-label={c("Elsewhere on this site", "Weiter auf dieser Website")}>
        <a href="/#work"><span>{c("Selected work", "Ausgewählte Arbeiten")}</span><i class="ui-arrow" aria-hidden="true"></i></a>
        <a href={de ? "/de/leistungen/" : "/services/"}><span>{c("Services in detail", "Leistungen im Detail")}</span><i class="ui-arrow" aria-hidden="true"></i></a>
        <a href="/notes/"><span>{c("What broke, and why", "Was kaputtging, und warum")}</span><i class="ui-arrow" aria-hidden="true"></i></a>
      </nav>

      <section class="pf-outro" data-reveal>
        <p>{c(
          "Open to projects of any size — in Vienna, across Austria or remote.",
          "Offen für Projekte jeder Größe — in Wien, österreichweit oder remote.",
        )}</p>
        <div class="pf-actions">
          <a class="pf-btn primary" href={de ? "/de/kontakt/" : "/contact/"} data-magnetic>
            <span>{c("Send me a message", "Schreiben Sie mir")}</span><i class="ui-arrow" aria-hidden="true"></i>
          </a>
          <a class="pf-btn" href="https://www.linkedin.com/in/rodion-belousov-413040228/" rel="me noopener" target="_blank" data-magnetic>
            <span>LinkedIn</span><i class="ui-arrow" aria-hidden="true"></i>
          </a>
        </div>
      </section>
    </article>
  </div>
</Layout>

<style>
  /* Body copy over the site's WebGL sculpture is unreadable on a phone, where
     the sphere sits directly behind the column — so this page sets `noWebgl`,
     paints its own ground, and runs its own much lighter field behind the hero
     only, where there is nothing to read. */
  .pf {
    position: relative;
    z-index: 1;
    background: #030405;
  }
  .pf-inner { max-width: 74rem; }

  /* Hero and picker share one stage so the field stays on screen while the
     visitor is choosing — the lattice reacting is the point of it, and a
     backdrop that has already scrolled away cannot react to anything. */
  .pf-stage {
    position: relative;
    isolation: isolate;
    background: radial-gradient(circle at 78% 22%, rgba(255, 255, 255, 0.06), transparent 26rem);
  }
  .pf-stage > .pf-inner { position: relative; z-index: 1; }

  /* ── Hero ──────────────────────────────────────────────────────────────── */
  .pf-hero { padding: clamp(7.5rem, 13vw, 11rem) 0 clamp(3rem, 6vw, 4.5rem); }
  .pf-kicker {
    display: block;
    font-family: var(--font-inter);
    font-size: var(--font-size-xs);
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .pf-title {
    margin: 1.5rem 0 0;
    max-width: 15ch;
    font: 500 clamp(2.9rem, 8vw, 7rem)/0.98 var(--font-display);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .pf-title span { color: rgba(var(--rgb-text), 0.42); }
  .pf-lead {
    max-width: 58ch;
    margin: 2rem 0 0;
    color: rgba(var(--rgb-text), 0.72);
    font-size: clamp(1.05rem, 1.6vw, 1.35rem);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .pf-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.4rem; }

  /* The hero needs one moment of scale that is not the name. Four measured
     figures at display size do that, and they are the only numbers on the page
     that are not about what something costs in time. */
  .pf-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1.6rem 2rem;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding-top: clamp(2rem, 4vw, 2.8rem);
    border-top: 1px solid rgba(var(--rgb-text), 0.12);
  }
  .pf-facts dt {
    display: flex;
    align-items: baseline;
    gap: 0.1em;
    font: 500 clamp(2rem, 4.4vw, 3.4rem)/0.95 var(--font-display);
    letter-spacing: -0.035em;
    font-variant-numeric: tabular-nums;
  }
  .pf-facts dt em { font-style: normal; font-size: 0.46em; color: rgba(var(--rgb-text), 0.4); }
  .pf-facts dd {
    margin: 0.7rem 0 0;
    max-width: 20ch;
    font-family: var(--font-inter);
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    line-height: 1.45;
    color: rgba(var(--rgb-text), 0.5);
  }
  .pf-btn {
    display: inline-flex;
    gap: 0.75rem;
    align-items: center;
    padding: 0.95rem 1.5rem;
    border: 1px solid rgba(var(--rgb-text), 0.22);
    border-radius: 999px;
    color: rgb(var(--rgb-text));
    font-family: var(--font-inter);
    font-size: var(--font-size-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: border-color 0.3s, background-color 0.3s, color 0.3s;
  }
  .pf-btn:hover { border-color: rgba(var(--rgb-text), 0.5); background: rgba(var(--rgb-text), 0.06); }
  .pf-btn.primary { background: rgb(var(--rgb-text)); border-color: rgb(var(--rgb-text)); color: #06070a; }
  .pf-btn.primary:hover { background: #fff; border-color: #fff; }
  .pf-btn.ghost { border-color: rgba(var(--rgb-text), 0.14); }

  /* ── Sections ──────────────────────────────────────────────────────────── */
  .pf-section {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 2.5rem;
    padding: clamp(3.2rem, 6vw, 5rem) 0;
    border-top: 1px solid rgba(var(--rgb-text), 0.1);
  }
  .pf-idx {
    font-family: var(--font-inter);
    font-size: var(--font-size-xs);
    letter-spacing: 0.2em;
    color: rgba(var(--rgb-text), 0.38);
    padding-top: 0.5rem;
  }
  .pf-process { display: block; }
  .pf-process > .pf-idx { display: block; margin-bottom: 1.8rem; }
  .pf-body h2 {
    margin: 0;
    font: 500 clamp(1.7rem, 3.4vw, 2.8rem)/1.1 var(--font-display);
    letter-spacing: -0.02em;
  }
  .pf-body > p,
  .pf-body li p { color: rgba(var(--rgb-text), 0.7); line-height: 1.65; }
  .pf-body > p { margin: 1.2rem 0 0; max-width: 62ch; }
  .pf-sub { font-size: 1.02rem; }
  .pf-note {
    margin-top: 2rem !important;
    font-size: 0.95rem;
    color: rgba(var(--rgb-text), 0.55) !important;
  }
  @keyframes sc-rule { from { width: 0; } to { width: 100%; } }
  @keyframes sc-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  /* ── Process ───────────────────────────────────────────────────────────── */
  .pf-steps { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; gap: 0; }
  .pf-steps li {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1.8rem;
    padding: 2rem 0;
    border-top: 1px solid rgba(var(--rgb-text), 0.09);
  }
  .pf-steps li:first-child { border-top: 0; padding-top: 0; }
  /* Outlined numerals at display scale. A mono "01" is a label; this is a
     landmark, and the section needed one to stop reading as a paragraph list. */
  .pf-step-n {
    font: 500 clamp(2.4rem, 5vw, 3.6rem)/0.85 var(--font-display);
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(var(--rgb-text), 0.3);
    font-variant-numeric: tabular-nums;
  }
  .pf-steps h3 { margin: 0 0 0.5rem; font: 500 1.15rem/1.25 var(--font-display); }
  .pf-steps p { margin: 0; }

  /* ── Record ────────────────────────────────────────────────────────────── */
  /* The record was three unstructured rows separated by hairlines, which is how
     a CV looks when nobody has designed it. A drawn rail with a node per role
     gives it a spine and reads as a timeline at a glance. */
  .pf-rows { position: relative; list-style: none; margin: 2.4rem 0 0; padding: 0; }
  .pf-rows li {
    position: relative;
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1.5rem;
    padding: 0 0 2.6rem 2rem;
  }
  .pf-track {
    position: absolute;
    left: 0;
    top: 0.6rem;
    height: 100%;
    width: 1px;
    background: rgba(var(--rgb-text), 0.14);
  }
  .pf-track > span {
    display: block;
    width: 100%;
    height: 100%;
    transform: scaleY(var(--career-progress, 0));
    transform-origin: top;
    background: #e4ebf7;
    box-shadow: 0 0 8px rgba(201,220,247,.7);
  }
  .pf-rows li:last-child { padding-bottom: 0; }
  .pf-rows li:last-child .pf-track { display: none; }
  .pf-dot {
    position: absolute;
    left: calc(0.5px - 0.25rem);
    top: 0.35rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #31353d;
    box-shadow: 0 0 0 3px #06070a, 0 0 0 4px rgba(var(--rgb-text),.18);
    transition: background .2s, box-shadow .2s;
  }
  .pf-rows li.is-reached .pf-dot { background: #eff4ff; box-shadow: 0 0 0 3px #06070a, 0 0 0 4px #aebfd677, 0 0 15px #bbd2f499; }
  @media (prefers-reduced-motion: reduce) { .pf-dot { transition: none; } }
  .pf-period {
    font-family: var(--font-inter);
    font-size: var(--font-size-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(var(--rgb-text), 0.42);
    padding-top: 0.3rem;
  }
  .pf-rows h3 { margin: 0; font: 500 1.2rem/1.25 var(--font-display); }
  .pf-role {
    margin: 0.3rem 0 0.7rem !important;
    font-family: var(--font-inter);
    font-size: var(--font-size-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent) !important;
  }
  .pf-rows p:last-child { margin: 0; }

  /* The links under a role. Underlined rather than buttoned: they are evidence
     for the sentence above them, not a call to action competing with the page's
     own. */
  .pf-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.4rem;
    margin: 0.85rem 0 0 !important;
  }
  .pf-proof a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.28rem;
    border-bottom: 1px solid rgba(var(--rgb-text), 0.26);
    color: rgba(var(--rgb-text), 0.82);
    font-size: 0.82rem;
    transition: color 0.35s ease, border-color 0.35s ease, gap 0.45s var(--ease-out-expo);
  }
  .pf-proof a:hover,
  .pf-proof a:focus-visible {
    color: #fff;
    border-color: #fff;
    gap: 0.8rem;
  }
  .pf-proof .css-arrow {
    display: inline-block;
    width: 0.42rem;
    height: 0.42rem;
    border-top: 1px solid currentColor;
    border-right: 1px solid currentColor;
    transform: rotate(-45deg);
  }

  .pf-cards { display: grid; gap: 1rem; margin-top: 2rem; }
  .pf-cards.three { grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .pf-cards article {
    padding: 1.4rem;
    background: rgba(var(--rgb-text), 0.03);
    border: 1px solid rgba(var(--rgb-text), 0.1);
    border-radius: 1rem;
  }
  .pf-cards h3 { margin: 0.6rem 0 0.4rem; font: 500 1.05rem/1.3 var(--font-display); }
  .pf-cards p { margin: 0; color: rgba(var(--rgb-text), 0.66); line-height: 1.55; }
  .pf-meta {
    font-family: var(--font-inter);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(var(--rgb-text), 0.4);
  }

  .pf-langs {
    margin-top: 2rem !important;
    font-size: 0.95rem;
    color: rgba(var(--rgb-text), 0.6) !important;
  }
  .pf-langs span {
    display: block;
    margin-bottom: 0.35rem;
    font-family: var(--font-inter);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(var(--rgb-text), 0.4);
  }

  /* ── Elsewhere + outro ─────────────────────────────────────────────────── */
  .pf-elsewhere {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.6rem;
    padding: clamp(2.4rem, 5vw, 3.4rem) 0 0;
    border-top: 1px solid rgba(var(--rgb-text), 0.1);
  }
  .pf-elsewhere a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.3rem;
    background: rgba(var(--rgb-text), 0.03);
    border: 1px solid rgba(var(--rgb-text), 0.1);
    border-radius: 0.9rem;
    color: rgba(var(--rgb-text), 0.8);
    font-family: var(--font-inter);
    font-size: var(--font-size-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: border-color 0.25s, background-color 0.25s, color 0.25s;
  }
  .pf-elsewhere a:hover {
    border-color: rgba(var(--rgb-text), 0.3);
    background: rgba(var(--rgb-text), 0.06);
    color: rgb(var(--rgb-text));
  }

  .pf-outro {
    padding: clamp(3rem, 6vw, 4.5rem) 0 clamp(4rem, 8vw, 6rem);
  }
  .pf-outro p {
    margin: 0 0 1.8rem;
    max-width: 40ch;
    font: 500 clamp(1.4rem, 3vw, 2.1rem)/1.2 var(--font-display);
    letter-spacing: -0.02em;
  }
  .pf-outro .pf-actions { margin-top: 0; }

  /* ── Narrow ────────────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .pf-section { grid-template-columns: 1fr; gap: 1.2rem; }
    .pf-idx { padding-top: 0; }
    .pf-rows li { grid-template-columns: 1fr; gap: 0.5rem; }
    .pf-steps li { grid-template-columns: 3.6rem 1fr; gap: 1.1rem; }
  }
  @media (max-width: 900px) {
    /* One figure per row turned four numbers into four screens of scrolling. */
    .pf-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.8rem 1.2rem; }
    .pf-facts dt { font-size: clamp(1.7rem, 8vw, 2.4rem); }
    .pf-facts dd { font-size: 0.72rem; }
  }</style>

<script>
  import { setupProfileMotion } from "../utils/profileMotion";
  const profile = document.querySelector<HTMLElement>(".pf");
  if (profile) {
    const disposeProfileMotion = setupProfileMotion(profile);
    document.addEventListener("astro:before-swap", disposeProfileMotion, { once: true });
  }

  // Each segment spans exactly two node centres. Progress follows the viewport
  // in both directions; measuring only on scroll/resize avoids an idle loop.
  const career = document.querySelector<HTMLOListElement>("[data-career-timeline]");
  if (career) {
    const items = Array.from(career.querySelectorAll<HTMLLIElement>("li"));
    const dots = items.map((item) => item.querySelector<HTMLElement>(".pf-dot")!);
    let careerFrame = 0;
    const updateCareer = () => {
      careerFrame = 0;
      const cursor = innerHeight * .64;
      const centres = dots.map((dot) => {
        const rect = dot.getBoundingClientRect();
        return rect.top + rect.height / 2;
      });
      items.forEach((item, index) => {
        item.classList.toggle("is-reached", centres[index] <= cursor);
        const distance = centres[index + 1] - centres[index];
        const progress = distance > 0 ? Math.max(0, Math.min(1, (cursor - centres[index]) / distance)) : 0;
        item.style.setProperty("--career-progress", String(progress));
      });
    };
    const scheduleCareer = () => { if (!careerFrame) careerFrame = requestAnimationFrame(updateCareer); };
    const careerResize = new ResizeObserver(scheduleCareer);
    careerResize.observe(career);
    window.addEventListener("scroll", scheduleCareer, { passive: true });
    window.addEventListener("resize", scheduleCareer, { passive: true });
    document.fonts.ready.then(scheduleCareer);
    scheduleCareer();
    document.addEventListener("astro:before-swap", () => {
      careerResize.disconnect();
      window.removeEventListener("scroll", scheduleCareer);
      window.removeEventListener("resize", scheduleCareer);
      cancelAnimationFrame(careerFrame);
    }, { once: true });
  }


</script>
