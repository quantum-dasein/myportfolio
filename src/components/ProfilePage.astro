</style>

<script>
  // The picker: plain tablist semantics, arrow-key navigable, and it tells the
  // lattice how much of itself to light. No framework, no state library — the
  // selected tab IS the state, which is what `aria-selected` already means.
  const picker = document.querySelector<HTMLElement>("[data-scope-picker]");

  if (picker) {
    const tabs = Array.from(picker.querySelectorAll<HTMLButtonElement>("[data-scope-tab]"));
    const panels = Array.from(picker.querySelectorAll<HTMLElement>("[data-scope-panel]"));
    const rail = picker.querySelector<HTMLElement>(".sc-rail");

    const select = (id: string, focus = false) => {
      const index = tabs.findIndex((tab) => tab.dataset.scopeTab === id);
      if (rail && index >= 0) {
        rail.style.setProperty("--at", `${(index / Math.max(1, tabs.length - 1)) * 100}%`);
      }
      tabs.forEach((tab) => {
        const on = tab.dataset.scopeTab === id;
        tab.setAttribute("aria-selected", on ? "true" : "false");
        tab.tabIndex = on ? 0 : -1;
        if (on) {
          if (focus) tab.focus();
          const ratio = Number(tab.dataset.field);
          if (Number.isFinite(ratio)) {
            dispatchEvent(new CustomEvent("rb:scope", { detail: { ratio } }));
          }
        }
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.scopePanel !== id;
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => { announced = true; select(tab.dataset.scopeTab!); });
    });

    picker.addEventListener("keydown", (event) => {
      const key = event.key;
      if (key !== "ArrowRight" && key !== "ArrowLeft" && key !== "Home" && key !== "End") return;
      const current = tabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true");
      if (current < 0) return;
      event.preventDefault();
      const next =
        key === "Home" ? 0
        : key === "End" ? tabs.length - 1
        : (current + (key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
      select(tabs[next].dataset.scopeTab!, true);
    });

    // Position the rail immediately, but hold the field's contraction until the
    // picker is actually on screen — the hero is entitled to the whole range,
    // and the field narrowing to one scope should be something the visitor sees
    // happen rather than something already over by the time they arrive.
    const first = tabs.find((tab) => tab.getAttribute("aria-selected") === "true") || tabs[0];
    if (first && rail) {
      rail.style.setProperty("--at", `${(tabs.indexOf(first) / Math.max(1, tabs.length - 1)) * 100}%`);
    }
    let announced = false;
    const announce = () => {
      if (announced || !first) return;
      announced = true;
      const ratio = Number(first.dataset.field);
      if (Number.isFinite(ratio)) dispatchEvent(new CustomEvent("rb:scope", { detail: { ratio } }));
    };
    const io = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) { announce(); io.disconnect(); }
    }, { threshold: 0.35 });
    io.observe(picker);
  }
</script>
