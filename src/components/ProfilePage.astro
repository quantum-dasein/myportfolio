---
// ─────────────────────────────────────────────────────────────────────────────
//  ProfilePage.astro — /en/rodion-belousov-vienna/ and /de/rodion-belousov-wien/
//
//  This used to be the home page again: the same career rows, the same work
//  cards, the same service list, restated with nothing added. A visitor who had
//  already scrolled the home page learned nothing by opening it, and it made
//  the site look like it was padding for search.
//
//  It has one job now that no other page does — answering the question someone
//  actually arrives with. Not "is he good", which the rest of the site argues
//  at length, but "would he take MY job, and how long would it take". So the
//  page leads with a scope picker: pick the size of the thing you need, from a
//  single landing page upward, and get the timeline, what is included, what I
//  need from you, and the closest real piece of work. The lattice behind it
//  lights up in proportion, so the picture states the same thing as the copy.
//
//  That ordering is deliberate. The smallest, fastest, cheapest job is the
//  first thing on the page, because the site's whole risk is reading as a
//  studio that only takes elaborate WebGL commissions. It takes ordinary work,
//  and this is where it says so.
//
//  The professional record stays — it is why the page ranks for the name and
//  what a hiring reader came for — but the duplicated work and service blocks
//  are gone, replaced by one line pointing at the pages that own them.
//
//  Both languages live in this one component; the route decides which. It is
//  lockLang, which means it states its own language and must never write that
//  into the visitor's stored preference.
// ─────────────────────────────────────────────────────────────────────────────
import Layout from "../layouts/Layout.astro";
import ScopeField from "./ScopeField.astro";
import { useTranslations, type Lang, type UIKey } from "../i18n/utils";

interface Props { lang: Lang }
const { lang } = Astro.props;
const de = lang === "de";
const t = useTranslations(lang);
const tk = (key: string) => t(key as UIKey);
const c = (en: string, deText: string) => (de ? deText : en);

const paths = { en: "/en/rodion-belousov-vienna/", de: "/de/rodion-belousov-wien/" };
const title = c(
  "Rodion Belousov — Web Developer in Vienna | Websites & SEO",
  "Rodion Belousov — Webentwickler in Wien | Websites & SEO",
);
const description = c(
  "Rodion Belousov in Vienna: websites, online shops, technical SEO and web platforms. Pick the size of the job and see the timeline, what is included and what it costs you to start.",
  "Rodion Belousov in Wien: Websites, Online-Shops, technisches SEO und Web-Plattformen. Wählen Sie die Größe des Projekts und sehen Sie Zeitrahmen, Leistungsumfang und den Einstieg.",
);

// ── The scope picker ─────────────────────────────────────────────────────────
// Ordered smallest first, on purpose. `field` is the share of the lattice that
// scope lights, so the picture scales with the job.
// NOTE (Rodion): there is a deliberate empty slot for a price band on each
// entry — add `price: c("from €900", "ab 900 €")` and it renders itself. Left
// blank because those are your numbers to set, not mine to invent.
type Scope = {
  id: string;
  label: string;
  size: string;
  time: string;
  field: number;
  price?: string;
  gets: string[];
  needs: string;
  proof?: { text: string; href: string };
};

const scopes: Scope[] = [
  {
    id: "landing",
    label: c("Landing page", "Landingpage"),
    size: c("One page, one action", "Eine Seite, eine Handlung"),
    time: c("2–4 days", "2–4 Tage"),
    field: 0.09,
    gets: [
      c("One page written around a single action — call, booking or form", "Eine Seite rund um eine einzige Handlung — Anruf, Buchung oder Formular"),
      c("Form or booking wired to your inbox, with spam handling", "Formular oder Buchung an Ihr Postfach angebunden, inklusive Spam-Schutz"),
      c("Analytics and conversion tracking installed and verified", "Analytics und Conversion-Tracking eingerichtet und geprüft"),
      c("Hosting, domain and certificate set up in your own accounts", "Hosting, Domain und Zertifikat in Ihren eigenen Konten eingerichtet"),
    ],
    needs: c("Your text and images, or an hour on a call for me to write them.", "Ihre Texte und Bilder — oder eine Stunde Gespräch, damit ich sie schreibe."),
  },
  {
    id: "site",
    label: c("Business website", "Unternehmens-Website"),
    size: c("5–10 pages", "5–10 Seiten"),
    time: c("About a week", "Etwa eine Woche"),
    field: 0.24,
    gets: [
      c("5–10 pages, structured so each one can rank on its own", "5–10 Seiten, so strukturiert, dass jede einzeln ranken kann"),
      c("German and English, without a second site to maintain", "Deutsch und Englisch, ohne eine zweite Website zu pflegen"),
      c("On-page SEO, sitemap and Search Console handed over working", "On-Page-SEO, Sitemap und Search Console funktionsfähig übergeben"),
      c("Editable yourself where you need it — no monthly builder fee", "Selbst editierbar, wo Sie es brauchen — keine monatliche Baukasten-Gebühr"),
    ],
    needs: c("Finished content, or a list of what the site has to say.", "Fertige Inhalte — oder eine Liste dessen, was die Website sagen soll."),
    proof: { text: c("What that looks like", "Wie das aussieht"), href: c("/en/website-development-vienna/", "/de/website-erstellen-wien/") },
  },
  {
    id: "shop",
    label: c("Online shop", "Online-Shop"),
    size: c("Catalogue and checkout", "Katalog und Checkout"),
    time: c("2–3 weeks", "2–3 Wochen"),
    field: 0.42,
    gets: [
      c("Product catalogue, cart and a checkout that works on a phone", "Produktkatalog, Warenkorb und ein Checkout, der auf dem Handy funktioniert"),
      c("Payment, Austrian VAT and shipping rules configured", "Zahlung, österreichische USt und Versandregeln konfiguriert"),
      c("Order and dispatch emails, plus a stock view you can run", "Bestell- und Versandmails, dazu eine Bestandsansicht, die Sie selbst bedienen"),
      c("Product pages built to be found, not just to be browsed", "Produktseiten, die gefunden werden — nicht nur durchgeblättert"),
    ],
    needs: c("Your products, prices and shipping rules. I will tell you honestly if a hosted platform is the better buy for your case.", "Ihre Produkte, Preise und Versandregeln. Ich sage Ihnen ehrlich, wenn eine gehostete Plattform für Ihren Fall die bessere Wahl ist."),
  },
  {
    id: "seo",
    label: c("SEO & content", "SEO & Content"),
    size: c("On a site that already exists", "Für eine bestehende Website"),
    time: c("First findings in 2 weeks", "Erste Ergebnisse in 2 Wochen"),
    field: 0.58,
    gets: [
      c("Technical crawl, then the fixes actually made — not a PDF of them", "Technischer Crawl, dann die Fixes tatsächlich umgesetzt — kein PDF davon"),
      c("Content plan built from what people in your market search for", "Content-Plan auf Basis dessen, wonach Ihr Markt tatsächlich sucht"),
      c("Indexing, Core Web Vitals and rankings tracked over time", "Indexierung, Core Web Vitals und Rankings laufend verfolgt"),
      c("Reporting you can read without a marketing degree", "Reporting, das Sie ohne Marketing-Abschluss lesen können"),
    ],
    needs: c("Access to the site, Search Console and analytics.", "Zugang zur Website, zur Search Console und zu Analytics."),
    proof: { text: c("+780% organic search — Bridge Consult", "+780 % organische Suche — Bridge Consult"), href: "/work/bridge-consult" },
  },
  {
    id: "platform",
    label: c("Web app or platform", "Web-App oder Plattform"),
    size: c("Live data, accounts, admin", "Live-Daten, Accounts, Verwaltung"),
    time: c("From 4 weeks", "Ab 4 Wochen"),
    field: 0.78,
    gets: [
      c("A data model that survives the second year, not just the launch", "Ein Datenmodell, das auch das zweite Jahr überlebt — nicht nur den Launch"),
      c("Admin, roles and an editing workflow your team can actually run", "Verwaltung, Rollen und ein Redaktions-Workflow, den Ihr Team wirklich bedient"),
      c("Integrations and scheduled jobs against live sources", "Integrationen und geplante Jobs gegen echte Datenquellen"),
      c("Multi-language handled in the routing, not bolted on afterwards", "Mehrsprachigkeit im Routing gelöst, nicht nachträglich angeflanscht"),
    ],
    needs: c("A conversation about what the thing has to do before anyone writes code.", "Ein Gespräch darüber, was das System leisten muss, bevor irgendjemand Code schreibt."),
    proof: { text: c("429 pages, 3 languages, 2 981 tenders — FIDIC.uz", "429 Seiten, 3 Sprachen, 2 981 Ausschreibungen — FIDIC.uz"), href: "/work/fidic" },
  },
  {
    id: "showreel",
    label: c("Showreel-grade build", "Showreel-Niveau"),
    size: c("3D, WebGL, custom motion", "3D, WebGL, eigene Motion"),
    time: c("From 3 weeks", "Ab 3 Wochen"),
    field: 1,
    gets: [
      c("Real-time 3D and hand-written shaders, not a stock template", "Echtzeit-3D und handgeschriebene Shader, kein Stock-Template"),
      c("Motion designed as a system, so it holds together page to page", "Motion als System entworfen, damit es über Seiten hinweg zusammenhält"),
      c("Every effect measured, and cut on devices where it costs more than it gives", "Jeder Effekt gemessen — und dort entfernt, wo er mehr kostet als er bringt"),
      c("Fast on a mid-range phone, or it does not ship", "Schnell auf einem Mittelklasse-Handy, sonst geht es nicht live"),
    ],
    needs: c("A reason for it. If the effect will not earn its weight, I will say so and build the simpler thing.", "Einen Grund dafür. Wenn der Effekt sein Gewicht nicht wert ist, sage ich das und baue die einfachere Variante."),
    proof: { text: c("This site, taken apart", "Diese Website, auseinandergenommen"), href: "/work/studio" },
  },
];

// Four numbers the rest of the site evidences. They are here because the hero
// is where someone decides whether to keep reading, and a claim with a figure
// on it survives that decision better than a paragraph.
const facts = [
  { v: "+780", suffix: "%", k: c("organic search after launch", "organische Suche nach Launch") },
  { v: "429", suffix: "", k: c("pages, FIDIC platform", "Seiten, FIDIC-Plattform") },
  { v: "2 981", suffix: "", k: c("tenders, refreshed daily", "Ausschreibungen, täglich aktualisiert") },
  { v: "03", suffix: "", k: c("languages in one content system", "Sprachen in einem Content-System") },
];

const experience = [1, 2, 3];
const education = [1, 2, 3];

const steps = [
  {
    n: "01",
    title: c("You write, in a sentence", "Sie schreiben, in einem Satz"),
    text: c("What you need and when. No brief template, no discovery invoice.", "Was Sie brauchen und bis wann. Kein Briefing-Formular, keine Discovery-Rechnung."),
  },
  {
    n: "02",
    title: c("Fixed scope and date, within a day", "Fester Umfang und Termin, binnen eines Tages"),
    text: c("A written scope, a price and a launch date. If I am not the right person for it, I say that instead — and where I would send you.", "Ein schriftlicher Umfang, ein Preis und ein Launch-Termin. Wenn ich nicht der Richtige bin, sage ich das — und wohin ich Sie schicken würde."),
  },
  {
    n: "03",
    title: c("Build, review, launch", "Bauen, prüfen, launchen"),
    text: c("You see it on a real URL while it is being built, not at the end. It goes live in your own accounts, and it is yours.", "Sie sehen es während der Arbeit unter einer echten URL, nicht erst am Ende. Es geht in Ihren eigenen Konten live und gehört Ihnen."),
  },
];

const breadcrumbs = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Rodion Belousov Studio", item: "https://rodionbelousov.studio/" },
    { "@type": "ListItem", position: 2, name: c("Profile & experience", "Profil & Berufserfahrung"), item: `https://rodionbelousov.studio${paths[lang]}` },
  ],
};
---

<Layout
  lang={lang}
  lockLang
  alternateUrls={{ ...paths, "x-default": paths.en }}
  title={title}
  description={description}
  pageType="profile"
  structuredData={breadcrumbs}
  noWebgl
>
  <div class="pf">
    <div class="pf-stage">
      <ScopeField />
      <article class="u-container pf-inner">
        <header class="pf-hero">
          <span class="pf-kicker">{c("VIENNA, AUSTRIA · INTERNATIONAL / REMOTE", "WIEN, ÖSTERREICH · INTERNATIONAL / REMOTE")}</span>
          <h1 class="pf-title" data-sy-reveal="words">Rodion Belousov <span>{c("in Vienna.", "in Wien.")}</span></h1>
          <p class="pf-lead" data-reveal>{c(
            "I build websites in Vienna — from a landing page in three days to a 429-page platform in three languages. Same person writes the copy, builds it and answers for what it does in the market afterwards. Small jobs are welcome; most weeks they are most of the work.",
            "Ich baue Websites in Wien — von der Landingpage in drei Tagen bis zur Plattform mit 429 Seiten in drei Sprachen. Dieselbe Person schreibt den Text, baut ihn und steht danach dafür gerade, was er im Markt tut. Kleine Aufträge sind willkommen; in den meisten Wochen sind sie der Großteil der Arbeit.",
          )}</p>

          <div class="pf-actions" data-reveal>
            <a class="pf-btn primary" href="mailto:rodionbelousov@protonmail.com" data-magnetic>
              <span>{c("Get a fixed quote", "Festes Angebot anfragen")}</span><i class="ui-arrow" aria-hidden="true"></i>
            </a>
            <a class="pf-btn ghost" href="#scope" data-magnetic>
              <span>{c("What do you need?", "Was brauchen Sie?")}</span><i class="ui-arrow ui-arrow-down" aria-hidden="true"></i>
            </a>
          </div>

          <dl class="pf-facts" data-reveal>
            {facts.map((f) => (
              <div>
                <dt><span>{f.v}</span>{f.suffix && <em>{f.suffix}</em>}</dt>
                <dd>{f.k}</dd>
              </div>
            ))}
          </dl>
        </header>

      <!-- ── 01 · Scope picker ──────────────────────────────────────────── -->
      <section class="pf-section" id="scope" aria-labelledby="scope-title">
        <span class="pf-idx">01 — {c("SCOPE", "UMFANG")}</span>
        <div class="pf-body">
          <h2 id="scope-title" data-sy-reveal="words">{c("What do you actually need?", "Was brauchen Sie wirklich?")}</h2>
          <p class="pf-sub" data-reveal>{c(
            "Pick the size of the job. No form, no call required to see this.",
            "Wählen Sie die Größe des Projekts. Kein Formular, kein Gespräch nötig, um das zu sehen.",
          )}</p>

          <div class="sc" data-scope-picker>
            <!-- The rail is the argument in one line: these six sit on one
                 continuum from a couple of days to a couple of months, and the
                 marker says where the visitor's job falls on it. "Any
                 complexity" is a claim; this is a picture of it. -->
            <div class="sc-rail" aria-hidden="true">
              <span class="sc-rail-line"></span>
              <span class="sc-rail-fill" data-scope-fill></span>
              {scopes.map((_, i) => (
                <span class="sc-rail-tick" style={`--at:${(i / (scopes.length - 1)) * 100}%`}></span>
              ))}
              <span class="sc-rail-marker" data-scope-marker></span>
            </div>
            <div class="sc-rail-ends" aria-hidden="true">
              <span>{c("a few days", "wenige Tage")}</span>
              <span>{c("a few months", "wenige Monate")}</span>
            </div>

            <div class="sc-tabs" role="tablist" aria-label={c("Project size", "Projektgröße")}>
              {scopes.map((s, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`sc-tab-${s.id}`}
                  class="sc-tab"
                  data-scope-tab={s.id}
                  data-field={s.field}
                  aria-selected={i === 0 ? "true" : "false"}
                  aria-controls={`sc-panel-${s.id}`}
                  tabindex={i === 0 ? 0 : -1}
                >
                  <span class="sc-tab-n">{String(i + 1).padStart(2, "0")}</span>
                  <span class="sc-tab-label">{s.label}</span>
                  <span class="sc-tab-size">{s.size}</span>
                </button>
              ))}
            </div>

            <div class="sc-panels">
              {scopes.map((s, i) => (
                <div
                  class="sc-panel"
                  id={`sc-panel-${s.id}`}
                  role="tabpanel"
                  aria-labelledby={`sc-tab-${s.id}`}
                  data-scope-panel={s.id}
                  hidden={i !== 0}
                >
                  <div class="sc-headline">
                    <div>
                      <span class="sc-key">{c("Timeline", "Zeitrahmen")}</span>
                      <strong class="sc-value">{s.time}</strong>
                    </div>
                    {s.price && (
                      <div>
                        <span class="sc-key">{c("From", "Ab")}</span>
                        <strong class="sc-value">{s.price}</strong>
                      </div>
                    )}
                    <div>
                      <span class="sc-key">{c("Reply", "Antwort")}</span>
                      <strong class="sc-value">{c("Within a day", "Binnen eines Tages")}</strong>
                    </div>
                  </div>

                  <ul class="sc-gets">
                    {s.gets.map((g) => <li>{g}</li>)}
                  </ul>

                  <p class="sc-needs"><span>{c("What I need from you", "Was ich von Ihnen brauche")}</span>{s.needs}</p>

                  {s.proof && (
                    <a class="sc-proof" href={s.proof.href}>
                      <span>{s.proof.text}</span><i class="ui-arrow" aria-hidden="true"></i>
                    </a>
                  )}
                </div>
              ))}
            </div>
          </div>

          <p class="pf-note" data-reveal>{c(
            "Not on the list, or you are not sure which one it is? Write anyway — describing it badly is fine, sorting it out is my job.",
            "Nicht auf der Liste, oder unsicher, was davon zutrifft? Schreiben Sie trotzdem — es unbeholfen zu beschreiben ist völlig in Ordnung, das Sortieren ist mein Job.",
          )}</p>
        </div>
      </section>
      </article>
    </div>

    <article class="u-container pf-inner">
      <!-- ── 02 · How it works ─────────────────────────────────────────── -->
      <section class="pf-section" aria-labelledby="process-title">
        <span class="pf-idx">02 — {c("PROCESS", "ABLAUF")}</span>
        <div class="pf-body">
          <h2 id="process-title" data-sy-reveal="words">{c("What happens after you write.", "Was passiert, nachdem Sie schreiben.")}</h2>
          <ol class="pf-steps">
            {steps.map((s) => (
              <li data-reveal>
                <span class="pf-step-n">{s.n}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- ── 03 · The record ───────────────────────────────────────────── -->
      <section class="pf-section" id="experience" aria-labelledby="experience-title">
        <span class="pf-idx">03 — {c("EXPERIENCE", "BERUFSERFAHRUNG")}</span>
        <div class="pf-body">
          <h2 id="experience-title" data-sy-reveal="words">{c("Professional experience", "Berufserfahrung")}</h2>
          <ol class="pf-rows">
            {experience.map((n) => (
              <li data-reveal>
                <span class="pf-period">{tk(`exp.${n}.period`)}</span>
                <div>
                  <h3>{tk(`exp.${n}.company`)}</h3>
                  <p class="pf-role">{tk(`exp.${n}.role`)}</p>
                  <p>{tk(`exp.${n}.text`)}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="pf-langs" data-reveal><span>{t("edu.langs.label")}</span>{t("edu.langs.value")}</p>
        </div>
      </section>

      <!-- ── 04 · Education ────────────────────────────────────────────── -->
      <section class="pf-section" aria-labelledby="education-title">
        <span class="pf-idx">04 — {c("EDUCATION", "AUSBILDUNG")}</span>
        <div class="pf-body">
          <h2 id="education-title" data-sy-reveal="words">{c("Education & tools", "Ausbildung & Werkzeuge")}</h2>
          <div class="pf-cards three">
            {education.map((n) => (
              <article data-reveal>
                <span class="pf-meta">{tk(`edu.${n}.period`)}</span>
                <h3>{tk(`edu.${n}.degree`)}</h3>
                <p>{tk(`edu.${n}.school`)}</p>
              </article>
            ))}
          </div>
          <p class="pf-langs" data-reveal><span>{t("edu.stack.label")}</span>{t("edu.stack.value")}</p>
        </div>
      </section>

      <!-- The work and the services have their own pages. Repeating them here
           is what made this page a duplicate of the home page in the first
           place, so it points at them instead of restating them. -->
      <nav class="pf-elsewhere" data-reveal aria-label={c("Elsewhere on this site", "Weiter auf dieser Website")}>
        <a href="/#work"><span>{c("Selected work", "Ausgewählte Arbeiten")}</span><i class="ui-arrow" aria-hidden="true"></i></a>
        <a href="/services"><span>{c("Services in detail", "Leistungen im Detail")}</span><i class="ui-arrow" aria-hidden="true"></i></a>
        <a href="/notes"><span>{c("What broke, and why", "Was kaputtging, und warum")}</span><i class="ui-arrow" aria-hidden="true"></i></a>
      </nav>

      <section class="pf-outro" data-reveal>
        <p>{c(
          "Open to projects of any size — in Vienna, across Austria or remote.",
          "Offen für Projekte jeder Größe — in Wien, österreichweit oder remote.",
        )}</p>
        <div class="pf-actions">
          <a class="pf-btn primary" href="mailto:rodionbelousov@protonmail.com" data-magnetic>
            <span>{c("Send me a message", "Schreiben Sie mir")}</span><i class="ui-arrow" aria-hidden="true"></i>
          </a>
          <a class="pf-btn" href="https://www.linkedin.com/in/rodion-belousov-413040228/" rel="me noopener" target="_blank" data-magnetic>
            <span>LinkedIn</span><i class="ui-arrow" aria-hidden="true"></i>
          </a>
        </div>
      </section>
    </article>
  </div>
</Layout>

<style>
  /* Body copy over the site's WebGL sculpture is unreadable on a phone, where
     the sphere sits directly behind the column — so this page sets `noWebgl`,
     paints its own ground, and runs its own much lighter field behind the hero
     only, where there is nothing to read. */
  .pf {
    position: relative;
    z-index: 1;
    background: #030405;
  }
  .pf-inner { max-width: 74rem; }

  /* Hero and picker share one stage so the field stays on screen while the
     visitor is choosing — the lattice reacting is the point of it, and a
     backdrop that has already scrolled away cannot react to anything. */
  .pf-stage {
    position: relative;
    isolation: isolate;
    background: radial-gradient(circle at 78% 22%, rgba(255, 255, 255, 0.06), transparent 26rem);
  }
  .pf-stage > .pf-inner { position: relative; z-index: 1; }

  /* ── Hero ──────────────────────────────────────────────────────────────── */
  .pf-hero { padding: clamp(7.5rem, 13vw, 11rem) 0 clamp(3rem, 6vw, 4.5rem); }
  .pf-kicker {
    display: block;
    font-family: var(--font-inter);
    font-size: var(--font-size-xs);
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .pf-title {
    margin: 1.5rem 0 0;
    max-width: 15ch;
    font: 500 clamp(2.9rem, 8vw, 7rem)/0.98 var(--font-display);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .pf-title span { color: rgba(var(--rgb-text), 0.42); }
  .pf-lead {
    max-width: 58ch;
    margin: 2rem 0 0;
    color: rgba(var(--rgb-text), 0.72);
    font-size: clamp(1.05rem, 1.6vw, 1.35rem);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .pf-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.4rem; }

  /* The hero needs one moment of scale that is not the name. Four measured
     figures at display size do that, and they are the only numbers on the page
     that are not about what something costs in time. */
  .pf-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1.6rem 2rem;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding-top: clamp(2rem, 4vw, 2.8rem);
    border-top: 1px solid rgba(var(--rgb-text), 0.12);
  }
  .pf-facts dt {
