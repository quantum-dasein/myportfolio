---
// ─────────────────────────────────────────────────────────────────────────────
//  ScrollScrub.astro — Apple-style scroll-scrubbed product film.
//
//  A tall section with a sticky viewport; scroll progress is mapped straight
//  onto independently decoded film frames, so the animation turns under the
//  visitor's own scroll instead of autoplaying past them.
//
//  Sticky (CSS) rather than a GSAP pin: no pin-spacer to fight with Lenis.
//  On touch / reduced-motion it degrades to a normal looping autoplay clip.
// ─────────────────────────────────────────────────────────────────────────────
interface Props {
  video: string;
  sequence?: string;
  frames?: number;
  poster: string;
  eyebrowKey?: string;
  titleKey?: string;
  textKey?: string;
  eyebrow?: string;
  title?: string;
  text?: string;
}

const { video, poster, sequence, frames = 360, eyebrowKey, titleKey, textKey, eyebrow, title, text } = Astro.props;
---

<section class="scrub" data-scrub data-sequence={sequence} data-frames={frames}>
  <div class="scrub-sticky">
    <video
      class="scrub-vid"
      data-scrub-src={video}
      poster={poster}
      muted
      playsinline
      preload="none"
      aria-hidden="true"
      data-scrub-video></video>

    <canvas class="scrub-vid scrub-sequence" data-scrub-canvas width="1280" height="720" hidden aria-hidden="true"></canvas>
    <div class="scrub-veil" aria-hidden="true"></div>

    <div class="scrub-copy">
      <span class="scrub-eyebrow" data-i18n={eyebrowKey}>{eyebrow}</span>
      <h2 class="scrub-title" data-i18n={titleKey}>{title}</h2>
      <p class="scrub-text" data-i18n={textKey}>{text}</p>
    </div>

    <div class="scrub-hud" aria-hidden="true">
      <span class="scrub-rec"><i></i>REC</span>
      <span class="scrub-bar"><i data-scrub-bar></i></span>
      <span class="scrub-frame" data-scrub-frame>FRAME 0000</span>
    </div>
  </div>
</section>

<style>
  .scrub {
    position: relative;
    /* the scroll distance that drives the film */
    height: 300vh;
  }

  .scrub-sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background: #050505;
  }

  .scrub-vid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Graded, not buried: the first pass crushed it to near-black and the work
       stopped being visible. Keep contrast and pull the colour back, but let
       the render actually read. */
    filter: contrast(1.12) brightness(0.92) saturate(0.62);
  }

  .scrub-sequence[hidden] { display: none; }

  .scrub-veil {
    position: absolute;
    inset: 0;
    /* Only enough scrim to keep the copy legible on the left. */
    background:
      radial-gradient(120% 90% at 68% 46%, transparent 0%, transparent 42%, rgba(0, 0, 0, 0.55) 100%),
      linear-gradient(90deg, rgba(4, 4, 5, 0.88), rgba(4, 4, 5, 0.34) 42%, transparent 66%),
      linear-gradient(0deg, rgba(4, 4, 5, 0.72), transparent 40%);
  }

  /* faint scan of the film gate */
  .scrub-sticky::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0.5;
    background: repeating-linear-gradient(
      0deg,
      transparent 0 3px,
      rgba(255, 255, 255, 0.014) 3px 4px
    );
  }

  .scrub-copy {
    position: absolute;
    left: clamp(1.5rem, 5vw, 5rem);
    bottom: clamp(4.5rem, 10vw, 8rem);
    max-width: 34rem;
  }

  .scrub-eyebrow {
    display: inline-block;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .scrub-title {
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 5.5vw, 4.4rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: #fff;
  }

  .scrub-text {
    margin: 1.1rem 0 0;
    max-width: 42ch;
    color: rgba(var(--rgb-text), 0.66);
    font-size: var(--font-size-sm);
    line-height: 1.6;
  }

  .scrub-hud {
    position: absolute;
    right: clamp(1.5rem, 5vw, 5rem);
    bottom: clamp(4.5rem, 10vw, 8rem);
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    color: rgba(var(--rgb-text), 0.6);
    font-variant-numeric: tabular-nums;
  }

  .scrub-rec {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: rgba(var(--rgb-text), 0.75);
  }
  .scrub-rec i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0.6rem rgba(255, 255, 255, 0.7);
    animation: rec-blink 1.6s steps(2) infinite;
  }
  @keyframes rec-blink {
    0%, 100% { opacity: 0.25; }
    50% { opacity: 1; }
  }

  .scrub-bar {
    display: block;
    width: clamp(5rem, 12vw, 11rem);
    height: 1px;
    background: rgba(255, 255, 255, 0.16);
  }

  .scrub-bar i {
    display: block;
    width: 0%;
    height: 100%;
    background: #fff;
    box-shadow: 0 0 0.8rem rgba(255, 255, 255, 0.5);
  }

  /* Touch + reduced motion: scrubbing an mp4 by finger is unreliable, so the
     film simply plays itself and the section collapses to one screen. */
  @media (pointer: coarse), (prefers-reduced-motion: reduce) {
    .scrub { height: auto; }
    .scrub-sticky { position: relative; height: 78svh; }
    .scrub-hud { display: none; }
  }
</style>

<script>
  import { mountScrollFilm } from '../scripts/scroll-film';
  document.querySelectorAll<HTMLElement>('[data-scrub]').forEach(mountScrollFilm);
</script>
