---
import Layout from "../layouts/Layout.astro";
import { insightContent, pick, serviceContent, type SeoLang, type ServiceKey } from "../data/seo-content";
import { cases, type CaseId } from "../data/cases";
import { works } from "../data/works";
import { scopes, pickScope } from "../data/scopes";
import AuditCta from "./AuditCta.astro";
import VideoStarter from "./VideoStarter.astro";

// Proper nouns, not translated.
const caseName: Record<CaseId, string> = {
  bridge: "Bridge Consult",
  fidic: "FIDIC.uz",
  academy: "Bridge Consult Academy",
};

interface Props { lang: SeoLang; serviceKey: ServiceKey }
const { lang, serviceKey } = Astro.props;
const service = serviceContent[serviceKey];
const de = lang === "de";
const relatedInsights = Object.values(insightContent).filter((item) => item.relatedService === serviceKey || item.key === "bridge-growth").slice(0, 3);
// Niche pages exist to be found by someone who does not search for "website
// development". They only earn that if the parent links down to them and they
// link back — an orphan page with nothing pointing at it is a page nobody,
// including a crawler, has a reason to reach.
const siblings = (service.siblings ?? []).map((sibling) => serviceContent[sibling]);
const alternates = { en: service.paths.en, de: service.paths.de, "x-default": service.paths.en };
const faqSchema = { "@type": "FAQPage", mainEntity: service.faq.map((item) => ({ "@type": "Question", name: pick(item.question, lang), acceptedAnswer: { "@type": "Answer", text: pick(item.answer, lang) } })) };

// A page that sells film shows film. These are the same files the WebGL archive
// uses, served here as ordinary <video> behind their poster so nothing but the
// poster downloads until a visitor presses play.
const reelAll = (service.reel ?? []).map((id) => works.find((work) => work.id === id)).filter(Boolean) as typeof works;
// Landscape films and vertical field reels are two different objects on a page:
// a 9:16 card in a three-column landscape grid is twice the height of its
// neighbours and drags the row with it. Same data, two strips.
const reel = reelAll.filter((film) => film.ratio !== "vertical");
const fieldReel = reelAll.filter((film) => film.ratio === "vertical");

// The row of the price table this page is selling, read from the same file the
// picker reads. These pages are what search sends people to, and every one of
// them used to end on "all services & research" — a reader who wanted the
// number had to go and find their own scope again.
const scope = service.scope ? scopes.find((row) => row.id === service.scope) : undefined;
const hub = de ? "/de/leistungen/" : "/services/";
// VideoObject for each one. No `uploadDate`: it is not recorded anywhere real,
// and Google would rather have an incomplete node than an invented date.
const videoSchema = reelAll.map((film) => ({
  "@type": "VideoObject",
  name: film.title!,
  description: pick({ en: film.detail!.en, de: film.detail!.de }, lang),
  thumbnailUrl: `https://rodionbelousov.studio${film.img}`,
  contentUrl: `https://rodionbelousov.studio${film.video}`,
  creator: { "@id": "https://rodionbelousov.studio/#rodion-belousov" },
  inLanguage: lang,
}));
const serviceSchema = { "@type": "Service", name: pick(service.title, lang), description: pick(service.description, lang), provider: { "@id": "https://rodionbelousov.studio/#rodion-belousov" }, areaServed: [{ "@type": "City", name: "Vienna" }, { "@type": "Country", name: "Austria" }] };
const seoTitle = `${pick(service.eyebrow, lang).replace(" / ", " · ")} | Rodion Belousov`;
// Unique OG image per service — real case evidence instead of the generic card.
// These pages sell Rodion's services, so the share card has to carry Rodion's
// identity. They previously pointed at client screenshots — the creative
// development page shared as a picture of the Bridge Consult website under the
// title "Rodion Belousov Studio", which reads as sharing the client's site.
// Work samples belong on the case studies; a service page gets its own card.
// These are also purpose-built at 1200x630 and under 100 KB, where the case
// screenshots were 883 KB and 2 MB at the wrong aspect ratio.
// A social crawler never runs the language switcher — it reads the URL it was
// given. These are separate DE and EN URLs, so each one can and should carry a
// card in its own language. `card` names a pair built by `npm run og`; `image`
// stays for the keys that still share one illustration.
const localizedCard: Partial<Record<ServiceKey, string>> = {
  websites: "websites",
  "digital-marketing": "digital-marketing",
  "technical-seo": "technical-seo",
  "creative-development": "creative-development",
  arztpraxis: "niche-arztpraxis",
  restaurant: "niche-restaurant",
  handwerker: "niche-handwerker",
  motion: "motion",
};

const og: Record<ServiceKey, { image: string; alt: string }> = {
  // Shares the default brand card with creative-development. Two service pages
  // on one card is fine — the title and description are what people read — and
  // a correct generic card beats a bespoke one with the wrong words on it.
  websites: { image: "/og/rodion-belousov-digital-marketer-creative-developer-vienna.jpg", alt: "Rodion Belousov — business websites in Vienna" },
  "digital-marketing": { image: "/og/rodion-belousov-digital-marketer-vienna.jpg", alt: "Rodion Belousov — digital marketing and SEO in Vienna" },
  "technical-seo": { image: "/og/rodion-belousov-services-marketing-seo-creative-development-vienna.jpg", alt: "Rodion Belousov — technical SEO in Vienna" },
  "creative-development": { image: "/og/rodion-belousov-digital-marketer-creative-developer-vienna.jpg", alt: "Rodion Belousov — creative development in Vienna" },
  // The niche pages share the websites card: the title and description are what
  // a reader sees in a share preview, and a correct generic image beats a
  // bespoke one carrying the wrong words.
  arztpraxis: { image: "/og/rodion-belousov-digital-marketer-creative-developer-vienna.jpg", alt: "Rodion Belousov — websites for medical practices in Vienna" },
  restaurant: { image: "/og/rodion-belousov-digital-marketer-creative-developer-vienna.jpg", alt: "Rodion Belousov — websites for restaurants in Vienna" },
  handwerker: { image: "/og/rodion-belousov-digital-marketer-creative-developer-vienna.jpg", alt: "Rodion Belousov — websites for tradespeople in Vienna" },
  motion: { image: "/og/rodion-belousov-3d-motion-archive-vienna.jpg", alt: "Rodion Belousov — 3D animation and video in Vienna" },
};
---

<Layout lang={lang} alternateUrls={alternates} lockLang title={seoTitle} description={pick(service.description, lang)} image={localizedCard[serviceKey] ? `/og/${localizedCard[serviceKey]}-${lang}.jpg` : og[serviceKey].image} imageAlt={og[serviceKey].alt} structuredData={[serviceSchema, faqSchema, ...videoSchema]}>
  <article class="service-page">
    <!-- Always give a way out: back to the Services & Research hub. -->
    <a class="back-link" href={de ? "/de/leistungen/" : "/services/"} data-cursor="BACK" data-magnetic>
      <i class="ui-arrow ui-arrow-back" aria-hidden="true"></i>
      <span>{de ? "Zurück" : "Back"}</span>
    </a>

    <header class="service-hero" data-hero>
      <div class="u-container">
        <span class="eyebrow" data-reveal>{pick(service.eyebrow, lang)}</span>
        <h1 data-sy-reveal="words">{pick(service.title, lang)}</h1>
        <p data-sy-reveal="lines">{pick(service.lead, lang)}</p>
        <a href="#evidence" data-reveal data-cursor="VIEW">{de ? "Belege ansehen" : "View evidence"} <i class="ui-arrow ui-arrow-down" aria-hidden="true"></i></a>
      </div>
    </header>

    {serviceKey === "motion" && <VideoStarter lang={lang} />}

    <section class="capabilities">
      <div class="u-container capability-grid">
        {service.capabilities.map((item, index) => (
          <div data-reveal><span>0{index + 1}</span><h2 data-sy-reveal="words">{pick(item.title, lang)}</h2><p data-sy-reveal="lines">{pick(item.text, lang)}</p></div>
        ))}
      </div>
    </section>

    {reel.length > 0 && (
      <section class="reel-strip" id="reel">
        <div class="u-container">
          <span class="eyebrow" data-reveal>{de ? "AUSSCHNITTE" : "SELECTED FILMS"}</span>
          <div class="reel-grid">
            {reel.map((film) => (
              <figure data-reveal data-film>
                <button type="button" data-film-play data-track="video_play" data-track-item={film.id} data-track-place="motion-page" aria-label={`${de ? "Film abspielen" : "Play film"}: ${film.title}`}>
                  <img src={film.img} alt={`${film.title} — ${pick({ en: film.detail!.en, de: film.detail!.de }, lang)}`} loading="lazy" width="800" height="450" />
                  <span class="reel-play" aria-hidden="true"></span>
                </button>
                {/* preload="none" is the whole point: the poster is an image, the
                    film is 4 MB, and most visitors will read the page instead. */}
                <video data-film-video src={film.video} poster={film.img} preload="none" playsinline loop controls hidden></video>
                <figcaption>
                  <strong>{film.title}</strong>
                  <span>{film.detail!.tools}</span>
                  <p>{pick({ en: film.detail!.en, de: film.detail!.de }, lang)}</p>
                </figcaption>
              </figure>
            ))}
          </div>
          <a class="reel-more" href="/gallery/" data-tunnel data-reveal data-cursor="ENTER">
            <span>{de ? "Das gesamte 3D-Archiv" : "The whole 3D archive"}</span>
            <i class="ui-arrow" aria-hidden="true"></i>
          </a>
        </div>
      </section>
    )}

    {/* Shot on location. This is here on purpose and not folded into the films
        above: a client who needs someone to turn up at an event and hand back a
        publishable vertical cut the same day is not reading a page about
        Cinema 4D, and there is no reason to make them infer it. */}
    {fieldReel.length > 0 && (
      <section class="reel-strip reel-strip--field" id="field-reel">
        <div class="u-container">
          <span class="eyebrow" data-reveal>{de ? "VOR ORT GEDREHT" : "SHOT ON LOCATION"}</span>
          <p class="field-lead" data-reveal>
            {de
              ? "Nicht jedes Video braucht ein Set. Manchmal braucht es jemanden, der zum Termin kommt, dreht und noch am selben Tag einen Schnitt zurückgibt, den der Kunde so veröffentlichen kann."
              : "Not every video needs a set. Sometimes it needs someone who turns up at the event, shoots it, and hands back a cut the client can publish the same day."}
          </p>
          <div class="reel-grid reel-grid--field">
            {fieldReel.map((film) => (
              <figure data-reveal data-film>
                <button type="button" data-film-play data-track="video_play" data-track-item={film.id} data-track-place="motion-page" aria-label={`${de ? "Film abspielen" : "Play film"}: ${film.title}`}>
                  <img src={film.img} alt={`${film.title} — ${pick({ en: film.detail!.en, de: film.detail!.de }, lang)}`} loading="lazy" width="464" height="848" />
                  <span class="reel-play" aria-hidden="true"></span>
                </button>
                <video data-film-video src={film.video} poster={film.img} preload="none" playsinline loop controls hidden></video>
                <figcaption>
                  <strong>{film.title}</strong>
                  <span>{film.detail!.tools}</span>
                  <p>{pick({ en: film.detail!.en, de: film.detail!.de }, lang)}</p>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="evidence" id="evidence">
      <div class="u-container">
        {/* Only the pages whose rows came out of a real client launch get to
            call them that. The rest are how the work is built — a one-second
            LCP measured on this site, zero plugins, one tap to a phone number —
            and no doctor's or restaurant's launch produced them. */}
        <span class="eyebrow" data-reveal>{
          service.proofKind === "evidence"
            ? (de ? "BELEGE AUS ECHTEN LAUNCHES" : "EVIDENCE FROM REAL LAUNCHES")
            : service.proofKind === "production"
              ? (de ? "BELEGE AUS ECHTEN PRODUKTIONEN" : "EVIDENCE FROM REAL PRODUCTIONS")
              : (de ? "SO WIRD HIER GEBAUT" : "HOW THE WORK IS BUILT")
        }</span>
        {/* A row of three bare numbers in a large black space was the whole
            section. The note under each one says where the figure comes from —
            the raw pair behind a percentage, the source behind a claim — which
            is the difference between a statistic and a poster. `is-text` is for
            values that are not numbers: "RU / EN / UZ" set at 6rem wrapped onto
            two lines and collided with its own label. */}
        <div class="metrics">
          {service.proof.map((item) => (
            <div data-reveal>
              <strong data-count-up={/^[+\-]?[\d.,]/.test(item.value) ? true : undefined} class:list={{ "is-text": !/^[+\-]?[\d.,]/.test(item.value) }}>{item.value}</strong>
              <p>{pick(item.label, lang)}</p>
              {item.note && <span class="metric-note">{pick(item.note, lang)}</span>}
            </div>
          ))}
        </div>
        {service.proofNote && <p class="proof-note" data-reveal>{pick(service.proofNote, lang)}</p>}
        {/* Relevance over habit: a page about a landing page for a medical
            practice leads with the one-page case, not a 429-page platform.
            `data-case-link` only where a warp scene exists for that case. */}
        <div class="case-links">
          {(service.cases ?? ["bridge", "fidic"]).map((id, index) => {
            const item = cases[id];
            return (
              <a
                href={`/work/${item.slug}/`}
                data-case-link={item.warp ? true : undefined}
                data-reveal
                data-cursor="OPEN"
              >
                {/* The card carried the project's name and nothing else, which
                    asks a reader to click on faith. The picture is the project;
                    the line under it is what the project was. */}
                <img src={item.image} alt="" loading="lazy" aria-hidden="true" />
                <span>CASE / {String(index + 1).padStart(2, "0")}</span>
                <strong>{caseName[id]}</strong>
                <p>{pick(item.tagline, lang)}</p>
                <b>
                  <span>{item.stack} · {item.year}</span>
                  <span>{de ? "Case öffnen" : "Open case"} <i class="ui-arrow" aria-hidden="true"></i></span>
                </b>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <section class="research">
      <div class="u-container research-grid">
        <div><span class="eyebrow" data-reveal>RESEARCH</span><h2 data-sy-reveal="words">{de ? "Die Logik hinter der Arbeit." : "The logic behind the work."}</h2></div>
        <div>{relatedInsights.map((item) => <a href={item.paths[lang]} data-reveal data-cursor="READ"><strong>{pick(item.title, lang)}</strong><span class="ui-arrow" aria-hidden="true"></span></a>)}</div>
      </div>
    </section>

    {siblings.length > 0 && (
      <section class="siblings">
        <div class="u-container">
          <span class="eyebrow" data-reveal>{
            serviceKey === "websites"
              ? (de ? "Für Ihre Branche" : "For your trade")
              : (de ? "Weiter hier" : "Keep reading")
          }</span>
          <div class="siblings-list">
            {siblings.map((item) => (
              <a href={item.paths[lang]} data-reveal data-cursor="OPEN">
                <strong>{pick(item.eyebrow, lang)}</strong>
                <span>{pick(item.title, lang)}</span>
                <i class="ui-arrow" aria-hidden="true"></i>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="service-audit">
      <div class="u-container">
        <AuditCta lang={lang} compact />
      </div>
    </section>

    <section class="faq">
      <div class="u-container"><span class="eyebrow" data-reveal>FAQ</span>{service.faq.map((item) => <details data-reveal><summary>{pick(item.question, lang)}</summary><p>{pick(item.answer, lang)}</p></details>)}</div>
    </section>

    {scope && serviceKey !== "motion" && (
      <section class="service-cta">
        <div class="u-container">
          <span class="eyebrow" data-reveal>{de ? "WAS ES KOSTET" : "WHAT IT COSTS"}</span>
          <h2 data-sy-reveal="words">{pickScope(scope.label, lang)}</h2>
          <dl class="cta-figures" data-reveal>
            <div>
              <dt>{de ? "Zeitrahmen" : "Timeline"}</dt>
              <dd>{pickScope(scope.time, lang)}</dd>
            </div>
            {scope.price && (
              <div>
                <dt>{de ? "Ab" : "From"}</dt>
                <dd>{pickScope(scope.price, lang)}</dd>
              </div>
            )}
            <div>
              <dt>{de ? "Antwort" : "Reply"}</dt>
              <dd>{de ? "Binnen eines Tages" : "Within a day"}</dd>
            </div>
          </dl>
          <p data-reveal>{pickScope(scope.needs, lang)}</p>
          <div class="cta-links" data-reveal>
            <a class="cta-primary" href={`${de ? "/de/kontakt/" : "/contact/"}?project=${scope.id}`} data-track="quote_open" data-track-item={scope.id} data-track-place="service-page" data-cursor="OPEN" data-magnetic>
              {de ? "Festpreis anfragen" : "Get a fixed price"}<i class="ui-arrow" aria-hidden="true"></i>
            </a>
            <a class="cta-secondary" href={`${hub}?project=${scope.id}#scope`} data-cursor="VIEW">
              {de ? "Alle Projektgrößen und Preise" : "Every project size, priced"}<i class="ui-arrow" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </section>
    )}

    <div class="service-outro">
      <div class="u-container">
        <a class="outro-link" href={de ? "/de/leistungen/" : "/services/"} data-cursor="OPEN" data-magnetic>
          <i class="ui-arrow ui-arrow-back" aria-hidden="true"></i>
          <span>{de ? "Alle Leistungen & Research" : "All services & research"}</span>
        </a>
      </div>
    </div>
  </article>
</Layout>

<style>
  .service-page{position:relative;z-index:1;background:#030405}.service-hero{min-height:88svh;display:grid;align-items:end;padding:10rem 0 6rem;background:radial-gradient(circle at 74% 26%,rgba(255,255,255,.1),transparent 24rem)}.eyebrow{display:block;color:rgba(var(--rgb-text),.53);font:.64rem var(--font-inter);letter-spacing:.22em;text-transform:uppercase}.service-hero h1{max-width:12ch;margin:1.5rem 0;font:500 clamp(4rem,8vw,8rem)/.9 var(--font-display);letter-spacing:0}.service-hero p{max-width:48rem;color:rgba(var(--rgb-text),.76);font-size:clamp(1.2rem,2vw,1.65rem);line-height:1.55}.service-hero a{display:inline-block;margin-top:2rem;padding-bottom:.4rem;border-bottom:1px solid rgba(255,255,255,.35)}section{padding:clamp(5rem,9vw,9rem) 0;border-top:1px solid rgba(255,255,255,.08)}.capability-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.capability-grid>div{min-height:22rem;padding:1.6rem;border:1px solid rgba(255,255,255,.12);background:linear-gradient(145deg,rgba(255,255,255,.05),rgba(255,255,255,.008))}.capability-grid span,.case-links span{font:.62rem var(--font-inter);letter-spacing:.16em;color:rgba(var(--rgb-text),.45)}.capability-grid h2{margin:7rem 0 1rem;font:500 clamp(1.7rem,2.2vw,2.6rem)/1.04 var(--font-display);overflow-wrap:anywhere;hyphens:auto}.capability-grid p,.metrics p{color:rgba(var(--rgb-text),.65);line-height:1.55}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin:2rem 0 1.4rem}.metrics>div{padding:2rem 2rem 1.6rem;border-top:1px solid rgba(255,255,255,.28)}.metrics strong{display:block;font:500 clamp(3rem,6vw,6rem)/1 var(--font-display)}.metrics strong.is-text{font-size:clamp(1.9rem,3vw,2.9rem);letter-spacing:.01em}.case-links{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.case-links a{position:relative;isolation:isolate;overflow:hidden;min-height:20rem;display:flex;flex-direction:column;padding:1.6rem;border:1px solid rgba(255,255,255,.12);border-radius:6px;background:rgba(255,255,255,.025)}.case-links img{position:absolute;inset:0;z-index:-1;width:100%;height:100%;object-fit:cover;opacity:.34;transform:scale(1.04);transition:opacity .6s var(--ease-out-expo),transform .8s var(--ease-out-expo)}.case-links a::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(3,4,5,.72),rgba(3,4,5,.5) 42%,rgba(3,4,5,.94))}.case-links a:hover img{opacity:.5;transform:scale(1)}.case-links strong{margin:auto 0 .6rem;font:500 clamp(1.8rem,3.2vw,3rem)/1.02 var(--font-display)}.case-links p{max-width:34ch;margin:0 0 1.2rem;color:rgba(var(--rgb-text),.72);font-size:.92rem;line-height:1.5}.case-links b{display:flex;flex-wrap:wrap;gap:.6rem 1.4rem;justify-content:space-between;padding-top:1rem;border-top:1px solid rgba(255,255,255,.14);font:.65rem var(--font-inter);letter-spacing:.12em;text-transform:uppercase;color:rgba(var(--rgb-text),.62)}.research-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:5rem}.research h2{max-width:9ch;font:500 clamp(3rem,5vw,5.5rem)/.95 var(--font-display)}.research-grid>div:last-child{border-top:1px solid rgba(255,255,255,.14)}.research-grid a{display:flex;justify-content:space-between;gap:2rem;padding:1.5rem 0;border-bottom:1px solid rgba(255,255,255,.14);font:500 clamp(1.2rem,2vw,1.8rem)/1.2 var(--font-display)}.faq .u-container{max-width:70rem}.faq details{border-bottom:1px solid rgba(255,255,255,.14)}.faq summary{cursor:pointer;padding:1.5rem 0;font:500 clamp(1.2rem,2vw,1.7rem) var(--font-display)}.faq details p{max-width:50rem;padding:0 0 1.7rem;color:rgba(var(--rgb-text),.68);line-height:1.6}
  @media(max-width:800px){.capability-grid,.metrics,.case-links,.research-grid{grid-template-columns:1fr}.capability-grid h2{margin-top:4rem}.service-hero{min-height:72svh;padding:8rem 0 4rem}.service-hero h1{max-width:100%;font-size:clamp(2.6rem,11.5vw,5.6rem);line-height:.93;overflow-wrap:anywhere;hyphens:auto}.capability-grid>div{min-height:18rem}.metrics strong{font-size:clamp(2.7rem,14vw,5rem);overflow-wrap:anywhere}.research h2{max-width:100%;overflow-wrap:anywhere;hyphens:auto}.research-grid a strong{min-width:0;overflow-wrap:anywhere;hyphens:auto}}@media(pointer:coarse){.capability-grid>div,.case-links a{background:rgba(9,10,11,.92)}}

  /* ── Back to the hub ───────────────────────────────────────────────────── */
  .back-link {
    position: fixed;
    top: 5.6rem;
    left: clamp(1rem, 5vw, 5rem);
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: .6rem;
    padding: .6rem 1rem;
    border: 1px solid rgba(255, 255, 255, .14);
    border-radius: 100px;
    background: rgba(6, 7, 8, .82);
    backdrop-filter: blur(12px);
    color: rgba(var(--rgb-text), .82);
    font: 600 .62rem var(--font-inter);
    letter-spacing: .16em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color .35s var(--ease-out-expo), border-color .35s var(--ease-out-expo), background .35s var(--ease-out-expo);
  }
  .back-link:hover { color: #fff; border-color: rgba(255, 255, 255, .34); background: rgba(16, 18, 20, .92); }
  .back-link .ui-arrow-back { transition: transform .35s var(--ease-out-expo); }
  .back-link:hover .ui-arrow-back { transform: translateX(-3px); }

  .ui-arrow-back { display: inline-block; width: .5rem; height: .5rem; border-left: 1px solid currentColor; border-bottom: 1px solid currentColor; transform: rotate(45deg); }

  @media (pointer: coarse) {
    .back-link { backdrop-filter: none; background: rgba(6, 7, 8, .96); top: 4.6rem; }
  }

  .metric-note {
    display: block;
    margin-top: .55rem;
    font-family: var(--font-inter);
    font-size: .64rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: rgba(var(--rgb-text), .38);
  }
  .proof-note {
    max-width: 52rem;
    margin: 0 0 3.4rem;
    color: rgba(var(--rgb-text), .5);
    font-size: .86rem;
    line-height: 1.55;
  }

  /* ── Selected films ────────────────────────────────────────────────────── */
  /*  Poster first, film on demand. Three 4 MB files autoplaying would make the
      page about video slower than every other page on the site, which is the
      one argument this page cannot afford to lose. */
  .reel-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 1.8rem;
  }
  .reel-grid figure { margin: 0; }

  .reel-grid [data-film-play] {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, .12);
    border-radius: 6px;
    overflow: hidden;
    background: #07080a;
    cursor: pointer;
  }
  .reel-grid img,
  .reel-grid video {
    display: block;
    width: 100%;
    /* height:auto is not decoration. The <img> carries width/height attributes
       for CLS, and those map to presentational hints — a real used height that
       aspect-ratio cannot override on its own. Without this line every poster
       on this page rendered at its attribute height (411x450 instead of
       411x231) and object-fit: cover quietly cropped the difference. */
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: #07080a;
  }
  .reel-grid video { border: 1px solid rgba(255, 255, 255, .12); border-radius: 6px; }
  /* `display: block` above outranks the reset's [hidden] rule, which is how the
     film ended up playing controls underneath its own poster. */
  .reel-grid video[hidden] { display: none; }
  .reel-grid [data-film-play] img { transition: transform .6s var(--ease-out-expo), opacity .4s ease; }
  .reel-grid [data-film-play]:hover img { transform: scale(1.03); opacity: .82; }

  .reel-play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 3.4rem;
    height: 3.4rem;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(255, 255, 255, .55);
    border-radius: 50%;
    background: rgba(6, 7, 8, .55);
    backdrop-filter: blur(6px);
    transition: background .35s ease, border-color .35s ease;
  }
  .reel-play::after {
    content: "";
    position: absolute;
    left: 54%;
    top: 50%;
    width: 0;
    height: 0;
    transform: translate(-50%, -50%);
    border-left: .62rem solid #fff;
    border-block: .42rem solid transparent;
  }
  .reel-grid [data-film-play]:hover .reel-play { background: rgba(12, 14, 16, .8); border-color: #fff; }

  /* The vertical strip. Narrow columns on purpose: a 9:16 card at a third of a
     1200px container would be nearly 700px tall and swallow the section. */
  .reel-strip--field { padding-top: 0; }
  .field-lead {
    max-width: 54ch;
    margin: .9rem 0 0;
    color: rgba(var(--rgb-text), .6);
    font-size: .95rem;
    line-height: 1.6;
  }
  /* Each field reel is a poster beside its caption rather than above it. A 9:16
     card is 246px wide and its description is thirteen lines long underneath —
     the text ends up in a gutter while two thirds of the row sit empty. */
  .reel-grid--field { grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr)); gap: 2rem; }
  .reel-grid--field figure {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    align-items: start;
    gap: 1.5rem;
  }
  .reel-grid--field img,
  .reel-grid--field video { aspect-ratio: 9 / 16; }
  /* One reel alone takes the full row, and without a cap its description runs
     the whole 1200px of it. */
  .reel-grid--field figcaption { padding-top: 0; max-width: 46ch; }
  @media (max-width: 560px) {
    .reel-grid--field figure { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .reel-grid--field [data-film-play] { max-width: 17rem; }
    .reel-grid--field figcaption { padding-top: .9rem; }
  }

  .reel-grid figcaption { display: grid; gap: .3rem; padding-top: .9rem; }
  .reel-grid figcaption strong { font: 500 1.05rem var(--font-display); }
  .reel-grid figcaption span {
    font: .58rem var(--font-inter);
    letter-spacing: .14em;
    color: rgba(var(--rgb-text), .42);
  }
  .reel-grid figcaption p {
    margin: .2rem 0 0;
    color: rgba(var(--rgb-text), .6);
    font-size: .84rem;
    line-height: 1.5;
  }

  .reel-more {
    display: inline-flex;
    align-items: center;
    gap: .7rem;
    margin-top: 2.4rem;
    padding-bottom: .35rem;
    border-bottom: 1px solid rgba(255, 255, 255, .28);
    font: .74rem var(--font-inter);
    letter-spacing: .16em;
    text-transform: uppercase;
    transition: gap .45s var(--ease-out-expo), border-color .35s ease;
  }
  .reel-more:hover { gap: 1.15rem; border-color: #fff; }

  @media (max-width: 900px) {
    .reel-grid { grid-template-columns: 1fr; gap: 2rem; }
  }
  @media (pointer: coarse) {
    .reel-play { backdrop-filter: none; }
  }

  /* ── What it costs ─────────────────────────────────────────────────────── */
  .service-cta h2 {
    margin: 1.4rem 0 0;
    font: 500 clamp(2.2rem, 4vw, 3.6rem)/1.02 var(--font-display);
  }
  .service-audit { border-top: 1px solid rgba(255, 255, 255, .08); }
  .cta-figures {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 3.2rem;
    margin: 2rem 0 1.6rem;
  }
  .cta-figures > div { position: relative; padding-left: 1rem; }
  .cta-figures > div::before {
    content: "";
    position: absolute;
    left: 0;
    top: .2rem;
    bottom: .2rem;
    width: 1px;
    background: rgba(255, 255, 255, .24);
  }
  .cta-figures dt {
    font: .6rem var(--font-inter);
    letter-spacing: .2em;
    text-transform: uppercase;
    color: rgba(var(--rgb-text), .44);
  }
  .cta-figures dd { margin: .45rem 0 0; font: 500 1.5rem var(--font-display); }
  .service-cta > .u-container > p {
    max-width: 46rem;
    color: rgba(var(--rgb-text), .66);
    line-height: 1.6;
  }
  .cta-links { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2.2rem; }
  .cta-primary,
  .cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: .8rem;
    padding: 1rem 1.7rem;
    border-radius: 100px;
    font: .74rem var(--font-inter);
    letter-spacing: .16em;
    text-transform: uppercase;
    transition: opacity .25s ease, border-color .35s ease, gap .45s var(--ease-out-expo);
  }
  .cta-primary { background: var(--color-text); color: #0b0e12; }
  .cta-primary:hover { opacity: .86; gap: 1.2rem; }
  .cta-secondary { border: 1px solid rgba(255, 255, 255, .2); color: rgba(var(--rgb-text), .84); }
  .cta-secondary:hover { border-color: rgba(255, 255, 255, .5); color: #fff; gap: 1.2rem; }

  /* ── Outro ─────────────────────────────────────────────────────────────── */
  .siblings { padding: clamp(3rem, 6vw, 5rem) 0 0; }
  .siblings-list {
    display: grid;
    gap: 1px;
    margin-top: 1.6rem;
    background: var(--color-line);
    border-block: 1px solid var(--color-line);
  }
  .siblings-list a {
    display: grid;
    gap: 0.35rem;
    padding: clamp(1.2rem, 2.5vw, 1.8rem) 0;
    background: var(--color-bg, #030405);
    color: var(--color-text);
  }
  .siblings-list a strong {
    font-family: var(--font-inter);
    font-size: var(--font-size-xs);
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-alt);
  }
  .siblings-list a span { font-size: clamp(1.05rem, 2vw, 1.4rem); max-width: 44ch; }
  .siblings-list a:hover span { color: var(--color-accent); }
  @media (min-width: 900px) {
    .siblings-list a { grid-template-columns: 18rem minmax(0, 1fr) auto; align-items: baseline; gap: 2rem; }
  }

  .service-outro { padding: clamp(3rem, 6vw, 5rem) 0 clamp(4rem, 8vw, 7rem); border-top: 1px solid rgba(255, 255, 255, .08); }
  .outro-link {
    display: inline-flex;
    align-items: center;
    gap: .8rem;
    padding: 1rem 1.6rem;
    border: 1px solid rgba(255, 255, 255, .14);
    border-radius: 6px;
    color: rgba(var(--rgb-text), .85);
    font: 600 .68rem var(--font-inter);
    letter-spacing: .16em;
    text-transform: uppercase;
    transition: color .35s var(--ease-out-expo), border-color .35s var(--ease-out-expo), background .35s var(--ease-out-expo);
  }
  .outro-link:hover { color: #fff; border-color: rgba(255, 255, 255, .3); background: rgba(255, 255, 255, .05); }

  /* ── Reveal base (ScrollTrigger lifts these in) ────────────────────────── */
  [data-reveal] { opacity: 0; transform: translateY(26px); will-change: transform, opacity; }
  @media (prefers-reduced-motion: reduce) { [data-reveal] { opacity: 1; transform: none; } }
</style>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  import { REVEAL } from "../utils/reveals";

  gsap.registerPlugin(ScrollTrigger);

  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const items = gsap.utils.toArray<HTMLElement>("[data-reveal]");

  if (reduced) {
    gsap.set(items, { opacity: 1, y: 0 });
  } else {
    // Each element joins the site-wide reveal wave instead of staggering
    // inside its own batch: block reveals and split text then belong to one
    // cascade in document order, rather than two that merely overlap.
    ScrollTrigger.batch(items, {
      start: "top 88%",
      once: true,
      onEnter: (batch) =>
        gsap.to(batch, {
          opacity: 1,
          y: 0,
          duration: REVEAL.block.duration,
          ease: REVEAL.ease,
          stagger: 0.06,
          overwrite: true,
          onStart: () => batch.forEach((el) => (el as HTMLElement).classList.add("is-in")),
        }),
    });

    // Metrics count up from zero — the proof numbers should land, not just sit.
    gsap.utils.toArray<HTMLElement>("[data-count-up]").forEach((el) => {
      const raw = el.textContent?.trim() ?? "";
      const match = raw.match(/^([^\d-]*)(-?[\d.]+)(.*)$/);
      if (!match) return; // non-numeric values (e.g. "RU / EN / UZ") stay as-is
      const [, prefix, num, suffix] = match;
      const end = parseFloat(num);
      const decimals = (num.split(".")[1] || "").length;
      const obj = { v: 0 };
      ScrollTrigger.create({
        trigger: el,
        start: "top 88%",
        once: true,
        onEnter: () =>
          gsap.to(obj, {
            v: end,
            duration: 1.4,
            ease: "power2.out",
            onUpdate: () => (el.textContent = `${prefix}${obj.v.toFixed(decimals)}${suffix}`),
          }),
      });
    });

    document.fonts?.ready.then(() => ScrollTrigger.refresh());
  }

  // ── Selected films ─────────────────────────────────────────────────────────
  // The poster is a button; pressing it swaps in the <video> and starts it. The
  // file has preload="none" until then, so a visitor who never presses play
  // downloads three JPEGs rather than twelve megabytes of MP4.
  document.querySelectorAll<HTMLElement>("[data-film]").forEach((figure) => {
    const button = figure.querySelector<HTMLButtonElement>("[data-film-play]");
    const video = figure.querySelector<HTMLVideoElement>("[data-film-video]");
    if (!button || !video) return;

    button.addEventListener("click", () => {
      button.hidden = true;
      video.hidden = false;
      video.play().catch(() => {
        // Autoplay refused (a policy that varies by platform). The controls are
        // already there, so leave it paused and visible rather than reverting.
      });
    });

    // One film at a time: starting a second one pauses the first, which is what
    // anyone expects and what stops three soundtracks stacking.
    video.addEventListener("play", () => {
      document.querySelectorAll<HTMLVideoElement>("[data-film-video]").forEach((other) => {
        if (other !== video) other.pause();
      });
    });
  });
</script>
