---
// ─────────────────────────────────────────────────────────────────────────────
//  ServicesHub — the Services & Research hub, in one language per URL.
//
//  It used to be a single English route that swapped itself into German in the
//  browser. A crawler never runs that swap, so a German visitor could be
//  reading German prose under an English <title>, an English description and an
//  English FAQ schema — the three things search actually reads. Two real URLs
//  now: /services and /de/leistungen/, both lockLang, with the switcher in the
//  header moving between them instead of rewriting the page underneath.
//
//  Every card's href still lives in the dictionary, so each one points at the
//  deep-dive in the language of the page it is on.
// ─────────────────────────────────────────────────────────────────────────────
import Layout from "../layouts/Layout.astro";
import ScopePicker from "./ScopePicker.astro";
import { useTranslations, type Lang, type UIKey } from "../i18n/utils";

interface Props { lang: Lang }
const { lang } = Astro.props;
const de = lang === "de";
const c = <T,>(en: T, deValue: T): T => (de ? deValue : en);
const t = useTranslations(lang);
const tk = (key: string) => t(key as UIKey);

const paths = { en: "/services/", de: "/de/leistungen/" };

const services = [1, 2, 3, 4, 5].map((n) => ({
  n,
  title: `services.${n}.title`,
  text: `services.${n}.text`,
  href: `services.${n}.href`,
}));

const how = [1, 2, 3, 4].map((n) => ({
  n,
  title: `services.how.${n}.title`,
  text: `services.how.${n}.text`,
}));

const faq = [1, 2, 3, 4, 5].map((n) => ({
  n,
  q: `services.faq.${n}.q`,
  a: `services.faq.${n}.a`,
}));

const research = [1, 2, 3, 4].map((n) => ({
  n,
  title: `research.${n}.title`,
  text: `research.${n}.text`,
  href: `research.${n}.href`,
}));
---

<Layout
  lang={lang}
  lockLang
  alternateUrls={{ en: paths.en, de: paths.de, "x-default": paths.en }}
  title={c(
    "Websites, Video & SEO in Vienna — services and prices",
    "Websites, Video & SEO in Wien — Leistungen und Preise",
  )}
  description={c(
    "Starting prices for a landing page, business website, short or reel, online shop, SEO, platform and showreel-grade build in Vienna.",
    "Startpreise für Landingpage, Unternehmens-Website, Short oder Reel, Online-Shop, SEO, Plattform und Showreel-Niveau in Wien.",
  )}
  image={c("/og/services-en.jpg", "/og/services-de.jpg")}
  imageAlt={c(
    "Rodion Belousov — services and prices: websites, reels, video, SEO and 3D in Vienna",
    "Rodion Belousov — Leistungen und Preise: Websites, Reels, Video, SEO und 3D in Wien",
  )}
  keywords={c(
    [
      "Digital Marketing Vienna",
      "Technical SEO Vienna",
      "Creative Development Vienna",
      "3D animation Vienna",
      "video editor Vienna",
      "reels editing Vienna",
      "website prices Vienna",
      "Rodion Belousov Services",
    ],
    [
      "Digital Marketing Wien",
      "Technical SEO Wien",
      "Creative Development Wien",
      "3D Animation Wien",
      "Video Editor Wien",
      "Reels schneiden Wien",
      "Website Kosten Wien",
      "Rodion Belousov Leistungen",
    ],
  )}
  structuredData={[
    {
      "@type": "CollectionPage",
      name: c("Services & Research", "Leistungen & Research"),
      description: c(
        "Websites, shorts, reels, video editing, technical SEO, creative development and 3D production by Rodion Belousov, with starting prices.",
        "Websites, Shorts, Reels, Videoschnitt, Technical SEO, Creative Development und 3D-Produktion von Rodion Belousov — mit Startpreisen.",
      ),
      creator: { "@id": "https://rodionbelousov.studio/#rodion-belousov" },
    },
    {
      "@type": "FAQPage",
      mainEntity: faq.map((item) => ({
        "@type": "Question",
        name: tk(item.q),
        acceptedAnswer: { "@type": "Answer", text: tk(item.a) },
      })),
    },
  ]}
>
  <!-- ── Hero (deliberately distinct from the homepage) ───────────────────── -->
  <section class="svc-hero" data-hero>
    <div class="u-container">
      <span class="svc-eyebrow" data-i18n="services.eyebrow">{t("services.eyebrow")}</span>
      <h1 class="svc-title" data-sy-reveal="words" data-i18n="services.title">
        {t("services.title")}
      </h1>
      <p class="svc-lead" data-sy-reveal="lines" data-i18n="services.lead">{t("services.lead")}</p>

      <!-- Shown only to someone who arrived with a scope already picked, from
           the profile page or a link. Without it the page answered a question
           that had just been asked: a full-height hero about the practice in
           general, while the visitor's own answer sat a screen below. The
           values are read out of the picker rather than restated here, so
           there is still one price table on the site. -->
      <a class="svc-carried" href="#scope" data-scope-carried data-cursor="VIEW" hidden>
        <span class="svc-carried-key" data-i18n="services.carried.label">{t("services.carried.label")}</span>
        <strong data-scope-carried-label></strong>
        <span class="svc-carried-meta">
          <span data-scope-carried-time></span>
          <span data-scope-carried-price></span>
        </span>
        <i class="ui-arrow ui-arrow-down" aria-hidden="true"></i>
      </a>
    </div>
  </section>

  <!-- ── What you need, priced ────────────────────────────────────────────
       This page is the one in the nav and the one a visitor opens to find out
       what things cost. Until now the prices were on the Vienna profile page,
       reachable only through a small link in the footer. Same component, same
       table — see src/data/scopes.ts. -->
  <section class="svc-section" id="scope">
    <div class="u-container">
      <span class="svc-idx">01 - <span data-i18n="services.scope.label">{t("services.scope.label")}</span></span>
      <h2 class="svc-h2" data-sy-reveal="words" data-i18n="services.scope.title">{t("services.scope.title")}</h2>
      <p class="svc-section-lead" data-sy-reveal="lines" data-i18n="services.scope.lead">{t("services.scope.lead")}</p>

      <ScopePicker lang={lang} />

      <p class="svc-scope-note" data-reveal data-i18n="services.scope.note">{t("services.scope.note")}</p>
      <a class="svc-scope-cta" href={de ? "/de/kontakt/" : "/contact/"} data-scope-cta data-reveal data-cursor="OPEN" data-magnetic>
        <span data-i18n="services.scope.cta">{t("services.scope.cta")}</span>
        <i aria-hidden="true">→</i>
      </a>
    </div>
  </section>

  <!-- ── Disciplines ──────────────────────────────────────────────────────── -->
  <section class="svc-section" id="services">
    <div class="u-container">
      <span class="svc-idx">02 - <span data-i18n="services.disciplines.label">{t("services.disciplines.label")}</span></span>

      <div class="cards">
        {
          services.map((s) => (
            <a
              class="card"
              href={tk(s.href)}
              data-i18n-attr={`href:${s.href}, data-transition-label:${s.title}`}
              data-reveal
              data-cursor="OPEN"
              data-transition-label={tk(s.title)}
            >
              <span class="card-glint" aria-hidden="true" />
              <span class="card-n">{String(s.n).padStart(2, "0")}</span>
              <h2 class="card-title" data-i18n={s.title}>
                {tk(s.title)}
              </h2>
              <p class="card-text" data-i18n={s.text}>
                {tk(s.text)}
              </p>
              <span class="card-open">
                <span data-i18n="services.open">{t("services.open")}</span>
                <i aria-hidden="true">→</i>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Research ─────────────────────────────────────────────────────────── -->
  <section class="svc-section" id="research">
    <div class="u-container">
      <span class="svc-idx">03 - <span data-i18n="research.label">{t("research.label")}</span></span>
      <h2 class="svc-h2" data-sy-reveal="words" data-i18n="research.title">
        {t("research.title")}
      </h2>

      <div class="rows">
        {
          research.map((r) => (
            <a
              class="row"
              href={tk(r.href)}
              data-i18n-attr={`href:${r.href}, data-transition-label:${r.title}`}
              data-reveal
              data-cursor="READ"
              data-transition-label={tk(r.title)}
            >
              <span class="row-n">{String(r.n).padStart(2, "0")}</span>
              <span class="row-main">
                <span class="row-title" data-i18n={r.title}>
                  {tk(r.title)}
                </span>
                <span class="row-text" data-i18n={r.text}>
                  {tk(r.text)}
                </span>
              </span>
              <i class="row-arrow" aria-hidden="true">→</i>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── 03 How the three combine ──────────────────────────────────────── -->
  <section class="svc-section" id="how">
    <div class="u-container">
      <span class="svc-idx">04 - <span data-i18n="services.how.label">{t("services.how.label")}</span></span>
      <h2 class="svc-h2" data-sy-reveal="words" data-i18n="services.how.title">{t("services.how.title")}</h2>
      <p class="svc-section-lead" data-sy-reveal="lines" data-i18n="services.how.lead">{t("services.how.lead")}</p>

      <div class="rows">
        {
          how.map((item) => (
            <div class="row static" data-reveal>
              <span class="row-n">{String(item.n).padStart(2, "0")}</span>
              <span class="row-main">
                <span class="row-title" data-i18n={item.title}>{tk(item.title)}</span>
                <span class="row-text" data-i18n={item.text}>{tk(item.text)}</span>
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── 04 FAQ ───────────────────────────────────────────────────────────  -->
  <section class="svc-section" id="faq">
    <div class="u-container">
      <span class="svc-idx">05 - <span data-i18n="services.faq.label">{t("services.faq.label")}</span></span>
      <h2 class="svc-h2" data-sy-reveal="words" data-i18n="services.faq.title">{t("services.faq.title")}</h2>

      <div class="svc-faq">
        {
          faq.map((item) => (
            <details data-reveal>
              <summary data-i18n={item.q}>{tk(item.q)}</summary>
              <p data-i18n={item.a}>{tk(item.a)}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Added sections ────────────────────────────────────────────────────── */
  .svc-section-lead {
    max-width: 62ch;
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    color: rgba(var(--rgb-text), .7);
    font-size: clamp(1.02rem, 1.5vw, 1.25rem);
    line-height: 1.6;
    text-wrap: pretty;
  }
  /* A non-navigating variant of .row — same rhythm, no hover or arrow. */
  .row.static { cursor: default; }

  .svc-faq { max-width: 68rem; }
  .svc-faq details { border-bottom: 1px solid rgba(255, 255, 255, .14); }
  .svc-faq summary {
    cursor: pointer;
    padding: 1.5rem 0;
    font: 500 clamp(1.1rem, 1.9vw, 1.6rem)/1.25 var(--font-display);
    text-wrap: balance;
  }
  .svc-faq details p {
    max-width: 62ch;
    padding: 0 0 1.7rem;
    margin: 0;
    color: rgba(var(--rgb-text), .68);
    line-height: 1.65;
    text-wrap: pretty;
  }

  /* ── Hero ──────────────────────────────────────────────────────────────── */
  .svc-hero {
    min-height: 82svh;
    display: flex;
    align-items: center;
    padding: 9rem 0 5rem;
  }

  /* A visitor who arrived with a scope chosen has already read the general
     pitch — they came for their own number. The hero gives up its height so
     the picker is the next thing on the screen rather than the next screen. */
  .svc-hero.is-carried {
    min-height: 0;
    padding: 8.5rem 0 3rem;
  }

  .svc-carried {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem 1rem;
    margin-top: 2.2rem;
    padding: 0.85rem 1.3rem;
    border: 1px solid rgba(var(--rgb-text), 0.16);
    border-radius: 999px;
    background: rgba(var(--rgb-white), 0.03);
    color: var(--color-text);
    transition: border-color 0.35s ease, background-color 0.35s ease;
  }
  .svc-carried:hover { border-color: rgba(var(--rgb-text), 0.4); background: rgba(var(--rgb-white), 0.06); }

  .svc-carried-key {
    font-family: var(--font-inter);
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(var(--rgb-text), 0.42);
  }
  .svc-carried strong { font-size: 0.95rem; font-weight: 500; }
  .svc-carried-meta {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    font-size: 0.82rem;
    color: rgba(var(--rgb-text), 0.66);
  }
  .svc-carried-meta span:empty { display: none; }

  @media (max-width: 620px) {
    .svc-carried { border-radius: 14px; }
  }

  .svc-eyebrow {
    display: inline-block;
    font-family: var(--font-inter);
    font-size: var(--font-size-xs);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .svc-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.8rem, 8.5vw, 8rem);
    line-height: 0.94;
    letter-spacing: -0.04em;
    margin: 1.4rem 0 0;
    max-width: 14ch;
  }

  .svc-lead {
    margin: 2rem 0 0;
    max-width: 52ch;
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    line-height: 1.6;
    color: var(--color-text-alt);
  }

  /* ── Section shell ─────────────────────────────────────────────────────── */
  .svc-section {
    padding: clamp(4.5rem, 10vw, 9rem) 0;
    border-top: 1px solid var(--color-line);
  }

  .svc-idx {
    display: inline-block;
    font-family: var(--font-inter);
    font-size: var(--font-size-xs);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-text-alt);
    margin-bottom: 2.5rem;
  }

  .svc-h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.9rem, 4.5vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.035em;
    margin: 0 0 2.5rem;
    max-width: 18ch;
    /* German compounds outrun the line on a phone. Hyphenation where a
       dictionary exists, and the soft hyphens carried in the string itself
       where one does not — the reset's overflow-wrap: break-word stays as the
       last resort it is meant to be. */
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  /* ── Service cards ─────────────────────────────────────────────────────── */
  /* The site-wide sculpture sits exactly where the picker does, and a chrome
     sphere behind six option cards makes them unreadable. Same opaque-surface
     treatment /notes and /contact use, with the radial glow keeping the light
     the backdrop was giving. */
  #scope {
    position: relative;
    z-index: 1;
    background:
      radial-gradient(circle at 84% 8%, rgba(255, 255, 255, 0.07), transparent 32rem),
      #030405;
  }

  .svc-scope-note {
    max-width: 54ch;
    margin: 2.4rem 0 0;
    color: var(--color-text-alt);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .svc-scope-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1.6rem;
    padding: 0.95rem 1.7rem;
    border-radius: 999px;
    background: var(--color-text);
    color: #0b0e12;
    font-size: 0.76rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: opacity 0.25s ease;
  }
  .svc-scope-cta:hover { opacity: 0.86; }

  /* Five disciplines on a three-column grid leaves a hole. Six columns with
     the first three cards spanning two and the last two spanning three gives
     a full 3 + 2 composition instead of a gap where a card should be. */
  .cards {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.25rem;

    @media (--mq-tablet) {
      grid-template-columns: 1fr;
    }
  }
  .card { grid-column: span 2; }
  .card:nth-child(4),
  .card:nth-child(5) { grid-column: span 3; }
  @media (--mq-tablet) {
    .card,
    .card:nth-child(4),
    .card:nth-child(5) { grid-column: auto; }
  }

  .card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 2rem 1.75rem 1.75rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.022);
    color: var(--color-text);
    transition:
      border-color 0.45s var(--ease-out-expo),
      background 0.45s var(--ease-out-expo),
      transform 0.45s var(--ease-out-expo);

    &:hover,
    &:focus-visible {
      border-color: rgba(255, 255, 255, 0.2);
      background: rgba(255, 255, 255, 0.05);
      transform: translateY(-4px);
    }
  }

  /* chrome sheen sweeping across on hover */
  .card-glint {
    position: absolute;
    inset: -40% -60%;
    background: linear-gradient(
      100deg,
      transparent 35%,
      rgba(255, 255, 255, 0.11) 50%,
      transparent 65%
    );
    transform: translateX(-60%);
    opacity: 0;
    transition: transform 0.9s var(--ease-out-expo), opacity 0.5s;
    pointer-events: none;
  }
  .card:hover .card-glint {
    transform: translateX(60%);
    opacity: 1;
  }

  .card-n {
    font-family: var(--font-inter);
    font-size: var(--font-size-xs);
    letter-spacing: 0.2em;
    color: var(--color-accent);
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    letter-spacing: -0.025em;
    margin: 0;
  }

  .card-text {
    margin: 0;
    color: var(--color-text-alt);
    font-size: var(--font-size-sm);
    line-height: 1.6;
    flex: 1;
  }

  .card-open {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-family: var(--font-inter);
    font-size: var(--font-size-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-alt);
    transition: color 0.35s var(--ease-out-expo);

    i {
      font-style: normal;
      transition: transform 0.4s var(--ease-out-expo);
    }
  }
  .card:hover .card-open {
    color: #fff;
  }
  .card:hover .card-open i {
    transform: translateX(5px);
  }

  /* ── Research rows ─────────────────────────────────────────────────────── */
  .rows {
    display: flex;
    flex-direction: column;
  }

  .row {
    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    gap: 1.5rem;
    align-items: center;
    padding: 1.6rem 0;
    border-top: 1px solid var(--color-line);
    color: var(--color-text);
    transition: padding-left 0.45s var(--ease-out-expo);

    &:last-child {
      border-bottom: 1px solid var(--color-line);
    }

    &:hover,
    &:focus-visible {
      padding-left: 0.75rem;
    }

    @media (--mq-tablet-sm) {
      grid-template-columns: 2.5rem 1fr;
      gap: 1rem;
    }
  }

  .row-n {
    font-family: var(--font-inter);
    font-size: var(--font-size-xs);
    letter-spacing: 0.2em;
    color: var(--color-accent);
  }

  .row-main {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .row-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.15rem, 2vw, 1.6rem);
    letter-spacing: -0.02em;
    transition: color 0.35s var(--ease-out-expo);
  }

  .row-text {
    color: var(--color-text-alt);
    font-size: var(--font-size-sm);
  }

  .row-arrow {
    font-style: normal;
    color: var(--color-text-alt);
    transition: transform 0.4s var(--ease-out-expo), color 0.35s;

    @media (--mq-tablet-sm) {
      display: none;
    }
  }

  .row:hover .row-title {
    color: var(--color-accent);
  }
  .row:hover .row-arrow {
    transform: translateX(6px);
    color: #fff;
  }

  /* reveal base — ScrollTrigger batch below lifts these in */
  [data-reveal] {
    opacity: 0;
    transform: translateY(26px);
    will-change: transform, opacity;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  import { REVEAL } from "../utils/reveals";

  gsap.registerPlugin(ScrollTrigger);

  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const items = gsap.utils.toArray<HTMLElement>("[data-reveal]");

  if (reduced) {
    gsap.set(items, { opacity: 1, y: 0 });
  } else {
    // Each element joins the site-wide reveal wave instead of staggering inside
    // its own batch: block reveals and split text then belong to one cascade in
    // document order, rather than two that merely overlap.
    ScrollTrigger.batch(items, {
      start: "top 88%",
      once: true,
      onEnter: (batch) =>
        gsap.to(batch, {
          opacity: 1,
          y: 0,
          duration: REVEAL.block.duration,
          ease: REVEAL.ease,
          stagger: 0.06,
          overwrite: true,
          onStart: () => batch.forEach((el) => (el as HTMLElement).classList.add("is-in")),
        }),
    });
    document.fonts?.ready.then(() => ScrollTrigger.refresh());
  }

  // ── The scope carried in from elsewhere ────────────────────────────────────
  // /services?project=<id> is how the profile page hands a choice over. The
  // picker already opens on the right panel; this puts the answer where the
  // visitor is actually looking when they land — at the top — and takes the
  // hero's height back so the picker is a scroll away, not a screen away.
  //
  // The label, timeline and price are read out of the picker's own DOM rather
  // than restated here: scopes.ts stays the one place a price is written, and
  // the language swapper only has to translate one copy of them.
  const carried = document.querySelector<HTMLAnchorElement>("[data-scope-carried]");
  const scopePicker = document.querySelector<HTMLElement>("[data-scope-picker]");

  if (carried && scopePicker) {
    const wanted = new URLSearchParams(location.search).get("project");

    const fill = () => {
      const tab = scopePicker.querySelector<HTMLElement>("[data-scope-tab][aria-selected='true']");
      const id = tab?.dataset.scopeTab;
      if (!id) return;
      const panel = scopePicker.querySelector<HTMLElement>(`[data-scope-panel="${CSS.escape(id)}"]`);
      const text = (node: Element | null | undefined) => node?.textContent?.trim() || "";
      const write = (selector: string, value: string) => {
        const node = carried.querySelector<HTMLElement>(selector);
        if (node) node.textContent = value;
      };
      write("[data-scope-carried-label]", text(tab.querySelector(".sc-tab-label")));
      write("[data-scope-carried-time]", text(panel?.querySelector("[data-scope-value='time']")));
      const price = text(panel?.querySelector("[data-scope-value='price']"));
      write("[data-scope-carried-price]", price ? `${price}` : "");
    };

    if (wanted && scopePicker.querySelector(`[data-scope-tab="${CSS.escape(wanted)}"]`)) {
      document.querySelector(".svc-hero")?.classList.add("is-carried");
      carried.hidden = false;
      fill();
      // The picker announces every change, including the one it makes itself
      // when it reads the parameter, and the switcher retranslates the values
      // underneath us — follow both rather than snapshotting once.
      scopePicker.addEventListener("rb:scopechange", fill);
      addEventListener("rb:langchange", () => requestAnimationFrame(fill));
    }
  }
</script>
