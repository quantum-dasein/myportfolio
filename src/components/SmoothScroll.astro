<script>
  declare global {
    interface Window {
      scrollVelocity: number;
      scrollDirection: number;
      scrollCurrent: number;
      scrollStickyOffsets: [number, number, number][];
      __rbLenis?: Lenis;
    }
  }

  import Lenis from "lenis";
  import ScrollTrigger from "gsap/ScrollTrigger";
  import { addGlobalTicker } from "../utils/globalTicker";

  window.scrollStickyOffsets = window.scrollStickyOffsets || [];
  window.scrollVelocity = 0;
  window.scrollDirection = 1;

  // Touch scroll stays entirely browser-owned, including momentum and toolbar
  // resizing on iOS. Do not write scrollTo from a native scroll/scrollend event.
  const nativeScroll = matchMedia("(pointer: coarse)").matches;
  let lenis: Lenis | null = null;

  if (nativeScroll) {
    window.scrollCurrent = scrollY;
    let previous = scrollY;
    addEventListener("scroll", () => {
      window.scrollVelocity = scrollY - previous;
      if (window.scrollVelocity) window.scrollDirection = Math.sign(window.scrollVelocity);
      window.scrollCurrent = previous = scrollY;
      ScrollTrigger.update();
    }, { passive: true });
  } else {
    lenis = new Lenis({
      // syncTouch made Lenis intercept every touchmove to run its own transform
      // scroll — which BLOCKS native horizontal scroll containers (the Behance
      // carousel would not swipe) and fought the finger on iOS. Off: mobile uses
      // the browser's own (already smooth) touch scrolling; Lenis still smooths
      // the desktop wheel. This also settles the leftover mobile scroll jank.
      syncTouch: false,
      lerp: 0.125,
    });
    const l = lenis;
    window.__rbLenis = l;
    l.on("scroll", ScrollTrigger.update);

    l.direction = 1;

    addGlobalTicker((t: number) => {
      l.raf(t * 1000);
      window.scrollVelocity = l.velocity;
      window.scrollDirection = l.direction;
      window.scrollCurrent = l.animatedScroll;
    });

    let syncFrame = 0;
    const syncNativeJump = () => {
      cancelAnimationFrame(syncFrame);
      syncFrame = requestAnimationFrame(() => {
        const nativeY = window.scrollY;
        const delta = Math.abs(nativeY - l.animatedScroll);
        if (delta > Math.max(180, innerHeight * .32)) {
          l.scrollTo(nativeY, { immediate: true, force: true });
          window.scrollCurrent = nativeY;
          ScrollTrigger.update();
        }
      });
    };

    addEventListener("scroll", syncNativeJump, { passive: true });
    addEventListener("scrollend", () => l.scrollTo(window.scrollY, { immediate: true, force: true }), { passive: true });
    addEventListener("resize", () => {
      l.resize();
      requestAnimationFrame(() => ScrollTrigger.refresh());
    }, { passive: true });

    document.fonts?.ready.then(() => {
      l.resize();
      requestAnimationFrame(() => ScrollTrigger.refresh());
    });
  }

  // ── In-page anchor navigation — every device ────────────────────────────
  // This used to live inside the Lenis branch, so turning Lenis off for touch
  // took the whole of it out with it: on a phone, #about / #work / #contact-cta
  // and every cross-page "/#work" arrival fell back to the browser's raw hash
  // jump. With a fixed header and a layout still settling as images land, that
  // put people somewhere arbitrary down the page — usually far past the section
  // they tapped. It is shared now, and uses Lenis only when Lenis exists.
  // global.css already declares `[id] { scroll-margin-top: 5.25rem }`, so the
  // clearance under the fixed header is stated once, in CSS, and read from the
  // element here. Passing an element plus an offset to Lenis counted it twice —
  // desktop landed 189px below the header instead of 84 — so both paths resolve
  // a number themselves and hand Lenis that.
  const HEADER_OFFSET = 84;
  const anchorTop = (el: HTMLElement) => {
    const margin = parseFloat(getComputedStyle(el).scrollMarginTop);
    const clearance = Number.isFinite(margin) && margin > 0 ? margin : HEADER_OFFSET;
    return Math.max(0, el.getBoundingClientRect().top + window.scrollY - clearance);
  };

  const scrollToHash = (hash: string, immediate = false) => {
    if (!hash || hash === "#") return false;
    let target: HTMLElement | null = null;
    try {
      target = document.querySelector<HTMLElement>(hash);
    } catch {
      return false; // a hash that is not a valid selector
    }
    if (!target) return false;
    const y = anchorTop(target);
    if (lenis) {
      lenis.scrollTo(y, { immediate, duration: immediate ? 0 : 1.05, force: true });
    } else {
      window.scrollTo({ top: y, left: 0, behavior: immediate ? "auto" : "smooth" });
    }
    return true;
  };

  document.addEventListener("click", (event) => {
    const anchor = (event.target as HTMLElement).closest<HTMLAnchorElement>("a[href*='#']");
    if (!anchor || anchor.hasAttribute("data-tunnel") || anchor.hasAttribute("data-case-link")) return;
    const url = new URL(anchor.href, location.href);
    if (url.origin !== location.origin || url.pathname !== location.pathname || !url.hash) return;
    if (!scrollToHash(url.hash)) return;
    event.preventDefault();
    history.pushState(history.state, "", url.hash);
  });

  addEventListener("hashchange", () => scrollToHash(location.hash));

  // ── Where a new document lands ─────────────────────────────────────────────
  // Following a link must land at the top of the new page, or on the section its
  // hash names. Restoring a remembered position is for Back and Forward only —
  // the browser already does that on a back_forward entry, so nothing here may
  // touch one.
  //
  // Doing it once on arrival is not enough, and that was the bug. The position
  // was measured while the document was still assembling — Three.js scenes
  // mounting, ScrollTrigger inserting pin spacers, eager images landing — so the
  // three shots (rAF, load, fonts.ready) all fired against a layout that then
  // moved underneath them. Measured across the site, the same "/#work" resolved
  // to 5929px from one page and 0 from another, and "/#about" to 851 or 252.
  // When the intermediate layout is TALLER than the final one the same race
  // resolves past the end of the document and the browser clamps it to the
  // bottom — the "it throws me to the end of the page" report.
  //
  // So hold the landing instead: re-assert it every frame until the target stops
  // moving, then stop. The visitor's own scroll always wins — the first real
  // input hands the page back to them.
  const settleFrom = (resolve: () => number | null) => {
    const setScroll = (y: number) => {
      lenis?.scrollTo(y, { immediate: true, force: true });
      window.scrollTo({ top: y, left: 0, behavior: "auto" });
    };

    let done = false;
    const inputs = ["wheel", "touchstart", "keydown", "pointerdown"] as const;
    const release = () => {
      if (done) return;
      done = true;
      inputs.forEach((type) => removeEventListener(type, release));
    };
    // Passive: these only ever cancel our own correction, never the gesture.
    inputs.forEach((type) => addEventListener(type, release, { passive: true, once: true }));

    // Give up well before this becomes a page that fights the finger. The budget
    // only counts frames the document could actually scroll on — see below.
    const BUDGET = 3400;
    let spent = 0;
    let last = performance.now();
    let previous = Number.NaN;
    let previousHeight = -1;
    let stable = 0;

    const tick = (now: number) => {
      if (done) return;
      const frame = now - last;
      last = now;

      // While the intro lock is up, `overflow: hidden` clamps every scroll to 0,
      // so a correction applied now is silently discarded. Wait it out rather
      // than spend the budget on frames that cannot take effect.
      const locked = document.documentElement.classList.contains("is-preloading");
      if (!locked) {
        spent += frame;
        const raw = resolve();
        if (raw !== null) {
          const height = document.documentElement.scrollHeight;
          // Clamp to what the document can actually reach. A target resolved
          // against a page that has not finished growing routinely lands past
          // the end; the browser then clamps the scroll, and comparing the
          // request against the clamped result can never agree — which left the
          // hold running out its budget pinned to the very bottom. Exactly the
          // failure this whole thing exists to prevent, reintroduced one level
          // down.
          const y = Math.min(raw, Math.max(0, height - window.innerHeight));
          // Three things have to hold before we let go: the target has stopped
          // moving, the page is sitting where we put it, and the document has
          // stopped growing underneath both of them.
          stable =
            Math.abs(y - previous) < 2 &&
            Math.abs(window.scrollY - y) < 2 &&
            height === previousHeight
              ? stable + 1
              : 0;
          previous = y;
          previousHeight = height;
          setScroll(y);
        }
      }

      if (stable >= 4 || spent > BUDGET) release();
      else requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  {
    const entry = performance.getEntriesByType("navigation")[0] as PerformanceNavigationTiming | undefined;
    // A reload keeps your place, and back/forward is the browser's to restore.
    const followedALink = !entry || entry.type === "navigate";

    // The case and archive transitions load the origin page fresh and put the
    // visitor back exactly where they left it. That is a Back in everything but
    // navigation type, so it owns the landing position — stay out of its way.
    let returning = false;
    try {
      returning = !!(sessionStorage.getItem("rb-case-return") || sessionStorage.getItem("rb-warp-return"));
    } catch {
      returning = false; // private mode
    }

    if (followedALink && !returning) {
      if (location.hash) {
        settleFrom(() => {
          let target: HTMLElement | null = null;
          try {
            target = document.querySelector<HTMLElement>(location.hash);
          } catch {
            return null;
          }
          return target ? anchorTop(target) : null;
        });
      } else {
        settleFrom(() => 0);
      }
    }
  }
</script>

<style>
  html.lenis,
  html.lenis body {
    height: auto;
  }

  .lenis:not(.lenis-autoToggle).lenis-stopped {
    overflow: clip;
  }

  .lenis.lenis-smooth [data-lenis-prevent] {
    overscroll-behavior: contain;
  }

  .lenis.lenis-smooth iframe {
    pointer-events: none;
  }

  .lenis.lenis-autoToggle {
    transition-property: overflow;
    transition-duration: 1ms;
    transition-behavior: allow-discrete;
  }
</style>
