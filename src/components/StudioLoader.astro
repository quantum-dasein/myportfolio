---
import type { Lang } from "../i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
---

<!--
  First visit of a session: the page's own headline, set in the site's display face where it will
  stand, drawn first as a hairline outline and filled with light from left to right as the page
  really loads; the headline is the progress bar. Below it, the four crafts light one after another.
  Then the black gives way and the outline hands over to the real headline in place.
  One canvas, the site's own type, no library, no images.
-->
<rb-studio-loader aria-hidden="true" data-lang={lang}>
  <div class="ld-ground"></div>
  <canvas class="ld-type" data-ld-type></canvas>
</rb-studio-loader>

<style>
  :global(html.rb-loader-seen) rb-studio-loader { display: none; }
  rb-studio-loader:not(.is-playing) { display: none; }

  rb-studio-loader { position: fixed; inset: 0; z-index: 1000; }
  rb-studio-loader.is-hidden { pointer-events: none; }
  .ld-ground { position: absolute; inset: 0; background: #000; transition: opacity .9s cubic-bezier(.4, 0, .2, 1); }
  .ld-type { position: absolute; inset: 0; width: 100%; height: 100%; transition: opacity .7s ease .25s; }
  rb-studio-loader.is-opening .ld-ground { opacity: 0; }
  rb-studio-loader.is-opening .ld-type { opacity: 0; }
</style>

<script>
  class StudioLoader extends HTMLElement {
    private deadline = 0;
    private dismissed = false;
    private raf = 0;

    connectedCallback() {
      let seen = false;
      try { seen = sessionStorage.getItem("rb-loader-seen") === "1"; } catch { /* storage can be unavailable */ }
      if (seen) {
        document.documentElement.classList.remove("is-preloading");
        document.body.classList.remove("is-preloading");
        document.body.classList.add("is-loaded");
        this.remove();
        queueMicrotask(() => window.dispatchEvent(new CustomEvent("rb:loaded")));
        return;
      }
      try { sessionStorage.setItem("rb-loader-seen", "1"); } catch { /* intro still works */ }
      this.classList.add("is-playing");
      document.documentElement.classList.add("is-preloading");
      document.body.classList.add("is-preloading");
      // The scroll lock must never outlive the intro, whatever happens to the frame loop.
      this.deadline = window.setTimeout(() => this.dismiss(), 5000);
      try { this.play(); } catch { this.dismiss(); }
    }

    private play() {
      const canvas = this.querySelector<HTMLCanvasElement>("[data-ld-type]")!;
      const x = canvas.getContext("2d");
      if (!x) { this.dismiss(); return; }
      const de = (this.dataset.lang || "en") === "de";
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const touch = matchMedia("(max-width: 760px), (pointer: coarse)").matches;
      const W = innerWidth, H = innerHeight, dpr = Math.min(devicePixelRatio || 1, 2);
      canvas.width = W * dpr; canvas.height = H * dpr; x.scale(dpr, dpr);
      const display = getComputedStyle(document.documentElement).getPropertyValue("--font-display").trim() || "system-ui, sans-serif";

      // ── The headline to draw: the real one, where it will stand, in its own type ────────────
      type Line = { text: string; left: number; top: number; height: number; font: string; spacing: string };
      let lines: Line[] = [];
      const measure = () => {
      const next: Line[] = [];
      const sources = [...document.querySelectorAll<HTMLElement>(".hero-title .line")];
      const shift = (el: HTMLElement) => { const m = new DOMMatrixReadOnly(getComputedStyle(el).transform === "none" ? undefined : getComputedStyle(el).transform); return m.m42; };
      for (const el of sources) {
        const cs = getComputedStyle(el), font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
        const dy = shift(el), spacing = cs.letterSpacing === "normal" ? "0px" : cs.letterSpacing;
        // A line may wrap on narrow screens: take each word's own box and regroup them into the rows the page shows.
        const rows: { words: string[]; left: number; top: number; height: number }[] = [];
        const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
        for (let node = walker.nextNode(); node; node = walker.nextNode()) {
          const text = node.textContent || "";
          for (const m of text.matchAll(/\S+/g)) {
            const range = document.createRange(); range.setStart(node, m.index!); range.setEnd(node, m.index! + m[0].length);
            const r = range.getBoundingClientRect(); if (r.width < 1) continue;
            const row = rows.find((w) => Math.abs(w.top - r.top) < r.height * .5);
            if (row) { row.words.push(m[0]); row.left = Math.min(row.left, r.left); }
            else rows.push({ words: [m[0]], left: r.left, top: r.top, height: r.height });
          }
        }
        rows.sort((a, b) => a.top - b.top).forEach((r) => next.push({ text: r.words.join(" "), left: r.left, top: r.top - dy, height: r.height, font, spacing }));
      }
      if (!next.length) {
        // Elsewhere: the name, centred, in the same face.
        const size = Math.min(W * .075, 64), font = `400 ${size}px ${display}`;
        x.font = font; const w = x.measureText("Rodion Belousov").width;
        next.push({ text: "Rodion Belousov", left: (W - w) / 2, top: H / 2 - size * .7, height: size * 1.2, font, spacing: "-0.02em" });
      }
      lines = next;
      };
      // The headline reflows once the display face arrives: follow it so the outline hands over in place.
      measure();
      document.fonts?.ready.then(measure);
      addEventListener("load", measure, { once: true });
      window.setTimeout(measure, 400);
      const crafts = de ? ["Websites", "Video", "3D", "SEO"] : ["Websites", "Video", "3D", "SEO"];

      // ── Real progress: fonts, document, eager images; walked to the end by the budget ──────
      const BUDGET = touch ? 1.7 : 2.2;
      const MIN_RUN = reduced ? 0.2 : touch ? 1.2 : 1.5;
      let fontsDone = 0, domDone = document.readyState === "complete" ? 1 : 0;
      document.fonts?.ready.then(() => (fontsDone = 1));
      if (!domDone) addEventListener("load", () => (domDone = 1), { once: true });
      const eager = [...document.images].filter((img) => img.loading !== "lazy");
      const pending = eager.filter((img) => !img.complete);
      const total = Math.max(1, eager.length);
      let loaded = eager.length - pending.length;
      let imagesDone = pending.length ? loaded / total : 1;
      pending.forEach((img) => { const bump = () => (imagesDone = ++loaded / total); img.addEventListener("load", bump, { once: true }); img.addEventListener("error", bump, { once: true }); });
      const real = () => fontsDone * 0.3 + domDone * 0.25 + imagesDone * 0.45;
      const ceiling = (s: number) => (s >= MIN_RUN ? 1 : 1 - Math.pow(1 - s / MIN_RUN, 1.6));
      const clamp = (v: number) => Math.max(0, Math.min(1, v));

      const start = performance.now();
      let shown = 0;
      const tick = () => {
        if (this.dismissed) return;
        const s = (performance.now() - start) / 1000;
        const target = Math.min(Math.max(real(), Math.min(1, s / BUDGET)), ceiling(s));
        shown += (target - shown) * 0.12; if (s > BUDGET) shown = 1;
        const p = Math.min(1, shown);
        x.clearRect(0, 0, W, H);
        const appear = clamp(s / .5);

        // The headline: a hairline outline, filled with light line by line as the page arrives.
        lines.forEach((l, i) => {
          x.font = l.font; (x as CanvasRenderingContext2D & { letterSpacing?: string }).letterSpacing = l.spacing;
          x.textBaseline = "alphabetic";
          const m = x.measureText(l.text), asc = m.actualBoundingBoxAscent || l.height * .72, desc = m.actualBoundingBoxDescent || 0;
          const y = l.top + (l.height - (asc + desc)) / 2 + asc;
          x.globalAlpha = appear;
          x.lineWidth = 1; x.strokeStyle = "rgba(255,255,255,.28)"; x.strokeText(l.text, l.left, y);
          const k = clamp(p * lines.length - i);
          if (k > 0) {
            x.save(); x.beginPath(); x.rect(l.left - 4, l.top - l.height, (m.width + 8) * k, l.height * 3); x.clip();
            x.fillStyle = "#f4f4f2"; x.fillText(l.text, l.left, y); x.restore();
          }
        });

        // The four crafts, lit one after another along the bottom.
        x.globalAlpha = appear; x.textBaseline = "alphabetic";
        x.font = `400 ${touch ? 13 : 14}px ${display}`; (x as CanvasRenderingContext2D & { letterSpacing?: string }).letterSpacing = "0.02em";
        const gap = touch ? 22 : 30; let cx = touch ? 24 : Math.max(24, lines[0].left);
        // Along the bottom, unless the headline reaches down there; then along the top.
        const last = lines[lines.length - 1], low = H - (touch ? 34 : 44);
        const rowY = last.top + last.height > low - 30 ? (touch ? 48 : 56) : low;
        crafts.forEach((word, i) => {
          x.fillStyle = `rgba(244,244,242,${.22 + .68 * clamp((p - i * .22) / .18)})`;
          x.fillText(word, cx, rowY); cx += x.measureText(word).width + gap;
        });
        x.textAlign = "right"; x.fillStyle = "rgba(244,244,242,.5)";
        x.fillText(String(Math.round(p * 100)), W - (touch ? 24 : Math.max(24, lines[0].left)), rowY);
        x.textAlign = "left"; x.globalAlpha = 1;

        if (p >= 0.999 && s > MIN_RUN) { this.dismiss(); return; }
        this.raf = requestAnimationFrame(tick);
      };
      this.raf = requestAnimationFrame(tick);
    }

    private dismiss() {
      if (this.dismissed) return;
      this.dismissed = true;
      clearTimeout(this.deadline);
      cancelAnimationFrame(this.raf);
      this.classList.add("is-hidden", "is-opening");
      document.body.classList.add("is-loaded");
      document.documentElement.classList.remove("is-preloading");
      document.body.classList.remove("is-preloading");
      window.__rbLenis?.resize();
      window.dispatchEvent(new CustomEvent("rb:loaded"));
      window.setTimeout(() => this.remove(), 1400);
    }
  }

  if (!customElements.get("rb-studio-loader")) {
    customElements.define("rb-studio-loader", StudioLoader);
  }
</script>
