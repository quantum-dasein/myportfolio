---
import type { Lang } from "../i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const isDe = lang === "de";
---

<!--
  First visit of a session: the site's own night. Black, a few white stars like the home hero,
  the studio's name rising letter by letter, a hairline that fills as the page's assets arrive,
  then the curtain lifts onto the page. Monochrome, no library, no images.
-->
<rb-studio-loader aria-hidden="true" data-lang={lang}>
  <canvas class="ld-sky" data-ld-sky></canvas>
  <div class="ld-center">
    <p class="ld-name" data-ld-name>Rodion Belousov<span>.studio</span></p>
    <div class="ld-line"><i data-ld-line></i></div>
    <div class="ld-meta"><span>{isDe ? "Websites · Video · 3D · Wien" : "Websites · Video · 3D · Vienna"}</span><b data-ld-count>000</b></div>
  </div>
</rb-studio-loader>

<style>
  :global(html.rb-loader-seen) rb-studio-loader { display: none; }
  rb-studio-loader:not(.is-playing) { display: none; }

  rb-studio-loader {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #000;
    color: #f2f2f2;
    will-change: transform;
  }
  rb-studio-loader.is-hidden { pointer-events: none; }
  .ld-sky { position: absolute; inset: 0; width: 100%; height: 100%; }

  .ld-center { position: relative; width: fit-content; max-width: 90vw; }
  .ld-name {
    margin: 0 0 1.4rem;
    font: 400 clamp(2rem, 5.2vw, 3.6rem)/1 var(--font-display);
    letter-spacing: -.02em;
    white-space: nowrap;
  }
  .ld-name span { color: rgba(242, 242, 242, .45); }
  /* Each letter rises out of a mask, one after another. */
  .ld-name :global(.ld-ch) { display: inline-block; transform: translateY(105%); opacity: 0; transition: transform .5s cubic-bezier(.2, .8, .2, 1), opacity .45s ease; }
  .ld-name :global(.ld-mask) { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: .08em; }
  rb-studio-loader.is-in .ld-name :global(.ld-ch) { transform: none; opacity: 1; }

  .ld-line { position: relative; height: 1px; background: rgba(255, 255, 255, .14); overflow: hidden; }
  .ld-line i { position: absolute; inset: 0; background: #fff; transform-origin: left; transform: scaleX(0); }

  .ld-meta {
    display: flex;
    justify-content: space-between;
    margin-top: .9rem;
    font: 400 clamp(.6rem, .85vw, .72rem)/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: rgba(242, 242, 242, .5);
  }
  .ld-meta b { font-weight: 400; color: #f2f2f2; font-variant-numeric: tabular-nums; }

  /* Out: the words fade, the curtain lifts onto the page. */
  .ld-center { transition: opacity .4s ease, transform .5s cubic-bezier(.6, 0, .4, 1); }
  rb-studio-loader.is-opening .ld-center { opacity: 0; transform: translateY(-14px); }
  rb-studio-loader.is-opening { transform: translateY(-100%); transition: transform 1s cubic-bezier(.76, 0, .24, 1) .28s; }

  @media (prefers-reduced-motion: reduce) {
    .ld-name :global(.ld-ch) { transition: opacity .3s ease; transform: none; }
    rb-studio-loader.is-opening { transform: none; opacity: 0; transition: opacity .4s ease; }
  }
</style>

<script>
  class StudioLoader extends HTMLElement {
    private deadline = 0;
    private dismissed = false;
    private raf = 0;

    connectedCallback() {
      let seen = false;
      try { seen = sessionStorage.getItem("rb-loader-seen") === "1"; } catch { /* storage can be unavailable */ }
      if (seen) {
        document.documentElement.classList.remove("is-preloading");
        document.body.classList.remove("is-preloading");
        document.body.classList.add("is-loaded");
        this.remove();
        queueMicrotask(() => window.dispatchEvent(new CustomEvent("rb:loaded")));
        return;
      }

      try { sessionStorage.setItem("rb-loader-seen", "1"); } catch { /* intro still works */ }
      this.classList.add("is-playing");
      document.documentElement.classList.add("is-preloading");
      document.body.classList.add("is-preloading");

      // The scroll lock must never outlive the intro, whatever happens to the frame loop.
      this.deadline = window.setTimeout(() => this.dismiss(), 5000);
      try { this.play(); } catch { this.dismiss(); }
    }

    private play() {
      const count = this.querySelector<HTMLElement>("[data-ld-count]")!;
      const line = this.querySelector<HTMLElement>("[data-ld-line]")!;
      const name = this.querySelector<HTMLElement>("[data-ld-name]")!;
      const canvas = this.querySelector<HTMLCanvasElement>("[data-ld-sky]")!;
      const ctx = canvas.getContext("2d");

      // Split the name into masked letters that rise one after another.
      let i = 0;
      const wrap = (node: Node) => {
        for (const child of [...node.childNodes]) {
          if (child.nodeType === Node.TEXT_NODE) {
            const frag = document.createDocumentFragment();
            for (const ch of child.textContent ?? "") {
              const mask = document.createElement("span"); mask.className = "ld-mask";
              const inner = document.createElement("span"); inner.className = "ld-ch";
              inner.textContent = ch === " " ? " " : ch; inner.style.transitionDelay = `${i++ * 16}ms`;
              mask.append(inner); frag.append(mask);
            }
            child.replaceWith(frag);
          } else wrap(child);
        }
      };
      wrap(name);
      requestAnimationFrame(() => this.classList.add("is-in"));

      // Progress follows what really loads (fonts, document, eager images), is walked to the end
      // by the budget so a slow asset never holds the visitor, and has a short minimum run.
      const touch = matchMedia("(max-width: 760px), (pointer: coarse)").matches;
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const BUDGET = touch ? 1.6 : 2.2;
      const MIN_RUN = reduced ? 0.2 : touch ? 0.8 : 1.1;
      let fontsDone = 0, domDone = document.readyState === "complete" ? 1 : 0;
      document.fonts?.ready.then(() => (fontsDone = 1));
      if (!domDone) addEventListener("load", () => (domDone = 1), { once: true });
      const eager = [...document.images].filter((img) => img.loading !== "lazy");
      const pending = eager.filter((img) => !img.complete);
      const total = Math.max(1, eager.length);
      let loaded = eager.length - pending.length;
      let imagesDone = pending.length ? loaded / total : 1;
      pending.forEach((img) => {
        const bump = () => (imagesDone = ++loaded / total);
        img.addEventListener("load", bump, { once: true });
        img.addEventListener("error", bump, { once: true });
      });
      const real = () => fontsDone * 0.3 + domDone * 0.25 + imagesDone * 0.45;
      const ceiling = (s: number) => (s >= MIN_RUN ? 1 : 1 - Math.pow(1 - s / MIN_RUN, 1.7));

      // A few faint white stars, drifting, like the home page's sky.
      const dpr = Math.min(devicePixelRatio || 1, 1.5);
      canvas.width = innerWidth * dpr; canvas.height = innerHeight * dpr;
      let seed = 7;
      const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
      const stars = Array.from({ length: 110 }, () => ({ x: rnd(), y: rnd(), s: rnd(), p: rnd() * 6 }));

      const start = performance.now();
      let shown = 0;
      const tick = () => {
        if (this.dismissed) return;
        const elapsed = (performance.now() - start) / 1000;
        const target = Math.min(Math.max(real(), Math.min(1, elapsed / BUDGET)), ceiling(elapsed));
        shown += (target - shown) * 0.14;
        if (elapsed > BUDGET) shown = 1;
        const value = Math.min(1, shown);
        count.textContent = String(Math.round(value * 100)).padStart(3, "0");
        line.style.transform = `scaleX(${value})`;
        if (ctx) {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          ctx.fillStyle = "#fff";
          for (const st of stars) {
            ctx.globalAlpha = (0.08 + 0.32 * st.s) * (0.6 + 0.4 * Math.sin(elapsed * 1.6 + st.p));
            const r = (0.6 + st.s * 1.1) * dpr;
            ctx.fillRect(st.x * canvas.width, ((st.y - elapsed * 0.004 * (0.3 + st.s)) % 1 + 1) % 1 * canvas.height, r, r);
          }
          ctx.globalAlpha = 1;
        }
        if (value >= 0.999 && elapsed > MIN_RUN) { this.dismiss(); return; }
        this.raf = requestAnimationFrame(tick);
      };
      this.raf = requestAnimationFrame(tick);
    }

    private dismiss() {
      if (this.dismissed) return;
      this.dismissed = true;
      clearTimeout(this.deadline);
      cancelAnimationFrame(this.raf);
      this.classList.add("is-hidden", "is-opening");
      document.body.classList.add("is-loaded");
      document.documentElement.classList.remove("is-preloading");
      document.body.classList.remove("is-preloading");
      window.__rbLenis?.resize();
      window.dispatchEvent(new CustomEvent("rb:loaded"));
      window.setTimeout(() => this.remove(), 1500);
    }
  }

  if (!customElements.get("rb-studio-loader")) {
    customElements.define("rb-studio-loader", StudioLoader);
  }
</script>
