---
import type { Lang } from "../i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const isDe = lang === "de";

// The wordmark is split on the server so the letters are in the first paint,
// waiting under their mask. `--i` staggers the rise.
const words = ["Rodion", "Belousov"].map((word, w) =>
  [...word].map((ch, i) => ({ ch, i: w * 6 + i })),
);

// The counter is an odometer: one strip of digits per column, moved by a
// transform. Every strip only ever rolls forward, so each holds one cell per
// position it can reach — units 0…100, tens 0…10, hundreds 0…1.
const strip = (cells: number) => Array.from({ length: cells }, (_, i) => i % 10).join("\n");
---

<!--
  "Seam" — the first-visit intro.

  The name rises onto a hairline; the hairline fills with what is actually
  loading; the name catches the light, and the screen parts along the line
  onto the page.

  It is painted by HTML and CSS and driven by the small inline script below,
  so it is on screen from the first frame instead of waiting for a bundled
  module. Everything that moves is a transform or an opacity, the counter
  included: the script only hands the compositor a new position every
  150 ms, so a busy main thread (three.js compiling, a slow phone parsing)
  makes the roll slower, never frozen.

  Visibility hangs off `html.rb-intro`, which the boot script in Layout sets
  before first paint on the first page of a session. Without it (a returning
  page, storage blocked, script off) the element never displays at all.
-->
<rb-studio-loader aria-hidden="true">
  <div class="seam-half seam-top">
    <div class="seam-inner">
      <div class="seam-meta">
        <span>RB / Digital Studio</span>
        <span><span class="seam-coords">48.21° N 16.37° E / </span>{isDe ? "Wien" : "Vienna"}</span>
      </div>

      <div class="seam-mark">
        {words.map((letters) => (
          <span class="seam-word">
            {letters.map(({ ch, i }) => <span class="seam-ch" style={`--i:${i}`}>{ch}</span>)}
          </span>
        ))}
      </div>
    </div>
  </div>

  <div class="seam-half seam-bottom">
    <div class="seam-line">
      <span class="seam-fill" data-loader-line></span>
      <span class="seam-spark" data-loader-spark></span>
    </div>

    <div class="seam-inner">
      <div class="seam-readout">
        <span class="seam-phase" data-loader-phase>{isDe ? "RENDER INITIALISIEREN" : "INITIALISING RENDER"}</span>
        <span class="seam-count">
          <span class="seam-odo"><span data-odo="2">{strip(2)}</span></span>
          <span class="seam-odo"><span data-odo="1">{strip(11)}</span></span>
          <span class="seam-odo"><span data-odo="0">{strip(101)}</span></span>
          <small>%</small>
        </span>
      </div>

      <div class="seam-meta">
        <span>Websites · SEO · 3D &amp; Film</span>
        <span>Pass <b data-loader-pass>01/04</b></span>
      </div>
    </div>
  </div>
</rb-studio-loader>

<script is:inline>
  (function () {
    var el = document.currentScript && document.currentScript.previousElementSibling;
    var root = document.documentElement;
    var body = document.body;
    if (!el || el.localName !== "rb-studio-loader") return;

    // Returning page in this session: no intro, and the page is "loaded" now.
    // HeroHome and the home reveals check `is-loaded` or the element's absence.
    if (!root.classList.contains("rb-intro")) {
      el.remove();
      body.classList.add("is-loaded");
      setTimeout(function () { dispatchEvent(new CustomEvent("rb:loaded")); });
      return;
    }

    try { sessionStorage.setItem("rb-loader-seen", "1"); } catch (e) { /* intro still plays */ }

    var calm = matchMedia("(prefers-reduced-motion: reduce)").matches || root.classList.contains("rb-calm");
    var touch = matchMedia("(max-width: 760px), (pointer: coarse)").matches;
    var de = (root.lang || "").indexOf("de") === 0;
    var phases = de
      ? ["RENDER INITIALISIEREN", "GEOMETRIE BERECHNEN", "TYPOGRAFIE AUFLÖSEN", "PROJEKT-ARCHIV ÖFFNEN"]
      : ["INITIALISING RENDER", "TRACING GEOMETRY", "RESOLVING TYPOGRAPHY", "OPENING CASE ARCHIVE"];

    var line = el.querySelector("[data-loader-line]");
    var spark = el.querySelector("[data-loader-spark]");
    var phase = el.querySelector("[data-loader-phase]");
    var pass = el.querySelector("[data-loader-pass]");
    var odo = [
      el.querySelector('[data-odo="2"]'),
      el.querySelector('[data-odo="1"]'),
      el.querySelector('[data-odo="0"]'),
    ];

    // MIN_RUN runs from the moment the name starts to rise, so the parting can
    // never cut the rise short however late the first frame came. BUDGET runs
    // from navigation start — it is what the visitor has waited — and is the
    // ceiling after which the bar walks to full whatever is still loading.
    // HOLD is the beat at 100 where the line flares and the name catches the
    // light; EXIT is the parting itself.
    var MIN_RUN = calm ? 0.6 : touch ? 1.0 : 1.25;
    var BUDGET = touch ? 1.8 : 2.6;
    var HOLD = calm ? 120 : 420;
    var EXIT = calm ? 500 : 1300;

    // Real progress: the display face (30%), the parsed document (20%) and the
    // load event, which covers the eager images (50%).
    var fonts = 0, dom = 0, load = 0;
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(function () { fonts = 1; });
    else fonts = 1;
    if (document.readyState !== "loading") dom = 1;
    else document.addEventListener("DOMContentLoaded", function () { dom = 1; }, { once: true });
    if (document.readyState === "complete") load = 1;
    else addEventListener("load", function () { load = 1; }, { once: true });

    // The name rises in its own face or not at all: the face is preloaded and
    // usually here already, and if it is not, the letters wait under their
    // mask for it — 450 ms at most — instead of rising in Arial and swapping.
    var t0 = 0;
    function rise() {
      if (t0) return;
      t0 = performance.now();
      el.classList.add("is-rising");
    }
    try {
      var face = '500 1em "RB Space"';
      if (!document.fonts || document.fonts.check(face)) rise();
      else {
        document.fonts.load(face).then(rise, rise);
        setTimeout(rise, 450);
      }
    } catch (e) { rise(); }

    // The studio's decode, inlined (utils/decode.ts is a module, and modules
    // arrive too late to be any use here). Each phase resolves out of noise.
    var GLYPHS = "ABCDEFGHJKLMNPQRSTUVWXYZ0123456789/#*<>·";
    var decodeRun = 0;
    function decode(text) {
      var run = ++decodeRun;
      if (calm) { phase.textContent = text; return; }
      var start = performance.now();
      (function step(now) {
        if (run !== decodeRun) return;
        var t = Math.min((now - start) / 420, 1), solid = Math.floor(t * text.length), out = "";
        for (var i = 0; i < text.length; i++) {
          out += i < solid || text[i] === " " ? text[i] : GLYPHS[(Math.random() * GLYPHS.length) | 0];
        }
        phase.textContent = out;
        if (t < 1) requestAnimationFrame(step);
      })(start);
    }

    var painted = 0, lastPaint = 0, lastPhase = 0, done = false;
    function paint(value) {
      painted = value;
      line.style.transform = "scaleX(" + value / 100 + ")";
      spark.style.transform = "translate3d(" + value + "%,0,0)";
      odo[0].style.transform = "translate3d(0," + -Math.floor(value / 100) + "em,0)";
      odo[1].style.transform = "translate3d(0," + -Math.floor(value / 10) + "em,0)";
      odo[2].style.transform = "translate3d(0," + -value + "em,0)";
      var p = Math.min(3, Math.floor(value / 25.1));
      if (p !== lastPhase) {
        lastPhase = p;
        decode(phases[p]);
        pass.textContent = "0" + (p + 1) + "/04";
      }
    }

    function tick() {
      if (done) return;
      var now = performance.now();
      var since = t0 ? (now - t0) / 1000 : 0;
      var end = t0 ? Math.max(BUDGET, t0 / 1000 + MIN_RUN) : Infinity;
      var real = fonts * 0.3 + dom * 0.2 + load * 0.5;
      // The clock caps a warm cache (so the name always gets its run-up) and
      // the floor caps a slow asset (so it can stall the bar, not the visitor).
      var ceiling = since >= MIN_RUN ? 1 : 1 - Math.pow(1 - since / MIN_RUN, 1.7);
      var floor = t0 ? Math.min(1, since / (end - t0 / 1000)) : 0;
      var value = now / 1000 >= end ? 100 : Math.round(Math.min(Math.max(real, floor), ceiling) * 100);
      // Paint in strides, not every frame: each paint hands the compositor a
      // glide to the new value, so the digits roll rather than flicker.
      if (value !== painted && (value === 100 || now - lastPaint > 150)) {
        lastPaint = now;
        paint(value);
      }
      if (painted === 100 && since >= MIN_RUN) return complete();
      requestAnimationFrame(tick);
    }

    function unlock() {
      root.classList.remove("is-preloading");
      body.classList.remove("is-preloading");
    }

    function complete() {
      if (done) return;
      done = true;
      clearTimeout(deadline);
      paint(100);
      el.classList.add("is-complete");
      setTimeout(leave, HOLD);
    }

    function leave() {
      el.classList.add("is-leaving");
      // The scroll lock goes now, not when the curtain has finished: the
      // element is pointer-events:none from here on, so nothing can hit it.
      unlock();
      body.classList.add("is-loaded");
      if (window.__rbLenis) window.__rbLenis.resize();
      dispatchEvent(new CustomEvent("rb:loaded"));
      setTimeout(function () {
        el.remove();
        root.classList.remove("rb-intro");
      }, EXIT);
    }

    // Timers fire whether or not a frame is ever served (background tab,
    // throttled rAF), so the lock can never outlive the intro.
    var deadline = setTimeout(complete, 4200);
    requestAnimationFrame(tick);
  })();
</script>

<style>
  rb-studio-loader { display: none; }

  :global(html.rb-intro) rb-studio-loader {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: block;
    color: rgb(var(--rgb-text));
    pointer-events: auto;
    /* Last line of defence, in CSS so it holds even if no script runs: the
       curtain lifts itself. The inline script normally removes it long before. */
    animation: seam-bail 0.6s ease 5s forwards;
  }

  rb-studio-loader.is-leaving { pointer-events: none; }

  /* ── The two halves ─────────────────────────────────────────────────────── */
  .seam-half {
    position: absolute;
    left: 0;
    right: 0;
    height: 50%;
    overflow: hidden;
    background-color: var(--color-bg);
    will-change: transform;
    transition: transform 1.1s var(--ease-in-out-quart);
  }

  /* One glow, split down the middle: each half carries its own side of it, so
     it reads as continuous until the seam opens. */
  .seam-top {
    top: 0;
    background-image: radial-gradient(70% 90% at 50% 100%, rgba(255, 255, 255, 0.07), transparent 70%);
  }

  .seam-bottom {
    top: 50%;
    background-image: radial-gradient(70% 90% at 50% 0%, rgba(255, 255, 255, 0.07), transparent 70%);
  }

  .seam-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.1rem, 2.6vw, 2.4rem) var(--container-offset);
    transition: transform 1.1s var(--ease-in-out-quart), opacity 0.55s ease;
  }

  .seam-top .seam-inner { padding-bottom: 0; }
  .seam-bottom .seam-inner { padding-top: 0; }

  /* Parting: the halves leave, and what is printed on them lags a little
     behind, so the type looks set into a surface rather than onto glass. */
  .is-leaving .seam-top { transform: translate3d(0, -101%, 0); }
  .is-leaving .seam-bottom { transform: translate3d(0, 101%, 0); }
  .is-leaving .seam-top .seam-inner { transform: translate3d(0, 38%, 0); opacity: 0; }
  .is-leaving .seam-bottom .seam-inner { transform: translate3d(0, -38%, 0); opacity: 0; }

  /* ── Small print ────────────────────────────────────────────────────────── */
  .seam-meta,
  .seam-phase {
    font: 400 clamp(0.58rem, 0.8vw, 0.7rem) / 1.3 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .seam-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: rgba(var(--rgb-text), 0.46);
  }

  .seam-meta b {
    color: rgba(var(--rgb-text), 0.82);
    font-weight: 400;
  }

  .seam-bottom .seam-meta { order: 2; }

  /* ── The name, sitting on the seam ──────────────────────────────────────── */
  .seam-mark {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.24em;
    font-family: var(--font-display);
    font-size: min(10.2vw, 15rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.78;
    /* descender room inside the mask, then pulled back down onto the line */
    margin-bottom: -0.04em;
  }

  .seam-word {
    display: inline-flex;
    overflow: hidden;
    padding: 0.06em 0.02em 0.1em 0;
  }

  /* Chrome type with a highlight parked off to the right of every letter;
     at 100 it sweeps across them in turn, so the name catches the light just
     before the screen parts. */
  .seam-ch {
    display: inline-block;
    color: transparent;
    background-image:
      linear-gradient(105deg, transparent 36%, rgba(96, 106, 118, 0.85) 44%, #fff 50%, rgba(96, 106, 118, 0.85) 56%, transparent 64%),
      var(--chrome);
    background-size: 320% 100%, 100% 100%;
    background-position: 100% 0, 0 0;
    background-repeat: no-repeat;
    background-clip: text;
    -webkit-background-clip: text;
    transform: translate3d(0, 112%, 0);
  }

  .is-rising .seam-ch {
    animation: seam-rise 1.15s var(--ease-out-expo) forwards;
    animation-delay: calc(0.04s + var(--i) * 0.034s);
  }

  .is-complete .seam-ch {
    animation:
      seam-rise 1.15s var(--ease-out-expo) forwards,
      seam-glint 0.8s var(--ease-in-out-quad) forwards;
    animation-delay: calc(0.04s + var(--i) * 0.034s), calc(var(--i) * 0.022s);
  }

  /* ── The seam itself ────────────────────────────────────────────────────── */
  .seam-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1;
    height: 1px;
    background: rgba(var(--rgb-line), 0.14);
  }

  /* Fill and spark glide to each new value on the compositor, on the same
     curve, so they stay together however unevenly the values arrive. */
  .seam-fill,
  .seam-spark {
    position: absolute;
    inset: 0;
    transition: transform 0.6s cubic-bezier(0.16, 0.84, 0.24, 1);
  }

  .seam-fill {
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.3), #fff);
    box-shadow: 0 0 14px rgba(255, 255, 255, 0.5);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* the bright head of the fill, with a short comet tail behind it */
  .seam-spark::before,
  .seam-spark::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    border-radius: 999px;
  }

  .seam-spark::before {
    width: clamp(4rem, 12vw, 10rem);
    height: 1px;
    margin-left: calc(-1 * clamp(4rem, 12vw, 10rem));
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.9));
  }

  .seam-spark::after {
    width: 5px;
    height: 5px;
    margin: -2.5px 0 0 -2.5px;
    background: #fff;
    box-shadow: 0 0 10px 2px rgba(255, 255, 255, 0.8), 0 0 36px 8px rgba(205, 225, 235, 0.3);
  }

  /* the moment it completes: the line flares and the spark spends itself;
     then line and spark go with the halves */
  .is-complete .seam-fill { animation: seam-flare 0.7s ease-out forwards; }
  .is-complete .seam-spark { animation: seam-spent 0.5s ease-out forwards; }

  /* ── Readout under the line ─────────────────────────────────────────────── */
  .seam-readout {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding-top: clamp(0.8rem, 1.4vw, 1.3rem);
  }

  .seam-phase { color: rgba(var(--rgb-text), 0.72); }

  .seam-count {
    display: inline-flex;
    align-items: flex-start;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 6.4vw, 6.5rem);
    font-variant-numeric: tabular-nums;
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  /* one window per column, one digit tall */
  .seam-odo {
    display: block;
    height: 1em;
    overflow: hidden;
  }

  .seam-odo > span {
    display: block;
    white-space: pre;
    transition: transform 0.6s cubic-bezier(0.16, 0.84, 0.24, 1);
  }

  .seam-count small {
    margin: 0.04em 0 0 0.12em;
    color: rgba(var(--rgb-text), 0.5);
    font-size: 0.3em;
    letter-spacing: 0;
    line-height: 1;
  }

  @keyframes seam-rise {
    to { transform: translate3d(0, 0, 0); }
  }

  @keyframes seam-glint {
    to { background-position: -10% 0, 0 0; }
  }

  @keyframes seam-flare {
    0% { opacity: 1; box-shadow: 0 0 14px rgba(255, 255, 255, 0.5); }
    30% { opacity: 1; box-shadow: 0 0 40px 3px rgba(255, 255, 255, 0.6); }
    100% { opacity: 0.25; box-shadow: 0 0 0 rgba(255, 255, 255, 0); }
  }

  @keyframes seam-spent {
    30% { opacity: 1; }
    100% { opacity: 0; }
  }

  @keyframes seam-bail {
    to { opacity: 0; visibility: hidden; pointer-events: none; }
  }

  @media (max-width: 760px) {
    .seam-coords,
    .seam-bottom .seam-meta span:last-child { display: none; }
    .seam-mark {
      flex-direction: column;
      font-size: 17vw;
      line-height: 0.8;
    }
    .seam-readout { flex-direction: column-reverse; gap: 0.9rem; }
    .seam-count { font-size: 15vw; }
  }

  /* ── Calm: Reduce Motion, or the site's own Calm toggle ─────────────────
     Nothing travels. The name fades in, the bar still reports, and the
     curtain dissolves instead of parting. */
  @media (prefers-reduced-motion: reduce) {
    .is-rising .seam-ch,
    .is-complete .seam-ch { transform: none; opacity: 0; animation: seam-fade 0.5s ease forwards; animation-delay: 0.05s; }
    .seam-half, .seam-inner, .seam-odo > span { transition: none; }
    .is-leaving .seam-half, .is-leaving .seam-inner { transform: none; opacity: 1; }
    :global(html.rb-intro) rb-studio-loader.is-leaving { opacity: 0; transition: opacity 0.45s ease; }
  }

  :global(html.rb-calm) .is-rising .seam-ch,
  :global(html.rb-calm) .is-complete .seam-ch { transform: none; opacity: 0; animation: seam-fade 0.5s ease forwards; animation-delay: 0.05s; }
  :global(html.rb-calm) .seam-half,
  :global(html.rb-calm) .seam-inner,
  :global(html.rb-calm) .seam-odo > span { transition: none; }
  :global(html.rb-calm) .is-leaving .seam-half,
  :global(html.rb-calm) .is-leaving .seam-inner { transform: none; opacity: 1; }
  :global(html.rb-calm.rb-intro) rb-studio-loader.is-leaving { opacity: 0; transition: opacity 0.45s ease; }

  @keyframes seam-fade {
    to { opacity: 1; }
  }
</style>
