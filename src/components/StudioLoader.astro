---
import type { Lang } from "../i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const isDe = lang === "de";
---

<!--
  The observatory opens. The first visit of a session begins inside a closed dome: a slit of night
  sky with a green glow, widening as the page's own assets arrive (the slit is the progress bar),
  then the two shutters slide apart onto the site. No library and no images: a small star canvas
  and two transformed panels, so it costs almost nothing and runs on the compositor.
-->
<rb-studio-loader aria-hidden="true" data-lang={lang}>
  <canvas class="dome-sky" data-dome-sky></canvas>
  <div class="dome-glow"></div>
  <div class="dome-shutter dome-left"><i></i></div>
  <div class="dome-shutter dome-right"><i></i></div>
  <div class="dome-hud">
    <span>Rodion Belousov <em>·</em> {isDe ? "Wien" : "Vienna"}</span>
    <span class="dome-status"><span>{isDe ? "Die Sternwarte öffnet" : "The observatory opens"}</span><b data-dome-count>000</b></span>
  </div>
</rb-studio-loader>

<style>
  :global(html.rb-loader-seen) rb-studio-loader { display: none; }
  rb-studio-loader:not(.is-playing) { display: none; }

  rb-studio-loader {
    --slit: 4px;
    position: fixed;
    inset: 0;
    z-index: 1000;
    overflow: hidden;
    background: #020504;
    color: #eaf6ef;
  }
  rb-studio-loader.is-hidden { pointer-events: none; }

  .dome-sky, .dome-glow { position: absolute; inset: 0; width: 100%; height: 100%; transition: opacity .9s ease; }
  /* The green of the site's portals, rising in the slit like the glow over a city at night. */
  .dome-glow {
    background:
      radial-gradient(ellipse 22vw 60vh at 50% 40%, rgba(79, 220, 156, .2), transparent 70%),
      radial-gradient(ellipse 8vw 30vh at 50% 34%, rgba(170, 255, 214, .16), transparent 70%);
    pointer-events: none;
  }

  .dome-shutter {
    position: absolute;
    top: 0;
    bottom: 0;
    width: calc(50% + 1px);
    background:
      repeating-linear-gradient(180deg, transparent 0 calc(12.5vh - 1px), rgba(160, 255, 210, .045) calc(12.5vh - 1px) 12.5vh),
      linear-gradient(180deg, #0b100e, #060a09 60%, #040706);
    will-change: transform;
  }
  .dome-left { left: 0; transform: translateX(calc(var(--slit) / -2)); }
  .dome-right { right: 0; transform: translateX(calc(var(--slit) / 2)); }
  /* The lit edges of the slit. */
  .dome-shutter i {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(180deg, rgba(160, 255, 210, .1), rgba(160, 255, 210, .75) 40%, rgba(160, 255, 210, .15));
    box-shadow: 0 0 18px rgba(110, 240, 180, .45);
  }
  .dome-left i { right: 0; }
  .dome-right i { left: 0; }

  .dome-hud {
    position: absolute;
    left: clamp(1.2rem, 3vw, 2.5rem);
    right: clamp(1.2rem, 3vw, 2.5rem);
    bottom: clamp(1.2rem, 3vw, 2.2rem);
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    font: 400 clamp(.6rem, .85vw, .72rem)/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: rgba(234, 246, 239, .55);
    transition: opacity .35s ease, transform .35s ease;
  }
  .dome-hud em { font-style: normal; color: #6fe8a8; }
  .dome-status { display: flex; gap: 1.2rem; align-items: baseline; }
  .dome-status b { font-weight: 400; font-variant-numeric: tabular-nums; color: #eaf6ef; letter-spacing: .1em; }

  /* The dome opens: the shutters part, the sky gives way to the page. */
  rb-studio-loader.is-opening .dome-shutter { transition: transform 1.15s cubic-bezier(.72, 0, .18, 1); }
  rb-studio-loader.is-opening .dome-left { transform: translateX(-101%); }
  rb-studio-loader.is-opening .dome-right { transform: translateX(101%); }
  rb-studio-loader.is-opening .dome-sky,
  rb-studio-loader.is-opening .dome-glow { opacity: 0; }
  rb-studio-loader.is-opening .dome-hud { opacity: 0; transform: translateY(8px); }
  rb-studio-loader.is-opening { background: transparent; transition: background .6s ease .35s; }

  @media (max-width: 760px) {
    .dome-hud > span:first-child { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    rb-studio-loader.is-opening .dome-shutter { transition: none; }
    rb-studio-loader.is-opening { opacity: 0; transition: opacity .4s ease; }
  }
</style>

<script>
  class StudioLoader extends HTMLElement {
    private deadline = 0;
    private dismissed = false;
    private raf = 0;

    connectedCallback() {
      let seen = false;
      try { seen = sessionStorage.getItem("rb-loader-seen") === "1"; } catch { /* storage can be unavailable */ }
      if (seen) {
        document.documentElement.classList.remove("is-preloading");
        document.body.classList.remove("is-preloading");
        document.body.classList.add("is-loaded");
        this.remove();
        queueMicrotask(() => window.dispatchEvent(new CustomEvent("rb:loaded")));
        return;
      }

      try { sessionStorage.setItem("rb-loader-seen", "1"); } catch { /* intro still works */ }
      this.classList.add("is-playing");
      document.documentElement.classList.add("is-preloading");
      document.body.classList.add("is-preloading");

      // The scroll lock must never outlive the intro, whatever happens to the frame loop:
      // this timer releases it even if no frame is ever served.
      this.deadline = window.setTimeout(() => this.dismiss(), 5000);
      try { this.play(); } catch { this.dismiss(); }
    }

    private play() {
      const count = this.querySelector<HTMLElement>("[data-dome-count]")!;
      const canvas = this.querySelector<HTMLCanvasElement>("[data-dome-sky]")!;
      const ctx = canvas.getContext("2d");
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Progress follows what is really loading (fonts, the document, eager images), is walked to
      // the end by the budget so a slow asset can never hold the visitor, and is held back by a
      // short minimum so a warm cache still gets its moment.
      const touch = matchMedia("(max-width: 760px), (pointer: coarse)").matches;
      const BUDGET = touch ? 1.6 : 2.4;
      const MIN_RUN = reduced ? 0.2 : touch ? 0.6 : 0.9;
      let fontsDone = 0, domDone = document.readyState === "complete" ? 1 : 0;
      document.fonts?.ready.then(() => (fontsDone = 1));
      if (!domDone) addEventListener("load", () => (domDone = 1), { once: true });
      const eager = [...document.images].filter((img) => img.loading !== "lazy");
      const pending = eager.filter((img) => !img.complete);
      const total = Math.max(1, eager.length);
      let loaded = eager.length - pending.length;
      let imagesDone = pending.length ? loaded / total : 1;
      pending.forEach((img) => {
        const bump = () => (imagesDone = ++loaded / total);
        img.addEventListener("load", bump, { once: true });
        img.addEventListener("error", bump, { once: true });
      });
      const real = () => fontsDone * 0.3 + domDone * 0.25 + imagesDone * 0.45;
      const ceiling = (s: number) => (s >= MIN_RUN ? 1 : 1 - Math.pow(1 - s / MIN_RUN, 1.7));

      // The sky in the slit: slow stars, a few of them mint.
      const dpr = Math.min(devicePixelRatio || 1, 1.5);
      const size = () => { canvas.width = innerWidth * dpr; canvas.height = innerHeight * dpr; };
      size();
      let seed = 7;
      const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
      const stars = Array.from({ length: 160 }, () => ({ x: 0.36 + rnd() * 0.28, y: rnd(), s: rnd(), p: rnd() * 6 }));

      const start = performance.now();
      let shown = 0;
      const tick = () => {
        if (this.dismissed) return;
        const elapsed = (performance.now() - start) / 1000;
        const target = Math.min(Math.max(real(), Math.min(1, elapsed / BUDGET)), ceiling(elapsed));
        shown += (target - shown) * 0.14;
        if (elapsed > BUDGET) shown = 1;
        const value = Math.min(1, shown);
        count.textContent = String(Math.round(value * 100)).padStart(3, "0");
        // The slit is the progress bar: a hairline at first, a fifth of the screen when ready.
        this.style.setProperty("--slit", `${4 + value * innerWidth * 0.18}px`);
        if (ctx) {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          for (const st of stars) {
            const y = ((st.y + elapsed * 0.006 * (0.4 + st.s)) % 1) * canvas.height;
            ctx.globalAlpha = (0.25 + 0.75 * st.s) * (0.55 + 0.45 * Math.sin(elapsed * 2 + st.p));
            ctx.fillStyle = st.s > 0.9 ? "#9fffd0" : "#ffffff";
            const r = (0.6 + st.s * 1.3) * dpr;
            ctx.fillRect(st.x * canvas.width, y, r, r);
          }
          ctx.globalAlpha = 1;
        }
        if (value >= 0.999 && elapsed > MIN_RUN) { this.dismiss(); return; }
        this.raf = requestAnimationFrame(tick);
      };
      this.raf = requestAnimationFrame(tick);
    }

    private dismiss() {
      if (this.dismissed) return;
      this.dismissed = true;
      clearTimeout(this.deadline);
      cancelAnimationFrame(this.raf);
      this.classList.add("is-hidden", "is-opening");
      document.body.classList.add("is-loaded");
      // Unlock at once: the loader no longer takes pointer events, and a stalled frame loop
      // must never leave the page unscrollable.
      document.documentElement.classList.remove("is-preloading");
      document.body.classList.remove("is-preloading");
      window.__rbLenis?.resize();
      window.dispatchEvent(new CustomEvent("rb:loaded"));
      window.setTimeout(() => this.remove(), 1400);
    }
  }

  if (!customElements.get("rb-studio-loader")) {
    customElements.define("rb-studio-loader", StudioLoader);
  }
</script>
