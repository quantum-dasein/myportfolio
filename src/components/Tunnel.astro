<div class="tunnel" data-tunnel-root aria-hidden="true">
  <div class="tunnel-black" data-tunnel-black></div>
  <canvas class="tunnel-canvas" data-tunnel-canvas></canvas>
  <div class="tunnel-hud"><span>RB / SPATIAL TRANSIT</span><b>ARCHIVE VECTOR</b></div>
</div>

<style>
  .tunnel {
    position: fixed;
    inset: 0;
    z-index: 480;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    background: #000;
  }
  .tunnel.is-active,
  :global(html.rb-warp-arriving) .tunnel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .tunnel-black { position: absolute; z-index: 1; inset: 0; background: #000; opacity: 0; }
  :global(html.rb-warp-arriving) .tunnel-black { opacity: 1; }
  .tunnel-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .tunnel-hud {
    position: absolute;
    z-index: 2;
    left: clamp(1.2rem,4vw,4rem);
    right: clamp(1.2rem,4vw,4rem);
    bottom: clamp(1rem,3vw,2.5rem);
    display: flex;
    justify-content: space-between;
    color: rgba(255,255,255,.5);
    font: 500 .58rem/1 var(--font-inter);
    letter-spacing: .17em;
    opacity: 0;
  }
  .tunnel-hud b { color: #fff; font-weight: 500; }
  :global(html.rb-transitioning),
  :global(html.rb-transitioning body) { overflow: hidden !important; }
</style>

<script>
  import gsap from "gsap";
  // MPA, not ClientRouter — plain full-page navigation.
  const navigate = (href: string) => location.assign(href);

  let root: HTMLElement;
  let black: HTMLElement;
  let hud: HTMLElement;
  let canvas: HTMLCanvasElement;
  let ctx: CanvasRenderingContext2D;
  let reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let lowPower = matchMedia("(max-width: 760px), (pointer: coarse)").matches;
  let isGallery = location.pathname.startsWith("/gallery");

  const tunnelRoot = document.querySelector<HTMLElement>("[data-tunnel-root]");
  if (tunnelRoot) {
    root = tunnelRoot;
    black = root.querySelector<HTMLElement>("[data-tunnel-black]")!;
    hud = root.querySelector<HTMLElement>(".tunnel-hud")!;
    canvas = root.querySelector<HTMLCanvasElement>("[data-tunnel-canvas]")!;
    ctx = canvas.getContext("2d", { alpha: false })!;
    isGallery = location.pathname.startsWith("/gallery");
  }

  let stars: { x: number; y: number; z: number; tone: number }[] = [];
  let W = 0, H = 0, cx = 0, cy = 0, focal = 0;
  let running = false;
  let completingBack = false;
  let rafId = 0;
  let safetyTimer = 0;
  let arrivalAnimation: Animation | undefined;
  let releaseArrival: (() => void) | undefined;
  let dir = 1;
  let previousDraw = 0;
  const state = { speed: 0, alpha: 1 };

  // Size the canvas ONCE now — after W/H/focal are declared above. Calling
  // resize() up in the init block ran before `let W = 0 …`, whose initializer
  // then clobbered the real values back to 0, so W/H/focal stayed 0 and every
  // star projected to (0,0): the whole warp drew pure black on desktop.
  if (root) resize();

  const originMatches = () => {
    const raw = sessionStorage.getItem("rb-warp-origin");
    if (!raw) return false;
    const origin = new URL(raw, location.href);
    return origin.origin === location.origin && origin.pathname === location.pathname && origin.search === location.search;
  };

  function resize() {
    const dpr = 1;
    W = canvas.width = Math.floor(innerWidth * dpr);
    H = canvas.height = Math.floor(innerHeight * dpr);
    cx = W / 2; cy = H / 2; focal = W * .52;
  }

  function initStars() {
    stars = Array.from({ length: lowPower ? 280 : 640 }, () => ({
      x: (Math.random() * 2 - 1) * W,
      y: (Math.random() * 2 - 1) * H,
      z: Math.random() * W + 1,
      tone: .48 + Math.random() * .52,
    }));
  }

  function draw(time = performance.now()) {
    if (!running) return;
    const delta=previousDraw?Math.min((time-previousDraw)/16.667,2):1;
    previousDraw=time;
    ctx.fillStyle = `rgba(0,0,0,${Math.max(.12, .46 - state.speed / 300)})`;
    ctx.fillRect(0, 0, W, H);
    const speed = state.speed * delta;
    for (const star of stars) {
      const previous = star.z;
      star.z -= speed * dir;
      
      if (dir === 1 && star.z < 1) {
        star.z = W;
        star.x = (Math.random() * 2 - 1) * W;
        star.y = (Math.random() * 2 - 1) * H;
        continue;
      }
      
      if (dir === -1 && star.z > W) {
        star.z = 1;
        star.x = (Math.random() * 2 - 1) * W;
        star.y = (Math.random() * 2 - 1) * H;
        continue;
      }

      const k = focal / star.z;
      const oldK = focal / previous;
      const depth = 1 - star.z / W;
      ctx.strokeStyle = `rgba(238,244,247,${star.tone * state.alpha})`;
      ctx.lineWidth = Math.max(.55, depth * 3.2);
      ctx.beginPath();
      ctx.moveTo(cx + star.x * oldK, cy + star.y * oldK);
      ctx.lineTo(cx + star.x * k, cy + star.y * k);
      ctx.stroke();
    }
    rafId = requestAnimationFrame(draw);
  }

  function reset() {
    clearTimeout(safetyTimer);
    arrivalAnimation?.cancel();arrivalAnimation=undefined;
    if(releaseArrival)removeEventListener('rb:observatory-ready',releaseArrival);
    releaseArrival=undefined;
    running = false;
    cancelAnimationFrame(rafId);
    gsap.killTweensOf([state, black, hud, root]);
    state.speed = 0;previousDraw=0;root.style.opacity="";
    black.style.opacity = "0";
    root.classList.remove("is-active");
    document.documentElement.classList.remove("rb-transitioning", "rb-warp-arriving");
    ctx.clearRect(0, 0, W, H);
  }

  function depart(complete: () => void, reverse = false) {
    if (running) reset();
    if (reduced) { complete(); return; }
    running = true;
    dir = reverse ? -1 : 1;
    document.documentElement.classList.add("rb-transitioning");
    root.classList.add("is-active");
    initStars();
    state.speed = .65;previousDraw=0;
    root.style.opacity="0";
    state.alpha = 1;
    black.style.opacity = "0";
    draw();
    let finished = false;
    const finish = () => {
      if (finished) return;
      finished = true;
      clearTimeout(safetyTimer);
      complete();
    };
    const duration=reverse ? 1.15 : 1.85;
    safetyTimer = window.setTimeout(finish, duration*1000+400);
    // A visible gathering phase, then sustained acceleration and a short cover.
    // Speeds are time-based, so 60 Hz phones and 144 Hz desktops feel the same.
    gsap.timeline({ onComplete: finish })
      .to(root, {opacity:1,duration:.26,ease:'power1.out'},0)
      .to(hud, {opacity:1,duration:.35},.12)
      .to(state, {speed:7,duration:duration*.35,ease:'power2.in'},0)
      .to(state, {speed:40,duration:duration*.35,ease:'power2.in'},duration*.35)
      .to(state, {speed:135,duration:duration*.3,ease:'power3.in'},duration*.7)
      .to(black, {opacity:1,duration:.2,ease:'power2.in'},duration-.2);
  }

  function arrive(clearOrigin = false, reverse = false) {
    reset();running=true;
    document.documentElement.classList.add('rb-warp-arriving');
    root.classList.add('is-active');black.style.opacity='1';hud.style.opacity='1';
    const finish=()=>{
      reset();
      if(clearOrigin){
        sessionStorage.removeItem('rb-warp-origin');sessionStorage.removeItem('rb-warp-scroll');sessionStorage.removeItem('rb-warp-return');
      }
    };
    const reveal=()=>{
      if(!releaseArrival)return;
      removeEventListener('rb:observatory-ready',releaseArrival);releaseArrival=undefined;clearTimeout(safetyTimer);
      if(reduced){finish();return;}
      arrivalAnimation=root.animate([{opacity:1},{opacity:0}],{duration:reverse?1050:850,easing:'cubic-bezier(.22,.61,.36,1)'});
      arrivalAnimation.onfinish=finish;
      safetyTimer=window.setTimeout(finish,1500);
    };
    releaseArrival=reveal;
    const gallery=document.querySelector('[data-observatory]');
    if(isGallery&&gallery&&!gallery.classList.contains('is-ready')&&!gallery.classList.contains('is-fallback')){
      addEventListener('rb:observatory-ready',reveal,{once:true});
      // Independent of rendering: a failed WebGL boot exposes the real fallback.
      safetyTimer=window.setTimeout(reveal,10500);
    }else if(clearOrigin){
      // Back can be a fresh document, not just BFCache. Restore after layout and
      // synchronize Lenis too, or its next tick immediately snaps back to zero.
      const y=Number(sessionStorage.getItem('rb-warp-scroll')||0);
      const started=performance.now();let stable=0;
      const restore=()=>{
        if(!running)return;
        (window as any).__rbLenis?.resize();
        (window as any).__rbLenis?.scrollTo(y,{immediate:true,force:true});
        scrollTo({top:y,behavior:'instant'});
        stable=Math.abs(scrollY-y)<3?stable+1:0;
        if((performance.now()-started>350&&stable>=4)||performance.now()-started>1400)reveal();
        else requestAnimationFrame(restore);
      };
      requestAnimationFrame(restore);
    }else requestAnimationFrame(()=>requestAnimationFrame(reveal));
  }

  function enterArchive(href: string) {
    if (running) reset();
    sessionStorage.removeItem("rb-case-arrive");
    sessionStorage.removeItem("rb-case-return");
    sessionStorage.setItem("rb-warp-origin", location.href);
    sessionStorage.setItem("rb-warp-scroll", String(scrollY));
    depart(() => {
      sessionStorage.setItem("rb-warp-arrive", "1");
      navigate(href);
    });
  }

  function returnToOrigin() {
    if (completingBack) return;
    completingBack = true;
    history.back();
  }

  if (root) {
    const arriving = sessionStorage.getItem("rb-warp-arrive");
    if (arriving) {
      sessionStorage.removeItem("rb-warp-arrive");
      const isReturn = sessionStorage.getItem("rb-warp-return") === "1";
      arrive(isReturn, isReturn);
      if (isGallery && sessionStorage.getItem("rb-warp-origin") && !history.state?.rbWarpGuard) {
        history.pushState({ ...(history.state || {}), rbWarpGuard: true }, "", location.href);
      }
    }
  }

  addEventListener("popstate", () => {
    if (!isGallery || !sessionStorage.getItem("rb-warp-origin")) return;
    depart(() => {
      sessionStorage.setItem("rb-warp-arrive", "1");
      sessionStorage.setItem("rb-warp-return", "1");
      history.back();
    }, true);
  });

  // A warp must never survive into the page cache. On iOS the animation loop
  // could get frozen mid-flight into BFCache and then resume forever when the
  // page was restored — the "endless stream of stars" on mobile back. Resetting
  // on pagehide stops the loop and clears the overlay before the freeze, and a
  // pageshow safety net catches anything that still slips through.
  addEventListener("pagehide", () => reset());
  addEventListener("pageshow", (event) => {
    if(event.persisted){reset();completingBack=false;}
    if (!event.persisted || sessionStorage.getItem("rb-warp-return") !== "1" || !originMatches()) return;
    reset();
    sessionStorage.removeItem("rb-warp-arrive");
    scrollTo(0, Number(sessionStorage.getItem("rb-warp-scroll") || 0));
    arrive(true, true);
  });

  document.addEventListener("click", (event) => {
    const anchor = (event.target as HTMLElement)?.closest<HTMLAnchorElement>("a[data-tunnel]");
    if (!anchor || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || anchor.target === "_blank") return;
    const url = new URL(anchor.href, location.href);
    event.preventDefault();
    if (isGallery && sessionStorage.getItem("rb-warp-origin")) {
      returnToOrigin();
      return;
    }
    if(isGallery){
      depart(()=>{sessionStorage.setItem('rb-warp-arrive','1');sessionStorage.setItem('rb-warp-return','1');navigate(url.href);},true);
      return;
    }
    if (url.pathname === location.pathname) return;
    document.body.classList.remove("is-nav-opened");
    enterArchive(url.href);
  });

  addEventListener("resize", resize);
</script>
