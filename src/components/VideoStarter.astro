---
import type { Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const de = lang === "de";
const href = `${de ? "/de/kontakt/" : "/contact/"}?project=film`;
---

<section class="video-starter" aria-labelledby="video-starter-title">
  <div class="u-container starter-grid">
    <div class="starter-copy">
      <span class="starter-kicker" data-reveal
        >{de ? "DER NORMALE VIDEOAUFTRAG" : "THE EVERYDAY VIDEO JOB"}</span
      >
      <h2 id="video-starter-title" data-sy-reveal="words">
        {
          de
            ? "Ein fertiges Reel. Ab einem Tag."
            : "One finished reel. From one day."
        }
      </h2>
      <p data-sy-reveal="lines">
        {
          de
            ? "Sie schicken das Material und sagen, wo es laufen soll. Ich übernehme Rhythmus, Farbe, Ton, Untertitel und einfache Motion — 3D nur, wenn die Idee es wirklich braucht."
            : "Send the footage and tell me where it will run. I handle pacing, colour, sound, captions and simple motion — 3D only when the idea genuinely needs it."
        }
      </p>
      <dl data-reveal>
        <div><dt>{de ? "Ab" : "From"}</dt><dd>{de ? "190 €" : "€190"}</dd></div>
        <div>
          <dt>{de ? "Zeitrahmen" : "Timeline"}</dt><dd>
            {de ? "Ab 1 Tag" : "From 1 day"}
          </dd>
        </div>
      </dl>
      <a
        href={href}
        data-track="video_quote_open"
        data-track-item="single-reel"
        data-track-place="motion-page"
        data-cursor="OPEN"
        data-magnetic
      >
        {de ? "Reel anfragen" : "Ask for a reel"}<i aria-hidden="true">→</i>
      </a>
    </div>

    <div
      class="starter-flow"
      aria-label={de
        ? "Vom Rohmaterial zu drei fertigen Formaten"
        : "From source footage to three finished formats"}
      data-reveal
    >
      <div class="source">
        <span>{de ? "ROHMATERIAL" : "SOURCE"}</span><i></i><i></i><i></i>
      </div>
      <span class="flow-arrow" aria-hidden="true">→</span>
      <div class="edit">
        <span>EDIT</span><b></b><b></b><b></b><small
          >CAPTIONS · COLOUR · SOUND</small>
      </div>
      <span class="flow-arrow" aria-hidden="true">→</span>
      <div class="outputs">
        <i class="vertical">9:16</i><i class="square">1:1</i><i class="wide"
          >16:9</i>
      </div>
    </div>
  </div>
</section>

<style>
  .video-starter {
    padding: clamp(4rem, 9vw, 8rem) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.09);
    background: #030405;
  }
  .starter-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(24rem, 1.1fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }
  .starter-kicker {
    font: 0.62rem var(--font-inter);
    letter-spacing: 0.2em;
    color: rgba(var(--rgb-text), 0.48);
  }
  .starter-copy h2 {
    max-width: 11ch;
    margin: 1rem 0 1.2rem;
    font: 500 clamp(2.2rem, 5vw, 4.5rem)/0.96 var(--font-display);
    letter-spacing: -0.04em;
  }
  .starter-copy > p {
    max-width: 52ch;
    margin: 0;
    color: rgba(var(--rgb-text), 0.68);
    line-height: 1.6;
  }
  .starter-copy dl {
    display: flex;
    gap: 2.5rem;
    margin: 2rem 0;
  }
  .starter-copy dl div {
    padding-left: 0.8rem;
    border-left: 1px solid rgba(255, 255, 255, 0.22);
  }
  .starter-copy dt {
    font: 0.56rem var(--font-inter);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(var(--rgb-text), 0.42);
  }
  .starter-copy dd {
    margin: 0.4rem 0 0;
    font: 500 1.35rem var(--font-display);
  }
  .starter-copy a {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.95rem 1.4rem;
    border-radius: 999px;
    background: #f3f5f6;
    color: #090b0d;
    font: 600 0.66rem var(--font-inter);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .starter-copy a i {
    font-style: normal;
  }
  .starter-flow {
    display: grid;
    grid-template-columns: 1fr auto 1.1fr auto 1.15fr;
    gap: 1rem;
    align-items: center;
    padding: 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.025);
  }
  .source,
  .edit {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-height: 13rem;
    padding: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 9px;
    background: #080a0d;
  }
  .source span,
  .edit span {
    font: 0.5rem var(--font-inter);
    letter-spacing: 0.16em;
    color: rgba(var(--rgb-text), 0.42);
  }
  .source i {
    height: 2.5rem;
    border-radius: 4px;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.16),
      rgba(255, 255, 255, 0.025)
    );
  }
  .source i:nth-child(3) {
    width: 72%;
  }
  .source i:nth-child(4) {
    width: 88%;
  }
  .edit b {
    display: block;
    height: 0.35rem;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.13);
  }
  .edit b:nth-of-type(1) {
    margin-top: 3.3rem;
    width: 92%;
  }
  .edit b:nth-of-type(2) {
    width: 63%;
    background: rgba(255, 255, 255, 0.5);
  }
  .edit b:nth-of-type(3) {
    width: 78%;
  }
  .edit small {
    margin-top: auto;
    font: 0.43rem var(--font-inter);
    letter-spacing: 0.09em;
    color: rgba(var(--rgb-text), 0.34);
  }
  .flow-arrow {
    color: rgba(var(--rgb-text), 0.38);
  }
  .outputs {
    display: flex;
    align-items: end;
    justify-content: center;
    gap: 0.45rem;
    min-width: 0;
  }
  .outputs i {
    display: grid;
    place-items: end center;
    padding-bottom: 0.45rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 5px;
    background: linear-gradient(
      160deg,
      rgba(255, 255, 255, 0.12),
      rgba(255, 255, 255, 0.025)
    );
    font: 0.46rem var(--font-inter);
    font-style: normal;
    color: rgba(var(--rgb-text), 0.55);
  }
  .outputs .vertical {
    width: 3rem;
    height: 9rem;
  }
  .outputs .square {
    width: 4rem;
    height: 4rem;
  }
  .outputs .wide {
    width: 5.4rem;
    height: 3rem;
  }

  @media (max-width: 920px) {
    .starter-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 620px) {
    .starter-copy dl {
      flex-wrap: wrap;
    }
    .starter-flow {
      grid-template-columns: 1fr;
    }
    .flow-arrow {
      transform: rotate(90deg);
      justify-self: center;
    }
    .source,
    .edit {
      min-height: 9rem;
    }
    .outputs {
      min-height: 10rem;
    }
  }
</style>
