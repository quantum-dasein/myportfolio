---
import Layout from "../layouts/Layout.astro";
import { useTranslations } from "../i18n/utils";
import { driftRoutes } from "../data/drift-routes";
const t = useTranslations("en");
const beacons = [
  { id: "01", key: "studio", path: "/", type: "BASE" },
  { id: "02", key: "archive", path: "/gallery/", type: "OBSERVATORY" },
  { id: "03", key: "services", path: "/services/", type: "WORKSHOP" },
  { id: "04", key: "bridge", path: "/work/bridge-consult/", type: "CASE STUDY" },
  { id: "05", key: "fidic", path: "/work/fidic/", type: "CASE STUDY" },
  { id: "06", key: "meta", path: "/work/studio/", type: "ENGINE ROOM" },
] as const;
---
<Layout title="404 — Lost among the stars" description="This page doesn't exist. Inside Boullée's Cenotaph for Newton, the address you typed is written in the stars — and repairs itself." noindex={true} noWebgl={true} hideFinale={true}>
  <div class="lost-world">
    <svg class="glass-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <defs><filter id="evac-glass-lens" x="0%" y="0%" width="100%" height="100%" color-interpolation-filters="sRGB">
        <feImage data-glass-map result="lens" width="100%" height="100%" preserveAspectRatio="none" />
        <feDisplacementMap in="SourceGraphic" in2="lens" scale="22" xChannelSelector="R" yChannelSelector="G" />
        <feGaussianBlur stdDeviation="0.35" />
      </filter></defs>
    </svg>
    <div class="stage" data-stage data-routes={JSON.stringify(driftRoutes)} aria-hidden="true">
      <div class="view" data-view>
        <video data-film muted playsinline preload="auto" disablepictureinpicture disableremoteplayback></video>
        <video data-loop muted playsinline loop preload="none" disablepictureinpicture disableremoteplayback></video>
        <canvas data-sky></canvas>
      </div>
      <div class="scrim"></div>
    </div>
    <script is:inline>(function(){var s=document.querySelector('[data-stage]'),q=new URLSearchParams(location.search).get('t'),h=new Date().getHours();s.dataset.time=(q?q==='day':h>=7&&h<19)?'day':'night';})();</script>
    <section class="void" aria-labelledby="void-title">
      <div class="void-ui" data-ui>
        <div class="void-head">
          <p class="void-eyebrow"><i></i><span data-i18n="404.eyebrow">{t("404.eyebrow")}</span></p>
          <h1 id="void-title" class="void-title" data-i18n="404.title">{t("404.title")}</h1>
        </div>
        <div class="void-foot">
        <p class="void-lead"><span data-i18n="404.lead.a">{t("404.lead.a")}</span> <code data-path>/unknown</code> <span data-i18n="404.gone">{t("404.gone")}</span> <span class="reason" data-reason></span></p>
        <p class="guess-kicker" data-kicker><span data-i18n="404.guess">{t("404.guess")}</span></p>
        <div class="void-actions">
          <a href="/" class="evac" data-evac><span class="evac-glass" aria-hidden="true"></span><img class="evac-thumb" data-thumb alt="" width="84" height="44" hidden /><span class="evac-copy"><span class="evac-label" data-evac-label>{t("404.cta")}</span><span class="evac-path" data-evac-path></span></span><span class="evac-arrow" aria-hidden="true">↗</span></a>
          <a href="/" class="void-home" data-home hidden><span data-i18n="404.home">{t("404.home")}</span></a>
        </div>
        <p class="guess-alt" data-alt hidden><span data-i18n="404.also">{t("404.also")}</span></p>
        <p class="star-note" data-star-note hidden></p>
        </div>
      </div>
      <div class="void-bottom">
        <a href="#recovery" class="void-scroll"><span class="scroll-mark" aria-hidden="true">↓</span><span data-i18n="404.scroll">{t("404.scroll")}</span></a>
        <p class="credit" data-i18n="404.credit">{t("404.credit")}</p>
        <p class="live-hint" data-live-hint hidden><span class="hint-desk" data-i18n="404.live.desk">{t("404.live.desk")}</span><span class="hint-touch" data-i18n="404.live.touch">{t("404.live.touch")}</span></p>
        <button class="film-button explore-button" type="button" data-explore hidden><span class="explore-dot" aria-hidden="true"></span><span data-i18n="404.explore">{t("404.explore")}</span></button>
        <button class="film-button" type="button" data-skip><span data-i18n="404.skip">{t("404.skip")}</span><span aria-hidden="true">→</span></button>
        <button class="film-button" type="button" data-replay hidden><span aria-hidden="true">↺</span><span data-i18n="404.replay">{t("404.replay")}</span></button>
      </div>
    </section>
    <section class="recover" id="recovery" aria-labelledby="recover-title">
      <div class="recovery-axis" aria-hidden="true"><span></span><b>+</b><span></span></div>
      <div class="recover-head">
        <p class="recover-eyebrow"><span data-i18n="404.recover.eyebrow">{t("404.recover.eyebrow")}</span><span>06 / ONLINE</span></p>
        <h2 id="recover-title" data-i18n="404.recover.title">{t("404.recover.title")}</h2>
        <p class="recover-sub" data-i18n="404.recover.sub">{t("404.recover.sub")}</p>
      </div>
      <div class="beacons">
        {beacons.map(beacon => (
          <a class="beacon" href={beacon.path} data-beacon data-lang-href-en={beacon.key === "services" ? "/services/" : undefined} data-lang-href-de={beacon.key === "services" ? "/de/leistungen/" : undefined}>
            <span class="beacon-id">{beacon.id}</span>
            <span class="beacon-copy"><span class="beacon-type">{beacon.type}<i></i></span><span class="beacon-name" data-i18n={`404.beacon.${beacon.key}.name`}>{t(`404.beacon.${beacon.key}.name`)}</span><span class="beacon-desc" data-i18n={`404.beacon.${beacon.key}.desc`}>{t(`404.beacon.${beacon.key}.desc`)}</span></span>
            <span class="beacon-go" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      <div class="diag"><span><i></i><span data-i18n="404.diag.system">{t("404.diag.system")}</span></span><span>HTTP 404 / NO_ROUTE</span><span data-i18n="404.diag.recovery">{t("404.diag.recovery")}</span></div>
    </section>
    <div class="explore-hud" data-hud hidden>
      <p class="hud-keys"><span class="hint-desk" data-i18n="404.hud.desk">{t("404.hud.desk")}</span><span class="hint-touch" data-i18n="404.hud.touch">{t("404.hud.touch")}</span></p>
      <div class="hud-buttons">
        <button type="button" class="hud-button hud-touch" data-jump><span data-i18n="404.hud.jump">{t("404.hud.jump")}</span></button>
        <button type="button" class="hud-button hud-touch" data-throw><span data-i18n="404.hud.apple">{t("404.hud.apple")}</span></button>
        <button type="button" class="hud-button" data-talk><span data-i18n="404.hud.talk">{t("404.hud.talk")}</span></button>
        <button type="button" class="hud-button hud-exit" data-exit><span data-i18n="404.hud.exit">{t("404.hud.exit")}</span> <kbd class="hint-desk">Esc</kbd></button>
      </div>
    </div>
    <div class="void-flash" data-flash aria-hidden="true"></div>
  </div>
</Layout>
<script>
  import { prefersCalm } from "../utils/decode";
  import type { DriftRoute } from "../data/drift-routes";
  import { guess, special, REASONS, type Guess } from "../data/lost-guess";
  import { mountLiquidGlass } from "../scripts/liquid-glass";
  import { mountCenotaph, type CenotaphMeta } from "../scripts/cenotaph";
  import { mountCenotaphSound } from "../scripts/cenotaph-sound";
  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  mountLiquidGlass($("[data-evac]"), $<SVGImageElement>("[data-glass-map]"));
  const stage = $("[data-stage]"), view = $("[data-view]"), video = $<HTMLVideoElement>("[data-film]"), canvas = $<HTMLCanvasElement>("[data-sky]");
  const path = (() => { try { return decodeURI(location.pathname) || "/"; } catch { return location.pathname; } })();
  const lang = (): "en" | "de" => document.documentElement.lang.startsWith("de") ? "de" : "en";
  const routes = JSON.parse(stage.dataset.routes || "[]") as DriftRoute[];
  const evac = $<HTMLAnchorElement>("[data-evac]"), evacLabel = $("[data-evac-label]"), evacPath = $("[data-evac-path]"), thumb = $<HTMLImageElement>("[data-thumb]");
  const home = $<HTMLAnchorElement>("[data-home]"), kicker = $("[data-kicker]"), alt = $("[data-alt]"), reasonEl = $("[data-reason]"), starNote = $("[data-star-note]");
  const skip = $<HTMLButtonElement>("[data-skip]"), replay = $<HTMLButtonElement>("[data-replay]"), flash = $("[data-flash]");
  const copy = {
    en: { back: "Back to the start", star: "Your star on the vault: №", gallery: "ARCHIVE", services: "SERVICES", contact: "CONTACT" },
    de: { back: "Zurück zum Start", star: "Dein Stern im Gewölbe: №", gallery: "ARCHIV", services: "LEISTUNGEN", contact: "KONTAKT" },
  };
  // The page's own switches (?film, ?live, ?t=) are not part of what the visitor typed.
  const typedSearch = (() => { const q = new URLSearchParams(location.search); ["film", "live", "t"].forEach(k => q.delete(k)); const s = q.toString(); return s ? `?${s}` : ""; })();
  $("[data-path]").textContent = path + (typedSearch.length > 1 && typedSearch.length < 40 ? typedSearch : "");
  const egg = special(path);

  // Did you mean: the best reading of the address, and up to two other close ones.
  let guesses: Guess[] = [];
  const title = (route: DriftRoute) => route[lang()].split(" — ")[0];
  function paint() {
    const l = copy[lang()];
    guesses = guess(path + typedSearch, routes, lang(), 3);
    const top = guesses[0], found = top.score > 0 && !["admin", "meta", "newton"].includes(top.reason);
    reasonEl.textContent = REASONS[lang()][top.reason];
    kicker.hidden = !found;
    evac.href = found ? top.route.path : "/";
    evacLabel.textContent = found ? title(top.route) : l.back;
    evacPath.textContent = found ? top.route.path : "";
    thumb.hidden = !found; if (found) thumb.src = top.route.image;
    home.hidden = !found;
    alt.querySelectorAll("a").forEach(a => a.remove());
    const rest = found ? guesses.slice(1).filter(g => g.score > .6) : [];
    alt.hidden = !rest.length;
    rest.forEach(g => { const a = document.createElement("a"); a.href = g.route.path; a.textContent = g.route[lang()].replace(/ \((German|Englisch)\)$/, "").replace(" — ", ": "); a.addEventListener("click", follow); alt.append(a); });
    if (starNumber) starNote.textContent = `${l.star} ${starNumber.toLocaleString("de-AT")}`;
  }
  let starNumber: number | null = null;

  const go = (to: string) => { if (prefersCalm()) { location.href = to; return; } flash.classList.add("is-on"); setTimeout(() => location.href = to, 380); };
  function follow(this: HTMLAnchorElement, event: MouseEvent) {
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
    event.preventDefault(); go(this.pathname);
  }
  addEventListener("pageshow", () => flash.classList.remove("is-on"));
  [evac, home].forEach(link => link.addEventListener("click", follow));
  paint();

  // One film per orientation, both flown along the same camera path.
  const portrait = innerHeight > innerWidth;
  const frame: [number, number] = portrait ? [810, 1440] : [1920, 1080];
  // Boullée drew both effects: by day the lamp lights the vault; by night the vault is the sky.
  const time = stage.dataset.time === "day" ? "day" : "night";
  const file = (name: string, ext: string) => `/cenotaph/${name}-${time}${portrait ? "-portrait" : ""}.${ext}`;
  // Reduced motion (the system setting) or data saver: one still frame. The site's Calm mode only
  // skips the flight: the vault and its slow loop stay alive.
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const saveData = !!(navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  const still = reduced || saveData;
  const calm = !still && prefersCalm();
  video.poster = file(still || calm ? "end" : "start", "jpg");
  const at = (x: number, y: number, width: number) => ({ x: frame[0] * x, y: frame[1] * y, width: frame[0] * width });
  // Where the address is written: the open vault right of the sunbeam, or high and centred on a phone.
  const anchor = () => portrait ? at(.52, time === "day" ? .525 : .41, .65) : at(.724, .306, .365);
  // Faint constellations of other pages, in the open stretches of the vault.
  const sections = () => {
    const l = copy[lang()], de = lang() === "de";
    const list = [
      { text: de ? "archiv" : "gallery", href: "/gallery/", label: `${l.gallery} ↗` },
      { text: de ? "leistungen" : "services", href: de ? "/de/leistungen/" : "/services/", label: `${l.services} ↗` },
      { text: de ? "kontakt" : "contact", href: de ? "/de/kontakt/" : "/contact/", label: `${l.contact} ↗` },
    ].filter(sec => sec.href !== guesses[0]?.route.path);
    // A phone has no open vault to spare: the pages are listed below the fold instead.
    const spots = portrait ? [] : [at(.2, .215, .2), at(.79, .55, .19), at(.79, .68, .19)];
    return list.slice(0, spots.length).map((sec, i) => ({ ...sec, anchor: spots[i] }));
  };
  const visitorAnchor = () => portrait ? at(.86, .3, 0) : at(.44, .585, 0);

  let cenotaph: ReturnType<typeof mountCenotaph> | undefined;
  // The vault in real time (still a prototype, behind ?live): lightmapped stone, walkable.
  // Films stay for reduced motion, data saver, no WebGL2 or ?film; everywhere else the vault is live.
  const liveMode = !still && !new URLSearchParams(location.search).has("film") && !!document.createElement("canvas").getContext("webgl2");
  let live: Awaited<ReturnType<typeof import("../scripts/cenotaph-live")["mountCenotaphLive"]>> | undefined;
  // The film carries the approach; at its last frame the live vault takes over from the same camera.
  let handed = false, liveReady = false, filmDone = false;
  const storyClock = { get currentTime() { return handed ? live?.story().currentTime ?? 12 : video.currentTime; }, get ended() { return handed; }, get paused() { return !handed && video.paused; } };
  const sound = mountCenotaphSound((liveMode ? storyClock : video) as HTMLVideoElement, 12);
  const reveal = () => { stage.classList.add("is-vault"); skip.hidden = true; replay.hidden = false; };
  // If the live vault cannot start, the same address opens again with the films.
  const toFilm = () => location.replace(location.pathname + (location.search ? location.search + "&film" : "?film"));
  const exploreButton = $<HTMLButtonElement>("[data-explore]"), hud = $("[data-hud]"), world = $(".lost-world");
  const handOver = (fromFilm: boolean) => {
    if (handed || !live || !liveReady) return;
    handed = true; live.enter(fromFilm); stage.classList.add("is-live-on");
    setTimeout(() => { video.pause(); exploreButton.hidden = false; }, 900);
  };
  if (liveMode) {
    stage.classList.add("is-live");
    $("[data-live-hint]").hidden = false; $(".credit").hidden = true;
    const top = guesses[0];
    const found = top.score > 0 && !["admin", "meta", "newton"].includes(top.reason);
    // Calm skips the flight; otherwise the film plays while the vault loads behind it.
    if (!calm) {
      video.src = file("film", "mp4");
      video.addEventListener("ended", () => { filmDone = true; handOver(true); });
      video.play().catch(() => { filmDone = true; handOver(false); });
    } else filmDone = true;
    import("../scripts/cenotaph-live").then(({ mountCenotaphLive }) => {
      const target = egg === "newton" ? path : found ? top.route.path : "rodionbelousov.studio";
      live = mountCenotaphLive({
        host: view, base: "/cenotaph/live", mode: time, requested: path, target, reduced: reduced || calm, still: egg === "newton", portrait,
        routes, targetRoute: found ? top.route : null, lang,
        sections: () => portrait ? [] : sections().map(({ text, href, label }) => ({ text, href, label })),
        onReveal: reveal,
        onRepaired: () => { evac.classList.add("is-found"); if (egg === "newton") setTimeout(() => live?.dropApple(), 900); },
        onEvent: (e, d) => sound.event(e, d),
        onOpen: to => go(to),
        onReady: () => { liveReady = true; stage.classList.add("is-live-ready"); if (filmDone) handOver(!calm); },
        onMode: m => { world.classList.toggle("is-exploring", m === "explore"); hud.hidden = m !== "explore"; document.documentElement.style.overflow = m === "explore" ? "hidden" : ""; if (m === "explore") scrollTo({ top: 0 }); },
        ui: world,
      });
      if (starNumber) live.visitor(starNumber);
      live.ready.catch(error => { console.warn("404: live vault failed", error); toFilm(); });
    }).catch(error => { console.warn("404: live vault failed", error); toFilm(); });
    exploreButton.addEventListener("click", () => live?.setMode("explore"));
    $("[data-exit]").addEventListener("click", () => live?.setMode("menu"));
    $("[data-jump]").addEventListener("click", () => live?.jump());
    $("[data-throw]").addEventListener("click", () => live?.throwApple());
    $("[data-talk]").addEventListener("click", () => live?.talk());
  } else fetch("/cenotaph/camera.json").then(r => r.json() as Promise<CenotaphMeta>).then(meta => {
    const top = guesses[0];
    const target = egg === "newton" ? path : top.score > 0 && top.reason !== "admin" && top.reason !== "meta" ? top.route.path : "rodionbelousov.studio";
    cenotaph = mountCenotaph({
      stage, video, canvas, meta, frameSize: () => frame, requested: path, target, reduced, anchor, theme: time,
      sections, visitorAnchor, still: egg === "newton",
      onReveal: reveal,
      onRepaired: () => { evac.classList.add("is-found"); if (egg === "newton") setTimeout(() => cenotaph?.dropApple(), 900); },
      onEvent: (e, d) => sound.event(e, d),
      onOpen: to => go(to),
    });
    if (starNumber) cenotaph.visitor(starNumber);
    if (still) { cenotaph.still(); reveal(); return; }
    if (calm) { cenotaph.still(); reveal(); startLoop(); return; }
    video.src = file("film", "mp4");
    const fallback = setTimeout(() => { if (video.paused && video.currentTime === 0) { video.poster = file("end", "jpg"); cenotaph?.still(); reveal(); } }, 3500);
    video.play().then(() => clearTimeout(fallback)).catch(() => { clearTimeout(fallback); video.poster = file("end", "jpg"); cenotaph?.still(); reveal(); });
  }).catch(error => { console.warn("404: no cenotaph", error); video.poster = file("end", "jpg"); reveal(); });

  // Every lost visitor adds a star to the vault. Only the number is kept, never the address.
  fetch("/api/lost/", { method: "POST" }).then(r => r.ok ? r.json() : null).then(d => {
    if (!d || typeof d.number !== "number") return;
    starNumber = d.number; paint(); starNote.hidden = false; cenotaph?.visitor(d.number); live?.visitor(d.number);
  }).catch(() => {});

  // After the flight the film hands over to a living loop shot from the same place: its first frame
  // is the film's last, so the switch cannot be seen.
  const loop = $<HTMLVideoElement>("[data-loop]");
  const armLoop = () => { if (!loop.getAttribute("src") && !still && !liveMode) { loop.src = file("loop", "mp4"); loop.preload = "auto"; loop.load(); } };
  const startLoop = () => { if (still || liveMode) return; armLoop(); loop.currentTime = 0; loop.play().catch(() => {}); };
  loop.addEventListener("playing", () => stage.classList.add("is-looping"));
  video.addEventListener("timeupdate", () => { if (video.currentTime > 5) armLoop(); });
  video.addEventListener("ended", startLoop);
  // Coming back with the back button restores the page with its videos paused: start them again.
  addEventListener("pageshow", e => {
    if (!e.persisted) return;
    if (stage.classList.contains("is-looping") || video.ended || calm) loop.play().catch(() => {});
    else if (video.getAttribute("src")) video.play().catch(() => {});
  });
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) return;
    if (stage.classList.contains("is-looping") && loop.paused) loop.play().catch(() => {});
  });
  skip.addEventListener("click", () => { if (liveMode) { filmDone = true; handOver(false); return; } cenotaph?.skip(); reveal(); startLoop(); });
  replay.addEventListener("click", () => { if (live) { live.replay(); handed = false; filmDone = false; stage.classList.remove("is-live-on"); exploreButton.hidden = true; if (!video.getAttribute("src")) video.src = file("film", "mp4"); video.currentTime = 0; video.play().catch(() => { filmDone = true; handOver(false); }); evac.classList.remove("is-found"); skip.hidden = false; replay.hidden = true; return; } if (!video.getAttribute("src")) { video.src = file("film", "mp4"); video.poster = file("start", "jpg"); } stage.classList.remove("is-vault", "is-looping"); loop.pause(); evac.classList.remove("is-found"); skip.hidden = false; replay.hidden = true; cenotaph?.replay(); });

  // Look around the vault: the mouse, or the tilt of a phone, turns the view a little.
  if (!reduced && !liveMode) {
    let tx = 0, ty = 0, x = 0, y = 0;
    addEventListener("pointermove", e => { if (e.pointerType === "mouse") { tx = e.clientX / innerWidth * 2 - 1; ty = e.clientY / innerHeight * 2 - 1; } }, { passive: true });
    const tilt = (e: DeviceOrientationEvent) => { if (e.gamma == null || e.beta == null) return; tx = Math.max(-1, Math.min(1, e.gamma / 25)); ty = Math.max(-1, Math.min(1, (e.beta - 50) / 25)); };
    const D = DeviceOrientationEvent as unknown as { requestPermission?: () => Promise<string> };
    if (typeof D?.requestPermission === "function") {
      addEventListener("touchend", () => { D.requestPermission!().then(p => { if (p === "granted") addEventListener("deviceorientation", tilt); }).catch(() => {}); }, { once: true });
    } else addEventListener("deviceorientation", tilt);
    const look = () => {
      x += (tx - x) * .06; y += (ty - y) * .06;
      view.style.transform = `scale(1.12) translate3d(${(-x * 4.2).toFixed(3)}%, ${(-y * 3.2).toFixed(3)}%, 0)`;
      requestAnimationFrame(look);
    };
    look();
  }
  addEventListener("scroll", () => { const d = Math.min(1, scrollY / Math.max(1, innerHeight * .8)); stage.style.setProperty("--dim", String(d)); live?.dim(d * .75); }, { passive: true });
  addEventListener("rb:langchange", () => { paint(); cenotaph?.resize(); });
</script>
<style>
  :global(body:has(.lost-world)) { background: #07080b; }
  /* The site's own film grain and vignette carry over; its drifting stars would fight the vault's. */
  :global(body:has(.lost-world) .site-fx__stars), :global(body:has(.lost-world) rb-cursor-field) { display: none; }
  :global(body:has(.lost-world) .site-fx__grain) { opacity: .11; }
  :global(html.has-custom-cursor:has(.lost-world)), :global(html.has-custom-cursor:has(.lost-world) a), :global(html.has-custom-cursor:has(.lost-world) button) { cursor: auto; }
  :global(body:has(.lost-world) sy-footer footer) { background: transparent; }
  /* The nav sits over a bright vault by day: give its words a little night to stand on. */
  :global(body:has(.lost-world) header a), :global(body:has(.lost-world) header button) { text-shadow: 0 1px 2px #0009, 0 0 16px #000a; }
  :global(body:has(.lost-world) sy-footer) { --footer-deep: 7, 8, 11; }
  .lost-world { --ember: #e3b183; --label: var(--font-inter), system-ui, sans-serif; color: #ece6de; }

  .stage { --dim: 0; position: fixed; inset: 0; z-index: 0; overflow: hidden; background: #07080b url("/cenotaph/start-night.jpg") center / cover no-repeat; }
  .stage[data-time="day"] { background-image: url("/cenotaph/start-day.jpg"); }
