---
import Layout from "../layouts/Layout.astro";
import { useTranslations } from "../i18n/utils";
import { driftRoutes } from "../data/drift-routes";
const t = useTranslations("en");
const beacons = [
  { id: "01", key: "studio", path: "/", type: "BASE" },
  { id: "02", key: "archive", path: "/gallery/", type: "OBSERVATORY" },
  { id: "03", key: "services", path: "/services/", type: "WORKSHOP" },
  { id: "04", key: "bridge", path: "/work/bridge-consult/", type: "CASE STUDY" },
  { id: "05", key: "fidic", path: "/work/fidic/", type: "CASE STUDY" },
  { id: "06", key: "meta", path: "/work/studio/", type: "ENGINE ROOM" },
] as const;
---
<Layout title="404 — Fundbüro" description="This page doesn't exist. The lost-and-found office at rodionbelousov.studio found what you were probably looking for." noindex={true} noWebgl={true} hideFinale={true}>
  <div class="lost-world">
    <svg class="glass-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <defs><filter id="evac-glass-lens" x="0%" y="0%" width="100%" height="100%" color-interpolation-filters="sRGB">
        <feImage data-glass-map result="lens" width="100%" height="100%" preserveAspectRatio="none" />
        <feDisplacementMap in="SourceGraphic" in2="lens" scale="22" xChannelSelector="R" yChannelSelector="G" />
        <feGaussianBlur stdDeviation="0.35" />
      </filter></defs>
    </svg>
    <div class="office" data-office data-routes={JSON.stringify(driftRoutes)} aria-hidden="true"></div>
    <section class="void" aria-labelledby="void-title">
      <div class="void-ui">
        <p class="void-eyebrow"><i></i><span data-i18n="404.eyebrow">{t("404.eyebrow")}</span></p>
        <h1 id="void-title" class="void-title" data-i18n="404.title">{t("404.title")}</h1>
        <p class="void-lead"><span data-i18n="404.lead.a">{t("404.lead.a")}</span> <code data-path>/unknown</code><span data-lead-b> <span data-i18n="404.lead.b">{t("404.lead.b")}</span></span><span data-lead-none hidden> <span data-i18n="404.lead.none">{t("404.lead.none")}</span></span></p>
      </div>
      <div class="counter-ui" data-counter-ui>
        <div class="void-actions">
          <a href="/" class="evac" data-evac><span class="evac-glass" aria-hidden="true"></span><span class="evac-label" data-evac-label>{t("404.cta")}</span><span class="evac-arrow" aria-hidden="true">↗</span></a>
          <a href="/" class="void-home" data-home hidden><span data-i18n="404.home">{t("404.home")}</span></a>
        </div>
        <p class="filed" data-filed role="status" aria-live="polite"></p>
      </div>
      <div class="void-bottom">
        <a href="#recovery" class="void-scroll"><span class="scroll-mark" aria-hidden="true">↓</span><span data-i18n="404.scroll">{t("404.scroll")}</span></a>
        <p class="grab-hint" data-grab><span data-i18n="404.grab">{t("404.grab")}</span></p>
        <button class="bell-button" type="button" data-bell><span class="bell-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 18h16M6 18a6 6 0 0 1 12 0M12 12V9m-1.5 0h3"/></svg></span><span data-i18n="404.bell">{t("404.bell")}</span></button>
      </div>
    </section>
    <section class="recover" id="recovery" aria-labelledby="recover-title">
      <div class="recovery-axis" aria-hidden="true"><span></span><b>+</b><span></span></div>
      <div class="recover-head">
        <p class="recover-eyebrow"><span data-i18n="404.recover.eyebrow">{t("404.recover.eyebrow")}</span><span>06 / ONLINE</span></p>
        <h2 id="recover-title" data-i18n="404.recover.title">{t("404.recover.title")}</h2>
        <p class="recover-sub" data-i18n="404.recover.sub">{t("404.recover.sub")}</p>
      </div>
      <div class="beacons">
        {beacons.map(beacon => (
          <a class="beacon" href={beacon.path} data-beacon data-lang-href-en={beacon.key === "services" ? "/services/" : undefined} data-lang-href-de={beacon.key === "services" ? "/de/leistungen/" : undefined}>
            <span class="beacon-id">{beacon.id}</span>
            <span class="beacon-copy"><span class="beacon-type">{beacon.type}<i></i></span><span class="beacon-name" data-i18n={`404.beacon.${beacon.key}.name`}>{t(`404.beacon.${beacon.key}.name`)}</span><span class="beacon-desc" data-i18n={`404.beacon.${beacon.key}.desc`}>{t(`404.beacon.${beacon.key}.desc`)}</span></span>
            <span class="beacon-go" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      <div class="diag"><span><i></i><span data-i18n="404.diag.system">{t("404.diag.system")}</span></span><span>HTTP 404 / NO_ROUTE</span><span data-i18n="404.diag.recovery">{t("404.diag.recovery")}</span></div>
    </section>
    <div class="void-flash" data-flash aria-hidden="true"></div>
  </div>
</Layout>
<script>
  import { prefersCalm } from "../utils/decode";
  import { rankSignals } from "../data/drift-signals";
  import type { DriftRoute } from "../data/drift-routes";
  import { mountLiquidGlass } from "../scripts/liquid-glass";
  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  mountLiquidGlass($("[data-evac]"), $<SVGImageElement>("[data-glass-map]"));
  const host = $("[data-office]");
  const requested = (() => { try { return decodeURI(location.pathname) || "/"; } catch { return location.pathname; } })();
  const lang = (): "en" | "de" => document.documentElement.lang.startsWith("de") ? "de" : "en";
  const routes = JSON.parse(host.dataset.routes || "[]") as DriftRoute[];
  const evac = $<HTMLAnchorElement>("[data-evac]"), evacLabel = $("[data-evac-label]"), home = $<HTMLAnchorElement>("[data-home]");
  const counterUi = $("[data-counter-ui]"), filed = $("[data-filed]"), grab = $("[data-grab]"), flash = $("[data-flash]");
  const copy = {
    en: { take: "Take me to", back: "Back to the start", filed: "Filed on the shelf as found item no.", filedNone: "Filed on the shelf." },
    de: { take: "Bring mich zu", back: "Zurück zum Start", filed: "Im Regal abgelegt als Fundstück Nr.", filedNone: "Im Regal abgelegt." },
  };
  $("[data-path]").textContent = requested;
  const signal = rankSignals(requested, routes, lang(), 1)[0];
  const best = signal && signal.score > 0 ? signal.route : undefined;
  $("[data-lead-b]").hidden = !best; $("[data-lead-none]").hidden = !!best;
  let number: number | null = null;
  const title = (route: DriftRoute) => route[lang()].split(" — ")[0];
  function paint() {
    const l = copy[lang()];
    evac.href = best?.path ?? "/"; evacLabel.textContent = best ? `${l.take} ${title(best)}` : l.back; home.hidden = !best;
    if (filed.dataset.shown) filed.textContent = number ? `${l.filed} ${number}.` : l.filedNone;
  }
  paint();

  // Tags already on the shelves: plausible slips of the site's own addresses, never visitor text.
  function slip(path: string, seed: number) {
    const core = path.replace(/^\/|\/$/g, ""); if (core.length < 4) return null;
    const i = 1 + (seed % (core.length - 2)), kind = seed % 4;
    const out = kind === 0 ? core.slice(0, i) + core.slice(i + 1) : kind === 1 ? core.slice(0, i) + core[i] + core.slice(i) : kind === 2 ? core.slice(0, i) + core[i + 1] + core[i] + core.slice(i + 2) : core.slice(0, i) + (/[aeiou]/.test(core[i]) ? "eaiou"["aeiou".indexOf(core[i])] : "k") + core.slice(i + 1);
    return `/${out}/`;
  }
  const shelfPaths = routes.filter(r => r.path.length < 26).map((r, i) => slip(r.path, i * 7 + 3)).filter((p): p is string => !!p);

  // The counter only stores a number; one per visitor per day.
  const numberPromise = fetch("/api/lost/", { method: "POST" }).then(r => r.ok ? r.json() : null).then(d => (d && typeof d.number === "number" ? d.number : null)).catch(() => null);
  numberPromise.then(n => { number = n; paint(); });

  const go = (path: string) => { if (prefersCalm()) { location.href = path; return; } flash.classList.add("is-on"); setTimeout(() => location.href = path, 380); };
  addEventListener("pageshow", () => flash.classList.remove("is-on"));
  [evac, home].forEach(link => link.addEventListener("click", event => {
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
    event.preventDefault(); go(link.pathname);
  }));

  let office: ReturnType<typeof import("../scripts/fundbuero").mountFundbuero> | undefined;
  const placeUi = () => { if (!office) return; const at = office.anchor(); counterUi.style.setProperty("--ax", `${at.x}px`); counterUi.style.setProperty("--ay", `${at.y}px`); };
  const webgl = (() => { try { return !!document.createElement("canvas").getContext("webgl2"); } catch { return false; } })();
  if (webgl) {
    import("../scripts/fundbuero").then(({ mountFundbuero }) => {
      office = mountFundbuero({
        host, requested, target: best?.path ?? null, lang, reduced: prefersCalm(), number: numberPromise, shelfPaths,
        onRepaired: () => { placeUi(); counterUi.classList.add("is-on"); setTimeout(() => grab.classList.add("is-on"), 2400); },
        onFiled: () => { filed.dataset.shown = "1"; paint(); filed.classList.add("is-on"); },
      });
      addEventListener("resize", placeUi);
    }).catch(error => { console.warn("404: static office", error); host.classList.add("is-static"); counterUi.classList.add("is-on", "is-static"); });
  } else { host.classList.add("is-static"); counterUi.classList.add("is-on", "is-static"); }
  $<HTMLButtonElement>("[data-bell]").addEventListener("click", () => office?.ring());
  addEventListener("scroll", () => office?.scroll(Math.min(1, scrollY / Math.max(1, innerHeight * .8))), { passive: true });
  addEventListener("rb:langchange", () => { paint(); office?.relabel(); });
</script>
<style>
  :global(body:has(.lost-world)) { background: #0a0807; }
  :global(body:has(.lost-world) .site-fx), :global(body:has(.lost-world) rb-cursor-field) { display: none; }
  :global(html.has-custom-cursor:has(.lost-world)), :global(html.has-custom-cursor:has(.lost-world) a), :global(html.has-custom-cursor:has(.lost-world) button) { cursor: auto; }
  :global(body:has(.lost-world) sy-footer footer) { background: transparent; }
  :global(body:has(.lost-world) sy-footer) { --footer-deep: 10, 8, 7; }
  .lost-world { --ember: #dcaa7c; --label: var(--font-inter), system-ui, sans-serif; color: #e8e3dc; }
  .office { position: fixed; inset: 0; z-index: 0; background: #0a0807; }
  .office :global(canvas) { display: block; width: 100%; height: 100%; opacity: 0; transition: opacity 1.8s ease; }
  .office:global(.is-live) :global(canvas) { opacity: 1; }
  .office:global(.is-static) { background: radial-gradient(ellipse 40% 55% at 50% 38%, #3a2716, #0a0807 70%); }
  .void { position: relative; min-height: max(760px, 100svh); pointer-events: none; }
  .void-ui { position: relative; z-index: 2; padding: clamp(150px, 20vh, 220px) 0 0; margin-left: 6.5%; width: 34%; max-width: 560px; }
  .void-eyebrow, .recover-eyebrow { display: flex; align-items: center; gap: 12px; margin: 0 0 26px; font: 500 11px var(--label); text-transform: uppercase; letter-spacing: .22em; color: #c9b39c; }
  .void-eyebrow i { width: 6px; height: 6px; border-radius: 50%; background: var(--ember); box-shadow: 0 0 14px #e0955c99; }
  .void-title { margin: 0 0 26px; font: 400 clamp(64px, 7vw, 124px)/.9 var(--font-display), sans-serif; letter-spacing: -.06em; text-wrap: balance; }
  .void-lead { max-width: 420px; margin: 0; font: 400 17px/1.65 var(--font-inter), sans-serif; color: #b7b0a8; }
  .void-lead code { display: inline-block; padding: 1px 10px 2px; border-radius: 999px; background: #dcaa7c17; border: 1px solid #dcaa7c3d; font: 500 15px/1.5 var(--font-display), sans-serif; color: #f1cba9; overflow-wrap: anywhere; }
  [hidden] { display: none !important; }

  /* The answer sits under the corrected word, on the front of the counter. */
  .counter-ui { position: absolute; z-index: 2; left: var(--ax, 50%); top: calc(var(--ay, 70%) + 26px); transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 16px; opacity: 0; translate: 0 12px; transition: opacity 1s ease, translate 1s cubic-bezier(.2,.8,.2,1); pointer-events: none; }
  .counter-ui:global(.is-on) { opacity: 1; translate: 0 0; }
  .counter-ui:global(.is-on) .void-actions { pointer-events: auto; }
  .counter-ui:global(.is-static) { position: relative; left: auto; top: auto; transform: none; align-items: flex-start; margin: 40px 0 0 6.5%; }
  .void-actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 14px 26px; }
  .void-home { font: 400 14px var(--font-inter), sans-serif; color: #a9a39c; text-decoration: underline; text-decoration-color: #a9a39c55; text-underline-offset: 5px; transition: color .3s; }
  .void-home:hover { color: #efe8e1; }
  .filed { margin: 0; font: 500 11px var(--label); letter-spacing: .16em; text-transform: uppercase; color: #bfa98f; opacity: 0; transition: opacity 1s; }
  .filed:global(.is-on) { opacity: 1; }
  .glass-defs { position: absolute; pointer-events: none; }
  .evac { --glass-x: 24%; --glass-y: 0%; position: relative; display: inline-flex; justify-content: space-between; align-items: center; gap: 30px; min-height: 62px; padding: 9px 10px 9px 27px; border-radius: 999px; font: 500 15px var(--font-inter), sans-serif; color: #f6f2ec; text-decoration: none; isolation: isolate; box-shadow: 0 10px 30px #0008, 0 0 30px #e0a06a10; transition: transform .45s cubic-bezier(.2,.8,.2,1), box-shadow .4s; }
  .evac-glass { position: absolute; inset: 0; z-index: -1; overflow: hidden; border-radius: inherit; background: linear-gradient(155deg, #f5ece226, #d8c6b20a 45%, #d6a1751f); box-shadow: inset 0 3px 9px #fff4e80d, inset 0 -3px 8px #0006; backdrop-filter: blur(12px) saturate(1.35); -webkit-backdrop-filter: blur(12px) saturate(1.35); }
  @supports (backdrop-filter: url("#evac-glass-lens")) { .evac:global(.has-lens) .evac-glass { backdrop-filter: url("#evac-glass-lens") saturate(1.35); } }
  .evac::before { content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; background: radial-gradient(ellipse at var(--glass-x) var(--glass-y), #fff2e442, transparent 65%); opacity: .6; transition: opacity .35s; }
  .evac::after { content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; border: 1px solid #f1e3d42e; border-top-color: #fff1e285; border-bottom-color: #d3ad8555; }
  .evac-label { position: relative; text-shadow: 0 1px 5px #0007; }
  .evac-arrow { position: relative; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; font-size: 21px; background: linear-gradient(145deg,#fff4e81c,#ffffff05); border: 1px solid #fff1e226; transition: transform .4s; }
  .evac:hover { transform: translateY(-2px); box-shadow: 0 14px 34px #0009, 0 0 38px #e0a06a1f; }
  .evac:hover::before { opacity: 1; }
  .evac:hover .evac-arrow { transform: rotate(45deg); }

  .void-bottom { position: absolute; z-index: 2; bottom: 30px; left: 6.5%; right: 6.5%; display: flex; align-items: center; justify-content: space-between; gap: 24px; border-top: 1px solid #c9b39c1f; padding-top: 20px; }
  .void-scroll, .bell-button { pointer-events: auto; display: inline-flex; align-items: center; gap: 12px; color: #bdb5ac; font: 500 11px var(--label); letter-spacing: .16em; text-transform: uppercase; text-decoration: none; }
  .scroll-mark { font-size: 16px; color: var(--ember); }
  .bell-button { border: 0; padding: 0; background: none; min-height: 44px; cursor: pointer; }
  .bell-icon { display: grid; place-items: center; width: 36px; height: 36px; border: 1px solid #c79a6e55; border-radius: 50%; color: var(--ember); transition: box-shadow .3s, transform .3s; }
  .bell-button:hover .bell-icon { box-shadow: 0 0 24px #d08a5040; transform: rotate(-12deg); }
  .grab-hint { margin: 0; font: 400 13px var(--font-inter), sans-serif; color: #a39b92; opacity: 0; transition: opacity 1s; }
  .grab-hint:global(.is-on) { opacity: 1; }

  .recover { position: relative; z-index: 2; max-width: 1440px; margin: 0 auto; padding: 0 6.5% 70px; scroll-margin-top: 100px; }
  .recovery-axis { display: flex; flex-direction: column; align-items: center; gap: 14px; height: 190px; margin-bottom: 30px; opacity: .45; }
  .recovery-axis span { width: 1px; flex: 1; background: linear-gradient(transparent, #b89a78); }
  .recovery-axis span:last-child { background: linear-gradient(#b89a78, transparent); }
  .recovery-axis b { font: 14px var(--label); color: var(--ember); }
  .recover-head { max-width: 730px; margin-bottom: 70px; }
  .recover-eyebrow { justify-content: space-between; margin-bottom: 24px; }
  .recover-eyebrow span:last-child { color: #847a70; }
  .recover-head h2 { max-width: 650px; margin: 0 0 22px; font: 400 clamp(42px, 5.1vw, 76px)/1.02 var(--font-display); letter-spacing: -.05em; text-wrap: balance; }
  .recover-sub { max-width: 430px; margin: 0; font: 15px/1.8 var(--font-inter); color: #a8a19a; }
  .beacons { display: grid; grid-template-columns: 1fr 1fr; column-gap: 64px; }
  .beacon { position: relative; display: flex; align-items: flex-start; gap: 25px; min-height: 160px; border-top: 1px solid #c9b39c2e; padding: 30px 0; text-decoration: none; transition: border-color .3s; }
  .beacon-id { padding-top: 2px; font: 500 11px var(--label); letter-spacing: .08em; color: #9a8570; }
  .beacon-copy { display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .beacon-type { display: flex; align-items: center; gap: 10px; font: 500 10px var(--label); letter-spacing: .2em; color: #a39b92; }
  .beacon-type i, .diag i { width: 3px; height: 3px; border-radius: 50%; background: #b3a48c; }
  .beacon-name { font: 400 clamp(20px, 2vw, 30px)/1.25 var(--font-display); letter-spacing: -.035em; color: #ddd7cf; transition: color .3s; }
  .beacon-desc { max-width: 310px; font: 13px/1.65 var(--font-inter); color: #9a938b; }
  .beacon-go { font-size: 20px; color: #a89c8c; transition: transform .3s, color .3s; }
  .beacon:hover { border-color: #dcaa7ca6; }
  .beacon:hover .beacon-name, .beacon:hover .beacon-go { color: #f0c8a6; }
  .beacon:hover .beacon-go { transform: translate(3px, -3px); }
  .diag { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 18px; margin-top: 45px; padding-top: 22px; border-top: 1px solid #c9b39c1f; font: 500 10px var(--label); letter-spacing: .16em; color: #8f877e; text-transform: uppercase; }
  .diag > span:first-child { display: flex; align-items: center; gap: 9px; }
  .void-flash { position: fixed; inset: 0; z-index: 250; pointer-events: none; opacity: 0; background: #0a0807; transition: opacity .38s; }
  .void-flash:global(.is-on) { opacity: 1; }
  a:focus-visible, button:focus-visible { outline: 2px solid var(--ember); outline-offset: 6px; }
  @media (max-width: 1100px) and (min-width: 701px) { .void-ui { width: 44%; } }
  @media (max-width: 700px), (orientation: portrait) {
    .void { min-height: max(860px, 100svh); }
    .office { height: max(860px, 100svh); }
    .void-ui { padding: 112px 0 0; margin-left: 7%; width: 86%; max-width: none; }
    .void-eyebrow { font-size: 10px; margin-bottom: 16px; }
    .void-title { font-size: clamp(50px, 13vw, 84px); margin-bottom: 14px; }
    .void-lead { font-size: 15px; }
    .void-lead code { font-size: 13px; }
    .counter-ui { width: 88%; }
    .evac { gap: 18px; padding: 7px 8px 7px 20px; font-size: 14px; min-height: 54px; }
    .evac-arrow { width: 40px; height: 40px; }
    .void-bottom { left: 7%; right: 7%; bottom: 22px; gap: 12px; }
    .grab-hint { display: none; }
    .void-scroll, .bell-button { font-size: 10px; letter-spacing: .12em; gap: 9px; }
    .recover { padding: 0 7% 45px; }
    .recovery-axis { height: 120px; }
    .recover-head { margin-bottom: 42px; }
    .recover-head h2 { font-size: 43px; }
    .beacons { grid-template-columns: 1fr; }
    .beacon { min-height: 140px; gap: 20px; padding: 25px 0; }
    .beacon-name { font-size: 25px; }
    .diag { font-size: 9px; }
  }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
</style>
