---
import Layout from "../layouts/Layout.astro";
import { useTranslations } from "../i18n/utils";
import { driftRoutes } from "../data/drift-routes";

const t = useTranslations("en");
---

<Layout
  title="404 — Signal Lost"
  description="You've drifted off course. These coordinates do not exist in the current space."
  noindex={true}
  noWebgl={true}
>
  <section class="void" aria-labelledby="void-title">
    <!-- z1: open space — a black hole, the drifting astronaut, the frames still transmitting -->
    <div class="void-gl" data-drift data-routes={JSON.stringify(driftRoutes)}></div>

    <!-- z2: the readout -->
    <div class="void-ui">
      <p class="void-eyebrow" data-i18n="404.eyebrow" data-decode-in>{t("404.eyebrow")}</p>
      <h1 id="void-title" class="void-title" data-i18n="404.title" data-split>{t("404.title")}</h1>
      <p class="void-sub"><span data-i18n="404.drift.sub">{t("404.drift.sub")}</span> <code class="void-path" data-drift-path></code></p>
      <p class="void-hint" data-i18n="404.drift.hint">{t("404.drift.hint")}</p>
      <p class="void-closest" data-drift-closest hidden><span data-i18n="404.drift.closest">{t("404.drift.closest")}</span> <a href="/" data-drift-closest-link></a></p>
      <a href="/" class="evac" data-magnetic data-cursor="HOME">
        <span class="evac-inner" data-i18n="404.cta">{t("404.cta")}</span>
        <span class="evac-arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="void-corner tl" aria-hidden="true"><span data-decode-in>LOST SIGNAL</span></div>
    <div class="void-corner br" aria-hidden="true">
      <span>HORIZON <b data-tele="horizon">--.-</b> KM</span>
      <span>DRIFT <b data-tele="speed">0.00</b> M/S</span>
    </div>

    <span class="void-bracket tl" aria-hidden="true"></span>
    <span class="void-bracket tr" aria-hidden="true"></span>
    <span class="void-bracket bl" aria-hidden="true"></span>
    <span class="void-bracket br" aria-hidden="true"></span>
    <div class="void-flash" data-drift-flash aria-hidden="true"></div>
  </section>

  <!-- ── Signal recovery: real destinations, dressed as navigation beacons ──── -->
  <section class="recover" aria-labelledby="recover-title">
    <div class="recover-head">
      <span class="recover-eyebrow" data-i18n="404.recover.eyebrow" data-decode-in>{t("404.recover.eyebrow")}</span>
      <h2 id="recover-title" data-i18n="404.recover.title">{t("404.recover.title")}</h2>
      <p data-i18n="404.recover.sub">{t("404.recover.sub")}</p>
    </div>

    <div class="beacons">
      <a class="beacon" href="/" data-beacon data-magnetic data-cursor="HOME">
        <span class="beacon-top"><span class="beacon-id">00 / BASE</span><span class="beacon-dot"></span></span>
        <span class="beacon-name" data-i18n="404.beacon.studio.name">{t("404.beacon.studio.name")}</span>
        <span class="beacon-desc" data-i18n="404.beacon.studio.desc">{t("404.beacon.studio.desc")}</span>
        <span class="beacon-go" aria-hidden="true">→</span>
      </a>
      <a class="beacon" href="/services/" data-beacon data-magnetic data-cursor="OPEN">
        <span class="beacon-top"><span class="beacon-id">01 / WORKSHOP</span><span class="beacon-dot"></span></span>
        <span class="beacon-name" data-i18n="404.beacon.services.name">{t("404.beacon.services.name")}</span>
        <span class="beacon-desc" data-i18n="404.beacon.services.desc">{t("404.beacon.services.desc")}</span>
        <span class="beacon-go" aria-hidden="true">→</span>
      </a>
      <a class="beacon" href="/gallery/" data-beacon data-magnetic data-cursor="ENTER">
        <span class="beacon-top"><span class="beacon-id">02 / ARCHIVE</span><span class="beacon-dot"></span></span>
        <span class="beacon-name" data-i18n="404.beacon.archive.name">{t("404.beacon.archive.name")}</span>
        <span class="beacon-desc" data-i18n="404.beacon.archive.desc">{t("404.beacon.archive.desc")}</span>
        <span class="beacon-go" aria-hidden="true">→</span>
      </a>
      <a class="beacon" href="/work/bridge-consult/" data-beacon data-magnetic data-cursor="OPEN">
        <span class="beacon-top"><span class="beacon-id">03 / CASE</span><span class="beacon-dot"></span></span>
        <span class="beacon-name" data-i18n="404.beacon.bridge.name">{t("404.beacon.bridge.name")}</span>
        <span class="beacon-desc" data-i18n="404.beacon.bridge.desc">{t("404.beacon.bridge.desc")}</span>
        <span class="beacon-go" aria-hidden="true">→</span>
      </a>
      <a class="beacon" href="/work/fidic/" data-beacon data-magnetic data-cursor="OPEN">
        <span class="beacon-top"><span class="beacon-id">04 / CASE</span><span class="beacon-dot"></span></span>
        <span class="beacon-name" data-i18n="404.beacon.fidic.name">{t("404.beacon.fidic.name")}</span>
        <span class="beacon-desc" data-i18n="404.beacon.fidic.desc">{t("404.beacon.fidic.desc")}</span>
        <span class="beacon-go" aria-hidden="true">→</span>
      </a>
      <a class="beacon" href="/work/studio/" data-beacon data-magnetic data-cursor="OPEN">
        <span class="beacon-top"><span class="beacon-id">05 / META</span><span class="beacon-dot"></span></span>
        <span class="beacon-name" data-i18n="404.beacon.meta.name">{t("404.beacon.meta.name")}</span>
        <span class="beacon-desc" data-i18n="404.beacon.meta.desc">{t("404.beacon.meta.desc")}</span>
        <span class="beacon-go" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="diag" aria-hidden="true">
      <div class="diag-cell"><span class="diag-key">System</span><span class="diag-val"><i class="diag-pulse"></i><span data-i18n="404.diag.system">{t("404.diag.system")}</span></span></div>
      <div class="diag-cell"><span class="diag-key">Sector</span><span class="diag-val">rodionbelousov.studio</span></div>
      <div class="diag-cell"><span class="diag-key">Error</span><span class="diag-val">HTTP 404 · NO_ROUTE</span></div>
      <div class="diag-cell"><span class="diag-key">Recovery</span><span class="diag-val" data-i18n="404.diag.recovery">{t("404.diag.recovery")}</span></div>
    </div>
  </section>
</Layout>

<script>
  // 404 — "The Drift": the scene lives in src/scripts/drift404.ts.
  import gsap from "gsap";
  import { decodeText, prefersCalm } from "../utils/decode";
  import type { DriftRoute } from "../data/drift-routes";

  const host = document.querySelector<HTMLElement>("[data-drift]");
  const requested = (() => { try { return decodeURI(location.pathname) || "/"; } catch { return location.pathname; } })();
  const lang = (): "en" | "de" => (document.documentElement.lang.startsWith("de") ? "de" : "en");
  const reduced = prefersCalm();
  document.querySelectorAll<HTMLElement>("[data-drift-path]").forEach((el) => (el.textContent = requested));

  const closest = document.querySelector<HTMLElement>("[data-drift-closest]");
  const closestLink = document.querySelector<HTMLAnchorElement>("[data-drift-closest-link]");
  const flash = document.querySelector<HTMLElement>("[data-drift-flash]");
  const horizon = document.querySelector<HTMLElement>('[data-tele="horizon"]');
  const speed = document.querySelector<HTMLElement>('[data-tele="speed"]');
  let best: DriftRoute | undefined;
  const showClosest = () => {
    if (!closest || !closestLink) return;
    closest.hidden = !best;
    if (best) { closestLink.href = best.path; closestLink.textContent = best[lang()]; }
  };
  // The beam ends in a white-blue flash, then the page changes underneath it.
  const go = (path: string) => {
    if (!flash || reduced) { location.href = path; return; }
    flash.classList.add("is-on");
    setTimeout(() => (location.href = path), 420);
  };
  addEventListener("pageshow", () => flash?.classList.remove("is-on"));

  const webgl = (() => { try { return !!document.createElement("canvas").getContext("webgl2"); } catch { return false; } })();
  if (host && webgl) {
    import("../scripts/drift404").then(({ mountDrift }) => {
      const routes = JSON.parse(host.dataset.routes || "[]") as DriftRoute[];
      let lastTele = 0;
      const drift = mountDrift({
        host, routes, requested, lang, reduced,
        onSignals: (signals) => { best = signals[0] && signals[0].score > 0 ? signals[0].route : undefined; showClosest(); },
        onTelemetry: ({ horizon: h, speed: v }) => {
          const now = performance.now(); if (now - lastTele < 160) return; lastTele = now;
          if (horizon) horizon.textContent = (h * 1.7).toFixed(1);
          if (speed) speed.textContent = v.toFixed(2);
        },
        onNavigate: go,
      });
      closestLink?.addEventListener("click", (event) => {
        if (!best || event.metaKey || event.ctrlKey || event.shiftKey) return;
        event.preventDefault(); drift.beam(best.path);
      });
      addEventListener("rb:langchange", () => { drift.relabel(); showClosest(); });
      document.fonts?.ready.then(() => drift.relabel());
    }).catch((error) => { console.warn("404: showing the static scene.", error); host.classList.add("is-static"); });
  } else host?.classList.add("is-static");

  // Title: characters resolve in a scrambled order.
  document.querySelectorAll<HTMLElement>("[data-split]").forEach((el) => {
    const text = el.textContent ?? "";
    el.textContent = ""; el.setAttribute("aria-label", text);
    const spans: HTMLElement[] = [];
    for (const ch of text) {
      const s = document.createElement("span"); s.className = "void-char"; s.textContent = ch === " " ? " " : ch;
      s.setAttribute("aria-hidden", "true"); el.appendChild(s); spans.push(s);
    }
    if (reduced) return;
    gsap.set(spans, { opacity: 0, y: (i) => (i % 2 ? 30 : -30), rotateX: -60 });
    gsap.to(spans, { opacity: 1, y: 0, rotateX: 0, duration: 0.9, ease: "power3.out", delay: 0.25, stagger: { each: 0.05, from: "random" } });
  });
  document.querySelectorAll<HTMLElement>("[data-decode-in]").forEach((el, i) => gsap.delayedCall(0.5 + i * 0.08, () => decodeText(el, { duration: 720 })));
  if (!reduced) gsap.fromTo([".void-sub", ".void-hint", ".void-closest", ".evac"], { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: 1, ease: "power3.out", delay: 0.7, stagger: 0.1 });

  // Beacon grid drifts into range as it scrolls into view.
  const beacons = gsap.utils.toArray<HTMLElement>("[data-beacon]");
  if (beacons.length && !reduced) {
    gsap.set(beacons, { opacity: 0, y: 26 });
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e, i) => { if (!e.isIntersecting) return; gsap.to(e.target, { opacity: 1, y: 0, duration: 0.8, ease: "power3.out", delay: (i % 3) * 0.08 }); io.unobserve(e.target); });
    }, { threshold: 0.18 });
    beacons.forEach((b) => io.observe(b));
  }
</script>

<style>
  .void {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: #020305;
  }
  .void-gl { position: absolute; inset: 0; z-index: 1; opacity: 0; transition: opacity 1.4s ease; }
  .void-gl:global(.is-live) { opacity: 1; }
  .void-gl :global(canvas) { display: block; width: 100%; height: 100%; }
  .void-gl:global(.is-static) {
    opacity: 1;
    background:
      radial-gradient(circle at 69% 48%, #000 0 6.5%, #ffcf94 7.2%, #b8521a 9.5%, rgba(80, 30, 10, 0.4) 14%, transparent 24%),
      radial-gradient(90% 70% at 69% 48%, #0b1426, #020305 70%);
  }

  .void-ui {
    position: absolute;
    z-index: 2;
    left: clamp(1.2rem, 5vw, 5rem);
    top: clamp(7rem, 18vh, 11rem);
    max-width: min(34rem, 40vw);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    pointer-events: none;
  }
  .void-ui a { pointer-events: auto; }

  .void-eyebrow {
    margin: 0;
    font-family: var(--font-inter);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.5em;
    color: rgba(255, 190, 150, 0.72);
    text-transform: uppercase;
  }
  .void-title {
    margin: 0;
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: clamp(3rem, 7vw, 6.6rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
    color: #f2f6fb;
    text-shadow: 0 0 4rem rgba(255, 170, 110, 0.18);
  }
  .void-char { display: inline-block; will-change: transform, opacity; }
  .void-sub, .void-hint, .void-closest {
    margin: 0;
    font-family: var(--font-inter);
    font-size: clamp(0.85rem, 1.15vw, 1rem);
    line-height: 1.6;
    color: rgba(216, 226, 240, 0.74);
  }
  .void-hint { color: rgba(216, 226, 240, 0.5); font-size: clamp(0.78rem, 0.95vw, 0.88rem); max-width: 30rem; }
  .void-path {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.9em;
    color: #ffc9a8;
    background: rgba(255, 140, 90, 0.1);
    border: 1px solid rgba(255, 150, 100, 0.26);
    border-radius: 0.35rem;
    padding: 0.05rem 0.4rem;
    word-break: break-all;
  }
  .void-closest { color: rgba(255, 217, 138, 0.82); font-size: 0.82rem; letter-spacing: 0.02em; }
  .void-closest[hidden] { display: none; }
  .void-closest a { color: #ffd98a; text-decoration: underline; text-underline-offset: 0.25em; }

  .evac {
    --mx: 0px; --my: 0px;
    margin-top: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 1.4rem;
    height: 3.3rem;
    padding: 0 1.5rem 0 1.8rem;
    font-family: var(--font-inter);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(240, 246, 252, 0.92);
    background: rgba(140, 170, 210, 0.08);
    border: 1px solid rgba(180, 205, 235, 0.24);
    border-radius: 2rem;
    transform: translate3d(var(--mx), var(--my), 0);
    transition: background 0.5s var(--ease-out-expo), border-color 0.5s var(--ease-out-expo);
  }
  .evac:hover { background: rgba(190, 215, 245, 0.16); border-color: rgba(200, 222, 250, 0.5); color: #fff; }
  .evac-arrow { font-size: 1.15em; font-weight: 300; transition: transform 0.4s var(--ease-out-expo); }
  .evac:hover .evac-arrow { transform: translateX(5px); }

  .void-corner {
    position: absolute;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-family: var(--font-inter);
    font-size: 0.54rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    color: rgba(180, 200, 225, 0.42);
    pointer-events: none;
  }
  .void-corner.tl { top: 6.5rem; left: clamp(1.2rem, 4vw, 3rem); }
  .void-corner.br { bottom: 2rem; right: clamp(1.2rem, 4vw, 3rem); text-align: right; align-items: flex-end; }
  .void-corner b { color: rgba(230, 236, 244, 0.78); font-weight: 500; font-variant-numeric: tabular-nums; }
  .void-bracket { position: absolute; z-index: 2; width: 16px; height: 16px; opacity: 0.35; pointer-events: none; }
  .void-bracket.tl { top: 5.6rem; left: 1.2rem; border-top: 1px solid #cdd8e6; border-left: 1px solid #cdd8e6; }
  .void-bracket.tr { top: 5.6rem; right: 1.2rem; border-top: 1px solid #cdd8e6; border-right: 1px solid #cdd8e6; }
  .void-bracket.bl { bottom: 1.2rem; left: 1.2rem; border-bottom: 1px solid #cdd8e6; border-left: 1px solid #cdd8e6; }
  .void-bracket.br { bottom: 1.2rem; right: 1.2rem; border-bottom: 1px solid #cdd8e6; border-right: 1px solid #cdd8e6; }
  .void-scroll {
    position: absolute; left: 50%; bottom: 1.7rem; z-index: 2; transform: translateX(-50%);
    display: inline-flex; align-items: center; gap: .6rem;
    font-family: var(--font-inter); font-size: .54rem; font-weight: 500; letter-spacing: .34em; text-transform: uppercase;
    color: rgba(180, 200, 225, .42); pointer-events: none;
  }
  .void-scroll b { width: 1px; height: 2rem; background: linear-gradient(rgba(180, 200, 225, 0), rgba(180, 200, 225, .7)); animation: scroll-pull 2.4s ease-in-out infinite; }
  @keyframes scroll-pull { 0%, 100% { transform: scaleY(.4); opacity: .4; transform-origin: top; } 50% { transform: scaleY(1); opacity: 1; transform-origin: top; } }
  /* The white-blue flash of the beam, over everything, just before the page changes. */
  .void-flash { position: fixed; inset: 0; z-index: 50; pointer-events: none; opacity: 0; background: radial-gradient(circle at 50% 50%, #eaf6ff, #8fd8ff 45%, #0b1830); transition: opacity .42s ease-in; }
  .void-flash:global(.is-on) { opacity: 1; }

  @media (max-width: 700px), (orientation: portrait) {
    .void-ui { top: 5.6rem; bottom: 1.3rem; left: 1.2rem; right: 1.2rem; max-width: none; gap: 0.55rem; }
    .void-title { font-size: clamp(2.3rem, 10.5vw, 3.4rem); }
    .void-hint { display: none; }
    .void-sub, .void-closest { font-size: 0.8rem; }
    .evac { position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); margin: 0; height: 3rem; white-space: nowrap; }
    .void-corner.tl, .void-corner.br, .void-bracket, .void-scroll { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .void-scroll b { animation: none; } .void-flash { transition: none; } }

  /* ── Signal recovery ───────────────────────────────────────────────────── */
  /* Flat #030405 — exactly the void's WebGL clear colour — so the seam between
     the two sections disappears and the page reads as one black space instead
     of shifting blue toward the bottom. */
  .recover {
    position: relative;
    z-index: 2;
    padding: clamp(4rem, 9vw, 8rem) clamp(1.2rem, 5vw, 5rem) clamp(5rem, 10vw, 9rem);
    background: #030405;
  }
  /* A scattered starfield (not a regular grid) that carries the void's stars
     down through the lower half. Four layers at coprime sizes never line up,
     so it reads as random sky. */
  .recover::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1.3px 1.3px at 24% 33%, rgba(255, 255, 255, .6), transparent 60%),
      radial-gradient(1px 1px at 72% 61%, rgba(255, 255, 255, .45), transparent 60%),
      radial-gradient(1.4px 1.4px at 52% 84%, rgba(205, 222, 255, .5), transparent 60%),
      radial-gradient(1px 1px at 88% 20%, rgba(255, 255, 255, .38), transparent 60%);
    background-size: 9rem 9rem, 13rem 13rem, 17rem 17rem, 23rem 23rem;
    pointer-events: none;
  }
  .recover-head {
    position: relative;
    max-width: 46rem;
    margin: 0 auto clamp(2.6rem, 5vw, 4.2rem);
    text-align: center;
  }
  .recover-eyebrow {
    display: block;
    margin-bottom: 1.1rem;
    font-family: var(--font-inter);
    font-size: .6rem;
    font-weight: 500;
    letter-spacing: .5em;
    text-indent: .5em;
    text-transform: uppercase;
    color: rgba(190, 210, 235, .5);
  }
  .recover-head h2 {
    margin: 0 0 1.1rem;
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: clamp(2.1rem, 5.2vw, 3.7rem);
    line-height: 1;
    letter-spacing: -.02em;
    color: #f2f6fb;
  }
  .recover-head p {
    margin: 0 auto;
    max-width: 34rem;
    font-family: var(--font-inter);
    font-size: clamp(.9rem, 1.4vw, 1.02rem);
    line-height: 1.65;
    color: rgba(216, 226, 240, .6);
  }

  .beacons {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    gap: clamp(.8rem, 1.6vw, 1.1rem);
    max-width: 74rem;
    margin: 0 auto;
  }
  .beacon {
    --mx: 0px; --my: 0px;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: .55rem;
    padding: clamp(1.4rem, 2.4vw, 1.9rem);
    border: 1px solid rgba(180, 205, 235, .14);
    border-radius: 10px;
    background: linear-gradient(150deg, rgba(255, 255, 255, .035), rgba(255, 255, 255, .006));
    text-decoration: none;
    overflow: hidden;
    transform: translate3d(var(--mx), var(--my), 0);
    transition: border-color .5s var(--ease-out-expo), background .5s var(--ease-out-expo);
  }
  .beacon::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 82% 0%, rgba(150, 190, 255, .16), transparent 60%);
    opacity: 0;
    transition: opacity .5s var(--ease-out-expo);
    pointer-events: none;
  }
  .beacon:hover {
    border-color: rgba(200, 222, 250, .44);
    background: linear-gradient(150deg, rgba(255, 255, 255, .075), rgba(255, 255, 255, .015));
  }
  .beacon:hover::after { opacity: 1; }
  .beacon-top { display: flex; align-items: center; justify-content: space-between; }
  .beacon-id {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: .56rem;
    letter-spacing: .2em;
    color: rgba(180, 200, 225, .5);
  }
  .beacon-dot {
    width: .4rem;
    height: .4rem;
    border-radius: 50%;
    background: rgba(150, 190, 255, .45);
    box-shadow: 0 0 .5rem rgba(150, 190, 255, .4);
    transition: background .4s var(--ease-out-expo), box-shadow .4s var(--ease-out-expo);
  }
  .beacon:hover .beacon-dot { background: #9ec3ff; box-shadow: 0 0 .8rem #9ec3ff; }
  .beacon-name {
    font-family: var(--font-display), sans-serif;
    font-weight: 500;
    font-size: clamp(1.35rem, 2.2vw, 1.7rem);
    line-height: 1.05;
    color: #f2f6fb;
  }
  .beacon-desc {
    font-family: var(--font-inter);
    font-size: .82rem;
    line-height: 1.55;
    color: rgba(210, 222, 238, .56);
  }
  .beacon-go {
    margin-top: .35rem;
