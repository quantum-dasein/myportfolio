---
import Layout from "../layouts/Layout.astro";
import HeroHome from "../components/HeroHome.astro";
import MotionGallery from "../components/MotionGallery.astro";
import TextMarquee from "../components/TextMarquee.astro";
import VideoType from "../components/VideoType.astro";
import ScrollScrub from "../components/ScrollScrub.astro";
import { useTranslations, type UIKey } from "../i18n/utils";

const lang = "en";
const t = useTranslations(lang);
const tk = (key: string) => t(key as UIKey);

const pillars = [1, 2, 3].map((n) => ({
  title: `about.pillar.${n}.title`,
  text: `about.pillar.${n}.text`,
}));

// Real proof links: the WinCC OA training series and the Awaken Trees film
// were produced by Rodion — they anchor the career cards in verifiable work.
const jobLinks: Record<number, { href: string; i18n: string }> = {
  2: { href: "https://www.youtube.com/@WinCCOA/playlists", i18n: "exp.2.link" },
  3: { href: "https://www.youtube.com/watch?v=cC-eCQHxzyA", i18n: "exp.3.link" },
};

const jobs = [1, 2, 3].map((n) => ({
  n,
  company: `exp.${n}.company`,
  role: `exp.${n}.role`,
  period: `exp.${n}.period`,
  text: `exp.${n}.text`,
  link: jobLinks[n],
}));

const edu = [1, 2, 3].map((n) => ({
  degree: `edu.${n}.degree`,
  school: `edu.${n}.school`,
  period: `edu.${n}.period`,
}));

// `warp` marks the two projects the bespoke WebGL departure was drawn for.
// Everything else navigates with the ordinary page transition: the warp only
// knows "bridge" and "fidic", so a third case handed to it silently played
// Bridge Consult's animation for a project that is not Bridge Consult.
const selectedWork = [
  {
    title: "work.1.title",
    tag: "work.1.tag",
    role: "work.1.role",
    year: "work.1.year",
    text: "work.1.text",
    img: "/cases/rodion-belousov-bridge-consult-ai-assisted-web-development-case-study.webp",
    href: "/work/bridge-consult",
    warp: true,
  },
  {
    title: "work.2.title",
    tag: "work.2.tag",
    role: "work.2.role",
    year: "work.2.year",
    text: "work.2.text",
    img: "/cases/rodion-belousov-fidic-uz-contract-knowledge-platform-design.webp",
    href: "/work/fidic",
    warp: true,
  },
  // Third on purpose, and small on purpose. Two studies about multilingual
  // platforms tell a business that needs five pages it is the wrong size of
  // client; this one says otherwise with a project instead of a sentence.
  {
    title: "work.3.title",
    tag: "work.3.tag",
    role: "work.3.role",
    year: "work.3.year",
    text: "work.3.text",
    img: "/cases/rodion-belousov-bridge-consult-academy-one-page-course-landing.webp",
    href: "/work/academy",
    warp: false,
  },
];
---

<Layout
  alternateUrls={{ "x-default": "/" }}
  title="Web Developer in Vienna — Websites, Webdesign & SEO | Rodion Belousov"
  description="Websites, Webdesign and SEO in Vienna (Wien). A clear business site live in about a week — fixed price, fast, yours to keep — plus interactive builds when a brand needs more."
  pageType="profile"
  keywords={[
    "Digital Marketer Vienna",
    "SEO Consultant Austria",
    "Creative Developer Vienna",
    "Astro Developer Austria",
    "Three.js Developer Vienna",
    "Content Marketing Austria",
    "WebGL Portfolio",
    "Rodion Belousov",
  ]}
  structuredData={[
    {
      "@type": "VideoObject",
      "@id": "https://rodionbelousov.studio/#awaken-trees-film",
      name: "Awaken Trees — FMNR Reforestation Explainer Film",
      description:
        "Animated explainer film about the FMNR (Farmer Managed Natural Regeneration) reforestation method, created by Rodion Belousov for the Vienna-based initiative Awaken Trees.",
      contentUrl: "https://www.youtube.com/watch?v=cC-eCQHxzyA",
      embedUrl: "https://www.youtube.com/embed/cC-eCQHxzyA",
      thumbnailUrl: "https://i.ytimg.com/vi/cC-eCQHxzyA/hqdefault.jpg",
      uploadDate: "2022-01-01",
      inLanguage: "en",
      creator: { "@id": "https://rodionbelousov.studio/#rodion-belousov" },
    },
    {
      "@type": "CreativeWorkSeries",
      "@id": "https://rodionbelousov.studio/#wincc-oa-video-series",
      name: "SIMATIC WinCC Open Architecture — Tutorial & Safety Video Series",
      description:
        "2D tutorial videos and safety-guideline explainers for SIMATIC WinCC Open Architecture, Siemens' scalable SCADA platform, produced by Rodion Belousov at Siemens Eisenstadt.",
      url: "https://www.youtube.com/@WinCCOA/playlists",
      creator: { "@id": "https://rodionbelousov.studio/#rodion-belousov" },
      publisher: { "@type": "Organization", name: "Siemens" },
    },
  ]}
>
  <HeroHome />

  <TextMarquee
    class="signal-marquee"
    texts={["Digital Marketing", "Content Systems", "SEO", "Creative Development", "Vienna"]}
  />

  <section class="section approach" id="about">
    <div class="u-container section-grid">
      <span class="s-idx">01 - <span data-i18n="about.label">{t("about.label")}</span></span>
      <div>
        <h2 class="s-title" data-sy-reveal="words" data-i18n="about.title">{t("about.title")}</h2>
        <p class="s-lead" data-sy-reveal="lines" data-i18n="about.text">{t("about.text")}</p>

        <div class="pillars">
          {
            pillars.map((pillar, index) => (
              <article class="pillar glass-tilt" data-reveal data-tilt-card>
                <span class="pillar-glint" aria-hidden="true"></span>
                <span class="pillar-index">{String(index + 1).padStart(2, "0")}</span>
                <h3 data-sy-reveal="words" data-i18n={pillar.title}>{tk(pillar.title)}</h3>
                <p data-i18n={pillar.text}>{tk(pillar.text)}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ── The objection, answered before it is raised ────────────────────── -->
  <section class="section objection" id="objection">
    <div class="u-container section-grid">
      <span class="s-idx">02 - <span data-i18n="objection.label">{t("objection.label")}</span></span>
      <div>
        <h2 class="s-title obj-title" data-sy-reveal="words" data-i18n="objection.title">{t("objection.title")}</h2>
        <p class="s-lead" data-sy-reveal="lines" data-i18n="objection.text">{t("objection.text")}</p>

        <div class="obj-rows">
          {
            [1, 2, 3].map((n) => (
              <article class="obj-row" data-reveal>
                <h3 data-i18n={`objection.${n}.title`}>{tk(`objection.${n}.title`)}</h3>
                <p data-i18n={`objection.${n}.text`}>{tk(`objection.${n}.text`)}</p>
              </article>
            ))
          }
        </div>

        <a class="obj-cta" href="/notes" data-cursor="READ" data-magnetic>
          <span data-i18n="objection.cta">{t("objection.cta")}</span>
          <i class="ui-arrow" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- The CV used to be two full sections here AND the whole of the profile
       page, word for word. It belongs on the profile page: that page exists to
       be the professional record, and repeating it here made both look like
       padding for search. This band is the pointer, and the home page stays
       about the work. -->
  <section class="section record" id="record">
    <div class="u-container section-grid">
      <span class="s-idx">03 - <span data-i18n="record.label">{t("record.label")}</span></span>
      <div>
        <h2 class="s-title" data-sy-reveal="words" data-i18n="record.title">{t("record.title")}</h2>
        <p class="record-text" data-sy-reveal="lines" data-i18n="record.text">{t("record.text")}</p>
        <a
          class="record-link"
          href={lang === "de" ? "/de/rodion-belousov-wien/" : "/en/rodion-belousov-vienna/"}
          data-lang-href-en="/en/rodion-belousov-vienna/"
          data-lang-href-de="/de/rodion-belousov-wien/"
          data-cursor="OPEN"
          data-magnetic
        >
          <span data-i18n="record.cta">{t("record.cta")}</span>
          <span class="css-arrow" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section work" id="work">
    <div class="u-container work-composition">
      <div class="work-intro">
        <span class="s-idx">04 - <span data-i18n="work.label">{t("work.label")}</span></span>
        <h2 class="s-title" data-sy-reveal="words" data-i18n="work.title">{t("work.title")}</h2>
        <p class="s-lead" data-sy-reveal="lines" data-i18n="work.text">{t("work.text")}</p>
        <a class="work-archive-link" href="/gallery" data-tunnel data-cursor="VIEW">
          <span data-i18n="gallery.cta">{t("gallery.cta")}</span><span class="css-arrow css-arrow-up" aria-hidden="true"></span>
        </a>

        <!-- The third case is this site itself. It is a text link rather than a
             card: the stage above is art-directed around exactly two cards. -->
        <a class="work-archive-link meta" href="/work/studio" data-cursor="READ" data-magnetic>
          <span data-i18n="studio.eyebrow">{t("studio.eyebrow")}</span><span class="css-arrow css-arrow-up" aria-hidden="true"></span>
        </a>
        <!-- These chips used to read "Solo Build / Claude / Cursor / Codex",
             which advertised the one part of the work a visitor can already buy
             for themselves. They name what the two systems actually are now. -->
        <div class="work-signals" aria-label="What these two systems are">
          <span>Solo Build</span><span>3 Languages</span><span>Live Data</span><span>Maintained</span>
        </div>
      </div>

      <div class="work-stage">
        <div class="work-core" aria-hidden="true">
          <span class="work-core-shine"></span>
          <span class="work-core-grid"></span>
        </div>
        <div class="work-terrain" aria-hidden="true"></div>
        <div class="work-orbits" aria-hidden="true">
          <span class="orbit orbit-one"></span>
          <span class="orbit orbit-two"></span>
          <span class="orbit-node node-one"></span>
          <span class="orbit-node node-two"></span>
          <span class="orbit-label label-one">SYSTEMS<br />THINKING</span>
          <span class="orbit-label label-two">CONTENT<br />ARCHITECTURE</span>
          <span class="orbit-label label-three">FRONTEND<br />ENGINEERING</span>
        </div>

        <div class="work-grid">
          {
            selectedWork.map((work, index) => (
              <article class="work-card" style={`--case-index:${index}`}>
                <a
                  href={work.href}
                  target={work.href.startsWith("http") ? "_blank" : undefined}
                  rel={work.href.startsWith("http") ? "noopener" : undefined}
                  data-case-link={work.warp ? true : undefined}
                  data-cursor="OPEN"
                >
                  <figure>
                    <img src={work.img} alt={tk(work.title)} loading="lazy" />
                  </figure>
                  <div class="work-copy">
                    <div class="work-meta">
                      <span>{String(index + 1).padStart(2, "0")} / <span data-i18n={work.tag}>{tk(work.tag)}</span></span>
                      <span data-i18n={work.year}>{tk(work.year)}</span>
                    </div>
                    <h3 data-sy-reveal="words" data-i18n={work.title}>{tk(work.title)}</h3>
                    <p class="work-role" data-i18n={work.role}>{tk(work.role)}</p>
                    <p data-i18n={work.text}>{tk(work.text)}</p>
                    <span class="work-cta">
                      <span data-i18n="work.cta">{t("work.cta")}</span>
                      <span class="css-arrow css-arrow-up" aria-hidden="true"></span>
                    </span>
                  </div>
                </a>
              </article>
            ))
          }
        </div>

        {/* The deck controls. Hidden until the script turns the column into a
            deck, so a visitor whose JavaScript failed still gets three cards in
            a readable column rather than dots that do nothing. */}
        <div class="deck-ui" data-deck-ui hidden>
          <button type="button" class="deck-arrow" data-deck-step="-1" aria-label="Previous project">
            <i aria-hidden="true"></i>
          </button>
          <div class="deck-dots" role="tablist" aria-label="Selected work">
            {selectedWork.map((work, index) => (
              <button
                type="button"
                role="tab"
                class="deck-dot"
                data-deck-dot={index}
                aria-selected={index === 0 ? "true" : "false"}
                aria-label={tk(work.title)}
              ><span></span></button>
            ))}
          </div>
          <button type="button" class="deck-arrow" data-deck-step="1" aria-label="Next project">
            <i aria-hidden="true"></i>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Services & Research existed only in the header until now. This is the
       on-page entry: a teaser that reads as part of the story and hands off to
       the /services hub. Card hrefs come from the dictionary, so they follow
       the active language to the matching localized deep-dive. -->
  <section class="section services-teaser" id="services">
    <div class="u-container section-grid">
      <span class="s-idx">05 - <span data-i18n="nav.services">{t("nav.services")}</span></span>
      <div>
        <h2 class="s-title" data-sy-reveal="words" data-i18n="services.teaser.title">{t("services.teaser.title")}</h2>
        <p class="s-lead" data-sy-reveal="lines" data-i18n="services.teaser.text">{t("services.teaser.text")}</p>

        <div class="svc-list">
          {
            [1, 2, 3, 4].map((n) => (
              <a
                class="svc-item"
                href={tk(`services.${n}.href`)}
                data-i18n-attr={`href:services.${n}.href, data-transition-label:services.${n}.title`}
                data-reveal
                data-cursor="OPEN"
                data-transition-label={tk(`services.${n}.title`)}
              >
                <span class="svc-item-n">{String(n).padStart(2, "0")}</span>
                <span class="svc-item-body">
                  <span class="svc-item-title" data-i18n={`services.${n}.title`}>{tk(`services.${n}.title`)}</span>
                  <span class="svc-item-text" data-i18n={`services.${n}.text`}>{tk(`services.${n}.text`)}</span>
                </span>
                <span class="css-arrow css-arrow-up" aria-hidden="true"></span>
              </a>
            ))
          }
        </div>

        <a class="svc-all" href="/services" data-reveal data-cursor="OPEN" data-magnetic>
          <span data-i18n="nav.services">{t("nav.services")}</span>
          <span class="css-arrow css-arrow-up" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Rodion's own Redshift render playing inside the word -->
  <VideoType
    text="MOTION"
    video="/portfolio/video/rodion-belousov-squidz-pos-display-3d-animation.mp4"
    poster="/portfolio/rodion-belousov-squidz-pos-display-3d-animation-poster.webp"
    labelKey="reel.type.label"
    label={t("reel.type.label")}
  />

  <MotionGallery />

  <!-- Apple-style: the product film turns under the visitor's scroll -->
  <ScrollScrub
    video="/portfolio/video/rodion-belousov-ski-snowboard-equipment-3d-product-animation.mp4"
    poster="/portfolio/rodion-belousov-ski-snowboard-equipment-3d-product-animation-poster.jpg"
    eyebrowKey="scrub.eyebrow"
    eyebrow={t("scrub.eyebrow")}
    titleKey="scrub.title"
    title={t("scrub.title")}
    textKey="scrub.text"
    text={t("scrub.text")}
  />

  <section class="portal" id="archive">
    <div class="u-container portal-inner">
      <div>
        <span class="s-idx">06 - <span data-i18n="portal.eyebrow">{t("portal.eyebrow")}</span></span>
        <h2 class="portal-title" data-sy-reveal="words" data-i18n="portal.title">{t("portal.title")}</h2>
        <p class="portal-text" data-sy-reveal="lines" data-i18n="portal.text">{t("portal.text")}</p>
      </div>
      <a class="archive-button" href="/gallery" data-tunnel data-reveal data-cursor="ENTER" data-magnetic aria-label={t("portal.cta")}>
        <span class="archive-orbit" aria-hidden="true"></span>
        <span class="archive-label" data-i18n="portal.cta">{t("portal.cta")}</span>
        <span class="archive-arrow css-arrow css-arrow-down" aria-hidden="true"></span>
      </a>
    </div>
  </section>

  <section class="section contact legacy-ending" id="legacy-contact">
    <div class="u-container contact-grid">
      <span class="s-idx">07 - <span data-i18n="contact.label">{t("contact.label")}</span></span>
      <div>
        <h2 class="contact-title" data-sy-reveal="words" data-i18n="contact.title">{t("contact.title")}</h2>
        <p class="s-lead" data-sy-reveal="lines" data-i18n="contact.text">{t("contact.text")}</p>
        <div class="contact-links" data-reveal>
          <a href={`mailto:${t("contact.email")}`} data-i18n="contact.email">{t("contact.email")}</a>
          <a href="https://www.behance.net/gallery/146849483/Meine-3D-Projekte" target="_blank" rel="noopener" data-i18n="contact.behance.label">
            {t("contact.behance.label")}
          </a>
          <a href="https://www.linkedin.com/in/rodion-belousov-413040228/" target="_blank" rel="me noopener">LinkedIn</a>
          <span data-i18n="contact.location">{t("contact.location")}</span>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .signal-marquee {
    --c: rgba(var(--rgb-text), 0.95);
    position: relative;
    z-index: 2;
    padding: 1.2rem 0;
    overflow: hidden;
    border-block: 1px solid rgba(255, 255, 255, 0.11);
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.025), rgba(255, 255, 255, 0.065), rgba(255, 255, 255, 0.018)),
      rgba(2, 2, 3, 0.72);
    backdrop-filter: blur(18px) saturate(0.8);
    box-shadow: 0 0 3rem rgba(255, 255, 255, 0.035);
  }

  .signal-marquee :global(.text) {
    --fs: 2.15rem;
    font-weight: 420;
    letter-spacing: 0;
    color: rgba(248, 250, 250, 0.88);
    background: none;
  }

  .signal-marquee :global(.divider) {
    opacity: 0.42;
  }

  .section {
    position: relative;
    padding: clamp(6rem, 13vw, 12rem) 0;
    overflow: clip;
    background:
      radial-gradient(circle at 82% 16%, rgba(255, 255, 255, 0.055), transparent 29rem),
      radial-gradient(circle at 12% 76%, rgba(255, 255, 255, 0.032), transparent 32rem),
      linear-gradient(180deg, rgba(3, 3, 4, 0.4), rgba(8, 9, 10, 0.74) 18%, rgba(5, 6, 7, 0.66) 82%, rgba(2, 2, 3, 0.36));
  }

  .section::before {
    content: "";
    position: absolute;
    inset: -20% 0 auto;
    height: 36rem;
    pointer-events: none;
    background:
      radial-gradient(circle at 76% 22%, rgba(255, 255, 255, 0.075), transparent 25rem),
      linear-gradient(115deg, transparent 28%, rgba(255, 255, 255, 0.018) 49%, transparent 66%);
    opacity: 0.82;
  }

  .section-grid,
  .work-head,
  .contact-grid {
    display: grid;
    grid-template-columns: 18rem minmax(0, 1fr);
    gap: 3rem;

    @media (--mq-tablet) {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  .s-idx {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--color-text-alt);
    font-family: var(--font-inter);
    font-size: var(--font-size-xs);
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .s-idx.center {
    display: block;
    text-align: center;
  }

  .s-title,
  .contact-title {
    max-width: 15ch;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.2rem, 5.8vw, 5.1rem);
    line-height: 0.98;
    letter-spacing: 0;
    color: #f7f9f9;
    background: none;
    filter: drop-shadow(0 0 1.6rem rgba(255, 255, 255, 0.06));
  }

  .s-lead {
    max-width: 43rem;
    margin: 2.2rem 0 0;
    color: rgba(var(--rgb-text), 0.82);
    font-size: clamp(1.1rem, 2vw, 1.55rem);
    line-height: 1.55;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.45);
  }

  /* ── Services & Research teaser (hands off to /services) ───────────────── */
  .svc-list {
    display: flex;
    flex-direction: column;
    margin-top: 3rem;
  }

  .svc-item {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: 1.5rem;
    align-items: center;
    padding: 1.5rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--color-text);
    transition: padding-left 0.45s var(--ease-out-expo);

    &:last-of-type {
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    &:hover,
    &:focus-visible {
      padding-left: 0.7rem;
    }

    @media (--mq-tablet-sm) {
      grid-template-columns: 2.2rem 1fr;
      gap: 0.9rem;
    }
  }

  .svc-item-n {
    font-family: var(--font-inter);
    font-size: var(--font-size-xs);
    letter-spacing: 0.2em;
    color: var(--color-accent);
  }

  .svc-item-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .svc-item-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.2rem, 2vw, 1.7rem);
    letter-spacing: -0.02em;
    transition: color 0.35s var(--ease-out-expo);
  }

  .svc-item-text {
    color: rgba(var(--rgb-text), 0.6);
    font-size: var(--font-size-sm);
    line-height: 1.55;
    max-width: 58ch;
  }

  .svc-item:hover .svc-item-title,
  .svc-item:focus-visible .svc-item-title {
    color: #fff;
  }

  .svc-item .css-arrow {
    opacity: 0.45;
    transition: opacity 0.35s var(--ease-out-expo), transform 0.4s var(--ease-out-expo);

    @media (--mq-tablet-sm) {
      display: none;
    }
  }

  .svc-item:hover .css-arrow {
    opacity: 1;
    transform: translate(3px, -3px);
  }

  .svc-all {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2.5rem;
    padding: 0.8em 1.4em;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    font-family: var(--font-inter);
    font-size: var(--font-size-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(var(--rgb-text), 0.85);
    transition:
      color 0.35s var(--ease-out-expo),
      border-color 0.35s var(--ease-out-expo),
      background 0.35s var(--ease-out-expo);

    &:hover,
    &:focus-visible {
      color: #fff;
      border-color: rgba(255, 255, 255, 0.28);
      background: rgba(255, 255, 255, 0.05);
    }
  }

  /* ── The objection band ────────────────────────────────────────────────
     Deliberately plainer than the pillars around it: this section is an
     argument, not a showcase, and a rule-separated list reads as candour
     where a grid of glass cards would read as marketing. */
  .obj-title { max-width: 22ch; text-wrap: balance; }

  .obj-rows {
    display: grid;
    gap: 0;
    max-width: 52rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .obj-row {
    display: grid;
    gap: .5rem;
    padding: 1.6rem 0;
    border-top: 1px solid rgba(var(--rgb-text), .13);
  }
  .obj-row:last-child { border-bottom: 1px solid rgba(var(--rgb-text), .13); }

  .obj-row h3 {
    margin: 0;
    font: 500 clamp(1.05rem, 1.5vw, 1.3rem)/1.25 var(--font-display);
    color: rgba(var(--rgb-text), .95);
    text-wrap: balance;
  }
  .obj-row p {
    margin: 0;
    max-width: 62ch;
    color: rgba(var(--rgb-text), .62);
    font-size: clamp(.94rem, 1.2vw, 1.02rem);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .obj-cta {
    display: inline-flex;
    gap: .7rem;
    align-items: center;
    margin-top: 2.2rem;
    padding-bottom: .35rem;
    border-bottom: 1px solid rgba(var(--rgb-text), .28);
    color: rgb(var(--rgb-text));
    font-family: var(--font-inter);
    font-size: var(--font-size-xs);
    letter-spacing: .16em;
    text-transform: uppercase;
    text-decoration: none;
    transition: border-color .3s;
  }
  .obj-cta:hover { border-color: rgb(var(--rgb-text)); }

  @media (max-width: 620px) {
    .obj-row { padding: 1.3rem 0; }
  }

  .pillars {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    --glint-x: 50%;
    --glint-y: 50%;
    display: grid;
    /* Reflow by the space actually available instead of one hard breakpoint:
       a fixed repeat(3, 1fr) squeezed the columns at browser zoom until long
       words like "Development" overflowed and got clipped by overflow:hidden.
       13rem keeps the intended 3-up at desktop (the content column here is
       ~860px, not the full container) and drops to 2-up / 1-up as space runs
       out — at any zoom level, without a breakpoint to get wrong. */
    grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr));
    gap: clamp(0.9rem, 2vw, 1.3rem);
    margin-top: 4rem;
    perspective: 1100px;
  }

  .pillar {
    --panel-accent: 220, 226, 229;
    min-height: clamp(14rem, 24vw, 20rem);
    position: relative;
    isolation: isolate;
    padding: clamp(1.2rem, 2.5vw, 2rem);
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid rgba(210, 228, 235, 0.12);
    background:
      radial-gradient(circle at var(--glint-x) var(--glint-y), rgba(var(--panel-accent), 0.18), transparent 34%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.07), rgba(154, 181, 192, 0.024) 48%, rgba(0, 0, 0, 0.08)),
      rgba(10, 13, 17, 0.7);
    backdrop-filter: blur(20px) saturate(0.95);
    box-shadow:
      0 2rem 5rem rgba(0, 0, 0, 0.24),
      inset 0 1px 0 rgba(255, 255, 255, 0.045),
      inset 0 -1px 0 rgba(0, 0, 0, 0.3);
    transform:
      rotateX(var(--tilt-x))
      rotateY(var(--tilt-y))
      translate3d(0, var(--lift, 0), 0);
    transform-style: preserve-3d;
    transition:
      box-shadow 0.5s var(--ease-out-expo),
      border-color 0.5s var(--ease-out-expo),
      background 0.5s var(--ease-out-expo),
      transform 0.25s var(--ease-out-expo);
  }

  .pillar:nth-child(2) { --panel-accent: 194, 201, 205; }
  .pillar:nth-child(3) { --panel-accent: 234, 237, 238; }

  .pillar::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.025), transparent 42%);
    opacity: 0.8;
  }

  .pillar::after {
    content: "";
    position: absolute;
    inset: -1px;
    pointer-events: none;
    border-radius: inherit;
    background:
      linear-gradient(115deg, transparent 0 38%, rgba(255, 255, 255, 0.15), transparent 58%),
      radial-gradient(circle at var(--glint-x) var(--glint-y), rgba(255, 255, 255, 0.09), transparent 22%);
    opacity: 0;
    mix-blend-mode: screen;
    transition: opacity 0.4s var(--ease-out-expo);
  }

  .pillar:hover {
    --lift: -10px;
    border-color: rgba(var(--panel-accent), 0.38);
    box-shadow:
      0 2.8rem 7rem rgba(0, 0, 0, 0.38),
      0 0 3.8rem rgba(var(--panel-accent), 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.07);
  }

  .pillar:hover::after {
    opacity: 0.74;
  }

  .pillar > *:not(.pillar-glint) {
    position: relative;
    z-index: 1;
    transform: translateZ(34px);
  }

  .pillar-glint {
    position: absolute;
    inset: -40%;
    z-index: 0;
    pointer-events: none;
    background: conic-gradient(from 120deg at var(--glint-x) var(--glint-y), transparent, rgba(255, 255, 255, 0.055), transparent 32%);
    opacity: 0;
    transition: opacity 0.45s var(--ease-out-expo);
  }

  .pillar:hover .pillar-glint {
    opacity: 1;
  }

  .pillar-index,
  .work-meta,
  .job-idx,
  .edu-period,
  .facts span {
    color: rgb(var(--panel-accent, 214, 220, 223));
    text-shadow: 0 0 1.2rem rgba(var(--panel-accent, 214, 220, 223), 0.22);
    font-size: var(--font-size-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .pillar h3,
  .job h3,
  .edu-row h3,
  .work-card h3 {
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.4rem, 2.4vw, 2.1rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    /* a single long word must never be clipped by the card */
    overflow-wrap: anywhere;
    hyphens: auto;
    /* survive 90% browser zoom / odd widths without clipping long titles */
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  .work-card h3 {
    overflow-wrap: normal;
    hyphens: none;
  }

  .pillar p,
  .job-text,
  .edu-row p,
  .facts p,
  .work-card p,
  .portal-text {
    color: rgba(var(--rgb-text), 0.8);
    line-height: 1.58;
  }

  .pillar p {
    margin-top: 1.15rem;
    transform: translateZ(24px);
  }

  .jobs,
  .edu-list {
    margin-top: clamp(3rem, 6vw, 5rem);
    display: grid;
    gap: 0.85rem;
    border-top: 0;
  }

  .edu-list {
    gap: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.012);
    backdrop-filter: blur(12px);
  }

  .career .section-grid {
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  .career .section-grid > div {
    min-width: 0;
  }

  .career .s-title {
    max-width: 11ch;
  }

  .jobs {
    position: relative;
    padding-left: 2.1rem;
  }

  .jobs::before {
    content: "";
    position: absolute;
    top: 1.25rem;
    bottom: 1.25rem;
    left: 0.5rem;
    width: 1px;
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.2) 12%, rgba(255, 255, 255, 0.08) 86%, transparent);
  }

  .job {
    --career-accent: 220, 226, 229;
    --job-x: 50%;
    --job-y: 50%;
    display: grid;
    grid-template-columns: 3.4rem minmax(13rem, 0.82fr) 10rem minmax(0, 1.25fr);
    gap: 1.6rem;
    align-items: start;
    position: relative;
    padding: 1.7rem;
    overflow: hidden;
    border: 1px solid rgba(215, 231, 237, 0.13);
    border-radius: 8px;
    background:
      radial-gradient(circle at var(--job-x) var(--job-y), rgba(var(--career-accent), 0.21), transparent 25rem),
      linear-gradient(135deg, rgba(255, 255, 255, 0.075), rgba(148, 173, 184, 0.025) 58%, rgba(255, 255, 255, 0.018)),
      rgba(12, 15, 20, 0.72);
    backdrop-filter: blur(20px) saturate(0.95);
    box-shadow:
      0 1.4rem 4rem rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.07);
    transform-origin: left center;
    transition:
      transform 0.55s var(--ease-out-expo),
      border-color 0.45s ease,
      background 0.45s ease,
      box-shadow 0.55s var(--ease-out-expo);

    &::before {
      content: "";
      position: absolute;
      top: 50%;
      left: -2.05rem;
      width: 0.65rem;
      height: 0.65rem;
      border: 1px solid rgba(225, 239, 244, 0.55);
      border-radius: 50%;
      background: #030304;
      transform: translate(-50%, -50%);
      box-shadow: 0 0 0 0.35rem rgba(214, 232, 239, 0.06), 0 0 1rem rgba(200, 224, 233, 0.12);
      transition: background 0.35s ease, box-shadow 0.35s ease, transform 0.45s var(--ease-out-expo);
    }

    &::after {
      content: "";
      position: absolute;
      right: 1.1rem;
      top: 1rem;
      width: .62rem;
      height: .62rem;
      border-top: 1px solid rgba(var(--rgb-text), 0.22);
      border-right: 1px solid rgba(var(--rgb-text), 0.22);
      transition: color 0.35s ease, transform 0.45s var(--ease-out-expo);
    }

    @media (--mq-tablet) {
      grid-template-columns: 3rem minmax(12rem, 1fr) 8rem;
      gap: 1rem;
    }
  }

  .job:nth-child(2) { --career-accent: 184, 191, 195; }
  .job:nth-child(3) { --career-accent: 236, 239, 240; }

  @media (max-width: 1024px) {
    .job-text {
      grid-column: 2 / -1;
    }
  }

  .job:hover,
  .job:focus-visible {
    z-index: 2;
    outline: none;
    border-color: rgba(var(--career-accent), 0.42);
    transform: translateX(0.8rem) perspective(900px) rotateY(-1.25deg);
    box-shadow:
      -1.1rem 2.2rem 5rem rgba(0, 0, 0, 0.42),
      0 0 4rem rgba(var(--career-accent), 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .job:hover::before,
  .job:focus-visible::before {
    background: rgb(var(--career-accent));
    box-shadow: 0 0 1.8rem rgba(var(--career-accent), 0.62);
    transform: translate(-50%, -50%) scale(1.15);
  }

  .job:hover::after,
  .job:focus-visible::after {
    color: rgba(var(--rgb-text), 0.8);
    transform: translate(0.2rem, -0.2rem);
  }

  .job h3 {
    margin-top: 0;
    font-size: 1.7rem;
  }

  .job-role {
    margin: 0.35rem 0 0;
    color: rgba(var(--rgb-text), 0.65);
  }

  .job-period {
    color: rgba(var(--rgb-text), 0.66);
  }

  .job-text {
    margin: 0;
    color: rgba(var(--rgb-text), 0.74);
    transition: color 0.4s ease, transform 0.55s var(--ease-out-expo);
  }

  /* Proof link: the actual published work behind the career card. */
  .job-link {
    grid-column: 2 / -1;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    width: fit-content;
    margin-top: 0.35rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.26);
    color: rgba(var(--rgb-text), 0.82);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    transition: color 0.35s ease, border-color 0.35s ease, gap 0.45s var(--ease-out-expo);
  }

  .job-link:hover,
  .job-link:focus-visible {
    color: #fff;
    border-color: #fff;
    gap: 0.95rem;
  }

  .job:hover .job-text,
  .job:focus-visible .job-text {
    color: rgba(var(--rgb-text), 0.92);
    transform: translateX(0.25rem);
  }

  @media (max-width: 760px) {
    .jobs { padding-left: 1.35rem; }
    .jobs::before { left: 0.25rem; }
    .job::before { left: -1.15rem; }
    .job:hover,
    .job:focus-visible { transform: translateX(0.25rem); }
    .job { grid-template-columns: 1fr; }
    .job-text { grid-column: auto; }
    .job-link { grid-column: auto; font-size: .78rem; }
  }

  .edu-row {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 2rem;
    padding: clamp(1.1rem, 2.2vw, 1.55rem);
    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.025), transparent 55%);
    backdrop-filter: none;
    transition: background 0.4s ease, padding-left 0.5s var(--ease-out-expo);

    @media (--mq-tablet-sm) {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
  }

  .edu-row:hover {
    padding-left: calc(clamp(1.1rem, 2.2vw, 1.55rem) + 0.45rem);
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.075), transparent 64%);
  }

  .edu-row h3 {
    margin-top: 0;
  }

  .edu-row p {
    margin: 0.4rem 0 0;
  }

  .facts {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 0.85rem;
    margin-top: 2.5rem;
    padding: 1px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    background: linear-gradient(115deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.012));
    backdrop-filter: blur(22px);

    @media (--mq-tablet) {
      grid-template-columns: 1fr;
    }
  }

  .facts article {
    padding: 1.25rem;
    border: 0;
    border-radius: 7px;
    background: rgba(3, 4, 5, 0.72);
    backdrop-filter: none;
  }

  .facts p {
    margin: 0.8rem 0 0;
  }

  .work {
    min-height: 100svh;
    padding: clamp(6rem, 9vw, 8rem) 0;
    overflow: hidden;
  }

  .work::after {
    content: "";
    position: absolute;
    z-index: 0;
    left: -10%;
    right: -10%;
    bottom: -5rem;
    height: 15rem;
    pointer-events: none;
    opacity: 0.24;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.62) 0 1px, transparent 1.3px);
    background-size: 0.85rem 0.85rem;
    mask-image: linear-gradient(180deg, transparent, #000 32%, transparent 96%);
    transform: perspective(480px) rotateX(64deg);
    transform-origin: bottom;
  }

  /* ── Record band ───────────────────────────────────────────────────────── */
  .record-text {
    max-width: 56ch;
    margin: 1.6rem 0 0;
    color: rgba(var(--rgb-text), 0.7);
    line-height: 1.65;
    text-wrap: pretty;
  }
  .record-link {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 2.2rem;
    padding: 1rem 1.6rem;
    border: 1px solid rgba(var(--rgb-text), 0.22);
    border-radius: 999px;
    color: rgb(var(--rgb-text));
    font-family: var(--font-inter);
    font-size: var(--font-size-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: border-color 0.3s, background-color 0.3s;
  }
  .record-link:hover {
    border-color: rgba(var(--rgb-text), 0.5);
    background: rgba(var(--rgb-text), 0.06);
  }

  .work-composition {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(18rem, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(2.5rem, 5vw, 6rem);
    align-items: center;
    min-height: 44rem;

    @media (--mq-tablet) {
      grid-template-columns: 1fr;
      min-height: auto;
    }
  }

  .work-intro {
    position: relative;
    z-index: 4;
    align-self: center;
  }

  .work-intro .s-title {
    max-width: 10ch;
    font-size: 4.15rem;
    line-height: 1.02;
  }

  .work-intro .s-lead {
    max-width: 34rem;
    font-size: 1.05rem;
  }

  .work-archive-link {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 2rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.28);
    color: rgba(var(--rgb-text), 0.82);
    font-size: 0.82rem;
    transition: color 0.35s ease, border-color 0.35s ease, gap 0.45s var(--ease-out-expo);
  }

  .work-archive-link:hover {
    color: #fff;
    border-color: #fff;
    gap: 1.15rem;
  }

  .work-signals {
    display: flex;
    flex-wrap: wrap;
    gap: 1.35rem;
    margin-top: 2rem;
    color: rgba(var(--rgb-text), 0.38);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .work-signals span::before {
    content: "";
    display: inline-block;
    width: 0.25rem;
    height: 0.25rem;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.65);
    box-shadow: 0 0 0.7rem rgba(255, 255, 255, 0.35);
  }

  .work-stage {
    position: relative;
    /* Tall enough for three cards in a cascade rather than two side by side. */
    min-height: 58rem;
    perspective: 1500px;

    @media (--mq-tablet) {
      min-height: 52rem;
    }
  }

  .work-grid {
    position: absolute;
    inset: 0;

    @media (--mq-phone) {
      position: relative;
      display: grid;
      gap: 1rem;
    }
  }

  .work-orbits {
    position: absolute;
    inset: 4% -8%;
    z-index: 0;
    pointer-events: none;

    @media (--mq-phone) { display: none; }
  }

  .orbit {
    position: absolute;
    inset: 18% 0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    transform: rotate(-9deg);
    box-shadow: 0 0 1.4rem rgba(255, 255, 255, 0.025);
  }

  .orbit-two {
    inset: 8% 9% 28%;
    border-color: rgba(255, 255, 255, 0.055);
    transform: rotate(23deg);
  }

  .orbit-node {
    position: absolute;
    width: 0.36rem;
    height: 0.36rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 1rem rgba(255, 255, 255, 0.82);
  }

  .node-one { left: 9%; top: 32%; }
  .node-two { right: 5%; top: 48%; }

  .orbit-label {
    position: absolute;
    color: rgba(var(--rgb-text), 0.38);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.52rem;
    letter-spacing: 0.12em;
    line-height: 1.65;
  }

  .label-one { left: 1%; top: 22%; }
  .label-two { left: 56%; top: 3%; }
  .label-three { right: -1%; top: 39%; }

  .work-card {
    --work-accent: 220, 226, 229;
    position: absolute;
    z-index: 2;
    width: min(51%, 23.5rem);
    min-height: 31rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.012));
    backdrop-filter: blur(24px) saturate(0.82);
    overflow: hidden;
    box-shadow:
      0 3rem 7rem rgba(0, 0, 0, 0.58),
      inset 0 1px 0 rgba(255, 255, 255, 0.13),
      inset 1px 0 0 rgba(255, 255, 255, 0.055);
    transform-style: preserve-3d;
    transition:
      border-color 0.45s ease,
      box-shadow 0.55s var(--ease-out-expo),
      transform 0.65s var(--ease-out-expo);

    /* The phone reset. `transform` used to carry !important here to beat the
       desktop collage, which then made every transform on a phone card
       impossible — including the deck's own shuffle, which computed to `none`
       no matter what it was set to. The block near the bottom of this file
       does the same job by specificity and source order, so the flag is gone
       and phone layouts can move these cards again. */
    @media (--mq-phone) {
      position: relative;
      inset: auto !important;
      width: 100%;
      min-height: 0;
      transform: none;
    }
  }

  /* The stage was composed for exactly two cards: two absolute positions and
     nothing for a third, so the Academy card landed at the stage origin and
     covered Bridge Consult — the one case a visitor most needs to see. Three
     positions now, with the depth order stated explicitly rather than left to
     document order: Bridge in front, FIDIC behind it, the small one furthest
     back. A fourth case will need its own rule here; that is deliberate, the
     composition is hand-placed, not a grid. */
  .work-card:nth-child(1) {
    left: 0;
    top: 6%;
    z-index: 4;
    transform: perspective(1200px) rotateY(9deg) rotateZ(-2.4deg) translateZ(2rem);
  }

  .work-card:nth-child(2) {
    --work-accent: 184, 191, 195;
    right: 0;
    top: 17%;
    z-index: 3;
    transform: perspective(1200px) rotateY(-8deg) rotateZ(2.6deg);
  }

  /* Smaller and set back, which is also what it is: the one-page job next to
     two multilingual platforms. */
  .work-card:nth-child(3) {
    --work-accent: 196, 203, 208;
    left: 17%;
    top: 48%;
    z-index: 2;
    width: min(46%, 21rem);
    /* Fixed, not a minimum: its blurb is the longest of the three and an
       auto-growing card would run straight out of the bottom of the stage. */
    height: 25rem;
    min-height: 0;
    transform: perspective(1200px) rotateY(5deg) rotateZ(-1.4deg) translateZ(-1rem);
  }
  .work-card:nth-child(3) a,
  .work-card:nth-child(3) .work-copy { height: 100%; min-height: 0; }
  .work-card:nth-child(3) .work-copy > p:not(.work-role) {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .work-card::before {
    content: "";
    position: absolute;
    inset: -1px;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(115deg, transparent 0 28%, rgba(255, 255, 255, 0.2) 44%, transparent 58%);
    transform: translateX(-70%);
    opacity: 0;
    mix-blend-mode: screen;
    transition: opacity 0.45s var(--ease-out-expo), transform 0.8s var(--ease-out-expo);
  }

  .work-card:nth-child(1):hover {
    border-color: rgba(var(--work-accent), 0.42);
    transform: perspective(1200px) rotateY(4deg) rotateZ(-1deg) translate3d(0, -12px, 3.2rem);
    box-shadow:
      0 3.8rem 8rem rgba(0, 0, 0, 0.68),
      0 0 4rem rgba(255, 255, 255, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.16);
  }

  .work-card:nth-child(2):hover {
    border-color: rgba(var(--work-accent), 0.42);
    transform: perspective(1200px) rotateY(-3deg) rotateZ(1deg) translate3d(0, -12px, 2rem);
    box-shadow:
      0 3.8rem 8rem rgba(0, 0, 0, 0.68),
      0 0 4rem rgba(255, 255, 255, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.16);
  }

  /* Hovering the card that sits behind has to bring it forward, or the pointer
     is on a card the visitor cannot fully see. */
  .work-card:nth-child(3):hover {
    z-index: 5;
    border-color: rgba(var(--work-accent), 0.42);
    transform: perspective(1200px) rotateY(2deg) rotateZ(-0.6deg) translate3d(0, -12px, 2.6rem);
    box-shadow:
      0 3.8rem 8rem rgba(0, 0, 0, 0.68),
      0 0 4rem rgba(255, 255, 255, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.16);
  }

  .work-card:hover::before {
    opacity: 0.7;
    transform: translateX(70%);
  }

  .work-card a {
    position: relative;
    z-index: 2;
    display: block;
    min-height: inherit;
    color: var(--color-text);
  }

  .work-card figure {
    position: absolute;
    inset: 0;
    margin: 0;
    overflow: hidden;
    background: var(--color-bg);
  }

  .work-card figure::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(2, 3, 4, 0.76) 0%, rgba(2, 3, 4, 0.26) 43%, rgba(2, 3, 4, 0.9) 100%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.4), transparent 65%);
    opacity: 1;
    transition: opacity 0.45s var(--ease-out-expo);
  }

  .work-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
    transition: transform 0.65s var(--ease-out-expo);
  }

  .work-card:hover img {
    transform: scale(1.02);
  }

  .work-card:hover figure::after {
    opacity: 0.86;
  }

  .work-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-height: inherit;
    padding: 1.6rem;
  }

  .work-meta {
