  }

  .work-card:nth-child(1) {
    left: 2%;
    top: 8%;
    transform: perspective(1200px) rotateY(8deg) rotateZ(-2deg) translateZ(2rem);
  }

  .work-card:nth-child(2) {
    right: 1%;
    top: 20%;
    transform: perspective(1200px) rotateY(-7deg) rotateZ(2.2deg);
  }

  .work-card:nth-child(3) {
    left: 16%;
    top: 52%;
    width: min(36%, 17.5rem);
    height: 21rem;
    transform: perspective(1200px) rotateY(4deg) rotateZ(-1.2deg);
  }

  .work-copy { padding: 1.35rem; }
  .work-card h3 { font-size: clamp(1.45rem, 2vw, 2rem); }
  .work-card p { font-size: 0.86rem; line-height: 1.48; }
  .work-card a,
  .work-copy { height: 100%; min-height: 0; }
  .work-copy > p:not(.work-role) {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
  }
  .work-role { margin-bottom: 0.7rem; }

  @keyframes work-core-float {
    0%, 100% { transform: translate(-50%, -50%) rotate(-1deg) scale(1); }
    50% { transform: translate(-50%, calc(-50% - 0.7rem)) rotate(1.5deg) scale(1.015); }
  }

  @keyframes work-core-turn { to { transform: rotate(360deg); } }

  @media (max-width: 1100px) {
    .work-composition { grid-template-columns: 1fr; }
    .work-stage { min-height: 40rem; }
    .work-core { width: min(54vw, 29rem); }
  }

  @media (max-width: 560px) {
    .work-intro .s-title { font-size: 3rem; }
    .work-stage { padding-top: 0; }
    .work-core { width: 18rem; top: 45%; opacity: 0.88; }
    .work-terrain { display: block; left: -42%; right: -42%; bottom: -2%; opacity: .28; }
    .work-orbits { display: block; inset: 4% -42% 8%; }
    .work-copy { padding: 1.05rem; }
    .work-card h3 { font-size: 1.42rem; }
    .work-card p { font-size: .76rem; line-height: 1.42; }
    .work-role { margin-block: .35rem .55rem; }
    .work-cta { padding-top: .8rem; }
  }

  /* ── Selected work, tablet cascade ────────────────────────────────────────
     Between the phone stack and the desktop composition the collage still had
     the third card on top of the first: Academy at 52% of a stage 640px tall,
     with its own heading behind the Bridge Consult card and the whole cascade
     spilling 33px out of the stage. The offsets are hand-placed per screen, so
     this range gets its own: a taller stage, and three positions that read as
     a cascade instead of a pile. Bridge starts at the top, FIDIC drops behind
     it on the right, Academy sits below both and clear of them.
     ------------------------------------------------------------------- */
  @media (max-width: 1100px) and (min-width: 768px) {
    /* Tall enough that 52% + the card's own 21rem still lands inside it. */
    .work-stage { min-height: 46rem; }
    .work-card:nth-child(1) { left: 0; top: 0; }
    .work-card:nth-child(2) { right: 0; top: 15%; }
    .work-card:nth-child(3) { left: 8%; top: 52%; }
  }

  /* ── Selected work, one column ────────────────────────────────────────────
     The stage is a hand-placed collage: three cards at absolute offsets on a
     perspective plane. That composition was written for two cards and adding
     the third broke it below tablet — Academy landed at 52% of a stage sized
     for two, half under FIDIC, at the 36% width its desktop rule gives it
     (`.work-card:nth-child(3)` outranks a plain `.work-card`, so the narrow
     rules never reached it).

     Absolute placement does not survive adding a case, so narrow screens get
     the honest answer instead: one column, in flow, each card its own width,
     image on top and text beneath. Every offset the wider layouts set is
     named and cleared here, because they are not all set on `.work-card`.
     ------------------------------------------------------------------- */
  @media (max-width: 767px) {
    .work-stage { min-height: 0; }

    .work-grid {
      position: relative;
      inset: auto;
      display: grid;
      gap: 1.15rem;
      padding: 1rem 0 0.5rem;
    }

    .work-card,
    .work-card:nth-child(1),
    .work-card:nth-child(2),
    .work-card:nth-child(3) {
      position: relative;
      left: auto;
      right: auto;
      top: auto;
      bottom: auto;
      width: 100%;
      height: auto;
      min-height: 0;
      transform: none;
      /* The scroll parallax writes --mobile-card-x/y into this; in a stack it
         would only close the gap between neighbours. */
      translate: none;
    }

    /* The nth-child(3) rules are repeated here on purpose: the desktop card
       is a fixed height, so it sets `height: 100%` and a line clamp through a
       selector one pseudo-class more specific than a plain `.work-card`. Left
       alone, the Academy card kept both and swallowed its own "Open project"
       link. */
    .work-card a,
    .work-card:nth-child(3) a,
    .work-card .work-copy,
    .work-card:nth-child(3) .work-copy {
      height: auto;
      min-height: 0;
    }

    /* A band at the top of the card rather than a full-bleed backdrop under
       the text, so it needs a height of its own. */
    .work-card figure { position: relative; inset: auto; aspect-ratio: 1.62; }

    /* The blurb is clamped on the desktop cards because those are a fixed
       height. These are not, so the whole sentence can stay. */
    .work-card .work-copy > p:not(.work-role),
    .work-card:nth-child(3) .work-copy > p:not(.work-role) {
      -webkit-line-clamp: none;
    }

    /* One line, so the year stays level with the index rather than stranded
       above a wrapped tag. */
    .work-meta { font-size: 0.56rem; letter-spacing: 0.1em; }
 
    /* ── The deck ──────────────────────────────────────────────────────────
       Three cards stacked in a column is honest and dull: it reads as a list
       of things rather than a hand of work. `.is-deck` is added by the script,
       so this only applies where the shuffle can actually run — without it the
       column above stays and all three projects stay readable.

       Every card sits in the SAME grid cell, so the deck is exactly as tall as
       its tallest card with nothing measured in JavaScript, and the shuffle is
       a transform inside that cell: the card never travels anywhere, it turns
       back into the stack and the next one takes its place. */
    .work-grid.is-deck {
      gap: 0;
      /* Room under the front card for the two rims behind it. */
      padding: 1.4rem 0 3.2rem;
      /* Horizontal drags belong to the deck; vertical ones stay the page's. */
      touch-action: pan-y;
      perspective: 900px;
    }

    .work-grid.is-deck .work-card,
    .work-grid.is-deck .work-card:nth-child(1),
    .work-grid.is-deck .work-card:nth-child(2),
    .work-grid.is-deck .work-card:nth-child(3) {
      grid-area: 1 / 1;
      /* --depth 0 is the card in hand, 1 and 2 are behind it. --drag is how far
         the finger has taken the front card, and is only set while it is down. */
      --depth: 0;
      --drag: 0px;
      --tilt: 0deg;
      /* Set from the script: +1 for the card one back, -1 for the one behind
         that, so the stack fans instead of hiding in its own silhouette. */
      --sway: 0;
      transform:
        translate3d(calc(var(--drag) * 0.34), calc(var(--depth) * 1.55rem), 0)
        rotate(calc(var(--tilt) + var(--sway) * 2.2deg))
        scale(calc(1 - var(--depth) * 0.05));
      /* Centre, not below the card: with the origin under it, scaling pulled
         the cards behind UP and the whole stack hid inside one silhouette. */
      transform-origin: 50% 50%;
      opacity: calc(1 - var(--depth) * 0.34);
      /* The cards share one cell, so the front one needs a floor of its own or
         the text of the two behind it reads straight through the glass. */
      background:
        linear-gradient(145deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.012)),
        #06080a;
      z-index: calc(10 - var(--depth));
      transition:
        transform 0.62s var(--ease-out-expo),
        opacity 0.5s ease,
        border-color 0.5s ease,
        box-shadow 0.6s var(--ease-out-expo);
    }
    /* While a finger is on it, the card follows the finger without easing. */
    .work-grid.is-deck.is-dragging .work-card { transition: opacity 0.2s ease; }

    /* "Neon" in a monochrome palette is the palette's own accent pushed until
       it glows: a lit rim, a bloom under it, and the sheen these cards already
       carry, run once as the card lands. */
    .work-grid.is-deck .work-card[data-deck-front] {
      border-color: rgba(var(--work-accent), 0.7);
      box-shadow:
        0 0 0 1px rgba(var(--work-accent), 0.22),
        0 0 1.1rem rgba(var(--work-accent), 0.3),
        0 0 3.4rem rgba(var(--work-accent), 0.2),
        0 0 7rem rgba(var(--work-accent), 0.1),
        0 2rem 4rem rgba(0, 0, 0, 0.7),
        inset 0 1px 0 rgba(255, 255, 255, 0.2);
      /* The tube itself: a hairline of light along the top edge of the card,
         which is what makes the rim read as lit rather than merely pale. */
      animation: deck-pulse 4.5s ease-in-out infinite;
    }
    @keyframes deck-pulse {
      0%, 100% { filter: brightness(1); }
      50% { filter: brightness(1.055); }
    }
    .work-grid.is-deck .work-card[data-deck-front]::before {
      opacity: 0.55;
      transform: translateX(140%);
      transition: transform 0.9s var(--ease-out-expo), opacity 0.9s ease;
    }
    .work-grid.is-deck .work-card:not([data-deck-front])::before {
      opacity: 0;
      transform: translateX(-70%);
    }

    /* Behind the front card the content is texture, not something to read
       through: dim it so the top card's type is the only type. */
    .work-grid.is-deck .work-card:not([data-deck-front]) .work-copy { opacity: 0.45; }
    .work-grid.is-deck .work-card:not([data-deck-front]) figure { opacity: 0.55; }

    /* ── Controls ────────────────────────────────────────────────────────── */
    .deck-ui {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.1rem;
      margin-top: 1.5rem;
    }

    .deck-arrow {
      display: grid;
      place-items: center;
      width: 2.4rem;
      height: 2.4rem;
      padding: 0;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 50%;
      background: rgba(9, 11, 13, 0.7);
      cursor: pointer;
      transition: border-color 0.3s ease, background-color 0.3s ease;
    }
    .deck-arrow:active { border-color: rgba(255, 255, 255, 0.45); background: rgba(18, 21, 24, 0.9); }
    .deck-arrow i {
      width: 0.42rem;
      height: 0.42rem;
      border-top: 1px solid rgba(var(--rgb-text), 0.7);
      border-right: 1px solid rgba(var(--rgb-text), 0.7);
      transform: rotate(45deg);
      margin-left: -0.15rem;
    }
    .deck-arrow[data-deck-step="-1"] i { transform: rotate(-135deg); margin: 0 -0.15rem 0 0; }

    .deck-dots { display: flex; align-items: center; gap: 0.55rem; }
    .deck-dot {
      width: 1.5rem;
      height: 1.5rem;
      padding: 0;
      display: grid;
      place-items: center;
      border: 0;
      background: none;
      cursor: pointer;
    }
    .deck-dot span {
      width: 0.4rem;
      height: 0.4rem;
      border-radius: 50%;
      background: rgba(var(--rgb-text), 0.26);
      transition: background-color 0.35s ease, box-shadow 0.35s ease, transform 0.35s var(--ease-out-expo);
    }
    .deck-dot[aria-selected="true"] span {
      background: #fff;
      transform: scale(1.35);
      box-shadow: 0 0 0.7rem rgba(255, 255, 255, 0.6);
    }
  }

  /* The controls belong to the deck, and the deck only exists on a phone. This
     has to be a min-width rule rather than a bare one: a later top-level
     declaration would beat the `display: flex` inside the block above. */
  @media (min-width: 768px) { .deck-ui { display: none; } }
  .deck-ui[hidden] { display: none !important; }

  @media (prefers-reduced-motion: reduce) {
    .work-grid.is-deck .work-card { transition: opacity 0.2s ease; }
    .work-grid.is-deck .work-card[data-deck-front]::before { display: none; }
  }

  @media (max-width: 760px) {
    .signal-marquee {
      padding: .72rem 0;
      backdrop-filter: none;
      box-shadow: 0 0 2rem rgba(255,255,255,.025);
    }

    .signal-marquee :global(.text) {
      --fs: 1.28rem;
      font-weight: 500;
      -webkit-text-stroke-width: 1px;
    }

    .section { padding: 5.4rem 0; }
    .section::before { height: 22rem; opacity: .58; }
    .section-grid,
    .contact-grid { gap: .7rem; }
    .s-idx { margin-bottom: 1.15rem; font-size: .6rem; }
    .s-title,
    .contact-title {
      max-width: 100%;
      font-size: clamp(2.55rem, 12vw, 3.45rem);
      line-height: .98;
    }
    .s-lead { margin-top: 1.25rem; font-size: .98rem; line-height: 1.55; }

    .pillars { gap: .8rem; margin-top: 2.5rem; }
    .pillar { min-height: 15rem; padding: 1.25rem; backdrop-filter: none; }
    .pillar:nth-child(2) { margin-left: .85rem; }
    .pillar:nth-child(3) { margin-right: .85rem; }
    .pillar p { margin-top: .85rem; font-size: .9rem; line-height: 1.5; }

    .jobs { gap: .7rem; margin-top: 2.4rem; padding-left: 1.1rem; }
    .jobs::before { left: .12rem; }
    .job {
      gap: .55rem;
      padding: 1.15rem;
      border-radius: 6px;
      backdrop-filter: none;
    }
    .job::before { left: -.98rem; }
    .job h3 { padding-right: 1.1rem; font-size: 1.4rem; }
    .job-text { font-size: .88rem; line-height: 1.5; }

    .edu-list { margin-top: 2.4rem; backdrop-filter: none; }
    .edu-row { padding: 1rem .15rem; }
    .edu-row:hover { padding-left: .15rem; }
    .facts { margin-top: 2rem; backdrop-filter: none; }
    .facts article { padding: 1rem; }
    .work-signals { gap: .7rem 1rem; margin-top: 1.4rem; }
    .portal { backdrop-filter: none; }
  }

  @media (pointer: coarse) {
    .facts,
    .portal,
    .archive-button,
    .work-card { backdrop-filter: none; }
    .job:hover,
    .job:focus-visible,
    .edu-row:hover,
    .work-card:nth-child(1):hover,
    .work-card:nth-child(2):hover,
    .archive-button:hover { transform: none; }
    .work-card::before { display: none; }
    .work-core,
    .work-core-shine { animation-duration: 24s; }
  }

  [data-reveal] {
    opacity: 1;
    transform: none;
    will-change: transform, opacity;
  }

  /* 26px, the same distance every other page starts a block reveal from — this
     was 36 and read as a different animation to the one beside it. */
  :global(html.is-motion-ready) [data-reveal]:not(.is-revealed) {
    opacity: 0;
    transform: translateY(26px);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  import { REVEAL } from "../utils/reveals";

  gsap.registerPlugin(ScrollTrigger);

  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const finePointer = matchMedia("(hover: hover) and (pointer: fine)").matches;
  const calm = () => document.documentElement.classList.contains("rb-calm");
  let motionStarted = false;

  const initReveals = async () => {
    if (motionStarted) return;
    motionStarted = true;
    const items = gsap.utils.toArray<HTMLElement>("[data-reveal]");

    if (reduced) {
      gsap.set(items, { opacity: 1, y: 0 });
      items.forEach((item) => item.classList.add("is-revealed"));
      return;
    }

    await document.fonts?.ready;
    document.documentElement.classList.add("is-motion-ready");

    requestAnimationFrame(() => {
      ScrollTrigger.batch(items, {
        // 88%, like every other reveal on the site — this was firing at 82%,
        // six per cent of a screen out of step with the split text beside it.
        start: "top 88%",
        once: true,
        onEnter: (batch) =>
          gsap.to(batch, {
            opacity: 1,
            y: 0,
            duration: REVEAL.block.duration,
            ease: REVEAL.ease,
            stagger: 0.06,
            overwrite: true,
            onComplete: () => batch.forEach((item) => (item as HTMLElement).classList.add("is-revealed")),
          }),
        onEnterBack: (batch) => {
          gsap.set(batch, { opacity: 1, y: 0 });
          batch.forEach((item) => item.classList.add("is-revealed"));
        },
      });
      ScrollTrigger.refresh();
    });
  };

  if (document.body.classList.contains("is-loaded") || !document.querySelector("rb-studio-loader")) {
    void initReveals();
  } else {
    addEventListener("rb:loaded", () => void initReveals(), { once: true });
  }

  addEventListener("rb:langchange", () => requestAnimationFrame(() => ScrollTrigger.refresh()));

  const tiltCards = gsap.utils.toArray<HTMLElement>("[data-tilt-card]");
  if (finePointer) tiltCards.forEach((card) => {
    const reset = () => {
      gsap.to(card, {
        rotationX: 0,
        rotationY: 0,
        z: 0,
        "--tilt-x": "0deg",
        "--tilt-y": "0deg",
        "--glint-x": "50%",
        "--glint-y": "50%",
        duration: 0.7,
        ease: "power3.out",
      });
    };

    card.addEventListener("pointermove", (event) => {
      if (reduced || calm()) return;
      const rect = card.getBoundingClientRect();
      const px = (event.clientX - rect.left) / rect.width;
      const py = (event.clientY - rect.top) / rect.height;
      const rx = (0.5 - py) * 5;
      const ry = (px - 0.5) * 7;
      gsap.to(card, {
        rotationX: rx,
        rotationY: ry,
        z: 10,
        "--tilt-x": `${rx}deg`,
        "--tilt-y": `${ry}deg`,
        "--glint-x": `${px * 100}%`,
        "--glint-y": `${py * 100}%`,
        duration: 0.35,
        ease: "power3.out",
      });
    });

    card.addEventListener("pointerleave", reset);
    card.addEventListener("blur", reset);
  });

  const jobCards = gsap.utils.toArray<HTMLElement>("[data-job-card]");
  if (finePointer) jobCards.forEach((card) => {
    card.addEventListener("pointermove", (event) => {
      if (reduced || calm()) return;
      const rect = card.getBoundingClientRect();
      const x = ((event.clientX - rect.left) / rect.width) * 100;
      const y = ((event.clientY - rect.top) / rect.height) * 100;
      card.style.setProperty("--job-x", `${x}%`);
      card.style.setProperty("--job-y", `${y}%`);
    });

    card.addEventListener("pointerleave", () => {
      card.style.setProperty("--job-x", "50%");
      card.style.setProperty("--job-y", "50%");
    });
  });

  const workStage = document.querySelector<HTMLElement>(".work-stage");
  const caseCards = gsap.utils.toArray<HTMLElement>(".work-card");
  const workOrbits = document.querySelector<HTMLElement>(".work-orbits");
  const workCore = document.querySelector<HTMLElement>(".work-core");

  if (finePointer) workStage?.addEventListener("pointermove", (event) => {
    if (reduced || calm() || innerWidth < 760) return;
    const rect = workStage.getBoundingClientRect();
    const nx = (event.clientX - rect.left) / rect.width - 0.5;
    const ny = (event.clientY - rect.top) / rect.height - 0.5;
    // Written for two cards; with three, a shared direction makes the back one
    // track its neighbour instead of holding its own plane. Depth order drives
    // both the direction and how far each drifts.
    caseCards.forEach((card, index) => {
      const direction = index === 1 ? -1 : 1;
      const depth = index === 0 ? 1 : index === 1 ? 0.85 : 0.55;
      gsap.to(card, {
        x: nx * 18 * direction * depth,
        y: ny * 12 * depth,
        duration: 0.65,
        ease: "power3.out",
        overwrite: "auto",
      });
    });
    if (workOrbits) gsap.to(workOrbits, { x: nx * -12, y: ny * -8, duration: 0.9, ease: "power3.out" });
  });

  if (finePointer) workStage?.addEventListener("pointerleave", () => {
    gsap.to(caseCards, { x: 0, y: 0, duration: 0.9, ease: "power3.out", overwrite: "auto" });
    if (workOrbits) gsap.to(workOrbits, { x: 0, y: 0, duration: 1.1, ease: "power3.out" });
  });

  if (workStage && innerWidth <= 760 && !reduced) {
    let workVisible = false;
    let workFrame = 0;

    const renderMobileWork = () => {
      workFrame = 0;
      if (!workVisible) return;
      const rect = workStage.getBoundingClientRect();
      const progress = Math.max(0, Math.min(1, (innerHeight - rect.top) / (innerHeight + rect.height)));
      const travel = progress - 0.5;

      caseCards.forEach((card, index) => {
        const direction = index === 1 ? 1 : -1;
        card.style.setProperty("--mobile-card-x", `${direction * 4}px`);
        card.style.setProperty("--mobile-card-y", `${travel * 34 * direction}px`);
      });
      if (workCore) workCore.style.translate = `0 ${travel * -18}px`;
      if (workOrbits) workOrbits.style.translate = `0 ${travel * 11}px`;
    };

    const requestMobileWork = () => {
      if (!workFrame) workFrame = requestAnimationFrame(renderMobileWork);
    };

    const workObserver = new IntersectionObserver(([entry]) => {
      workVisible = entry.isIntersecting;
      if (workVisible) requestMobileWork();
    }, { rootMargin: "20% 0px" });

    workObserver.observe(workStage);
    addEventListener("scroll", requestMobileWork, { passive: true });
    addEventListener("resize", requestMobileWork, { passive: true });
  }

  // ── Selected work, as a deck ───────────────────────────────────────────────
  // On a phone the three cards share one grid cell and only the front one is
  // in hand. A swipe does not carry the card off the screen — it turns it back
  // into the stack while the next one rises into the same place, which is what
  // a shuffle looks like when it happens in your hands rather than on a table.
  //
  // The column underneath is the fallback: this script adds `.is-deck`, so if
  // it never runs, all three cards stay stacked and readable.
  const deck = document.querySelector<HTMLElement>(".work-grid");
  const deckUi = document.querySelector<HTMLElement>("[data-deck-ui]");
  const deckMedia = matchMedia("(max-width: 767px)");

  if (deck && deckUi) {
    const cards = Array.from(deck.querySelectorAll<HTMLElement>(".work-card"));
    const dots = Array.from(deckUi.querySelectorAll<HTMLButtonElement>("[data-deck-dot]"));
    let front = 0;
    let on = false;

    const paint = () => {
      cards.forEach((card, index) => {
        // Depth is how far round the deck this card is from the one in hand,
        // so the order wraps instead of running out.
        const depth = (index - front + cards.length) % cards.length;
        card.style.setProperty("--depth", String(depth));
        card.style.setProperty("--sway", depth === 1 ? "1" : depth === 2 ? "-1" : "0");
        card.toggleAttribute("data-deck-front", depth === 0);
        // Nothing behind the front card should be reachable by tab or by a
        // stray tap — it is 45% opacity and half a card lower.
        if ("inert" in HTMLElement.prototype) card.inert = depth !== 0;
      });
      dots.forEach((dot, index) => dot.setAttribute("aria-selected", index === front ? "true" : "false"));
    };

    const go = (step: number) => {
      front = (front + step + cards.length) % cards.length;
      paint();
    };

    const enable = () => {
      if (on) return;
      on = true;
      deck.classList.add("is-deck");
      deckUi.hidden = false;
      paint();
    };

    const disable = () => {
      if (!on) return;
      on = false;
      deck.classList.remove("is-deck");
      deckUi.hidden = true;
      front = 0;
      cards.forEach((card) => {
        card.style.removeProperty("--depth");
        card.style.removeProperty("--sway");
        card.style.removeProperty("--drag");
        card.style.removeProperty("--tilt");
        card.removeAttribute("data-deck-front");
        if ("inert" in HTMLElement.prototype) card.inert = false;
      });
    };

    dots.forEach((dot, index) => dot.addEventListener("click", () => { front = index; paint(); }));
    deckUi.querySelectorAll<HTMLButtonElement>("[data-deck-step]").forEach((button) => {
      button.addEventListener("click", () => go(Number(button.dataset.deckStep)));
    });

    // ── The drag ────────────────────────────────────────────────────────────
    // The front card follows the finger a third of the way, which is enough to
    // feel like a card and not enough to look like it is leaving. Past the
    // threshold it shuffles; short of it, it springs back.
    let startX = 0;
    let startY = 0;
    let dragging = false;
    let decided = false;

    const frontCard = () => cards[front];

    deck.addEventListener("pointerdown", (event) => {
      if (!on || event.pointerType === "mouse") return;
      startX = event.clientX;
      startY = event.clientY;
      dragging = true;
      decided = false;
    }, { passive: true });

    deck.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;

      if (!decided) {
        if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
        // A mostly-vertical move is the page being scrolled, not a card being
        // played. Hand it back rather than fighting it.
        if (Math.abs(dy) > Math.abs(dx)) { dragging = false; return; }
        decided = true;
        deck.classList.add("is-dragging");
      }

      const card = frontCard();
      const held = Math.max(-90, Math.min(90, dx));
      card.style.setProperty("--drag", `${held}px`);
      card.style.setProperty("--tilt", `${held * 0.035}deg`);
    }, { passive: true });

    const release = (event: PointerEvent) => {
      if (!dragging) return;
      const dx = event.clientX - startX;
      const card = frontCard();
      dragging = false;
      deck.classList.remove("is-dragging");
      card.style.setProperty("--drag", "0px");
      card.style.setProperty("--tilt", "0deg");
      if (decided && Math.abs(dx) > 42) go(dx < 0 ? 1 : -1);
    };

    deck.addEventListener("pointerup", release);
    deck.addEventListener("pointercancel", release);

    // A tap on a card behind the front one plays it rather than following its
    // link — the link is inert anyway, but this makes the stack feel live.
    cards.forEach((card, index) => {
      card.addEventListener("click", (event) => {
        if (!on || index === front) return;
        event.preventDefault();
        front = index;
        paint();
      });
    });

    const sync = () => (deckMedia.matches ? enable() : disable());
    sync();
    deckMedia.addEventListener("change", sync);
  }
</script>
